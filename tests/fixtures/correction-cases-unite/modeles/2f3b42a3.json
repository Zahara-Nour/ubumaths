					"expectedAnswer": "{{eval:a[h]+b[h]+(c*10)[min]+(d*10)[min]}}"
				}
			],
			"statement": "Calcule et écris la réponse sous la forme que tu veux.\n\n${{a}}~\\unit{h}~{{eval:c*10}}~\\unit{min} + {{b}}~\\unit{h}~{{eval:d*10}}~\\unit{min} = ?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..4"
				},
				{
					"name": "b",
					"expression": "1..4"
				},
				{
					"name": "c",
					"expression": "1..5"
				},
				{
					"name": "d",
					"expression": "1..5!{{eval:6-c}}"
				}
			],
			"correction": {
				"steps": [
					"{{if:{{c}}+{{d}}>=6|$$\\begin{align}{{a}}~\\unit{h}~{{eval:c*10}}~\\unit{min} + {{b}}~\\unit{h}~{{eval:d*10}}~\\unit{min} &= {{a}}~\\unit{h} + {{b}}~\\unit{h} + {{eval:c*10}}~\\unit{min} + {{eval:d*10}}~\\unit{min}\\\\ &= {{eval:a+b}}~\\unit{h} + 60~\\unit{min} + {{eval:c*10+d*10-60}}~\\unit{min}\\\\ &= {{eval:a+b}}~\\unit{h} + 1~\\unit{h} + {{eval:c*10+d*10-60}}~\\unit{min}\\\\ &= {{eval:a[h]+b[h]+(c*10)[min]+(d*10)[min];hms}}\\end{align}$$|${{a}}~\\unit{h}~{{eval:c*10}}~\\unit{min} + {{b}}~\\unit{h}~{{eval:d*10}}~\\unit{min} = {{eval:a[h]+b[h]+(c*10)[min]+(d*10)[min];hms}}$}}"
				]
			}
		}
	],

	"domain": "Durées",
	"subdomain": "Calculer",
	"level": 8,
	"delay": 20,
	"status": "published",
	"options": {
		"constraints": {
			"unit": "off",
			"zeros": "off"
		}
	},
	"variations": [
		{
			"blanks": [
				{
					"unit": {
						"expected": true
					},
					"expectedAnswer": "{{eval:b[h]+d[min]}}"
				}
			],
			"statement": "J'ai commencé à regarder un film à ${{a}}~\\unit{h}~{{c}}~\\unit{min}$, et je l'ai terminé à ${{q}}~\\unit{h}~{{r}}~\\unit{min}$. Quelle était la durée de ce film ? (n'oublie pas l'unité)\n\n$?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..4"
				},
				{
					"name": "b",
					"expression": "1..2"
				},
				{
					"name": "c",
					"expression": "1..59"
				},
				{
					"name": "d",
					"expression": "1..59!{{eval:60-c}}"
				},
				{
					"name": "q",
					"expression": "eval:a+b+floor((c+d)/60)"
				},
				{
					"name": "r",
					"expression": "eval:c+d-60*floor((c+d)/60)"
				}
			],
			"correction": {
				"steps": [
					"{{if:{{c}}+{{d}}<60|${{a}}~\\unit{h}~{{c}}~\\unit{min} + {{b}}~\\unit{h}~{{d}}~\\unit{min} = {{q}}~\\unit{h}~{{r}}~\\unit{min}$|$$\\begin{align}{{q}}~\\unit{h}~{{r}}~\\unit{min} &= {{a}}~\\unit{h}~{{c}}~\\unit{min} + {{eval:60-c}}~\\unit{min} + {{b}}~\\unit{h} + {{eval:c+d-60}}~\\unit{min}\\\\ &= {{a}}~\\unit{h}~{{c}}~\\unit{min} + {{b}}~\\unit{h}~{{d}}~\\unit{min}\\end{align}$$}}",
					"Le film a duré ${{b}}~\\unit{h}~{{d}}~\\unit{min}$."
				],
				"feedback": {
					"correct": "La durée du film est de {{answer}}."
				}
			}
		}
	],

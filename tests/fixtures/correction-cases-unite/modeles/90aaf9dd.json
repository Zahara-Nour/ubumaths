					"expression": "1..59"
				}
			],
			"correction": {
				"steps": [
					"{{if:{{b}}+{{c}}>=60|$$\\begin{align}{{a}}~\\unit{h}~{{b}}~\\unit{min} + {{c}}~\\unit{min} &= {{a}}~\\unit{h} + {{eval:b+c}}~\\unit{min}\\\\ &= {{a}}~\\unit{h} + 60~\\unit{min} + {{eval:b+c-60}}~\\unit{min}\\\\ &= {{a}}~\\unit{h} + 1~\\unit{h} + {{eval:b+c-60}}~\\unit{min}\\\\ &= {{eval:a[h]+b[min]+c[min];hms}}\\end{align}$$|${{a}}~\\unit{h}~{{b}}~\\unit{min} + {{c}}~\\unit{min} = {{eval:a[h]+b[min]+c[min];hms}}$}}"
				]
			}
		}
	],

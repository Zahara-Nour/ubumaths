						"$$\\begin{align} {{eval:a*100 + b*10+c}} + {{eval:f*10^d}} &= {{if:((f*10^d))<10|{{if:(mod(((a*100 + b*10+c)),10))*((a*100 + b*10+c)-mod(((a*100 + b*10+c)),10))>0|\\textcolor{{{color:primary.0}}}{{{eval:(a*100 + b*10+c)-mod(((a*100 + b*10+c)),10)}}} + \\textcolor{{{color:primary.0}}}{{{eval:mod(((a*100 + b*10+c)),10)}}} + {{eval:f*10^d}} \\\\ &= {{eval:(a*100 + b*10+c)-mod(((a*100 + b*10+c)),10)}} + \\textcolor{{{color:primary.1}}}{{{eval:mod(((a*100 + b*10+c)),10)+(f*10^d)}}} \\\\ &= |}}|{{if:((f*10^d))<100|{{if:(mod(((a*100 + b*10+c)),10))*((a*100 + b*10+c)-mod(((a*100 + b*10+c)),10))>0|\\textcolor{{{color:primary.0}}}{{{eval:(a*100 + b*10+c)-mod(((a*100 + b*10+c)),10)}}} + {{eval:f*10^d}} + \\textcolor{{{color:primary.0}}}{{{eval:mod(((a*100 + b*10+c)),10)}}} \\\\ &= \\textcolor{{{color:primary.1}}}{{{eval:(a*100 + b*10+c)-mod(((a*100 + b*10+c)),10)+(f*10^d)}}} + {{eval:mod(((a*100 + b*10+c)),10)}} \\\\ &= |}}|{{if:(mod(((a*100 + b*10+c)),100))*((a*100 + b*10+c)-mod(((a*100 + b*10+c)),100))>0|\\textcolor{{{color:primary.0}}}{{{eval:(a*100 + b*10+c)-mod(((a*100 + b*10+c)),100)}}} + {{eval:f*10^d}} + \\textcolor{{{color:primary.0}}}{{{eval:mod(((a*100 + b*10+c)),100)}}} \\\\ &= \\textcolor{{{color:primary.1}}}{{{eval:(a*100 + b*10+c)-mod(((a*100 + b*10+c)),100)+(f*10^d)}}} + {{eval:mod(((a*100 + b*10+c)),100)}} \\\\ &= |}}}}}}{{solution}} \\end{align}$$"

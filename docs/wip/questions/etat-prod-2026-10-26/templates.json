						"$$\\begin{align} {{if:a>0|\\left( {{if:a>0|\\textcolor{{{color:primary.0}}}{{{a}}}|\\textcolor{{{color:primary.1}}}{0}}} \\times 100 \\right)|}}{{if:a+b>0|{{if:a>0| + |}}\\left( {{if:b>0|\\textcolor{{{color:primary.0}}}{{{b}}}|\\textcolor{{{color:primary.1}}}{0}}} \\times 10 \\right)|}}{{if:a+b>0|{{if:c>0| + \\textcolor{{{color:primary.0}}}{{{c}}}| + \\left( \\textcolor{{{color:primary.1}}}{0} \\times 1 \\right)}}|{{if:c>0|\\textcolor{{{color:primary.0}}}{{{c}}}|0}}}} &= {{solution}} \\end{align}$$"
					]

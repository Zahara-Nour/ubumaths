						"$$\\begin{align} {{a}}\\% &= \\dfrac{{{a}}}{100} \\\\ &= \\dfrac{{{a}} \\textcolor{{{color:primary.0}}}{\\div {{b}}}}{100 \\textcolor{{{color:primary.0}}}{\\div {{b}}}} \\\\ &= {{solution}} \\end{align}$$"
					]
				},
				"blanks": [

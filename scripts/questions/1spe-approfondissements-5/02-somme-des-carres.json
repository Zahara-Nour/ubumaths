	"variations": [
		{
			"statement": "On admet que, pour tout entier naturel $n$ non nul :\n\n$$S_n=1^2+2^2+\\cdots+n^2=\\dfrac{n(n+1)(2n+1)}{6}$$\n\nCalcule $1^2+2^2+\\cdots+{{eval:n}}^2$.\n\n$S_{{{eval:n}}}=?$",
			"variables": [
				{
					"name": "n",
					"expression": "5..20"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n*(n+1)*(2*n+1)/6}}"
				}
			],
			"correction": {
				"steps": [
					"On remplace $n$ par ${{eval:n}}$ : $S_{{{eval:n}}}=\\dfrac{{{eval:n}}\\times{{eval:n+1}}\\times{{eval:2*n+1}}}{6}$.",
					"Donc $S_{{{eval:n}}}=\\textcolor{{{color:primary.0}}}{{{eval:n*(n+1)*(2*n+1)/6}}}$."
				]
			}
		},
		{
			"statement": "On admet que, pour tout entier naturel $n$ non nul :\n\n$$S_n=1^2+2^2+\\cdots+n^2=\\dfrac{n(n+1)(2n+1)}{6}$$\n\nCalcule ${{eval:a}}^2+{{eval:a+1}}^2+\\cdots+{{eval:b}}^2$.\n\n$?$",
			"variables": [
				{
					"name": "a",
					"expression": "4..8"
				},
				{
					"name": "b",
					"expression": "12..20"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:b*(b+1)*(2*b+1)/6-(a-1)*a*(2*a-1)/6}}"
				}
			],
			"correction": {
				"steps": [
					"La somme demandée est $S_{{{eval:b}}}$ privée des termes $1^2$, …, ${{eval:a-1}}^2$, c'est-à-dire $S_{{{eval:b}}}-S_{{{eval:a-1}}}$.",
					"$S_{{{eval:b}}}={{eval:b*(b+1)*(2*b+1)/6}}$ et $S_{{{eval:a-1}}}={{eval:(a-1)*a*(2*a-1)/6}}$.",
					"Donc la somme vaut $\\textcolor{{{color:primary.0}}}{{{eval:b*(b+1)*(2*b+1)/6-(a-1)*a*(2*a-1)/6}}}$.",
					"Attention : on retire $S_{{{eval:a-1}}}$, pas $S_{{{eval:a}}}$ : le terme ${{eval:a}}^2$ fait partie de la somme."
				]
			}
		},
		{
			"statement": "On admet que, pour tout entier naturel $n$ non nul :\n\n$$S_n=1^2+2^2+\\cdots+n^2=\\dfrac{n(n+1)(2n+1)}{6}$$\n\nQue vaut $S_{n+1}-S_n$ ? Complète.\n\n$S_{n+1}-S_n=?$",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "(n+1)^2",
					"requiredForm": {
						"pattern": "u"
					}
				}
			],
			"correction": {
				"steps": [
					"$S_{n+1}=1^2+2^2+\\cdots+n^2+(n+1)^2$ : c'est $S_n$ plus un terme.",
					"Donc $S_{n+1}-S_n=\\textcolor{{{color:primary.0}}}{(n+1)^2}$, sans utiliser la formule."
				]
			}
		}
	],

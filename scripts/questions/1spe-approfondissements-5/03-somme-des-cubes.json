					"expectedAnswer": "{{eval:(n*(n+1)/2)^2}}"
				}
			],
			"correction": {
				"steps": [
					"On remplace $n$ par ${{eval:n}}$ : $\\dfrac{{{eval:n}}\\times{{eval:n+1}}}{2}={{eval:n*(n+1)/2}}$.",
					"Donc $T_{{{eval:n}}}={{eval:n*(n+1)/2}}^2=\\textcolor{{{color:primary.0}}}{{{eval:(n*(n+1)/2)^2}}}$.",
					"Ne pas oublier le carré."
				]
			}
		},
		{
			"statement": "On admet que, pour tout entier naturel $n$ non nul :\n\n$$T_n=1^3+2^3+\\cdots+n^3=\\left(\\dfrac{n(n+1)}{2}\\right)^2$$\n\nComme $1+2+\\cdots+n=\\dfrac{n(n+1)}{2}$, la somme des cubes est le carré d'une somme d'entiers. Complète.\n\n$1^3+2^3+\\cdots+{{eval:n}}^3=\\left(?\\right)^2$",
			"variables": [
				{
					"name": "n",
					"expression": "6..15"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n*(n+1)/2}}"
				}
			],
			"correction": {
				"steps": [
					"$1^3+2^3+\\cdots+n^3=\\left(1+2+\\cdots+n\\right)^2$.",
					"Ici $1+2+\\cdots+{{eval:n}}=\\dfrac{{{eval:n}}\\times{{eval:n+1}}}{2}=\\textcolor{{{color:primary.0}}}{{{eval:n*(n+1)/2}}}$."
				]
			}
		},
		{
			"statement": "On admet que, pour tout entier naturel $n$ non nul :\n\n$$T_n=1^3+2^3+\\cdots+n^3=\\left(\\dfrac{n(n+1)}{2}\\right)^2$$\n\nCalcule ${{eval:a}}^3+{{eval:a+1}}^3+\\cdots+{{eval:b}}^3$.\n\n$?$",

	"status": "draft",
	"variations": [
		{
			"statement": "Construis la collection de $\\textcolor{{{color:primary.0}}}{{{c}}}$ {{if:c<=1|centaine|centaines}}, $\\textcolor{{{color:primary.1}}}{{{d}}}$ dizaines et ${{u}}$ {{if:u<=1|unité|unités}}.\n\n```collection\nconstruire: {{eval:100*c+10*d+u}}\n```",
			"variables": [
				{
					"name": "c",
					"expression": "1..8"
				},
				{
					"name": "d",
					"expression": "11..19"
				},
				{
					"name": "u",
					"expression": "1..9"
				}
			],
			"conditions": ["100*c+10*d+u <= 999"],
			"blanks": [],
			"correction": {
				"steps": [
					"${{d}}$ dizaines, c'est $1$ centaine et ${{eval:d-10}}$ {{if:d-10<=1|dizaine|dizaines}}.",
					"La collection vaut $\\textcolor{{{color:primary.0}}}{{{eval:100*c+10*d+u}}}$ : on pose ${{eval:c+1}}$ plaques, ${{eval:d-10}}$ {{if:d-10<=1|barre|barres}} et ${{u}}$ {{if:u<=1|petit cube|petits cubes}} (ou ${{c}}$ {{if:c<=1|plaque|plaques}} et ${{d}}$ barres)."
				]
			}
		},
		{
			"statement": "Construis la collection de $\\textcolor{{{color:primary.1}}}{{{d}}}$ dizaines et ${{u}}$ {{if:u<=1|unité|unités}}.\n\n```collection\nconstruire: {{eval:10*d+u}}\n```",
			"variables": [
				{
					"name": "d",
					"expression": "11..39"
				},
				{
					"name": "u",
					"expression": "1..19"
				}
			],
			"conditions": ["d != 20", "d != 30", "u != 10"],
			"blanks": [],
			"correction": {
				"steps": [
					"${{d}}$ dizaines font ${{eval:10*d}}$ ; avec ${{u}}$ {{if:u<=1|unité|unités}}, la collection vaut $\\textcolor{{{color:primary.0}}}{{{eval:10*d+u}}}$.",
					"On peut poser ${{d}}$ barres et ${{u}}$ {{if:u<=1|petit cube|petits cubes}}, ou remplacer chaque fois $10$ barres par une plaque et $10$ petits cubes par une barre."
				]
			}
		},
		{
			"statement": "Construis la collection de $\\textcolor{{{color:primary.0}}}{{{c}}}$ centaines et $\\textcolor{{{color:primary.1}}}{{{d}}}$ dizaines.\n\n```collection\nconstruire: {{eval:100*c+10*d}}\n```",
			"variables": [
				{
					"name": "c",
					"expression": "8..9"
				},
				{
					"name": "d",
					"expression": "10..20"
				}
			],
			"conditions": ["100*c+10*d <= 1000"],
			"blanks": [],
			"correction": {
				"steps": [
					"${{d}}$ dizaines, c'est ${{eval:floor(d/10)}}$ {{if:floor(d/10)<=1|centaine|centaines}}{{if:mod(d,10)!=0| et ${{eval:d-10*floor(d/10)}}$ {{if:d-10*floor(d/10)<=1|dizaine|dizaines}}|}}.",
					"La collection vaut $\\textcolor{{{color:primary.0}}}{{{eval:100*c+10*d}}}$."
				]
			}
		}
	],

	"variations": [
		{
			"statement": "Soit $z={{a}}+({{a}})i$. Donne son module et son argument principal (l'argument qui appartient à $]-\\pi\\,;\\pi]$).\n\n$|z|=?$\n\nArgument principal : $?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..5;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:abs(a)*sqrt(2)}}"
				},
				{
					"expectedAnswer": "{{if:a>0|\\frac{\\pi}{4}|-\\frac{3\\pi}{4}}}"
				}
			],
			"correction": {
				"steps": [
					"$|z|=\\sqrt{ {{eval:a^2}}+{{eval:a^2}} }={{eval:abs(a)*sqrt(2)}}$.",
					"$\\cos\\theta=\\dfrac{x}{|z|}={{eval:a/(abs(a)*sqrt(2))}}$ et $\\sin\\theta=\\dfrac{y}{|z|}={{eval:a/(abs(a)*sqrt(2))}}$.",
					"Donc $\\theta=\\textcolor{{{color:primary.0}}}{{{if:a>0|\\frac{\\pi}{4}|-\\frac{3\\pi}{4}}}}$."
				]
			}
		},
		{
			"statement": "Soit $z={{a}}\\sqrt{3}+({{a}})i$. Donne son module et son argument principal (l'argument qui appartient à $]-\\pi\\,;\\pi]$).\n\n$|z|=?$\n\nArgument principal : $?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..4;±"

			"variationIndex": 0,
			"variables": {
				"p": "1",
				"q": "1",
				"c": "2",
				"d": "-1",
				"u": "3",
				"v": "1",
				"n": "5"
			},
			"answers": ["\\frac{3+i}{2-i}"],

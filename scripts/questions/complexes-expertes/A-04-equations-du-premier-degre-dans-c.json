			}
		},
		{
			"description": "v0 division terme à terme → 3/2 − i",
			"variationIndex": 0,
			"variables": {
				"p": "1",
				"q": "1",
				"c": "2",
				"d": "-1",
				"u": "3",
				"v": "1",
				"n": "5"
			},
			"answers": ["\\frac{3}{2}-i"],
			"expected": {
				"status": "incorrect"
			}

				"c": "2",
				"d": "-1",
				"u": "3",
				"v": "1",
				"n": "5"
			},
			"answers": ["1+i"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "v0 multiplié au lieu de divisé → (3+i)(2−i) = 7−i",
			"variationIndex": 0,
			"variables": {
				"p": "1",

{
	"title": "Conjugué d'un nombre complexe et ses propriétés",
	"description": "Conjugué de a+ib, z·z̄ = a²+b², z+z̄ et z−z̄, conjugué d'un produit (pièges : conjugué de la partie réelle, z·z̄ = a²−b², conjuguer un seul facteur)",
	"grades": ["T_EXP"],
	"points": ["TEXP-003", "TEXP-014", "TEXP-011", "TEXP-006"],
	"theme": "Nombres complexes",
	"domain": "Forme algébrique",
	"subdomain": "Conjugaison",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"shared": {
		"cleanCoefficients": true
	},
	"variations": [
		{
			"statement": "Soit $z={{a}}+({{b}})i$. Donne son conjugué $\\overline{z}$.\n\n$\\overline{z}$ : $?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9;±"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{a}}-({{b}})i"
				}
			],
			"correction": {
				"steps": [
					"Le conjugué de $a+ib$ est $a-ib$ : on change le signe de la partie imaginaire seulement.",
					"Le conjugué de $z$ est ${{a}}-({{b}})i$ ; son image est le symétrique de celle de $z$ par rapport à l'axe des réels."
				]
			}
		},
		{
			"statement": "Soit $z={{a}}+({{b}})i$. Calcule $z\\overline{z}$.\n\n$z\\overline{z}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..7;±"
				},
				{
					"name": "b",
					"expression": "1..7;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a^2+b^2}}"
				}
			],
			"correction": {
				"steps": [
					"$({{a}}+({{b}})i)({{a}}-({{b}})i)={{eval:a^2}}-{{eval:b^2}}i^2$.",
					"Comme $i^2=-1$ : $z\\overline{z}={{eval:a^2}}+{{eval:b^2}}=\\textcolor{{{color:primary.0}}}{{{eval:a^2+b^2}}}$, un réel positif : c'est $|z|^2$."
				]
			}
		},
		{
			"statement": "Soit $z={{a}}+({{b}})i$. Calcule $z+\\overline{z}$ et $z-\\overline{z}$.\n\n$z+\\overline{z}$ : $?$\n\n$z-\\overline{z}$ : $?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9;±"
				},
				{
					"name": "b",
					"expression": "2..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*a}}"
				},
				{
					"expectedAnswer": "{{eval:2*b}}i"
				}
			],
			"correction": {
				"steps": [
					"$z+\\overline{z}=2\\,\\mathrm{Re}(z)$ et $z-\\overline{z}=2i\\,\\mathrm{Im}(z)$.",
					"$z+\\overline{z}={{eval:2*a}}$ et $z-\\overline{z}={{eval:2*b}}i$."
				]
			}
		},
		{
			"statement": "Soit $z={{a}}+({{b}})i$ et $w={{c}}+({{d}})i$. Calcule $\\overline{zw}$ sous forme algébrique.\n\n$\\overline{zw}$ : $?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..4;±"
				},
				{
					"name": "b",
					"expression": "1..4;±"
				},
				{
					"name": "c",
					"expression": "1..4;±"
				},
				{
					"name": "d",
					"expression": "1..4;±"
				}
			],
			"conditions": ["a*c-b*d != 0", "a*d+b*c != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*c-b*d}}-({{eval:a*d+b*c}})i"
				}
			],
			"correction": {
				"steps": [
					"$\\overline{zw}=\\overline{z}\\times\\overline{w}$ : on peut calculer $zw$ puis le conjuguer.",
					"$zw={{eval:a*c-b*d}}+({{eval:a*d+b*c}})i$, donc le conjugué de $zw$ est ${{eval:a*c-b*d}}-({{eval:a*d+b*c}})i$."
				]
			}
		}
	],
	"testSpecs": [

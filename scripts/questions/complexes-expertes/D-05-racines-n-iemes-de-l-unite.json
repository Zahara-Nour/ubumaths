	"variations": [
		{
			"statement": "Donne les quatre racines quatrièmes de l'unité, c'est-à-dire les solutions dans $\\mathbb{C}$ de $z^4=1$, sous forme algébrique et dans l'ordre que tu veux.\n\n$?$, $?$, $?$ et $?$",
			"blanks": [
				{
					"expectedAnswer": "1"
				},
				{
					"expectedAnswer": "i"
				},
				{
					"expectedAnswer": "-1"
				},
				{
					"expectedAnswer": "-i"
				}
			],
			"correction": {
				"steps": [
					"$\\mathbb{U}_4$ est formé des $e^{i\\frac{2k\\pi}{4}}$ pour $k$ entier de $0$ à $3$ : $1$, $e^{i\\frac{\\pi}{2}}$, $e^{i\\pi}$, $e^{i\\frac{3\\pi}{2}}$.",
					"Soit $1$, $i$, $-1$ et $-i$ : les sommets d'un carré inscrit dans le cercle unité."
				]
			}
		},
		{
			"statement": "Donne les trois racines cubiques de l'unité, c'est-à-dire les solutions dans $\\mathbb{C}$ de $z^3=1$, sous forme algébrique et dans l'ordre que tu veux.\n\n$?$, $?$ et $?$",
			"blanks": [
				{
					"expectedAnswer": "1"
				},
				{
					"expectedAnswer": "-\\frac{1}{2}+\\frac{\\sqrt{3}}{2}i"
				},
				{
					"expectedAnswer": "-\\frac{1}{2}-\\frac{\\sqrt{3}}{2}i"
				}
			],
			"correction": {
				"steps": [
					"$\\mathbb{U}_3$ est formé de $1$, $e^{i\\frac{2\\pi}{3}}$ et $e^{-i\\frac{2\\pi}{3}}$.",
					"$e^{\\pm i\\frac{2\\pi}{3}}=-\\frac{1}{2}\\pm\\frac{\\sqrt{3}}{2}i$ : les sommets d'un triangle équilatéral inscrit dans le cercle unité."
				]
			}
		},
		{
			"statement": "Soit $\\omega=e^{i\\frac{2\\pi}{ {{n}} }}$. Calcule $S=1+\\omega+\\omega^2+\\cdots+\\omega^{ {{eval:n-1}} }$.\n\n$S=?$",
			"variables": [
				{
					"name": "n",
					"expression": "3..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"$S$ est la somme des termes d'une suite géométrique de raison $\\omega\\neq1$ : $S=\\dfrac{1-\\omega^{ {{n}} }}{1-\\omega}$.",
					"Or $\\omega^{ {{n}} }=e^{2i\\pi}=1$, donc $S=\\textcolor{{{color:primary.0}}}{0}$."
				]
			}
		},
		{
			"statement": "Soit $\\omega=e^{i\\frac{2\\pi}{ {{n}} }}$. Donne l'argument principal (dans $]-\\pi\\,;\\pi]$) de $\\omega^{ {{k}} }$.\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "5..8"
				},
				{
					"name": "k",
					"expression": "6..15"
				}
			],
			"conditions": ["k > n", "2*(k-n) <= n"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*(k-n)*pi/n}}"
				}
			],
			"correction": {
				"steps": [
					"$\\omega^{ {{k}} }=e^{i\\frac{ {{eval:2*k}}\\pi}{ {{n}} }}$ et $\\omega^{ {{n}} }=1$, donc $\\omega^{ {{k}} }=\\omega^{ {{eval:k-n}} }$.",
					"L'argument principal de $\\omega^{ {{k}} }$ est ${{eval:2*(k-n)*pi/n}}$."
				]
			}
		},
		{
			"statement": "On note $A_0, A_1, \\ldots$ les points dont les affixes sont les racines $n$-ièmes de l'unité pour $n={{n}}$ ; ils forment un polygone régulier à ${{n}}$ côtés inscrit dans le cercle unité. Calcule la longueur d'un côté, $A_0A_1=|\\omega-1|$ avec $\\omega=e^{i\\frac{2\\pi}{ {{n}} }}$.\n\n$A_0A_1=?$",
			"variables": [
				{
					"name": "n",
					"expression": "3|4|6"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:n==3|\\sqrt{3}|{{if:n==4|\\sqrt{2}|1}}}}"
				}
			],
			"correction": {
				"steps": [
					"$\\omega-1=\\left(\\cos\\frac{2\\pi}{ {{n}} }-1\\right)+i\\sin\\frac{2\\pi}{ {{n}} }$.",
					"$A_0A_1=|\\omega-1|=\\textcolor{{{color:primary.0}}}{{{if:n==3|\\sqrt{3}|{{if:n==4|\\sqrt{2}|1}}}}}$."
				]
			}
		}
	],

{
	"title": "Produit, quotient, puissance et inverse sous forme exponentielle",
	"description": "z₁z₂, z₁/z₂, zⁿ, 1/z avec z = re^{iθ} : module et argument principal du résultat (pièges : modules additionnés, arguments multipliés, argument non ramené dans ]−π ; π])",
	"grades": ["T_EXP"],
	"points": ["TEXP-033", "TEXP-039", "TEXP-015", "TEXP-017", "TEXP-034"],
	"theme": "Nombres complexes",
	"domain": "Formes trigonométrique et exponentielle",
	"subdomain": "Calculs sous forme exponentielle",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"shared": {
		"cleanCoefficients": true
	},
	"variations": [
		{
			"statement": "Soit $z_1={{r1}}e^{{{if:m1>=0||-}}i{{eval:abs(m1)*pi/12}}}$ et $z_2={{r2}}e^{{{if:m2>=0||-}}i{{eval:abs(m2)*pi/12}}}$. Écris $z_1z_2$ sous forme exponentielle, avec l'argument principal.\n\n$z_1z_2=?e^{i?}$",
			"variables": [
				{
					"name": "r1",
					"expression": "2..5"
				},
				{
					"name": "r2",
					"expression": "2..5"
				},
				{
					"name": "m1",
					"expression": "1..11;±"
				},
				{
					"name": "m2",
					"expression": "1..11;±"
				}
			],
			"conditions": ["m1+m2 > -12", "m1+m2 <= 12", "m1+m2 != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:r1*r2}}"
				},
				{
					"expectedAnswer": "{{eval:(m1+m2)*pi/12}}"
				}
			],
			"correction": {
				"steps": [
					"$e^{ia}\\times e^{ib}=e^{i(a+b)}$ : on multiplie les modules et on additionne les arguments.",
					"$z_1z_2={{eval:r1*r2}}e^{ {{if:m1+m2>=0||-}}i{{eval:abs((m1+m2)*pi/12)}} }$, et cet argument est bien dans $]-\\pi\\,;\\pi]$."
				]
			}
		},
		{
			"statement": "Soit $z_1={{r1}}e^{{{if:m1>=0||-}}i{{eval:abs(m1)*pi/12}}}$ et $z_2={{r2}}e^{{{if:m2>=0||-}}i{{eval:abs(m2)*pi/12}}}$. Écris $\\dfrac{z_1}{z_2}$ sous forme exponentielle, avec l'argument principal.\n\n$\\dfrac{z_1}{z_2}=?e^{i?}$",
			"variables": [
				{
					"name": "r1",
					"expression": "2..9"
				},
				{
					"name": "r2",
					"expression": "2..5"
				},
				{
					"name": "m1",
					"expression": "1..11;±"
				},
				{
					"name": "m2",
					"expression": "1..11;±"
				}
			],
			"conditions": ["m1-m2 > -12", "m1-m2 <= 12", "m1 != m2", "r1 != r2"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:r1/r2}}"
				},
				{
					"expectedAnswer": "{{eval:(m1-m2)*pi/12}}"
				}
			],
			"correction": {
				"steps": [
					"$\\dfrac{e^{ia}}{e^{ib}}=e^{i(a-b)}$ : on divise les modules et on soustrait les arguments.",
					"$\\dfrac{z_1}{z_2}={{eval:r1/r2}}e^{ {{if:m1-m2>=0||-}}i{{eval:abs((m1-m2)*pi/12)}} }$."
				]
			}
		},
		{
			"statement": "Soit $z={{r}}e^{i{{eval:m*pi/6}}}$. Écris $z^{ {{n}} }$ sous forme exponentielle, avec l'argument principal.\n\n$z^{ {{n}} }=?e^{i?}$",
			"variables": [
				{
					"name": "r",
					"expression": "2..3"
				},
				{
					"name": "n",
					"expression": "2..4"
				},
				{
					"name": "m",
					"expression": "1..5"
				},
				{
					"name": "k",
					"expression": "eval:mod(n*m+5,12)-5"
				}
			],
			"conditions": ["k != n*m"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:r^n}}"
				},
				{
					"expectedAnswer": "{{eval:k*pi/6}}"
				}
			],
			"correction": {
				"steps": [
					"$\\left(re^{i\\theta}\\right)^n=r^ne^{in\\theta}$ : ici $z^{ {{n}} }={{eval:r^n}}e^{i{{eval:n*m*pi/6}}}$.",
					"On retire un multiple de $2\\pi$ pour revenir dans $]-\\pi\\,;\\pi]$ : $z^{ {{n}} }={{eval:r^n}}e^{ {{if:k>=0||-}}i{{eval:abs(k*pi/6)}} }$."
				]
			}
		},
		{
			"statement": "Soit $z={{r}}e^{{{if:m>=0||-}}i{{eval:abs(m)*pi/12}}}$. Écris $\\dfrac{1}{z}$ sous forme exponentielle, avec l'argument principal.\n\n$\\dfrac{1}{z}=?e^{i?}$",
			"variables": [
				{
					"name": "r",
					"expression": "2..9"
				},
				{
					"name": "m",
					"expression": "1..11;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{1}{ {{r}} }"
				},
				{
					"expectedAnswer": "{{eval:-m*pi/12}}"
				}
			],
			"correction": {
				"steps": [
					"$\\dfrac{1}{re^{i\\theta}}=\\dfrac{1}{r}e^{-i\\theta}$.",
					"$\\dfrac{1}{z}=\\dfrac{1}{ {{r}} }e^{ {{if:m<=0||-}}i{{eval:abs(-m*pi/12)}} }$."
				]
			}
		}
	],

{
	"title": "Calculer avec des nombres complexes sous forme algébrique",
	"description": "Somme, produit, carré, cube par la formule du binôme, puissance de i (pièges : i² = 1, signe de la partie imaginaire, période 4 des puissances de i)",
	"grades": ["T_EXP"],
	"points": ["TEXP-001", "TEXP-002", "TEXP-005", "TEXP-006"],
	"theme": "Nombres complexes",
	"domain": "Forme algébrique",
	"subdomain": "Calculs algébriques",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"shared": {
		"cleanCoefficients": true
	},
	"variations": [
		{
			"statement": "Soit $z=({{a}}+({{b}})i)-({{c}}+({{d}})i)$. Écris le résultat sous forme algébrique $a+ib$.\n\n$z=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..6;±"
				},
				{
					"name": "b",
					"expression": "1..6;±"
				},
				{
					"name": "c",
					"expression": "1..6;±"
				},
				{
					"name": "d",
					"expression": "1..6;±"
				}
			],
			"conditions": ["a != c", "b != d"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a-c}}+({{eval:b-d}})i"
				}
			],
			"correction": {
				"steps": [
					"On soustrait les parties réelles et les parties imaginaires : $z=({{a}}-({{c}}))+({{b}}-({{d}}))i$.",
					"Donc $z={{eval:a-c}}+({{eval:b-d}})i$."
				]
			}
		},
		{
			"statement": "Soit $z=({{a}}+({{b}})i)({{c}}+({{d}})i)$. Écris le résultat sous forme algébrique $a+ib$.\n\n$z=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "b",
					"expression": "1..5;±"
				},
				{
					"name": "c",
					"expression": "1..5;±"
				},
				{
					"name": "d",
					"expression": "1..5;±"
				}
			],
			"conditions": ["a*c-b*d != 0", "a*d+b*c != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*c-b*d}}+({{eval:a*d+b*c}})i"
				}
			],
			"correction": {
				"steps": [
					"On développe : $z={{eval:a*c}}+({{eval:a*d}})i+({{eval:b*c}})i+({{eval:b*d}})i^2$.",
					"Comme $i^2=-1$ : $z={{eval:a*c}}-({{eval:b*d}})+({{eval:a*d+b*c}})i$, soit $z={{eval:a*c-b*d}}+({{eval:a*d+b*c}})i$."
				]
			}
		},
		{
			"statement": "Calcule $i^{ {{n}} }$.\\n\\n$i^{ {{n}} }=?$",
			"variables": [
				{
					"name": "n",
					"expression": "5..60"
				},
				{
					"name": "r",
					"expression": "eval:mod(n,4)"
				},
				{
					"name": "q",
					"expression": "eval:(n-r)/4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:r==0|1|{{if:r==1|i|{{if:r==2|-1|-i}}}}}}"
				}
			],
			"correction": {
				"steps": [
					"$i^2=-1$ et $i^4=1$ : les puissances de $i$ se répètent de 4 en 4.",
					"${{n}}=4\\times{{q}}+{{r}}$, donc $i^{ {{n}} }=\\left(i^4\\right)^{ {{q}} }\\times i^{ {{r}} }=i^{ {{r}} }$, soit $i^{ {{n}} }=\\textcolor{{{color:primary.0}}}{{{if:r==0|1|{{if:r==1|i|{{if:r==2|-1|-i}}}}}}}$."
				]
			}
		},
		{
			"statement": "Soit $z=({{a}}+({{b}})i)^2$. Écris le résultat sous forme algébrique $a+ib$.\n\n$z=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..6;±"
				},
				{
					"name": "b",
					"expression": "1..6;±"
				}
			],
			"conditions": ["a^2 != b^2"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a^2-b^2}}+({{eval:2*a*b}})i"
				}
			],
			"correction": {
				"steps": [
					"$(a+ib)^2=a^2+2iab+i^2b^2=a^2-b^2+2abi$.",
					"Donc $z={{eval:a^2}}-{{eval:b^2}}+({{eval:2*a*b}})i$, soit $z={{eval:a^2-b^2}}+({{eval:2*a*b}})i$."
				]
			}
		},
		{
			"statement": "Soit $z=({{a}}+i)^3$. Développe à l'aide de la formule du binôme. Écris le résultat sous forme algébrique $a+ib$.\n\n$z=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..4;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a^3-3*a}}+({{eval:3*a^2-1}})i"
				}
			],
			"correction": {
				"steps": [
					"Formule du binôme : $(a+i)^3=a^3+3a^2i+3ai^2+i^3$, avec $i^2=-1$ et $i^3=-i$.",
					"$z={{eval:a^3}}+{{eval:3*a^2}}i-({{eval:3*a}})-i$, soit $z={{eval:a^3-3*a}}+({{eval:3*a^2-1}})i$."
				]
			}
		}
	],

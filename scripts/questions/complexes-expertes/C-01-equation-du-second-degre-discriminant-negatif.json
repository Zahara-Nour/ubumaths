{
	"title": "Résoudre une équation du second degré à coefficients réels (Δ < 0)",
	"description": "z² + bz + c = 0 et 4z² − 4pz + p² + 1 = 0 avec Δ < 0 : deux solutions conjuguées, dans l'ordre que l'on veut (pièges : oubli de la solution conjuguée, signe de b, division par 2a oubliée, √Δ avec Δ < 0)",
	"grades": ["T_EXP"],
	"points": ["TEXP-043", "TEXP-047"],
	"theme": "Nombres complexes",
	"domain": "Équations polynomiales",
	"subdomain": "Second degré",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"shared": {
		"cleanCoefficients": true
	},
	"options": {
		"orderIndependent": true
	},
	"variations": [
		{
			"statement": "Résous dans $\\mathbb{C}$ l'équation $z^2+({{b}})z+{{c}}=0$.\n\n$z_1=?$ et $z_2=?$",
			"variables": [
				{
					"name": "p",
					"expression": "1..4;±"
				},
				{
					"name": "q",
					"expression": "1..4"
				},
				{
					"name": "b",
					"expression": "eval:-2*p"
				},
				{
					"name": "c",
					"expression": "eval:p^2+q^2"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{p}}+({{q}})i"
				},
				{
					"expectedAnswer": "{{p}}-({{q}})i"
				}
			],
			"correction": {
				"steps": [
					"$\\Delta={{b;()}}^2-4\\times{{c}}={{eval:b^2-4*c}}$.",
					"$\\Delta<0$ : l'équation a deux solutions complexes conjuguées $z=\\dfrac{-b\\pm i\\sqrt{-\\Delta}}{2a}$.",
					"$z_1={{p}}+({{q}})i$ et $z_2={{p}}-({{q}})i$."
				]
			}
		},
		{
			"statement": "Résous dans $\\mathbb{C}$ l'équation $z^2+({{b}})z+{{c}}=0$.\n\n$z_1=?$ et $z_2=?$",
			"variables": [
				{

			],
			"blanks": [
				{
					"expectedAnswer": "{{p}}+{{if:q==1||{{if:q==-1|-|{{eval:q}}}}}}\\sqrt{3}i"
				},
				{
					"expectedAnswer": "{{p}}-{{if:q==1||{{if:q==-1|-|{{eval:q}}}}}}\\sqrt{3}i"
				}
			],
			"correction": {
				"steps": [
					"$\\Delta={{b;()}}^2-4\\times{{c}}={{eval:b^2-4*c}}$, et $\\sqrt{ {{eval:4*c-b^2}} }={{eval:sqrt(4*c-b^2)}}$.",
					"$\\Delta<0$ : l'équation a deux solutions complexes conjuguées $z=\\dfrac{-b\\pm i\\sqrt{-\\Delta}}{2a}$.",
					"$z_1={{p}}+{{if:q==1||{{if:q==-1|-|{{eval:q}}}}}}\\sqrt{3}i$ et $z_2={{p}}-{{if:q==1||{{if:q==-1|-|{{eval:q}}}}}}\\sqrt{3}i$."
				]
			}
		},
		{
			"statement": "Résous dans $\\mathbb{C}$ l'équation $z^2+({{b}})z+{{c}}=0$.\n\n$z_1=?$ et $z_2=?$",
			"variables": [
				{
					"name": "b",
					"expression": "1|3|5|-1|-3|-5"
				},
				{
					"name": "c",
					"expression": "eval:(b^2+3)/4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:-b/2}}+\\frac{\\sqrt{3}}{2}i"
				},
				{
					"expectedAnswer": "{{eval:-b/2}}-\\frac{\\sqrt{3}}{2}i"
				}
			],
			"correction": {
				"steps": [
					"$\\Delta={{b;()}}^2-4\\times{{c}}=-3$.",
					"$\\Delta<0$ : l'équation a deux solutions complexes conjuguées $z=\\dfrac{-b\\pm i\\sqrt{-\\Delta}}{2a}$.",
					"$z_1=\\dfrac{ {{eval:-b}}+i\\sqrt{3}}{2}$ et $z_2=\\dfrac{ {{eval:-b}}-i\\sqrt{3}}{2}$, soit $z_1=\\textcolor{{{color:primary.0}}}{{{eval:-b/2}}+\\frac{\\sqrt{3}}{2}i}$ et $z_2=\\textcolor{{{color:primary.0}}}{{{eval:-b/2}}-\\frac{\\sqrt{3}}{2}i}$."
				]
			}
		},
		{
			"statement": "Résous dans $\\mathbb{C}$ l'équation $4z^2+({{eval:-4*p}})z+{{eval:p^2+1}}=0$.\n\n$z_1=?$ et $z_2=?$",
			"variables": [
				{
					"name": "p",
					"expression": "1..5;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:p/2}}+\\frac{1}{2}i"
				},
				{
					"expectedAnswer": "{{eval:p/2}}-\\frac{1}{2}i"
				}
			],
			"correction": {
				"steps": [
					"$\\Delta=({{eval:-4*p}})^2-16\\times{{eval:p^2+1}}=-16$, donc $\\sqrt{-\\Delta}=4$.",
					"$\\Delta<0$ : l'équation a deux solutions complexes conjuguées $z=\\dfrac{-b\\pm i\\sqrt{-\\Delta}}{2a}$.",
					"$z_1=\\dfrac{ {{eval:4*p}}+4i}{8}$ et $z_2=\\dfrac{ {{eval:4*p}}-4i}{8}$, soit $z_1=\\textcolor{{{color:primary.0}}}{{{eval:p/2}}+\\frac{1}{2}i}$ et $z_2=\\textcolor{{{color:primary.0}}}{{{eval:p/2}}-\\frac{1}{2}i}$."
				]
			}
		},
		{
			"statement": "Résous dans $\\mathbb{C}$ l'équation $z^2+({{b}})z+{{c}}=0$. Donne l'ensemble $S$ de ses solutions.\n\n$S=?$",
			"variables": [
				{
					"name": "p",
					"expression": "1..4;±"
				},
				{
					"name": "q",
					"expression": "1..4"
				},
				{
					"name": "b",
					"expression": "eval:-2*p"
				},
				{
					"name": "c",
					"expression": "eval:p^2+q^2"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\{ {{p}}+{{if:q==1||{{q}}}}i ; {{p}}-{{if:q==1||{{q}}}}i \\}",
					"answerKind": "intervalles"
				}
			],
			"correction": {
				"steps": [
					"$\\Delta={{b;()}}^2-4\\times{{c}}={{eval:b^2-4*c}}$.",
					"$\\Delta<0$ : l'équation a deux solutions complexes conjuguées $z=\\dfrac{-b\\pm i\\sqrt{-\\Delta}}{2a}$.",
					"$S=\\textcolor{{{color:primary.0}}}{\\{ {{p}}+{{if:q==1||{{q}}}}i\\,;{{p}}-{{if:q==1||{{q}}}}i \\}}$."
				]
			}
		}
	],

{
	"title": "Module d'un nombre complexe",
	"description": "|a+ib|, module d'un produit, d'un quotient, d'une puissance, nombre de module 1 (pièges : module au carré, a² − b², |z₁z₂| = |z₁| + |z₂|, racine non simplifiée)",
	"grades": ["T_EXP"],
	"points": ["TEXP-013", "TEXP-020", "TEXP-015", "TEXP-016", "TEXP-017"],
	"theme": "Nombres complexes",
	"domain": "Module et argument",
	"subdomain": "Module",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"shared": {
		"cleanCoefficients": true
	},
	"variations": [
		{
			"statement": "Soit $z={{a}}+({{b}})i$. Calcule son module.\n\n$|z|=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..6;±"
				},
				{
					"name": "b",
					"expression": "1..6;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:sqrt(a^2+b^2)}}"
				}
			],
			"correction": {
				"steps": [
					"$|a+ib|=\\sqrt{a^2+b^2}$ : ici $|z|=\\sqrt{ {{eval:a^2}}+{{eval:b^2}} }$.",
					"$|z|=\\textcolor{{{color:primary.0}}}{{{eval:sqrt(a^2+b^2)}}}$ (racine simplifiée)."
				]
			}
		},
		{
			"statement": "Soit $z_1={{a}}+({{b}})i$ et $z_2={{c}}+({{d}})i$. Calcule $|z_1z_2|$.\n\n$|z_1z_2|=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..3;±"
				},
				{
					"name": "b",
					"expression": "1..3;±"
				},
				{
					"name": "c",
					"expression": "1..3;±"
				},
				{
					"name": "d",
					"expression": "1..3;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:sqrt((a^2+b^2)*(c^2+d^2))}}"
				}
			],
			"correction": {
				"steps": [
					"Le module d'un produit est le produit des modules : $|z_1z_2|=|z_1|\\times|z_2|$.",
					"$|z_1|=\\sqrt{ {{eval:a^2+b^2}} }$ et $|z_2|=\\sqrt{ {{eval:c^2+d^2}} }$, donc $|z_1z_2|=\\sqrt{ {{eval:(a^2+b^2)*(c^2+d^2)}} }=\\textcolor{{{color:primary.0}}}{{{eval:sqrt((a^2+b^2)*(c^2+d^2))}}}$."
				]
			}
		},
		{
			"statement": "Soit $z_1={{a}}+({{b}})i$ et $z_2={{eval:3*c}}+({{eval:4*d}})i$. Calcule $\\left|\\dfrac{z_1}{z_2}\\right|$.\n\n$\\left|\\dfrac{z_1}{z_2}\\right|=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..6;±"
				},
				{
					"name": "b",
					"expression": "1..6;±"
				},
				{
					"name": "c",
					"expression": "1..1;±"
				},
				{
					"name": "d",
					"expression": "1..1;±"
				}
			],
			"conditions": ["a^2+b^2 != 25"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:sqrt(a^2+b^2)/5}}"
				}
			],
			"correction": {
				"steps": [
					"Le module d'un quotient est le quotient des modules : $\\left|\\dfrac{z_1}{z_2}\\right|=\\dfrac{|z_1|}{|z_2|}$.",
					"$|z_1|=\\sqrt{ {{eval:a^2+b^2}} }$ et $|z_2|=\\sqrt{9+16}=5$, donc $\\left|\\dfrac{z_1}{z_2}\\right|=\\textcolor{{{color:primary.0}}}{{{eval:sqrt(a^2+b^2)/5}}}$."
				]
			}
		},
		{
			"statement": "Soit $z=(1+i)^{ {{n}} }$. Calcule $|z|$ (valeur exacte simplifiée).\n\n$|z|=?$",
			"variables": [
				{
					"name": "n",
					"expression": "3..12"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:sqrt(2^n)}}"
				}
			],
			"correction": {
				"steps": [
					"$|z^n|=|z|^n$ et $|1+i|=\\sqrt{2}$.",
					"$|z|=\\left(\\sqrt{2}\\right)^{ {{n}} }=\\textcolor{{{color:primary.0}}}{{{eval:sqrt(2^n)}}}$."
				]
			}
		},
		{
			"statement": "Soit $z=\\dfrac{ {{a}}{{if:b==1|+i|{{if:b==-1|-i|{{eval:b;+}}i}}}}}{ {{a}}{{if:-b==1|+i|{{if:-b==-1|-i|{{eval:-b;+}}i}}}}}$. Calcule $|z|$.\n\n$|z|=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..7;±"
				},
				{
					"name": "b",
					"expression": "1..7;±"
				}
			],
			"conditions": ["abs(a) != abs(b)"],
			"blanks": [
				{
					"expectedAnswer": "1"
				}
			],
			"correction": {
				"steps": [
					"Le numérateur et le dénominateur sont conjugués, donc de même module : $|z|=\\dfrac{|w|}{|\\overline{w}|}=1$.",
					"$|z|=\\textcolor{{{color:primary.0}}}{1}$ : $z$ appartient à $\\mathbb{U}$, l'ensemble des nombres complexes de module $1$."
				]
			}
		}
	],

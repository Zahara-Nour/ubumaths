	"variations": [
		{
			"statement": "La suite $(u_n)$ est représentée ci-dessous par un nuage de points : le point d'abscisse $n$ a pour ordonnée $u_n$.\n\n```courbe\nx: -1 ; 8\ny: -5 ; 12\nu(n) = {{a}}+({{r}})*n pour n de 0 à 7   bleu   nom=u_n\ngrille: 1 ; 1\ntaille: moyenne\ndescription: Nuage de points représentant les premiers termes d'une suite, un point par rang n.\n```\n\nLis la valeur de $u_{{{k}}}$.\n\n$u_{{{k}}}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "-4..11"
				},
				{
					"name": "r",
					"expression": "1..2;±"
				},
				{
					"name": "k",
					"expression": "2..7"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a+r*k}}"
				}
			],
			"correction": {
				"steps": [
					"On repère sur l'axe des abscisses le rang $n={{k}}$, puis on monte (ou on descend) jusqu'au point du nuage situé à cette abscisse : c'est le point $M$.",
					"```courbe\nx: -1 ; 8\ny: -5 ; 12\nu(n) = {{a}}+({{r}})*n pour n de 0 à 7   bleu   nom=u_n\ngrille: 1 ; 1\npoints: M({{k}} ; {{a}}+({{r}})*{{k}})\ntaille: moyenne\ndescription: Nuage de points représentant les premiers termes d'une suite, un point par rang n.\n```",
					"L'ordonnée de $M$ se lit sur l'axe des ordonnées : $u_{ {{k}} }={{solution}}$."
				]
			},
			"conditions": ["a+7*r >= -4", "a+7*r <= 11", "a+r*k != k"]
		},
		{
			"statement": "La suite $(u_n)$ est représentée ci-dessous par un nuage de points : le point d'abscisse $n$ a pour ordonnée $u_n$.\n\n```courbe\nx: -1 ; 9\ny: -1 ; 8\nu(n) = {{a}}+({{s}})*n/2 pour n de 0 à 8   bleu   nom=u_n\ngrille: 1 ; 0.5\ntaille: moyenne\ndescription: Nuage de points représentant les premiers termes d'une suite, un point par rang n.\n```\n\nLis la valeur de $u_{{{k}}}$.\n\n$u_{{{k}}}=?$",
			"variables": [

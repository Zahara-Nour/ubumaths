					"expression": "1|3|5|7"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a+s*k/2}}",
					"acceptDecimal": true
				}
			],
			"correction": {
				"steps": [
					"On repère sur l'axe des abscisses le rang $n={{k}}$, puis on monte (ou on descend) jusqu'au point du nuage situé à cette abscisse : c'est le point $M$.",
					"```courbe\nx: -1 ; 9\ny: -1 ; 8\nu(n) = {{a}}+({{s}})*n/2 pour n de 0 à 8   bleu   nom=u_n\ngrille: 1 ; 0.5\npoints: M({{k}} ; {{a}}+({{s}})*{{k}}/2)\ntaille: moyenne\ndescription: Nuage de points représentant les premiers termes d'une suite, un point par rang n.\n```",
					"L'ordonnée de $M$ se lit sur l'axe des ordonnées : $u_{ {{k}} }={{solution}}$."

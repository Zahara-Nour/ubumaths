{
	"title": "Calculer un terme d'une suite géométrique",
	"description": "Calculer le terme suivant",
	"grades": ["1_SPE"],
	"points": ["1SPE-027", "1SPE-035"],
	"theme": "Suites",
	"domain": "Suites géométriques",
	"subdomain": "Calculer un terme",
	"level": 1,
	"status": "draft",
	"delay": 30,
	"variations": [
		{
			"statement": "Une suite géométrique a pour raison ${{q}}$. L'un de ses termes vaut ${{t}}$ : calcule le terme suivant.\n\nLe terme suivant est $?$.",
			"variables": [
				{
					"name": "q",
					"expression": "2..3;±"
				},
				{
					"name": "t",
					"expression": "2..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:t*(q)}}"
				}
			],
			"correction": {
				"steps": [
					"Dans une suite géométrique, on passe d'un terme au suivant en **multipliant** par la raison $\\textcolor{{{color:primary.0}}}{{{q}}}$ : le terme suivant est ${{t}}\\times\\textcolor{{{color:primary.0}}}{{{eval:q;()}}}={{solution}}$."
				]
			}
		},
		{
			"statement": "Une suite géométrique a pour raison ${{qd}}$. L'un de ses termes vaut ${{t}}$ : calcule le terme suivant.\n\nLe terme suivant est $?$.",
			"variables": [
				{
					"name": "qd",
					"expression": "\\frac{1}{2}|0{,}5"
				},
				{
					"name": "k",
					"expression": "2..15;±"
				},
				{
					"name": "t",
					"expression": "eval:2*(k)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{k}}"
				}
			],
			"correction": {
				"steps": [
					"On passe d'un terme au suivant en **multipliant** par la raison $\\textcolor{{{color:primary.0}}}{{{qd}}}$, ce qui revient à diviser par $2$ : le terme suivant est ${{t}}\\times\\textcolor{{{color:primary.0}}}{{{qd}}}={{solution}}$."
				]
			}
		}
	],
	"testSpecs": [

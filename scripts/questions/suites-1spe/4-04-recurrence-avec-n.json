		{
			"statement": "Calcule le terme demandé.\n\n$u_0={{a}}$ et $u_{n+1}=u_n{{eval:b*n+c;+}}$\n\n$u_3=?$",
			"variables": [
				{
					"name": "n",
					"expression": "n|n"
				},
				{
					"name": "a",
					"expression": "1..6;±"
				},
				{
					"name": "b",
					"expression": "2..5;±"
				},
				{
					"name": "c",
					"expression": "1..5;±"
				},
				{
					"name": "u1",
					"expression": "eval:a+c"
				},
				{
					"name": "u2",
					"expression": "eval:u1+b+c"
				},
				{
					"name": "u3",
					"expression": "eval:u2+2*b+c"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{u3}}"
				}
			],
			"correction": {
				"steps": [
					"Avec $u_0={{a}}$ et $u_{n+1}=u_n{{eval:b*n+c;+}}$ : pour calculer $u_{n+1}$, on remplace $n$ par le rang du terme **précédent**, celui qu'on connaît déjà.",
					"$$u_1=u_0{{eval:b;+}}\\times 0{{eval:c;+}}={{a}}{{eval:c;+}}=\\textcolor{{{color:primary.0}}}{{{u1}}}$$",
					"$$u_2=u_1{{eval:b;+}}\\times 1{{eval:c;+}}=\\textcolor{{{color:primary.0}}}{{{u1}}}{{eval:b;+}}{{eval:c;+}}=\\textcolor{{{color:primary.0}}}{{{u2}}}$$",
					"$$u_3=u_2{{eval:b;+}}\\times 2{{eval:c;+}}=\\textcolor{{{color:primary.0}}}{{{u2}}}{{eval:2*b;+}}{{eval:c;+}}={{solution}}$$"
				]
			}
		},
		{
			"statement": "Calcule le terme demandé.\n\n$u_0={{a}}$ et $u_{n+1}={{b}}u_n{{eval:c*n;+}}$\n\n$u_3=?$",
			"variables": [
				{
					"name": "n",
					"expression": "n|n"
				},
				{
					"name": "a",
					"expression": "1..4;±"
				},
				{
					"name": "b",
					"expression": "2|-2|3"
				},
				{
					"name": "c",
					"expression": "1..3;±"
				},
				{
					"name": "u1",
					"expression": "eval:b*(a)"
				},
				{
					"name": "u2",
					"expression": "eval:b*(u1)+(c)"
				},
				{
					"name": "u3",
					"expression": "eval:b*(u2)+2*(c)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{u3}}"
				}
			],
			"correction": {
				"steps": [
					"Avec $u_0={{a}}$ et $u_{n+1}={{b}}u_n{{eval:c*n;+}}$ : pour calculer $u_{n+1}$, on remplace $n$ par le rang du terme **précédent**, celui qu'on connaît déjà.",
					"$$u_1={{b}}u_0{{eval:c;+}}\\times 0={{b}}\\times{{eval:a;()}}+0=\\textcolor{{{color:primary.0}}}{{{u1}}}$$",
					"$$u_2={{b}}u_1{{eval:c;+}}\\times 1={{b}}\\times\\textcolor{{{color:primary.0}}}{{{eval:u1;()}}}{{eval:c;+}}=\\textcolor{{{color:primary.0}}}{{{u2}}}$$",
					"$$u_3={{b}}u_2{{eval:c;+}}\\times 2={{b}}\\times\\textcolor{{{color:primary.0}}}{{{eval:u2;()}}}{{eval:2*c;+}}={{solution}}$$"
				]
			}
		}
	],

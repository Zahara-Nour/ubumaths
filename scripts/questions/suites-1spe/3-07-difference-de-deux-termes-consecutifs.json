{
	"title": "Calculer la différence de deux termes consécutifs",
	"description": "u(n+1) − u(n) en fonction de n, développée et réduite",
	"grades": ["1_SPE"],
	"theme": "Suites",
	"domain": "Sens de variation",
	"status": "draft",
	"subdomain": "Différence de deux termes",
	"level": 1,
	"delay": 60,
	"variations": [
		{
			"statement": "On considère la suite $(u_n)$ définie, pour tout entier naturel $n$, par $u_n={{eval:a*n+b}}$.\n\nExprime $u_{n+1}-u_n$ en fonction de $n$, sous forme développée et réduite.\n\n$u_{n+1}-u_n=?$",
			"variables": [
				{
					"name": "n",
					"expression": "n|n"
				},
				{
					"name": "a",
					"expression": "2..9;±"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{a}}"
				}
			],
			"correction": {
				"steps": [
					"On remplace $n$ par $n+1$ : $u_{n+1}={{a}}(n+1){{eval:b;+}}={{eval:a*n+a+b}}$.",
					"$$u_{n+1}-u_n={{eval:a*n+a+b}}-\\left({{eval:a*n+b}}\\right)=\\textcolor{{{color:primary.0}}}{{{a}}}$$"
				]
			}
		},
		{
			"statement": "On considère la suite $(u_n)$ définie, pour tout entier naturel $n$, par $u_n=n^2{{eval:b*n;+}}$.\n\nExprime $u_{n+1}-u_n$ en fonction de $n$, sous forme développée et réduite.\n\n$u_{n+1}-u_n=?$",
			"variables": [
				{
					"name": "n",
					"expression": "n|n"
				},
				{
					"name": "b",
					"expression": "2..9;±"
				},
				{
					"name": "m",
					"expression": "eval:b+1"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*n+m}}"
				}
			],
			"correction": {
				"steps": [
					"On remplace $n$ par $n+1$, sans oublier que $(n+1)^2=n^2+2n+1$ :",
					"$$u_{n+1}=(n+1)^2{{eval:b;+}}(n+1)=n^2+2n+1{{eval:b*n;+}}{{eval:b;+}}={{eval:n^2+(b+2)*n+m}}$$",
					"$$u_{n+1}-u_n={{eval:n^2+(b+2)*n+m}}-\\left({{eval:n^2+b*n}}\\right)=\\textcolor{{{color:primary.0}}}{{{eval:2*n+m}}}$$"
				]
			}
		},
		{
			"statement": "On considère la suite $(u_n)$ définie, pour tout entier naturel $n$, par $u_n={{a}}n^2$.\n\nExprime $u_{n+1}-u_n$ en fonction de $n$, sous forme développée et réduite.\n\n$u_{n+1}-u_n=?$",
			"variables": [
				{
					"name": "n",
					"expression": "n|n"
				},
				{
					"name": "a",
					"expression": "2..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*a*n+a}}"
				}
			],
			"correction": {
				"steps": [
					"On remplace $n$ par $n+1$, sans oublier que $(n+1)^2=n^2+2n+1$ :",
					"$$u_{n+1}={{a}}(n+1)^2={{a}}\\left(n^2+2n+1\\right)={{eval:a*n^2+2*a*n+a}}$$",
					"$$u_{n+1}-u_n={{eval:a*n^2+2*a*n+a}}-\\left({{a}}n^2\\right)=\\textcolor{{{color:primary.0}}}{{{eval:2*a*n+a}}}$$"
				]
			}
		}
	],

				{
					"name": "q",
					"expression": "2..3;±"
				},
				{
					"name": "k",
					"expression": "2..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*(q)^k}}"
				}
			],
			"correction": {
				"steps": [
					"Pour une suite géométrique, $u_n=u_0\\times q^n$ : on multiplie $u_0$ par la raison $\\textcolor{{{color:primary.0}}}{{{q}}}$, $ {{k}} $ fois de suite.",
					"$u_{ {{k}} }={{a}}\\times\\textcolor{{{color:primary.0}}}{{{eval:q;()}}}^{ {{k}} }={{a}}\\times{{eval:(q)^k;()}}={{solution}}$"
				]
			}
		}
	],

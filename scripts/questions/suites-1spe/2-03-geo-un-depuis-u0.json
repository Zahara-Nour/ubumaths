	"variations": [
		{
			"statement": "$(u_n)$ est la suite géométrique de premier terme $u_0={{a}}$ et de raison ${{q}}$.\n\nCalcule $u_{ {{k}} }$.\n\n$u_{ {{k}} }=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..5;±"

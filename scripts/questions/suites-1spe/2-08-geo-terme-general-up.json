{
	"title": "Terme général d'une suite géométrique",
	"description": "À partir de u_1 ou d'un terme u_p",
	"grades": ["1_SPE"],
	"points": ["1SPE-036", "1SPE-027"],
	"theme": "Suites",
	"domain": "Suites géométriques",
	"subdomain": "Terme général",
	"level": 2,
	"status": "draft",
	"delay": 40,
	"options": {
		"constraints": {
			"form": "warn",
			"products": "off"
		}
	},
	"variations": [
		{
			"statement": "$(u_n)$ est la suite géométrique de premier terme $u_1={{c}}$ et de raison $q={{q}}$.\n\nExprime $u_n$ en fonction de $n$, pour $n\\geqslant1$.\n\n$u_n=?$",
			"variables": [
				{
					"name": "c",
					"expression": "2..9;±"
				},
				{
					"name": "q",
					"expression": "2..5;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{c}}\\times{{eval:q;()}}^{n-1}",
					"requiredForm": {
						"pattern": "a * b^c"
					}
				}
			],
			"correction": {
				"steps": [
					"Le premier terme est $u_1$ : pour aller de $u_1$ à $u_n$, on multiplie $n-1$ fois par la raison. Donc $u_n=u_1\\times q^{n-1}$.",
					"Ici $u_1={{c}}$ et $q=\\textcolor{{{color:primary.0}}}{{{q}}}$, donc $u_n={{c}}\\times\\textcolor{{{color:primary.0}}}{{{eval:q;()}}}^{n-1}$."
				]
			}
		},
		{
			"statement": "$(u_n)$ est la suite géométrique de raison $q={{q}}$ telle que $u_{ {{p}} }={{c}}$.\n\nExprime $u_n$ en fonction de $n$.\n\n$u_n=?$",
			"variables": [
				{
					"name": "p",
					"expression": "2..5"
				},
				{
					"name": "c",
					"expression": "2..9;±"
				},
				{
					"name": "q",
					"expression": "2..3;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{c}}\\times{{eval:q;()}}^{n-{{p}}}",
					"requiredForm": {
						"pattern": "a * b^c"
					}
				}
			],
			"correction": {
				"steps": [
					"Pour aller de $u_{ {{p}} }$ à $u_n$, on multiplie $n-{{p}}$ fois par la raison. Donc $u_n=u_{ {{p}} }\\times q^{n-{{p}}}$.",
					"Ici $u_{ {{p}} }={{c}}$ et $q=\\textcolor{{{color:primary.0}}}{{{q}}}$, donc $u_n={{c}}\\times\\textcolor{{{color:primary.0}}}{{{eval:q;()}}}^{n-{{p}}}$."
				]
			}
		}
	],

{
	"title": "Calculer un terme d'une suite géométrique",
	"description": "Calculer le terme précédent",
	"grades": ["1_SPE"],
	"theme": "Suites",
	"domain": "Suites géométriques",
	"subdomain": "Calculer un terme",
	"level": 2,
	"status": "draft",
	"delay": 30,
	"variations": [
		{
			"statement": "Une suite géométrique a pour raison ${{q}}$. L'un de ses termes vaut ${{t}}$ : calcule le terme précédent.\n\nLe terme précédent est $?$.",
			"variables": [
				{
					"name": "q",
					"expression": "2..3;±"
				},
				{
					"name": "k",
					"expression": "2..9;±"
				},
				{
					"name": "t",
					"expression": "eval:k*(q)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{k}}"
				}
			],
			"correction": {
				"steps": [
					"On passe d'un terme au suivant en multipliant par la raison $\\textcolor{{{color:primary.0}}}{{{q}}}$. Pour revenir au terme précédent, on fait l'inverse : on **divise** par la raison.",
					"Le terme précédent est ${{t}}\\div\\textcolor{{{color:primary.0}}}{{{eval:q;()}}}={{solution}}$."
				]
			}
		},
		{
			"statement": "Une suite géométrique a pour raison ${{qd}}$. L'un de ses termes vaut ${{t}}$ : calcule le terme précédent.\n\nLe terme précédent est $?$.",
			"variables": [
				{
					"name": "qd",
					"expression": "\\frac{1}{2}|0{,}5"
				},
				{
					"name": "t",
					"expression": "2..15;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*t}}"
				}
			],
			"correction": {
				"steps": [
					"On passe d'un terme au suivant en multipliant par la raison $\\textcolor{{{color:primary.0}}}{{{qd}}}$. Pour revenir au terme précédent, on **divise** par $\\textcolor{{{color:primary.0}}}{{{qd}}}$, ce qui revient à multiplier par $2$.",
					"Le terme précédent est ${{t}}\\div\\textcolor{{{color:primary.0}}}{{{qd}}}={{t}}\\times2={{solution}}$."
				]
			}
		}
	],

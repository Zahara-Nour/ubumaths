				{
					"name": "b",
					"expression": "eval:a+d"
				},
				{
					"name": "c",
					"expression": "1..9;±"
				},
				{
					"name": "q",
					"expression": "2..3;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:c*(q)^d}}"
				}
			],
			"correction": {
				"steps": [
					"Pour passer de $u_{ {{a}} }$ à $u_{ {{b}} }$, on avance de ${{b}}-{{a}}={{d}}$ rangs : on multiplie ${{d}}$ fois par la raison $\\textcolor{{{color:primary.0}}}{{{q}}}$.",
					"$u_{ {{b}} }=u_{ {{a}} }\\times q^{ {{d}} }={{c}}\\times\\textcolor{{{color:primary.0}}}{{{eval:q;()}}}^{ {{d}} }={{c}}\\times{{eval:(q)^d;()}}={{solution}}$"
				]
			}
		}
	],

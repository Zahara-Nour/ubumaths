		{
			"statement": "$(u_n)$ est une suite géométrique de raison ${{q}}$, et $u_{ {{a}} }={{c}}$.\n\nCalcule $u_{ {{b}} }$.\n\n$u_{ {{b}} }=?$",
			"variables": [

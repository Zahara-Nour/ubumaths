{
	"title": "Somme de termes consécutifs d'une suite arithmétique",
	"description": "Nombre de termes × (premier + dernier) / 2",
	"grades": ["1_SPE"],
	"theme": "Suites",
	"domain": "Sommes",
	"subdomain": "Suites arithmétiques",
	"level": 1,
	"status": "draft",
	"delay": 60,
	"variations": [
		{
			"statement": "$(u_n)$ est la suite arithmétique de premier terme $u_0={{a}}$ et de raison $r={{r}}$.\n\nCalcule $S=u_0+u_1+\\cdots+u_{ {{n}} }$.\n\n$S=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..20;±"
				},
				{
					"name": "r",
					"expression": "2..9;±"
				},
				{
					"name": "n",
					"expression": "8..20"
				},
				{
					"name": "l",
					"expression": "eval:a+n*r"
				},
				{
					"name": "s",
					"expression": "eval:(n+1)*(a+l)/2"
				}
			],
			"conditions": ["l != 0", "s != 0", "a+l != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{s}}"
				}
			],
			"correction": {
				"steps": [
					"De $u_0$ à $u_{ {{n}} }$, il y a $\\mathbf{ {{eval:n+1}} }$ termes (et non ${{n}}$).",
					"Dernier terme : $u_{ {{n}} }=u_0+{{n}}r={{a}}+{{n}}\\times{{eval:r;()}}={{l}}$.",
					"$$S=\\text{nombre de termes}\\times\\dfrac{\\text{premier}+\\text{dernier}}{2}$$",
					"$$S={{eval:n+1}}\\times\\dfrac{ {{a}}{{eval:l;+}} }{2}={{eval:n+1}}\\times\\dfrac{ {{eval:a+l}} }{2}={{s}}$$"
				]
			}
		},
		{
			"statement": "$(u_n)$ est la suite arithmétique de premier terme $u_0={{a}}$ et de raison $r={{r}}$.\n\nCalcule $S=u_1+u_2+\\cdots+u_{ {{n}} }$.\n\n$S=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..20;±"
				},
				{
					"name": "r",
					"expression": "2..9;±"
				},
				{
					"name": "n",
					"expression": "8..20"
				},
				{
					"name": "f",
					"expression": "eval:a+r"
				},
				{
					"name": "l",
					"expression": "eval:a+n*r"
				},
				{
					"name": "s",
					"expression": "eval:n*(f+l)/2"
				}
			],
			"conditions": ["f != 0", "l != 0", "s != 0", "f+l != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{s}}"
				}
			],
			"correction": {
				"steps": [
					"La somme commence à $u_1$ : de $u_1$ à $u_{ {{n}} }$, il y a $\\mathbf{ {{n}} }$ termes (et non ${{eval:n+1}}$).",
					"Premier terme : $u_1=u_0+r={{a}}{{eval:r;+}}={{f}}$. Dernier terme : $u_{ {{n}} }=u_0+{{n}}r={{a}}+{{n}}\\times{{eval:r;()}}={{l}}$.",
					"$$S=\\text{nombre de termes}\\times\\dfrac{\\text{premier}+\\text{dernier}}{2}$$",
					"$$S={{n}}\\times\\dfrac{ {{f}}{{eval:l;+}} }{2}={{n}}\\times\\dfrac{ {{eval:f+l}} }{2}={{s}}$$"
				]
			}
		}
	],

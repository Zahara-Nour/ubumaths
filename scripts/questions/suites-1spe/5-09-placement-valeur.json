{
	"title": "Valeur d'un placement à intérêts simples ou composés",
	"description": "Capital au bout de n années, exact ou arrondi",
	"grades": ["1_SPE"],
	"theme": "Suites",
	"domain": "Modélisation",
	"subdomain": "Placements",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"variations": [
		{
			"statement": "On place ${{C}}$ € à **intérêts simples** au taux annuel de ${{t}}\\,\\%$ : chaque année, on ajoute au capital ${{t}}\\,\\%$ du capital initial.\n\nQuel est le capital au bout de ${{n}}$ années ?\n\nLe capital est de $?$ €.",
			"variables": [
				{
					"name": "k",
					"expression": "5..50"
				},
				{
					"name": "C",
					"expression": "eval:100*k"
				},
				{
					"name": "t",
					"expression": "1..6"
				},
				{
					"name": "n",
					"expression": "2..15"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:C*(1+n*t/100)}}"
				}
			],
			"correction": {
				"steps": [
					"Les intérêts annuels sont constants : $\\dfrac{ {{t}} }{100}\\times{{C}}={{eval:C*t/100}}$ €. Le capital $u_n$ au bout de $n$ années est une suite arithmétique de premier terme $u_0={{C}}$ et de raison ${{eval:C*t/100}}$.",
					"$$u_{ {{n}} }=u_0+{{n}}\\times{{eval:C*t/100}}={{C}}+{{eval:n*C*t/100}}=\\mathbf{ {{eval:C*(1+n*t/100)}} }$$"
				]
			}
		},
		{
			"statement": "On place ${{C}}$ € à **intérêts composés** au taux annuel de ${{t}}\\,\\%$ : chaque année, les intérêts s'ajoutent au capital.\n\nQuel est le capital au bout de ${{n}}$ années ? Arrondis au centime.\n\nLe capital est d'environ $?$ €.",
			"variables": [
				{
					"name": "C",
					"expression": "500|1000|1500|2000|2500|3000|4000|5000"
				},
				{
					"name": "t",
					"expression": "1..5"
				},
				{
					"name": "n",
					"expression": "5..12"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:round(C*(1+t/100)^n*100)/100;d}}",
					"precision": {
						"type": "decimal",
						"digits": 2
					}
				}
			],
			"correction": {
				"steps": [
					"Chaque année, le capital est multiplié par $1+\\dfrac{ {{t}} }{100}={{eval:1+t/100;d}}$ : le capital $u_n$ au bout de $n$ années est une suite géométrique de premier terme $u_0={{C}}$ et de raison ${{eval:1+t/100;d}}$.",
					"$$u_{ {{n}} }=u_0\\times{{eval:1+t/100;d}}^{ {{n}} }={{C}}\\times{{eval:1+t/100;d}}^{ {{n}} }\\approx\\mathbf{ {{eval:round(C*(1+t/100)^n*100)/100;d}} }$$",
					"Arrondi au centime : deux chiffres après la virgule."
				]
			}
		},
		{
			"statement": "On place ${{C}}$ € à **intérêts composés** au taux annuel de ${{t}}\\,\\%$ : chaque année, les intérêts s'ajoutent au capital.\n\nQuel est le capital au bout de ${{n}}$ années ? Arrondis à l'euro.\n\nLe capital est d'environ $?$ €.",
			"variables": [
				{
					"name": "C",
					"expression": "500|1000|1500|2000|2500|3000|4000|5000"
				},
				{
					"name": "t",
					"expression": "1..5"
				},
				{
					"name": "n",
					"expression": "5..12"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:round(C*(1+t/100)^n)}}",
					"precision": {
						"type": "decimal",
						"digits": 0
					}
				}
			],
			"correction": {
				"steps": [
					"Chaque année, le capital est multiplié par $1+\\dfrac{ {{t}} }{100}={{eval:1+t/100;d}}$ : le capital $u_n$ au bout de $n$ années est une suite géométrique de premier terme $u_0={{C}}$ et de raison ${{eval:1+t/100;d}}$.",
					"$$u_{ {{n}} }=u_0\\times{{eval:1+t/100;d}}^{ {{n}} }={{C}}\\times{{eval:1+t/100;d}}^{ {{n}} }\\approx\\mathbf{ {{eval:round(C*(1+t/100)^n)}} }$$"
				]
			}
		}
	],

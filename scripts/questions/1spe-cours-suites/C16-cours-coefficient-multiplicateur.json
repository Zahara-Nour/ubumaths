			"correction": {
				"steps": [
					"Diminuer de ${{t}}\\,\\%$ : $x-\\dfrac{ {{t}} }{100}x=\\left(1-\\dfrac{ {{t}} }{100}\\right)x=0{,}9{{eval:10-t}}\\,x$."
				]
			}
		},
		{
			"statement": "Une quantité augmente de ${{t}}\\,\\%$ chaque année. La suite de ses valeurs annuelles est…\n\n```choix\n- géométrique de raison $1{,}0{{t}}$\n- arithmétique de raison ${{t}}$\n- géométrique de raison ${{t}}$\n- géométrique de raison $0{,}0{{t}}$\n```",
			"variables": [
				{
					"name": "t",
					"expression": "2..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"Chaque année, on multiplie par $1+\\dfrac{ {{t}} }{100}=1{,}0{{t}}$ : la suite est géométrique de raison $1{,}0{{t}}$."
				]
			}
		}
	],

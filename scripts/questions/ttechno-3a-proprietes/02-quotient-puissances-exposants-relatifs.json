					"expression": "0.5|1|1.5|2"
				},
				{
					"name": "p",
					"expression": "2.5|3|3.5|4"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{a}}^{ {{eval:m-p;d}} }",
					"requiredForm": "power"
				}
			],
			"correction": {
				"steps": [
					"Pour $a>0$ et tous réels $x$ et $y$ : $\\dfrac{a^x}{a^y}=a^{x-y}$. On **soustrait** les exposants (celui du numérateur moins celui du dénominateur).",
					"$\\dfrac{ {{a}}^{ {{m}} } }{ {{a}}^{ {{p}} } }={{a}}^{ {{m}}-{{p}} }=\\textcolor{{{color:primary.0}}}{{{a}}^{ {{eval:m-p;d}} }}$ : l'exposant est négatif, car le dénominateur l'emporte."
				]
			}
		},
		{
			"statement": "Écris sous la forme d'une seule puissance : $\\dfrac{ {{a}}^{ {{m}} } }{ {{a}}^{ {{p}} } }$.\n\n$\\dfrac{ {{a}}^{ {{m}} } }{ {{a}}^{ {{p}} } }=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2|3|5|1.5"
				},
				{
					"name": "m",
					"expression": "0.5|1|1.5|2|2.5"
				},
				{
					"name": "p",
					"expression": "-0.5|-1|-1.5|-2"
				}
			],
			"conditions": ["m-p != 1"],
			"blanks": [
				{
					"expectedAnswer": "{{a}}^{ {{eval:m-p;d}} }",
					"requiredForm": "power"
				}
			],
			"correction": {
				"steps": [
					"Pour $a>0$ et tous réels $x$ et $y$ : $\\dfrac{a^x}{a^y}=a^{x-y}$. On **soustrait** les exposants (celui du numérateur moins celui du dénominateur). Ces propriétés valent pour tous les réels $x$ et $y$, **positifs ou négatifs**, comme pour les puissances entières.",
					"$\\dfrac{ {{a}}^{ {{m}} } }{ {{a}}^{ {{p}} } }={{a}}^{ {{m}}-({{p}}) }=\\textcolor{{{color:primary.0}}}{{{a}}^{ {{eval:m-p;d}} }}$ : soustraire un nombre négatif revient à ajouter son opposé."
				]
			}
		},
		{
			"statement": "Écris sous la forme d'une seule puissance : $\\dfrac{1}{ {{a}}^{ {{p}} } }$.\n\n$\\dfrac{1}{ {{a}}^{ {{p}} } }=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2|3|5|1.5"
				},
				{
					"name": "p",
					"expression": "0.5|1.5|2|2.5|3"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{a}}^{ -{{p}} }",
					"requiredForm": "power"
				}
			],
			"correction": {
				"steps": [
					"$1={{a}}^0$, donc $\\dfrac{1}{ {{a}}^{ {{p}} } }=\\dfrac{ {{a}}^0}{ {{a}}^{ {{p}} } }$.",
					"Pour $a>0$ et tous réels $x$ et $y$ : $\\dfrac{a^x}{a^y}=a^{x-y}$. On **soustrait** les exposants (celui du numérateur moins celui du dénominateur).",
					"$\\dfrac{1}{ {{a}}^{ {{p}} } }={{a}}^{0-{{p}} }=\\textcolor{{{color:primary.0}}}{{{a}}^{ -{{p}} }}$. C'est la définition : $a^{-x}=\\dfrac{1}{a^x}$."
				]
			}
		}
	],

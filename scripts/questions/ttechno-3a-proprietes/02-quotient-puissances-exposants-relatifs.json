	"variations": [
		{
			"statement": "Écris sous la forme d'une seule puissance : $\\dfrac{ {{a}}^{ {{m}} } }{ {{a}}^{ {{p}} } }$.\n\n$\\dfrac{ {{a}}^{ {{m}} } }{ {{a}}^{ {{p}} } }=?$",
			"variables": [
				{

		{
			"statement": "Écris sous la forme d'une seule puissance : ${{a}}^{ {{m}} }\\times{{a}}^{ {{p}} }$.\n\n${{a}}^{ {{m}} }\\times{{a}}^{ {{p}} }=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2|3|5|1.5"
				},
				{
					"name": "m",
					"expression": "-3|-2.5|-1.5|-0.5"
				},
				{
					"name": "p",
					"expression": "0.5|1|1.5|2|2.5|3.5"
				}
			],
			"conditions": ["m+p != 0", "m+p != 1"],
			"blanks": [
				{
					"expectedAnswer": "{{a}}^{ {{eval:m+p;d}} }",
					"requiredForm": "power"
				}
			],
			"correction": {
				"steps": [
					"Pour $a>0$ et tous réels $x$ et $y$ : $a^x\\times a^y=a^{x+y}$. On **ajoute** les exposants.",
					"${{a}}^{ {{m}} }\\times{{a}}^{ {{p}} }={{a}}^{ {{m}}+{{p}} }=\\textcolor{{{color:primary.0}}}{{{a}}^{ {{eval:m+p;d}} }}$."
				]
			}
		},
		{
			"statement": "Écris sous la forme d'une seule puissance : ${{a}}^{ {{m}} }\\times{{a}}^{ {{p}} }$.\n\n${{a}}^{ {{m}} }\\times{{a}}^{ {{p}} }=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2|3|5|1.5"
				},
				{
					"name": "m",
					"expression": "-0.5|-1|-1.5|-2|-2.5"
				},
				{
					"name": "p",
					"expression": "-0.5|-1|-1.5|-2"
				}
			],
			"conditions": ["m != p"],
			"blanks": [
				{
					"expectedAnswer": "{{a}}^{ {{eval:m+p;d}} }",
					"requiredForm": "power"
				}
			],
			"correction": {
				"steps": [
					"Pour $a>0$ et tous réels $x$ et $y$ : $a^x\\times a^y=a^{x+y}$. On **ajoute** les exposants. Ces propriétés valent pour tous les réels $x$ et $y$, **positifs ou négatifs**, comme pour les puissances entières.",
					"${{a}}^{ {{m}} }\\times{{a}}^{ {{p}} }={{a}}^{ {{m}}+({{p}}) }=\\textcolor{{{color:primary.0}}}{{{a}}^{ {{eval:m+p;d}} }}$."
				]
			}
		},
		{
			"statement": "Quel réel $x$ vérifie ${{a}}^{ {{m}} }\\times{{a}}^x={{a}}^{ {{r}} }$ ?\n\n$x=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2|3|5|1.5"
				},
				{
					"name": "m",
					"expression": "1.5|2|2.5|3"
				},
				{
					"name": "r",
					"expression": "-1|-0.5|0.5|1"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{eval:r-m;d}}"
				}
			],
			"correction": {
				"steps": [
					"Pour $a>0$ et tous réels $x$ et $y$ : $a^x\\times a^y=a^{x+y}$. On **ajoute** les exposants.",
					"${{a}}^{ {{m}} }\\times{{a}}^x={{a}}^{ {{m}}+x }$ : il faut ${{m}}+x={{r}}$, donc $x={{r}}-{{m}}=\\textcolor{{{color:primary.0}}}{{{eval:r-m;d}}}$."
				]
			}
		}
	],

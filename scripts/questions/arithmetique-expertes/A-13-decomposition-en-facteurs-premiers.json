{
	"title": "Décomposition en facteurs premiers et nombre de diviseurs",
	"description": "Décomposer un entier en produit de facteurs premiers (écriture avec puissances), en déduire le nombre de diviseurs, le plus petit facteur qui rend un carré parfait (pièges : facteur non premier comme 9 ou 4, produit non décomposé, (a+1)(b+1)(c+1) confondu avec abc)",
	"grades": ["T_EXP"],
	"points": ["TEXP-101", "TEXP-106", "TEXP-075"],
	"theme": "Arithmétique",
	"domain": "Nombres premiers",
	"subdomain": "Nombres premiers",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"variations": [
		{
			"statement": "Décompose ${{eval:2^a*3^b*q}}$ en produit de facteurs premiers (écris les facteurs répétés avec des puissances).\n\n$?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..4"
				},
				{
					"name": "b",
					"expression": "2..3"
				},
				{
					"name": "q",
					"expression": "5|7|11"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "2^{ {{a}} }\\times3^{ {{b}} }\\times{{q}}"
				}
			],
			"correction": {
				"steps": [
					"On divise par $2$ tant que c'est possible (${{a}}$ fois), puis par $3$ (${{b}}$ fois) : il reste ${{q}}$, premier.",
					"${{eval:2^a*3^b*q}} = \\textcolor{{{color:primary.0}}}{2^{ {{a}} } \\times 3^{ {{b}} } \\times {{q}}}$."
				]
			}
		},
		{
			"statement": "$n = 2^{ {{a}} } \\times 3^{ {{b}} } \\times 5^{ {{c}} }$. Combien $n$ a-t-il de diviseurs positifs ?\n\n$?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..6"
				},
				{
					"name": "b",
					"expression": "2..5"
				},
				{
					"name": "c",
					"expression": "2..4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(a+1)*(b+1)*(c+1)}}"
				}
			],
			"correction": {
				"steps": [
					"Un diviseur positif de $n$ s'écrit $2^{\\alpha} \\times 3^{\\beta} \\times 5^{\\gamma}$ avec $0 \\leqslant \\alpha \\leqslant {{a}}$, $0 \\leqslant \\beta \\leqslant {{b}}$, $0 \\leqslant \\gamma \\leqslant {{c}}$.",
					"Il y en a $({{a}} + 1)({{b}} + 1)({{c}} + 1) = \\textcolor{{{color:primary.0}}}{{{eval:(a+1)*(b+1)*(c+1)}}}$."
				]
			}
		},
		{
			"statement": "Quel est le plus petit entier $k \\geqslant 1$ tel que ${{eval:2^a*3^b*5^c}}k$ soit le carré d'un entier ?\n\n$k=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..4"
				},
				{
					"name": "b",
					"expression": "1..3"
				},
				{
					"name": "c",
					"expression": "0..2"
				}
			],
			"conditions": ["mod(a,2) + mod(b,2) + mod(c,2) >= 1"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2^(mod(a,2))*3^(mod(b,2))*5^(mod(c,2))}}"
				}
			],
			"correction": {
				"steps": [
					"${{eval:2^a*3^b*5^c}} = 2^{ {{a}} } \\times 3^{ {{b}} } \\times 5^{ {{c}} }$.",
					"Un carré a tous ses exposants pairs : on complète chaque exposant impair par un facteur.",
					"$k = \\textcolor{{{color:primary.0}}}{{{eval:2^(mod(a,2))*3^(mod(b,2))*5^(mod(c,2))}}}$."
				]
			}
		}
	],

{
	"title": "Petit théorème de Fermat : reste d'une puissance modulo p",
	"description": "Utiliser aᵖ⁻¹ ≡ 1 [p] (p premier, a non multiple de p) et aᵖ ≡ a [p] pour réduire un exposant (pièges : répondre 1 pour toute puissance, a multiple de p, p non premier)",
	"grades": ["T_EXP"],
	"points": ["TEXP-102", "TEXP-074"],
	"theme": "Arithmétique",
	"domain": "Nombres premiers",
	"subdomain": "Nombres premiers",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"variations": [
		{
			"statement": "${{p}}$ est premier. Quel est le reste de la division euclidienne de ${{a}}^{ {{eval:m*(p-1)+r}} }$ par ${{p}}$ ?\n\n$?$",
			"variables": [
				{
					"name": "p",
					"expression": "5|7|11|13"
				},
				{
					"name": "a",
					"expression": "2..30"
				},
				{
					"name": "m",
					"expression": "3..20"
				},
				{
					"name": "r",
					"expression": "1..11"
				}
			],
			"conditions": ["mod(a,p) != 0", "r <= p-2", "mod(mod(a,p)^r,p) != 1"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:mod(mod(a,p)^r,p)}}"
				}
			],
			"correction": {
				"steps": [
					"${{p}}$ est premier et ne divise pas ${{a}}$ : d'après le petit théorème de Fermat, ${{a}}^{ {{eval:p-1}} } \\equiv 1 \\,[{{p}}]$.",
					"${{eval:m*(p-1)+r}} = {{eval:p-1}} \\times {{m}} + {{r}}$, donc ${{a}}^{ {{eval:m*(p-1)+r}} } \\equiv 1^{ {{m}} } \\times {{a}}^{ {{r}} } \\equiv {{eval:mod(a,p)}}^{ {{r}} } \\,[{{p}}]$.",
					"Le reste est $\\textcolor{{{color:primary.0}}}{{{eval:mod(mod(a,p)^r,p)}}}$."
				]
			}
		},
		{
			"statement": "${{p}}$ est premier. Quel est le reste de la division euclidienne de ${{a}}^{ {{p}} }$ par ${{p}}$ ?\n\n$?$",
			"variables": [
				{
					"name": "p",
					"expression": "5|7|11|13"
				},
				{
					"name": "a",
					"expression": "2..40"
				}
			],
			"conditions": ["mod(a,p) >= 2"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:mod(a,p)}}"
				}
			],
			"correction": {
				"steps": [
					"Petit théorème de Fermat, seconde forme : ${{a}}^{ {{p}} } \\equiv {{a}} \\,[{{p}}]$.",
					"${{a}} \\equiv {{eval:mod(a,p)}} \\,[{{p}}]$ : le reste est $\\textcolor{{{color:primary.0}}}{{{eval:mod(a,p)}}}$."
				]
			}
		},
		{
			"statement": "Quel est le reste de la division euclidienne de ${{eval:p*t}}^{ {{eval:p-1}} }$ par ${{p}}$ ?\n\n$?$",
			"variables": [
				{
					"name": "p",
					"expression": "5|7|11|13"
				},
				{
					"name": "t",
					"expression": "2..6"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"${{eval:p*t}} = {{p}} \\times {{t}}$ est un multiple de ${{p}}$ : le petit théorème de Fermat ne s'applique pas.",
					"${{p}}$ divise ${{eval:p*t}}^{ {{eval:p-1}} }$ : le reste est $\\textcolor{{{color:primary.0}}}{0}$."
				]
			}
		},
		{
			"statement": "Quel est le reste de la division euclidienne de $2^{ {{eval:n-1}} }$ par ${{n}}$ ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "9|15|21|25"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:mod(2^(n-1),n)}}"
				}
			],
			"correction": {
				"steps": [
					"${{n}}$ n'est pas premier : rien ne dit que $2^{ {{eval:n-1}} } \\equiv 1 \\,[{{n}}]$.",
					"On calcule de proche en proche : le reste est $\\textcolor{{{color:primary.0}}}{{{eval:mod(2^(n-1),n)}}}$, différent de $1$ — preuve (test de Fermat) que ${{n}}$ n'est pas premier."
				]
			}
		}
	],

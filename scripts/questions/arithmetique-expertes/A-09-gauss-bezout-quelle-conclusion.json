			"correctChoiceIndex": ["0"],
			"correction": {
				"steps": [
					"$au + bv = 1$ avec $u = {{s}}$ et $v = {{eval:-t}}$ entiers.",
					"D'après le théorème de Bézout, $\\textcolor{{{color:primary.0}}}{a \\text{ et } b \\text{ sont premiers entre eux}}$."
				]
			}
		}

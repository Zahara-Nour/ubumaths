	"delay": 60,
	"variations": [
		{
			"statement": "Effectue la division euclidienne de ${{a}}$ par ${{b}}$ : ${{a}} = {{b}} \\times q + r$ avec $0 \\leqslant r < {{b}}$.\n\n$q=?$ et $r=?$",
			"variables": [
				{
					"name": "b",
					"expression": "7..23"
				},
				{
					"name": "q",
					"expression": "12..60"
				},
				{
					"name": "rr",
					"expression": "0..22"
				},
				{
					"name": "a",
					"expression": "eval:b*q+mod(rr,b)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{q}}"
				},
				{
					"expectedAnswer": "{{eval:mod(rr,b)}}"
				}
			],
			"correction": {
				"steps": [
					"${{b}} \\times {{q}} = {{eval:b*q}} \\leqslant {{a}} < {{eval:b*(q+1)}} = {{b}} \\times {{eval:q+1}}$.",
					"Donc $q = \\textcolor{{{color:primary.0}}}{{{q}}}$ et $r = {{a}} - {{eval:b*q}} = \\textcolor{{{color:primary.0}}}{{{eval:mod(rr,b)}}}$, qui vérifie bien $0 \\leqslant r < {{b}}$."
				]
			}
		},
		{
			"statement": "Effectue la division euclidienne de ${{eval:-a}}$ par ${{b}}$ : ${{eval:-a}} = {{b}} \\times q + r$ avec $0 \\leqslant r < {{b}}$.\n\n$q=?$ et $r=?$",
			"variables": [
				{
					"name": "b",
					"expression": "3..12"
				},
				{
					"name": "q",
					"expression": "4..40"
				},
				{
					"name": "rr",
					"expression": "1..11"
				},
				{
					"name": "a",
					"expression": "eval:b*q+mod(rr,b)"
				}
			],
			"conditions": ["mod(rr,b) != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:-q-1}}"
				},
				{
					"expectedAnswer": "{{eval:b-mod(rr,b)}}"
				}
			],
			"correction": {
				"steps": [
					"Le reste doit être **positif** : on encadre ${{eval:-a}}$ entre deux multiples consécutifs de ${{b}}$.",
					"${{b}} \\times ({{eval:-q-1}}) = {{eval:-b*(q+1)}} \\leqslant {{eval:-a}} < {{eval:-b*q}} = {{b}} \\times ({{eval:-q}})$.",
					"Donc $q = \\textcolor{{{color:primary.0}}}{{{eval:-q-1}}}$ et $r = {{eval:-a}} - ({{eval:-b*(q+1)}}) = \\textcolor{{{color:primary.0}}}{{{eval:b-mod(rr,b)}}}$.",
					"L'écriture ${{eval:-a}} = {{b}} \\times ({{eval:-q}}) - {{eval:mod(rr,b)}}$ est juste, mais ce n'est pas la division euclidienne : son « reste » est négatif."
				]
			}
		},
		{
			"statement": "On a l'égalité ${{a}} = {{b}} \\times {{k}} + {{s}}$.\n\nQuels sont le quotient et le reste de la division euclidienne de ${{a}}$ par ${{b}}$ ?\n\n$q=?$ et $r=?$",
			"variables": [
				{
					"name": "b",
					"expression": "5..15"
				},
				{
					"name": "k",
					"expression": "8..30"
				},
				{
					"name": "t",
					"expression": "1..3"
				},
				{
					"name": "rr",
					"expression": "0..14"
				},
				{
					"name": "s",
					"expression": "eval:t*b+mod(rr,b)"
				},
				{
					"name": "a",
					"expression": "eval:b*k+s"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:k+t}}"
				},
				{
					"expectedAnswer": "{{eval:mod(rr,b)}}"
				}
			],
			"correction": {
				"steps": [
					"${{s}} \\geqslant {{b}}$ : l'égalité donnée n'est pas la division euclidienne.",
					"${{s}} = {{b}} \\times {{t}} + {{eval:mod(rr,b)}}$, donc ${{a}} = {{b}} \\times {{eval:k+t}} + {{eval:mod(rr,b)}}$ avec $0 \\leqslant {{eval:mod(rr,b)}} < {{b}}$.",
					"$q = \\textcolor{{{color:primary.0}}}{{{eval:k+t}}}$ et $r = \\textcolor{{{color:primary.0}}}{{{eval:mod(rr,b)}}}$."
				]
			}
		}
	],

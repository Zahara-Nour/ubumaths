{
	"title": "Théorème de Bézout : trouver des coefficients u et v",
	"description": "Compléter une égalité de Bézout au + bv = 1 ou au + bv = PGCD(a, b), donner un coefficient u qui convient parmi une infinité (pièges : u et v inversés, signe du coefficient négatif, au + bv = 1 alors que PGCD ≠ 1)",
	"grades": ["T_EXP"],
	"points": ["TEXP-087", "TEXP-086"],
	"theme": "Arithmétique",
	"domain": "PGCD, Bézout et Gauss",
	"subdomain": "PGCD, Bézout et Gauss",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"variations": [
		{
			"statement": "${{a}}$ et ${{b}}$ sont premiers entre eux. Complète l'égalité de Bézout :\n\n${{a}} \\times {{s}} + {{b}} \\times ? = 1$",
			"variables": [
				{
					"name": "b",
					"expression": "5|7|11|13"
				},
				{
					"name": "a",
					"expression": "14..60"
				},
				{
					"name": "s",
					"expression": "eval:mod(mod(a,b)^(b-2),b)"
				},
				{
					"name": "t",
					"expression": "eval:(1-a*s)/b"
				}
			],
			"conditions": ["mod(a,b) != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{t}}"
				}
			],
			"correction": {
				"steps": [
					"${{b}} \\times v = 1 - {{a}} \\times {{s}} = 1 - {{eval:a*s}} = {{eval:1-a*s}}$.",
					"$v = \\dfrac{ {{eval:1-a*s}} }{ {{b}} } = \\textcolor{{{color:primary.0}}}{{{t}}}$."
				]
			}
		},
		{
			"statement": "Donne un entier $u$ pour lequel il existe un entier $v$ tel que ${{a}}u + {{b}}v = 1$.\n\n$u=?$",
			"variables": [
				{
					"name": "b",
					"expression": "5|7|11|13"
				},
				{
					"name": "a",
					"expression": "14..60"
				},
				{
					"name": "s",
					"expression": "eval:mod(mod(a,b)^(b-2),b)"
				},
				{
					"name": "t",
					"expression": "eval:(1-a*s)/b"
				}
			],
			"conditions": ["mod(a,b) != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{s}}",
					"rulesSuffice": true,
					"validationRules": [
						{
							"type": "custom",
							"expression": "({{a}}*answer-1) % {{b}} == 0",
							"description": "Pour ce u, 1 − au n'est pas un multiple de b : aucun entier v ne convient."
						}
					]
				}
			],
			"correction": {
				"steps": [
					"Il faut ${{a}}u \\equiv 1 \\,[{{b}}]$, soit ${{eval:mod(a,b)}}u \\equiv 1 \\,[{{b}}]$ : $u = \\textcolor{{{color:primary.0}}}{{{s}}}$ convient, avec $v = {{t}}$ : ${{a}} \\times {{s}} + {{b}} \\times ({{t}}) = 1$.",
					"Tout $u = {{s}} + {{b}}k$ ($k \\in \\mathbb{Z}$) convient aussi."
				]
			}
		},
		{
			"statement": "$\\mathrm{PGCD}({{eval:k*a}} \\,;\\, {{eval:k*b}}) = {{k}}$. Complète l'égalité de Bézout :\n\n${{eval:k*a}} \\times {{s}} + {{eval:k*b}} \\times ? = {{k}}$",
			"variables": [
				{
					"name": "b",
					"expression": "5|7|11|13"
				},
				{
					"name": "a",
					"expression": "14..60"
				},
				{
					"name": "s",
					"expression": "eval:mod(mod(a,b)^(b-2),b)"
				},
				{
					"name": "t",
					"expression": "eval:(1-a*s)/b"
				},
				{
					"name": "k",
					"expression": "2..6"
				}
			],
			"conditions": ["mod(a,b) != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{t}}"
				}
			],
			"correction": {
				"steps": [
					"${{eval:k*b}} \\times v = {{k}} - {{eval:k*a*s}} = {{eval:k-k*a*s}}$.",
					"$v = \\dfrac{ {{eval:k-k*a*s}} }{ {{eval:k*b}} } = \\textcolor{{{color:primary.0}}}{{{t}}}$."
				]
			}
		}
	],

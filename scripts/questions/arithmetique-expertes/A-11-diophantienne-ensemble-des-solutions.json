	"status": "draft",
	"delay": 60,
	"variations": [
		{
			"statement": "Le couple $({{x0}} \\,;\\, {{y0}})$ est une solution de ${{a}}x + {{b}}y = {{c}}$, et $\\mathrm{PGCD}({{a}} \\,;\\, {{b}}) = 1$.\n\nQuelles sont toutes les solutions entières ($k \\in \\mathbb{Z}$) ?",
			"variables": [
				{
					"name": "b",
					"expression": "5|7|11|13"
				},
				{
					"name": "a",
					"expression": "3..30"
				},
				{
					"name": "c",
					"expression": "2..40"
				},
				{
					"name": "x0",
					"expression": "eval:mod(c*mod(mod(a,b)^(b-2),b),b)"
				},
				{
					"name": "y0",
					"expression": "eval:(c-a*x0)/b"
				}
			],
			"conditions": ["mod(a,b) != 0", "x0 != 0", "y0 != 0", "a != b"],
			"choices": [

				},
				{
					"content": "$x = {{x0}} + k$ et $y = {{y0}} - k$"
				}
			],
			"correctChoiceIndex": ["0"],
			"correction": {
				"steps": [
					"Par différence avec la solution particulière : ${{a}}(x - {{x0;()}}) = -{{b}}(y - {{y0;()}})$.",
					"${{b}}$ divise ${{a}}(x - {{x0;()}})$ et est premier avec ${{a}}$ : d'après Gauss, $x = {{x0}} + {{b}}k$ ; en reportant, $y = {{y0}} - {{a}}k$.",
					"Solutions : $\\textcolor{{{color:primary.0}}}{x = {{x0}} + {{b}}k,\\ y = {{y0}} - {{a}}k}$, $k \\in \\mathbb{Z}$."
				]
			}
		},

{
	"title": "Inverse modulo n et congruence ax ≡ b [n]",
	"description": "Déterminer un inverse de a modulo n premier, résoudre ax ≡ b [n] dans {0, …, n − 1} ou donner une solution quelconque (pièges : diviser b par a, multiplier par a au lieu de l'inverse, solution hors de {0, …, n − 1})",
	"grades": ["T_EXP"],
	"points": ["TEXP-076", "TEXP-077"],
	"theme": "Arithmétique",
	"domain": "Congruences",
	"subdomain": "Congruences",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"variations": [
		{
			"statement": "Détermine l'entier $x$ de $\\{0, 1, \\ldots, {{eval:n-1}}\\}$ tel que ${{a}}x \\equiv 1 \\,[{{n}}]$ (un inverse de ${{a}}$ modulo ${{n}}$).\n\n$x=?$",
			"variables": [
				{
					"name": "n",
					"expression": "7|11|13"
				},
				{
					"name": "a",
					"expression": "2..12"
				},
				{
					"name": "b",
					"expression": "1..12"
				}
			],
			"conditions": ["a <= n-2"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:mod(a^(n-2),n)}}"
				}
			],
			"correction": {
				"steps": [
					"${{a}}$ et ${{n}}$ sont premiers entre eux : ${{a}}$ a un inverse modulo ${{n}}$. On essaie les multiples de ${{a}}$.",
					"${{a}} \\times {{eval:mod(a^(n-2),n)}} = {{eval:a*mod(a^(n-2),n)}} = {{n}} \\times {{eval:(a*mod(a^(n-2),n)-1)/n}} + 1 \\equiv 1 \\,[{{n}}]$.",
					"$x = \\textcolor{{{color:primary.0}}}{{{eval:mod(a^(n-2),n)}}}$."
				]
			}
		},
		{
			"statement": "Résous ${{a}}x \\equiv {{b}} \\,[{{n}}]$ : donne la solution $x$ de $\\{0, 1, \\ldots, {{eval:n-1}}\\}$.\n\n$x=?$",
			"variables": [
				{
					"name": "n",
					"expression": "7|11|13"
				},
				{
					"name": "a",
					"expression": "2..12"
				},
				{
					"name": "b",
					"expression": "1..12"
				}
			],
			"conditions": ["a <= n-2", "b <= n-1", "b != 1"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:mod(mod(a^(n-2),n)*b,n)}}"
				}
			],
			"correction": {
				"steps": [
					"Un inverse de ${{a}}$ modulo ${{n}}$ est ${{eval:mod(a^(n-2),n)}}$ (${{a}} \\times {{eval:mod(a^(n-2),n)}} \\equiv 1 \\,[{{n}}]$).",
					"On multiplie les deux membres par ${{eval:mod(a^(n-2),n)}}$ : $x \\equiv {{eval:mod(a^(n-2),n)}} \\times {{b}} = {{eval:mod(a^(n-2),n)*b}} \\,[{{n}}]$.",
					"$x = \\textcolor{{{color:primary.0}}}{{{eval:mod(mod(a^(n-2),n)*b,n)}}}$ ; vérification : ${{a}} \\times {{eval:mod(mod(a^(n-2),n)*b,n)}} = {{eval:a*mod(mod(a^(n-2),n)*b,n)}} \\equiv {{b}} \\,[{{n}}]$."
				]
			}
		},
		{
			"statement": "Donne un entier $x$ (quelconque) tel que ${{a}}x \\equiv {{b}} \\,[{{n}}]$.\n\n$x=?$",
			"variables": [
				{
					"name": "n",
					"expression": "7|11|13"
				},
				{
					"name": "a",
					"expression": "2..12"
				},
				{
					"name": "b",
					"expression": "1..12"
				}
			],
			"conditions": ["a <= n-2", "b <= n-1", "b != 1"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:mod(mod(a^(n-2),n)*b,n)}}",
					"rulesSuffice": true,
					"validationRules": [
						{
							"type": "custom",
							"expression": "({{a}}*answer-{{b}}) % {{n}} == 0",
							"description": "Ce nombre ne vérifie pas la congruence."
						}
					]
				}
			],
			"correction": {
				"steps": [
					"Un inverse de ${{a}}$ modulo ${{n}}$ est ${{eval:mod(a^(n-2),n)}}$ : $x \\equiv {{eval:mod(a^(n-2),n)}} \\times {{b}} \\equiv {{eval:mod(mod(a^(n-2),n)*b,n)}} \\,[{{n}}]$.",
					"$x = \\textcolor{{{color:primary.0}}}{{{eval:mod(mod(a^(n-2),n)*b,n)}}}$ convient, et tout entier $x = {{eval:mod(mod(a^(n-2),n)*b,n)}} + {{n}}k$ ($k \\in \\mathbb{Z}$) aussi."
				]
			}
		}
	],

	"variations": [
		{
			"statement": "Quel chiffre $x$ faut-il écrire pour que le nombre $\\overline{ {{d1}}{{d2}}x{{d3}} }$ soit divisible par $9$ ?\n\n$x=?$",
			"variables": [
				{
					"name": "d1",
					"expression": "1..9"
				},
				{
					"name": "d2",
					"expression": "0..9"
				},
				{
					"name": "d3",
					"expression": "0..9"
				}
			],
			"conditions": ["mod(d1+d2+d3,9) != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:9-mod(d1+d2+d3,9)}}"
				}
			],
			"correction": {
				"steps": [
					"Un entier est divisible par $9$ si et seulement si la somme de ses chiffres l'est, car $10 \\equiv 1 \\,[9]$.",
					"${{d1}} + {{d2}} + x + {{d3}} = {{eval:d1+d2+d3}} + x$ doit être un multiple de $9$, avec $0 \\leqslant x \\leqslant 9$.",
					"$x = \\textcolor{{{color:primary.0}}}{{{eval:9-mod(d1+d2+d3,9)}}}$."
				]
			}
		},
		{
			"statement": "Quel chiffre $x$ faut-il écrire pour que le nombre $\\overline{ {{d1}}{{d2}}{{d3}}x }$ soit divisible par $11$ ?\n\n$x=?$",
			"variables": [
				{
					"name": "d1",
					"expression": "1..9"
				},
				{
					"name": "d2",
					"expression": "0..9"
				},
				{
					"name": "d3",
					"expression": "0..9"
				}
			],
			"conditions": ["mod(d1-d2+d3,11) <= 9"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:mod(d1-d2+d3,11)}}"
				}
			],
			"correction": {
				"steps": [
					"$10 \\equiv -1 \\,[11]$ : un entier est congru modulo $11$ à la somme alternée de ses chiffres, en partant des unités.",
					"$x - {{d3}} + {{d2}} - {{d1}} \\equiv 0 \\,[11]$, soit $x \\equiv {{d1}} - {{d2}} + {{d3}} \\equiv {{eval:mod(d1-d2+d3,11)}} \\,[11]$.",
					"$x = \\textcolor{{{color:primary.0}}}{{{eval:mod(d1-d2+d3,11)}}}$."
				]
			}
		},
		{
			"statement": "Quel est le reste de la division euclidienne de ${{eval:10000*d1+1000*d2+100*d3+10*d4+d5}}$ par $9$ ?\n\n$?$",
			"variables": [
				{
					"name": "d1",
					"expression": "1..9"
				},
				{
					"name": "d2",
					"expression": "0..9"
				},
				{
					"name": "d3",
					"expression": "0..9"
				},
				{
					"name": "d4",
					"expression": "0..9"
				},
				{
					"name": "d5",
					"expression": "0..9"
				}
			],
			"conditions": ["d1+d2+d3+d4+d5 >= 9"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:mod(d1+d2+d3+d4+d5,9)}}"
				}
			],
			"correction": {
				"steps": [
					"$10 \\equiv 1 \\,[9]$ : un entier est congru modulo $9$ à la somme de ses chiffres.",
					"${{d1}} + {{d2}} + {{d3}} + {{d4}} + {{d5}} = {{eval:d1+d2+d3+d4+d5}} \\equiv \\textcolor{{{color:primary.0}}}{{{eval:mod(d1+d2+d3+d4+d5,9)}}} \\,[9]$."
				]
			}
		},
		{
			"statement": "Donne un chiffre $x$ pour lequel le nombre $\\overline{ {{d1}}{{d2}}x }$ est divisible par $3$.\n\n$x=?$",
			"variables": [
				{
					"name": "d1",
					"expression": "1..9"
				},
				{
					"name": "d2",
					"expression": "0..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:mod(-d1-d2,3)}}",
					"rulesSuffice": true,
					"validationRules": [
						{
							"type": "custom",
							"expression": "({{d1}}+{{d2}}+answer) % 3 == 0",
							"description": "Avec ce chiffre, la somme des chiffres n'est pas un multiple de 3."
						},
						{
							"type": "range",
							"min": "0",
							"max": "9",
							"inclusive": true
						}
					]
				}
			],
			"correction": {
				"steps": [
					"Un entier est divisible par $3$ si et seulement si la somme de ses chiffres l'est : ${{eval:d1+d2}} + x$ doit être un multiple de $3$.",
					"$x = \\textcolor{{{color:primary.0}}}{{{eval:mod(-d1-d2,3)}}}$ convient, ainsi que $x = {{eval:mod(-d1-d2,3)+3}}$ et $x = {{eval:mod(-d1-d2,3)+6}}${{if:mod(-d1-d2,3)==0| et $x = 9$}}."
				]
			}
		}
	],

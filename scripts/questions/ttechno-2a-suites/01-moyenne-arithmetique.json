	"title": "Moyenne arithmétique de deux nombres",
	"description": "Calculer la moyenne arithmétique de deux nombres, retrouver un terme d'une suite arithmétique entre deux autres",
	"grades": ["T_TECHNO"],
	"level": 1,
	"delay": 30,
	"status": "draft",
	"shared": {
		"blankDefaults": {
			"acceptDecimal": true
		}
	},
	"variations": [
		{
			"statement": "Calcule la moyenne arithmétique de ${{a}}$ et ${{b}}$.\n\n$?$",
			"variables": [
				{
					"name": "a",
					"expression": "-20..40"
				},
				{
					"name": "b",
					"expression": "-20..40"
				}
			],
			"conditions": ["a != b", "a != -b"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(a+b)/2;d}}"
				}
			],
			"correction": {
				"steps": [
					"La moyenne arithmétique de deux nombres $a$ et $b$ est $\\dfrac{a+b}{2}$.",
					"$\\dfrac{ {{a}}{{eval:b;+}} }{2}=\\dfrac{ {{eval:a+b}} }{2}=\\textcolor{{{color:primary.0}}}{{{eval:(a+b)/2;d}}}$."
				]
			}
		},
		{
			"statement": "$(u_n)$ est une suite arithmétique telle que $u_{{k}}={{a}}$ et $u_{{k2}}={{eval:a+2*r}}$.\n\nCalcule $u_{{k1}}$.\n\n$u_{{k1}}=?$",
			"variables": [
				{
					"name": "k",
					"expression": "0..6"
				},
				{
					"name": "k1",
					"expression": "eval:k+1"
				},
				{
					"name": "k2",
					"expression": "eval:k+2"
				},
				{
					"name": "a",
					"expression": "-10..30"
				},
				{
					"name": "r",
					"expression": "-9..9"
				}
			],
			"conditions": ["r != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a+r}}"
				}
			],
			"correction": {
				"steps": [
					"Dans une suite arithmétique, chaque terme est la moyenne arithmétique du terme qui le précède et du terme qui le suit.",
					"$u_{{k1}}=\\dfrac{u_{{k}}+u_{{k2}}}{2}=\\dfrac{ {{a}}{{eval:a+2*r;+}} }{2}=\\textcolor{{{color:primary.0}}}{{{eval:a+r}}}$."
				]
			}
		},
		{
			"statement": "Une commune comptait ${{a}}$ habitants en 2022 et ${{eval:a+2*r}}$ habitants en 2024. On suppose que la population a varié du même nombre d'habitants chaque année.\n\nCombien la commune comptait-elle d'habitants en 2023 ?\n\n$?$ habitants",
			"variables": [
				{
					"name": "a",
					"expression": "1500..4800"
				},
				{
					"name": "r",
					"expression": "-90..150"
				}
			],
			"conditions": ["r*r >= 100"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a+r}}"
				}
			],
			"correction": {
				"steps": [
					"La population varie du même nombre chaque année : elle suit une suite arithmétique. Dans une suite arithmétique, chaque terme est la moyenne arithmétique du terme qui le précède et du terme qui le suit.",
					"$\\dfrac{ {{a}}+{{eval:a+2*r}} }{2}=\\textcolor{{{color:primary.0}}}{{{eval:a+r}}}$ habitants en 2023."
				]
			}
		}
	],

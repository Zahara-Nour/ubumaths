					"expression": "{{if:k==1|{{x3}}|{{x2}}}}"
				},
				{
					"name": "yc",
					"expression": "{{if:k==1|{{y3}}|{{y2}}}}"
				}
			],
			"conditions": ["abs(y3 - y1) >= 2"],
			"correction": {
				"steps": [
					"On pose la règle sur les points ${{if:k==3|B|A}}$ et ${{if:k==1|B|C}}$, puis on trace le trait d'un bord à l'autre : une droite ne s'arrête pas aux points.",
					"Le point ${{if:k==1|C|{{if:k==2|B|A}}}}$ n'est pas sur cette droite : il ne faut pas le prendre."
				]

			],
			"statement": "Deux variables aléatoires **indépendantes** $X$ et $Y$ vérifient $V(X)={{u}}$ et $V(Y)={{w}}$.\n\nCalcule $V(X-Y)$.\n\n$V(X-Y)=?$",
			"variables": [
				{
					"name": "u",
					"expression": "5..20"
				},
				{
					"name": "w",
					"expression": "1..4"
				}
			],
			"correction": {
				"steps": [
					"$V(X-Y)=V(X)+V(-Y)$ par indépendance, et $V(-Y)=(-1)^{2}V(Y)=V(Y)$ : une variance ne diminue jamais quand on ajoute une variable indépendante.",
					"$V(X-Y)={{u}}+{{w}}=\\textcolor{{{color:primary.0}}}{{{eval:u+w}}}$."
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "{{eval:a^2*u+b^2*w}}"
				}
			],
			"statement": "Deux variables aléatoires **indépendantes** $X$ et $Y$ vérifient $V(X)={{u}}$ et $V(Y)={{w}}$.\n\nCalcule $V({{a}}X+{{b}}Y)$.\n\n$V({{a}}X+{{b}}Y)=?$",
			"variables": [
				{
					"name": "u",
					"expression": "1..9"
				},
				{
					"name": "w",
					"expression": "1..9"

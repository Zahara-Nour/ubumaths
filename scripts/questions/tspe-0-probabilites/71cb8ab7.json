					"expression": "2..4"
				},
				{
					"name": "b",
					"expression": "2..3"
				}
			],
			"correction": {
				"steps": [
					"Par indépendance, $V(aX+bY)=V(aX)+V(bY)=a^{2}V(X)+b^{2}V(Y)$.",
					"$V({{a}}X+{{b}}Y)={{eval:a^2}}\\times{{u}}+{{eval:b^2}}\\times{{w}}=\\textcolor{{{color:primary.0}}}{{{eval:a^2*u+b^2*w}}}$."
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "{{sz}}"
				}
			],
			"statement": "Deux variables aléatoires **indépendantes** $X$ et $Y$ ont pour écarts types $\\sigma(X)={{sx}}$ et $\\sigma(Y)={{sy}}$.\n\nCalcule $\\sigma(X+Y)$.\n\n$\\sigma(X+Y)=?$",
			"variables": [
				{
					"name": "w",
					"expression": "1..5"
				},
				{
					"name": "sx",
					"expression": "{{if:w==1|3|{{if:w==2|6|{{if:w==3|5|{{if:w==4|8|9}}}}}}}}"
				},
				{
					"name": "sy",
					"expression": "{{if:w==1|4|{{if:w==2|8|{{if:w==3|12|{{if:w==4|15|12}}}}}}}}"
				},
				{
					"name": "sz",
					"expression": "{{if:w==1|5|{{if:w==2|10|{{if:w==3|13|{{if:w==4|17|15}}}}}}}}"
				}
			],
			"correction": {
				"steps": [
					"Ce sont les **variances** qui s'ajoutent : $V(X+Y)={{sx}}^{2}+{{sy}}^{2}={{eval:sz^2}}$.",
					"$\\sigma(X+Y)=\\sqrt{ {{eval:sz^2}} }=\\textcolor{{{color:primary.0}}}{{{sz}}}$ (et non ${{sx}}+{{sy}}={{eval:sx+sy}}$)."
				]
			}
		}
	],

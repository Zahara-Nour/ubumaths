				{
					"name": "w",
					"expression": "1..9;±"
				},
				{
					"name": "a",
					"expression": "2..5"
				},
				{
					"name": "b",
					"expression": "2..5"
				}
			],
			"correction": {
				"steps": [
					"Linéarité de l'espérance (vraie même si $X$ et $Y$ ne sont pas indépendantes) : $E(aX+bY)=aE(X)+bE(Y)$.",
					"$E({{a}}X+{{b}}Y)={{a}}\\times{{u;()}}+{{b}}\\times{{w;()}}=\\textcolor{{{color:primary.0}}}{{{eval:a*u+b*w}}}$."
				]
			}
		}
	],

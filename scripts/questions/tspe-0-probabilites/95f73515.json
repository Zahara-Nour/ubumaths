	"variations": [
		{
			"blanks": [
				{
					"expectedAnswer": "{{eval:v*d^2/n}}"
				}
			],
			"statement": "$M$ est la moyenne d'un échantillon de taille $n={{n}}$ d'une loi d'espérance $\\mu$ et de variance $V={{v}}$.\n\nDonne le majorant de $P\\left(\\left|M-\\mu\\right|\\geqslant {{eval:1/d;d}}\\right)$ fourni par l'inégalité de concentration (nombre décimal).\n\n$P\\left(\\left|M-\\mu\\right|\\geqslant {{eval:1/d;d}}\\right)\\leqslant ?$",
			"variables": [
				{
					"name": "n",
					"expression": "100|200|400|500|1000"
				},
				{
					"name": "v",
					"expression": "1..10"
				},
				{
					"name": "d",
					"expression": "2|4|5|10"
				}
			],
			"conditions": ["v*d^2 < n"],
			"correction": {
				"steps": [
					"Inégalité de concentration : $P\\left(\\left|M_n-\\mu\\right|\\geqslant\\delta\\right)\\leqslant\\dfrac{V}{n\\delta^{2}}$.",
					"$\\dfrac{ {{v}} }{ {{n}}\\times{{eval:1/d;d}}^{2} }=\\dfrac{ {{v}} }{ {{eval:n/d^2;d}} }=\\textcolor{{{color:primary.0}}}{{{eval:v*d^2/n;d}}}$."
				]
			}
		}
	],

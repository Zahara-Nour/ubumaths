{
	"title": "Écrire une proportion sous une autre forme",
	"description": "Passer d'une écriture d'une proportion à une autre : décimale → pourcentage, pourcentage → décimale, fraction → pourcentage, fraction → décimale. Valeurs choisies pour les pièges usuels (0,035 ; 0,5 % ; 8 % → 0,08 ; 1/8).",
	"grades": ["2"],
	"level": 1,
	"delay": 30,
	"status": "draft",
	"variations": [
		{
			"statement": "Écris la proportion $ {{eval:m/1000;d}} $ sous forme de pourcentage.\n\n$ {{eval:m/1000;d}}=?\\,\\% $",
			"variables": [
				{
					"name": "m",
					"expression": "5|8|20|35|45|75|80|125|350|400|650|990"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:m/10;d}}"
				}
			],
			"correction": {
				"steps": [
					"Un pourcentage est une proportion écrite sur $100$ : on multiplie par $100$.",
					"$$ {{eval:m/1000;d}}=\\dfrac{ {{eval:m/10;d}} }{100}=\\textcolor{{{color:primary.0}}}{ {{eval:m/10;d}}\\,\\% } $$"
				]
			}
		},
		{
			"statement": "Écris la proportion $ {{eval:m/10;d}}\\,\\% $ sous forme décimale.\n\n$ {{eval:m/10;d}}\\,\\%=? $",
			"variables": [
				{
					"name": "m",
					"expression": "5|8|20|35|45|75|80|125|350|400|650|990"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:m/1000;d}}"
				}
			],
			"correction": {
				"steps": [
					"$p\\,\\%$ signifie $\\dfrac{p}{100}$ : on divise par $100$.",
					"$$ {{eval:m/10;d}}\\,\\%=\\dfrac{ {{eval:m/10;d}} }{100}=\\textcolor{{{color:primary.0}}}{ {{eval:m/1000;d}} } $$"
				]
			}
		},
		{
			"statement": "Écris la proportion $\\dfrac{ {{a}} }{ {{b}} }$ sous forme de pourcentage.\n\n$\\dfrac{ {{a}} }{ {{b}} }=?\\,\\%$",
			"variables": [
				{
					"name": "b",
					"expression": "4|5|8|20|25|40|50"
				},
				{
					"name": "a",
					"expression": "1..19"
				}
			],
			"conditions": ["a < b", "gcd(a,b) = 1"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:100*a/b;d}}"
				}
			],
			"correction": {
				"steps": [
					"On écrit la proportion sur $100$ (ou on calcule son écriture décimale, puis on multiplie par $100$).",
					"$$\\dfrac{ {{a}} }{ {{b}} }={{eval:a/b;d}}=\\dfrac{ {{eval:100*a/b;d}} }{100}=\\textcolor{{{color:primary.0}}}{ {{eval:100*a/b;d}}\\,\\% }$$"
				]
			}
		},
		{
			"statement": "Écris la proportion $\\dfrac{ {{a}} }{ {{b}} }$ sous forme décimale.\n\n$\\dfrac{ {{a}} }{ {{b}} }=?$",
			"variables": [
				{
					"name": "b",
					"expression": "4|5|8|20|25|40|50"
				},
				{
					"name": "a",
					"expression": "1..19"
				}
			],
			"conditions": ["a < b", "gcd(a,b) = 1"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a/b;d}}"
				}
			],
			"correction": {
				"steps": [
					"On divise le numérateur par le dénominateur (ou on écrit la fraction sur $10$, $100$ ou $1\\,000$).",
					"$$\\dfrac{ {{a}} }{ {{b}} }=\\dfrac{ {{eval:1000*a/b}} }{1\\,000}=\\textcolor{{{color:primary.0}}}{ {{eval:a/b;d}} }$$"
				]
			}
		}
	],

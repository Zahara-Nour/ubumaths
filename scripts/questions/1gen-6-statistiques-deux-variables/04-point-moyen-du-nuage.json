					"expression": "3..5"
				},
				{
					"name": "x4",
					"expression": "eval:4*gx-x1-x2-x3"
				},
				{
					"name": "y1",
					"expression": "1..9"
				},
				{
					"name": "y2",
					"expression": "1..9"
				},
				{
					"name": "y3",
					"expression": "1..9"
				},
				{
					"name": "gy",
					"expression": "3..7"
				},
				{
					"name": "y4",
					"expression": "eval:4*gy-y1-y2-y3"
				}
			],
			"conditions": ["x4 > x3", "x4 <= 8", "y4 >= 0", "y4 <= 10", "gx != x2", "gx != x3"],
			"correction": {
				"steps": [
					"Le point moyen $G(\\bar{x}\\,;\\bar{y})$ a pour coordonnées la moyenne des abscisses et la moyenne des ordonnées.",
					"$\\bar{x}=\\dfrac{ {{x1}}+{{x2}}+{{x3}}+{{x4}} }{4}={{gx}}$ et $\\bar{y}=\\dfrac{ {{y1}}+{{y2}}+{{y3}}+{{y4}} }{4}={{gy}}$.",
					"On place $G\\textcolor{{{color:primary.0}}}{({{gx}}\\,;{{gy}})}$ : il est « au centre » du nuage, mais ce n'est en général pas un point du nuage."
				]
			}
		},
		{
			"statement": "Le point moyen d'un nuage de points est $G({{gx}}\\,;{{gy}})$. On ajuste ce nuage par une droite de coefficient directeur ${{eval:A/2;d}}$ qui passe par $G$, d'équation $y={{eval:A/2;d}}x+b$.\n\nCalcule $b$.\n\n$b=?$",
			"variables": [
				{
					"name": "gx",
					"expression": "2..8"
				},
				{
					"name": "gy",
					"expression": "20..60"
				},
				{
					"name": "A",
					"expression": "1..9"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{eval:gy-A*gx/2}}"
				}
			],
			"correction": {
				"steps": [
					"La droite passe par $G$ : les coordonnées de $G$ vérifient son équation.",
					"${{gy}}={{eval:A/2;d}}\\times{{gx}}+b$, donc $b={{gy}}-{{eval:A*gx/2;d}}=\\textcolor{{{color:primary.0}}}{{{eval:gy-A*gx/2;d}}}$."
				]
			}
		},
		{
			"statement": "On considère la série statistique à deux variables suivante.\n\n| $x_i$ | ${{x1}}$ | ${{x2}}$ | ${{x3}}$ | ${{x4}}$ | ${{x5}}$ |\n|---|---|---|---|---|---|\n| $y_i$ | ${{y1}}$ | ${{y2}}$ | ${{y3}}$ | ${{y4}}$ | ${{y5}}$ |\n\nQuel est le point moyen du nuage associé ?\n\n```choix\n- $G({{gx}}\\,;{{gy}})$\n- $G({{gy}}\\,;{{gx}})$\n- $G({{x3}}\\,;{{y3}})$\n- $G({{eval:5*gx/4;d}}\\,;{{eval:5*gy/4;d}})$\n```",
			"variables": [

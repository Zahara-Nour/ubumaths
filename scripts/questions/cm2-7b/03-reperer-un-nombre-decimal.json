{
	"title": "Repérer un point par un nombre décimal",
	"description": "Lire le nombre décimal qui repère un point d'une demi-droite graduée en dixièmes (2,8), d'un morceau agrandi gradué en centièmes (2,37) ou en millièmes (2,812 ; 33,916)",
	"grades": ["CM2"],
	"theme": "Décimaux",
	"domain": "Apprivoiser",
	"subdomain": "Repérage",
	"level": 5,
	"delay": 45,
	"status": "draft",
	"options": {
		"constraints": {
			"spacesFromFourDigits": true
		}
	},
	"variations": [
		{
			"statement": "Quel nombre repère le point $A$ ?\n\n```line\nstart: {{q}}\nend: {{eval:q+1}}\nstep: 0.1\nmajor: 10\npoints: A={{x}}\n```\n\n$$A : ?$$",
			"variables": [
				{
					"name": "q",
					"expression": "0..30"
				},
				{
					"name": "k",
					"expression": "1..9"
				},
				{
					"name": "x",
					"expression": "eval:q+k/10;d"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{x}}"
				}
			],
			"correction": {
				"steps": [
					"**Ce que vaut un petit intervalle.** De ${{q}}$ à ${{eval:q+1}}$, l'unité est partagée en $10$ : chaque petit intervalle vaut $0.1$.",
					"$A$ est ${{k}}$ petit{{if:k>1|s|}} intervalle{{if:k>1|s|}} après ${{q}}$ : ${{q}} + {{k}} \\times 0.1 = \\textcolor{green}{{{x}}}$."
				]
			}
		},
		{
			"statement": "Quel nombre repère le point $A$ ?\n\n```line\nstart: {{lo}}\nend: {{hi}}\nstep: 0.01\nmajor: 10\nlabels: {{lo}}, {{hi}}\npoints: A={{x}}\n```\n\n$$A : ?$$",
			"variables": [
				{
					"name": "a",
					"expression": "1..99"
				},
				{
					"name": "b",
					"expression": "0..9"
				},
				{
					"name": "k",
					"expression": "1..9"
				},
				{
					"name": "lo",
					"expression": "eval:a+b/10;d"
				},
				{
					"name": "hi",
					"expression": "eval:a+(b+1)/10;d"
				},
				{
					"name": "x",
					"expression": "eval:a+b/10+k/100;d"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{x}}"
				}
			],
			"correction": {
				"steps": [
					"**Ce que vaut un petit intervalle.** De ${{lo}}$ à ${{hi}}$, il y a un dixième, partagé en $10$ : chaque petit intervalle vaut $0.01$.",
					"$A$ est ${{k}}$ petit{{if:k>1|s|}} intervalle{{if:k>1|s|}} après ${{lo}}$ : ${{lo}} + {{k}} \\times 0.01 = \\textcolor{green}{{{x}}}$."
				]
			}
		},
		{
			"statement": "Quel nombre repère le point $A$ ?\n\n```line\nstart: {{lo}}\nend: {{hi}}\nstep: 0.001\nmajor: 10\nlabels: {{lo}}, {{hi}}\npoints: A={{x}}\n```\n\n$$A : ?$$",
			"variables": [
				{
					"name": "a",
					"expression": "1..99"
				},
				{
					"name": "c",
					"expression": "0..99"
				},
				{
					"name": "lo",
					"expression": "eval:a+c/100;d"
				},
				{
					"name": "hi",
					"expression": "eval:a+(c+1)/100;d"
				},
				{
					"name": "k",
					"expression": "1..9"
				},
				{
					"name": "x",
					"expression": "eval:a+c/100+k/1000;d"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{x}}"
				}
			],
			"correction": {
				"steps": [
					"**Ce que vaut un petit intervalle.** De ${{lo}}$ à ${{hi}}$, il y a un centième, partagé en $10$ : chaque petit intervalle vaut $0.001$.",
					"$A$ est ${{k}}$ petit{{if:k>1|s|}} intervalle{{if:k>1|s|}} après ${{lo}}$ : ${{lo}} + {{k}} \\times 0.001 = \\textcolor{green}{{{x}}}$."
				]
			}
		}
	],

					"expression": "a/c+b/c"
				}
			],
			"correction": {
				"steps": [
					"$$\\begin{align} \\dfrac{{{a}}}{\\textcolor{{{color:primary.0}}}{{{c}}}}+\\dfrac{{{b}}}{\\textcolor{{{color:primary.0}}}{{{c}}}} &= \\dfrac{{{a}}+{{b}}}{\\textcolor{{{color:primary.0}}}{{{c}}}} \\\\ &= {{solution}}  \\end{align}$$"
				]
			}
		},
		{
			"statement": "Calcule. Donne le résultat sous la forme d'une seule fraction.\n\n$${{n}} + \\frac{{{a}}}{{{b}}} = ?$$",
			"variables": [
				{
					"name": "n",
					"expression": "1..3"
				},
				{
					"name": "b",
					"expression": "2..5"
				},
				{
					"name": "a",
					"expression": "1..{{eval:b-1}}"
				}
			],
			"conditions": ["gcd(a,b)==1"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{eval:n*b+a}}}{{{b}}}",
					"requiredForm": {
						"pattern": "u:integer / w:integer"
					},
					"expectedErrors": [
						{
							"answer": "\\frac{{{eval:n+a}}}{{{b}}}",
							"message": "${{n}}$, ce n'est pas ${{n}}$ {{if:b==2|demis|{{if:b==3|tiers|{{if:b==4|quarts|cinquièmes}}}}}} : écris d'abord ${{n}}$ avec le dénominateur ${{b}}$.",
							"label": "Entier ajouté au numérateur"
						},
						{
							"answer": "\\frac{{{eval:n+a}}}{{{eval:b+1}}}",
							"message": "On n'additionne pas les dénominateurs : écris ${{n}}$ avec le dénominateur ${{b}}$.",
							"label": "Dénominateurs additionnés"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"**Un entier en fraction.** ${{n}} = \\frac{{{eval:n*b}}}{{{b}}}$ (dans une unité, il y a ${{b}}$ parts de $\\frac{1}{{{b}}}$).",
					"$${{n}} + \\frac{{{a}}}{{{b}}} = \\frac{{{eval:n*b}}}{{{b}}} + \\frac{{{a}}}{ {{b}}} = \\textcolor{{{color:primary.0}}}{\\frac{{{eval:n*b+a}}}{{{b}}}}$$"
				]
			},
			"hint": "Écris d'abord ${{n}}$ sous la forme d'une fraction de dénominateur ${{b}}$."
		},
		{
			"statement": "On met bout à bout quatre segments, de longueurs $\\frac{{{a}}}{{{d}}}~\\unit{m}$, $\\frac{{{b}}}{{{d}}}~\\unit{m}$, $\\frac{{{c}}}{{{d}}}~\\unit{m}$ et $\\frac{{{f}}}{{{d}}}~\\unit{m}$.\n\nQuelle est la longueur du segment obtenu ? Donne-la sous la forme d'une seule fraction.\n\n$$?~\\text{m}$$",
			"variables": [
				{
					"name": "d",
					"expression": "5..8"
				},
				{
					"name": "a",
					"expression": "1..{{eval:d-1}}"
				},
				{
					"name": "b",
					"expression": "1..{{eval:d-1}}"
				},
				{
					"name": "c",
					"expression": "1..{{eval:d-1}}"
				},
				{
					"name": "f",
					"expression": "1..{{eval:d-1}}"
				},
				{
					"name": "S",
					"expression": "eval:a+b+c+f"
				}
			],
			"conditions": ["gcd(S,d)==1"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{S}}}{{{d}}}",
					"requiredForm": {
						"pattern": "u:integer / w:integer"
					},
					"expectedErrors": [
						{
							"answer": "\\frac{{{S}}}{{{eval:4*d}}}",
							"message": "On n'additionne pas les dénominateurs : ce sont des {{if:d==5|cinquièmes|{{if:d==6|sixièmes|{{if:d==7|septièmes|huitièmes}}}}}} de mètre, on compte combien il y en a en tout.",
							"label": "Dénominateurs additionnés"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"**Même dénominateur.** Les quatre longueurs sont des {{if:d==5|cinquièmes|{{if:d==6|sixièmes|{{if:d==7|septièmes|huitièmes}}}}}} de mètre : on additionne les numérateurs, le dénominateur reste ${{d}}$.",
					"$$\\frac{{{a}}}{{{d}}} + \\frac{{{b}}}{{{d}}} + \\frac{{{c}}}{{{d}}} + \\frac{{{f}}}{{{d}}} = \\frac{{{a}} + {{b}} + {{c}} + {{f}}}{{{d}}} = \\textcolor{{{color:primary.0}}}{\\frac{{{S}}}{{{d}}}}$$",
					"Le segment obtenu mesure $\\frac{{{S}}}{{{d}}}~\\unit{m}$."
				]
			},
			"hint": "Les quatre fractions ont le même dénominateur : que devient-il quand on les additionne ?"
		}
	],

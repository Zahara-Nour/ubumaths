							"label": "Chiffres recopiés"
						},
						{
							"answer": "{{eval:60/b}}",
							"message": "Tu as pris $\\frac{1}{{{b}}}$ d'heure : il en faut ${{a}}$.",
							"label": "Multiplication oubliée"

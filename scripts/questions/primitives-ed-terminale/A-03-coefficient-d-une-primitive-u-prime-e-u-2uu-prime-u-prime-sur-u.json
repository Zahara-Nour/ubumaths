	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=e^{{{if:a==1|x}}{{if:a==-1|-x}}{{if:a!=1 && a!=-1|{{eval:a}}x}}{{if:b>0|+{{eval:b}}}}{{if:b<0|{{eval:b}}}}}$.\n\nDétermine le réel $k$ tel que la fonction $F$ définie par $F(x)=k\\,e^{{{if:a==1|x}}{{if:a==-1|-x}}{{if:a!=1 && a!=-1|{{eval:a}}x}}{{if:b>0|+{{eval:b}}}}{{if:b<0|{{eval:b}}}}}$ soit une primitive de $f$ sur $\\mathbb{R}$.\n\n$k=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..6;±"
				},
				{
					"name": "b",
					"expression": "-5..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:1/a}}"
				}
			],
			"correction": {
				"steps": [
					"Avec $u(x)={{if:a==1|x}}{{if:a==-1|-x}}{{if:a!=1 && a!=-1|{{eval:a}}x}}{{if:b>0|+{{eval:b}}}}{{if:b<0|{{eval:b}}}}$, on a $u'(x)={{eval:a}}$ et $(e^{u})'=u'e^{u}$.",
					"$F'(x)=k\\times{{eval:a;()}}e^{{{if:a==1|x}}{{if:a==-1|-x}}{{if:a!=1 && a!=-1|{{eval:a}}x}}{{if:b>0|+{{eval:b}}}}{{if:b<0|{{eval:b}}}}}$. Pour que $F'=f$, il faut ${{eval:a}}k=1$, soit $k=\\textcolor{{{color:primary.0}}}{{{eval:1/a}}}$.",
					"On divise par $u'$ : on ne multiplie pas."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)={{if:c==1|x}}{{if:c==-1|-x}}{{if:c!=1 && c!=-1|{{eval:c}}x}}e^{x^2}$.\n\nDétermine le réel $k$ tel que la fonction $F$ définie par $F(x)=k\\,e^{x^2}$ soit une primitive de $f$ sur $\\mathbb{R}$.\n\n$k=?$",
			"variables": [
				{
					"name": "c",
					"expression": "1..6;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:c/2}}"
				}
			],
			"correction": {
				"steps": [
					"Avec $u(x)=x^2$, $u'(x)=2x$ et $(e^{u})'=u'e^{u}$ : $F'(x)=k\\times 2x\\,e^{x^2}=2k\\,x\\,e^{x^2}$.",
					"Il faut $2k={{eval:c}}$, soit $k=\\textcolor{{{color:primary.0}}}{{{eval:c/2}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)={{if:c==1|x}}{{if:c==-1|-x}}{{if:c!=1 && c!=-1|{{eval:c}}x}}(x^2{{if:m>0|+{{eval:m}}}}{{if:m<0|{{eval:m}}}})$.\n\nDétermine le réel $k$ tel que la fonction $F$ définie par $F(x)=k(x^2{{if:m>0|+{{eval:m}}}}{{if:m<0|{{eval:m}}}})^2$ soit une primitive de $f$ sur $\\mathbb{R}$.\n\n$k=?$",
			"variables": [
				{
					"name": "c",
					"expression": "1..6;±"
				},
				{
					"name": "m",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:c/4}}"
				}
			],
			"correction": {
				"steps": [
					"Avec $u(x)=x^2{{if:m>0|+{{eval:m}}}}{{if:m<0|{{eval:m}}}}$, $u'(x)=2x$ et $(u^2)'=2u'u$ : $F'(x)=k\\times 2\\times 2x(x^2{{if:m>0|+{{eval:m}}}}{{if:m<0|{{eval:m}}}})=4k\\,x(x^2{{if:m>0|+{{eval:m}}}}{{if:m<0|{{eval:m}}}})$.",
					"Il faut $4k={{eval:c}}$, soit $k=\\textcolor{{{color:primary.0}}}{{{eval:c/4}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)={{if:c<0|-}}\\dfrac{{{if:abs(c)==1|x}}{{if:abs(c)==-1|-x}}{{if:abs(c)!=1 && abs(c)!=-1|{{eval:abs(c)}}x}}}{x^2+{{eval:m}}}$.\n\nDétermine le réel $k$ tel que la fonction $F$ définie par $F(x)=k\\ln(x^2+{{eval:m}})$ soit une primitive de $f$ sur $\\mathbb{R}$.\n\n$k=?$",
			"variables": [
				{
					"name": "c",
					"expression": "1..6;±"
				},
				{
					"name": "m",
					"expression": "1..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:c/2}}"
				}
			],
			"correction": {
				"steps": [
					"Avec $u(x)=x^2+{{eval:m}}$, strictement positive, $u'(x)=2x$ et $(\\ln u)'=\\dfrac{u'}{u}$ : $F'(x)=k\\times\\dfrac{2x}{x^2+{{eval:m}}}$.",
					"Il faut $2k={{eval:c}}$, soit $k=\\textcolor{{{color:primary.0}}}{{{eval:c/2}}}$."
				]
			}
		}
	],

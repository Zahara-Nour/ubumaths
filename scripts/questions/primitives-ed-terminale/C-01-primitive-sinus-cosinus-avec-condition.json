	},
	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)={{if:a==1|\\cos(x)}}{{if:a==-1|-\\cos(x)}}{{if:a!=1 && a!=-1|{{eval:a}}\\cos(x)}}$.\n\nDétermine la primitive $F$ de $f$ sur $\\mathbb{R}$ telle que $F(0)={{eval:y0}}$.\n\n$F(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "y0",
					"expression": "-5..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:a==1|\\sin(x)}}{{if:a==-1|-\\sin(x)}}{{if:a!=1 && a!=-1|{{eval:a}}\\sin(x)}}{{if:y0>0|+{{eval:y0}}}}{{if:y0<0|{{eval:y0}}}}"
				}
			],
			"correction": {
				"steps": [
					"Une primitive de $\\cos$ est $\\sin$ (car $\\sin'=\\cos$) : $F(x)={{if:a==1|\\sin(x)}}{{if:a==-1|-\\sin(x)}}{{if:a!=1 && a!=-1|{{eval:a}}\\sin(x)}}+k$.",
					"$F(0)=k={{eval:y0}}$ car $\\sin(0)=0$.",
					"$F(x)=\\textcolor{{{color:primary.0}}}{{{if:a==1|\\sin(x)}}{{if:a==-1|-\\sin(x)}}{{if:a!=1 && a!=-1|{{eval:a}}\\sin(x)}}{{if:y0>0|+{{eval:y0}}}}{{if:y0<0|{{eval:y0}}}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)={{if:a==1|\\sin(x)}}{{if:a==-1|-\\sin(x)}}{{if:a!=1 && a!=-1|{{eval:a}}\\sin(x)}}$.\n\nDétermine la primitive $F$ de $f$ sur $\\mathbb{R}$ telle que $F(0)={{eval:y0}}$.\n\n$F(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "y0",
					"expression": "-5..5"
				}
			],
			"conditions": ["y0+a != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{if:-a==1|\\cos(x)}}{{if:-a==-1|-\\cos(x)}}{{if:-a!=1 && -a!=-1|{{eval:-a}}\\cos(x)}}{{if:y0+a>0|+{{eval:y0+a}}}}{{if:y0+a<0|{{eval:y0+a}}}}"
				}
			],
			"correction": {
				"steps": [
					"Une primitive de $\\sin$ est $-\\cos$ (car $\\cos'=-\\sin$) : $F(x)={{if:-a==1|\\cos(x)}}{{if:-a==-1|-\\cos(x)}}{{if:-a!=1 && -a!=-1|{{eval:-a}}\\cos(x)}}+k$.",
					"$F(0)={{eval:-a}}+k={{eval:y0}}$ car $\\cos(0)=1$, donc $k={{eval:y0+a}}$.",
					"$F(x)=\\textcolor{{{color:primary.0}}}{{{if:-a==1|\\cos(x)}}{{if:-a==-1|-\\cos(x)}}{{if:-a!=1 && -a!=-1|{{eval:-a}}\\cos(x)}}{{if:y0+a>0|+{{eval:y0+a}}}}{{if:y0+a<0|{{eval:y0+a}}}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\cos({{eval:w}}x)$.\n\nDétermine la primitive $F$ de $f$ sur $\\mathbb{R}$ telle que $F(0)=0$.\n\n$F(x)=?$",
			"variables": [
				{
					"name": "w",
					"expression": "2..6"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{1}{{{eval:w}}}\\sin({{eval:w}}x)"
				}
			],
			"correction": {
				"steps": [
					"La dérivée de $x\\mapsto\\sin({{eval:w}}x)$ est $x\\mapsto {{eval:w}}\\cos({{eval:w}}x)$ : il faut donc diviser par ${{eval:w}}$.",
					"$F(x)=\\dfrac{1}{{{eval:w}}}\\sin({{eval:w}}x)+k$ et $F(0)=k=0$.",
					"$F(x)=\\textcolor{{{color:primary.0}}}{\\dfrac{1}{{{eval:w}}}\\sin({{eval:w}}x)}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\sin({{eval:w}}x)$.\n\nDétermine la primitive $F$ de $f$ sur $\\mathbb{R}$ telle que $F(0)=0$.\n\n$F(x)=?$",
			"variables": [
				{
					"name": "w",
					"expression": "2..6"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "-\\frac{1}{{{eval:w}}}\\cos({{eval:w}}x)+\\frac{1}{{{eval:w}}}"
				}
			],
			"correction": {
				"steps": [
					"La dérivée de $x\\mapsto\\cos({{eval:w}}x)$ est $x\\mapsto -{{eval:w}}\\sin({{eval:w}}x)$ : une primitive de $f$ est $x\\mapsto -\\dfrac{1}{{{eval:w}}}\\cos({{eval:w}}x)$.",
					"$F(x)=-\\dfrac{1}{{{eval:w}}}\\cos({{eval:w}}x)+k$ et $F(0)=-\\dfrac{1}{{{eval:w}}}+k=0$, donc $k=\\dfrac{1}{{{eval:w}}}$.",
					"$F(x)=\\textcolor{{{color:primary.0}}}{-\\dfrac{1}{{{eval:w}}}\\cos({{eval:w}}x)+\\dfrac{1}{{{eval:w}}}}$."
				]
			}
		}
	],

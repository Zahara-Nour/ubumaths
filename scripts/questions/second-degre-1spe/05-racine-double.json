	"variations": [
		{
			"statement": "Calcule le discriminant du polynôme $P(x)={{eval:ax^2+bx+c}}$, puis détermine sa racine.\n\n$\\Delta=?$ et la racine est $x_0=?$.",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..4;±"
				},
				{
					"name": "r",
					"expression": "1..6;±"
				},
				{
					"name": "b",
					"expression": "eval:-2*a*r"
				},
				{
					"name": "c",
					"expression": "eval:a*r^2"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "0"
				},
				{
					"expectedAnswer": "{{eval:-b/(2*a)}}"
				}
			],
			"correction": {
				"steps": [
					"On identifie $a={{a}}$, $b={{b}}$ et $c={{c}}$.",
					"$$\\begin{align}\\Delta &= b^2-4ac \\\\ &= {{eval:b;()}}^2-4\\times{{eval:a;()}}\\times{{eval:c;()}} \\\\ &= {{eval:b^2}}{{eval:-4*a*c;+}} \\\\ &= 0\\end{align}$$",
					"$\\Delta=0$ : le polynôme a une seule racine, dite **racine double**.",
					"$$x_0=\\dfrac{-b}{2a}=\\dfrac{ {{eval:-b}} }{ {{eval:2*a}} }={{eval:-b/(2*a)}}$$"
				]
			}
		},
		{

					"expression": "10000..999000"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n+1}}",
					"rulesSuffice": true,
					"validationRules": [
						{
							"type": "range",
							"min": "{{n}}",
							"max": "100000000",
							"inclusive": false
						},
						{
							"type": "predicate",
							"predicate": "isInteger"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"Un nombre supérieur à ${{n}}$ est plus grand que ${{n}}$ : il vient après dans la suite des nombres.",
					"Par exemple ${{eval:n+1}}$ ou ${{eval:n+10}}$ : $${{eval:n+1}} > {{n}}$$"
				]
			}
		},

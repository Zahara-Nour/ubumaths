			"blanks": [
				{
					"expectedAnswer": "{{eval:n+1}}"
				}
			],
			"correction": {
				"steps": [
					"Le nombre qui suit, c'est celui qu'on écrit juste après en comptant : on avance de $1$.",
					"${{n}}$ se termine par ${{z}}$ chiffres $9$ : en avançant de $1$, ils deviennent tous des $0$ et le chiffre juste à leur gauche augmente de $1$.",
					"$${{n}} \\rightarrow \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		},
		{
			"statement": "Le nombre qui précède ${{n}}$ est $?$.",
			"variables": [
				{
					"name": "c",
					"expression": "5..6"
				},
				{
					"name": "z",
					"expression": "2..4"
				},
				{
					"name": "m",
					"expression": "eval:c-z"
				},
				{
					"name": "a",
					"expression": "digits:m"
				},
				{
					"name": "n",
					"expression": "eval:a*10^z"
				}
			],
			"conditions": ["mod(a,10)!=0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n-1}}"
				}
			],
			"correction": {
				"steps": [
					"Le nombre qui précède, c'est celui qu'on écrit juste avant en comptant : on recule de $1$.",
					"${{n}}$ se termine par ${{z}}$ zéros : en reculant de $1$, ils deviennent tous des $9$ et le chiffre juste à leur gauche diminue de $1$.",
					"$$\\textcolor{{{color:primary.0}}}{{{solution}}} \\rightarrow {{n}}$$"
				]
			}
		},
		{
			"statement": "Le nombre qui {{if:s==0|suit|précède}} ${{n}}$ est $?$.",
			"variables": [
				{
					"name": "c",
					"expression": "4..5"
				},
				{
					"name": "s",
					"expression": "0..1"
				},
				{
					"name": "n",
					"expression": "eval:10^c-1+s"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n+1-2*s}}"
				}
			],
			"correction": {
				"steps": [
					"{{if:s==0|Le nombre qui suit, c'est celui qu'on écrit juste après en comptant : on avance de $1$.|Le nombre qui précède, c'est celui qu'on écrit juste avant en comptant : on recule de $1$.}}",
					"{{if:s==0|Tous les chiffres de ${{n}}$ sont des $9$ : ils deviennent tous des $0$, et un $1$ apparaît devant. Le nombre a un chiffre de plus.|${{n}}$, c'est $1$ suivi de ${{c}}$ zéros : en reculant de $1$, les zéros deviennent des $9$ et le $1$ disparaît. Le nombre a un chiffre de moins.}}",
					"$${{if:s==0|{{n}} \\rightarrow \\textcolor{{{color:primary.0}}}{{{solution}}}|\\textcolor{{{color:primary.0}}}{{{solution}}} \\rightarrow {{n}}}}$$"
				]
			}
		}
	],

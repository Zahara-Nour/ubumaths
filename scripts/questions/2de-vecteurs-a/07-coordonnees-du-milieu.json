	"variations": [
		{
			"statement": "Dans un repère $(O\\,;\\vec{i},\\vec{j})$, on considère les points $A({{ax}}\\,;\\,{{ay}})$ et $B({{bx}}\\,;\\,{{by}})$.\n\nDonne les coordonnées du milieu $I$ du segment $[AB]$.\n\n$$I(?\\,;\\,?)$$",
			"variables": [
				{
					"name": "ax",
					"expression": "-9..9"
				},
				{
					"name": "ay",
					"expression": "-9..9"
				},
				{
					"name": "bx",
					"expression": "-9..9"
				},
				{
					"name": "by",
					"expression": "-9..9"
				}
			],
			"conditions": ["bx != ax", "by != ay", "mod(ax+bx, 2) != 0 || mod(ay+by, 2) != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:((ax)+(bx))/2}}"
				},
				{
					"expectedAnswer": "{{eval:((ay)+(by))/2}}"
				}
			],
			"correction": {
				"steps": [
					"Le milieu $I$ de $[AB]$ a pour coordonnées les **moyennes** de celles de $A$ et $B$ : $x_I=\\dfrac{x_A+x_B}{2}$ et $y_I=\\dfrac{y_A+y_B}{2}$.",
					"$x_I=\\dfrac{ {{ax}}+{{bx;()}} }{2}=\\textcolor{{{color:primary.0}}}{{{eval:((ax)+(bx))/2;d}}}$ et $y_I=\\dfrac{ {{ay}}+{{by;()}} }{2}=\\textcolor{{{color:primary.1}}}{{{eval:((ay)+(by))/2;d}}}$."
				]
			}
		},
		{
			"statement": "Dans un repère $(O\\,;\\vec{i},\\vec{j})$, on considère les points $A({{ax}}\\,;\\,{{ay}})$ et $I({{ix}}\\,;\\,{{iy}})$. Le point $I$ est le milieu du segment $[AB]$.\n\nDonne les coordonnées du point $B$.\n\n$$B(?\\,;\\,?)$$",
			"variables": [
				{
					"name": "ax",
					"expression": "-9..9"
				},
				{
					"name": "ay",
					"expression": "-9..9"
				},
				{
					"name": "ix",
					"expression": "-6..6"
				},
				{
					"name": "iy",
					"expression": "-6..6"
				}
			],
			"conditions": ["ix != ax", "iy != ay", "abs(2*(ix)-(ax)) <= 12", "abs(2*(iy)-(ay)) <= 12"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*(ix)-(ax)}}"
				},
				{
					"expectedAnswer": "{{eval:2*(iy)-(ay)}}"
				}
			],
			"correction": {
				"steps": [
					"Le milieu $I$ de $[AB]$ a pour coordonnées les **moyennes** de celles de $A$ et $B$ : $x_I=\\dfrac{x_A+x_B}{2}$ et $y_I=\\dfrac{y_A+y_B}{2}$. Ici on connaît $x_I$ et $x_A$ : on cherche $x_B$.",
					"$\\dfrac{ {{ax}}+x_B}{2}={{ix}}$, donc ${{ax}}+x_B={{eval:2*(ix)}}$ et $x_B={{eval:2*(ix)}}-{{ax;()}}=\\textcolor{{{color:primary.0}}}{{{eval:2*(ix)-(ax)}}}$.",
					"De même, $y_B={{eval:2*(iy)}}-{{ay;()}}=\\textcolor{{{color:primary.1}}}{{{eval:2*(iy)-(ay)}}}$."
				]
			}
		},
		{
			"statement": "Dans un repère $(O\\,;\\vec{i},\\vec{j})$, $ABCD$ est un parallélogramme, avec $A({{ax}}\\,;\\,{{ay}})$ et $C({{cx}}\\,;\\,{{cy}})$.\n\nDonne les coordonnées de son centre $O'$.\n\n$$O'(?\\,;\\,?)$$",
			"variables": [
				{
					"name": "ax",
					"expression": "-9..9"
				},
				{
					"name": "ay",
					"expression": "-9..9"
				},
				{
					"name": "cx",
					"expression": "-9..9"
				},
				{
					"name": "cy",
					"expression": "-9..9"
				}
			],
			"conditions": ["abs(cx-ax) >= 2", "abs(cy-ay) >= 2"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:((ax)+(cx))/2}}"
				},
				{
					"expectedAnswer": "{{eval:((ay)+(cy))/2}}"
				}
			],
			"correction": {
				"steps": [
					"Les diagonales d'un parallélogramme se coupent en leur milieu : le centre $O'$ est le milieu de $[AC]$.",
					"Le milieu $O'$ de $[AC]$ a pour coordonnées les **moyennes** de celles de $A$ et $C$ : $x_{O'}=\\dfrac{x_A+x_C}{2}$ et $y_{O'}=\\dfrac{y_A+y_C}{2}$.",
					"$x_{O'}=\\dfrac{ {{ax}}+{{cx;()}} }{2}=\\textcolor{{{color:primary.0}}}{{{eval:((ax)+(cx))/2;d}}}$ et $y_{O'}=\\dfrac{ {{ay}}+{{cy;()}} }{2}=\\textcolor{{{color:primary.1}}}{{{eval:((ay)+(cy))/2;d}}}$."
				]
			}
		}
	],

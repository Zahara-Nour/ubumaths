					"name": "v2",
					"expression": "-9..9"
				},
				{
					"name": "p",
					"expression": "2..4"
				},
				{
					"name": "q",
					"expression": "2..4;±"
				}
			],
			"conditions": [
				"abs(u1)+abs(u2) > 0",
				"abs(v1)+abs(v2) > 0",
				"abs(u1) <= 6",
				"abs(u2) <= 6",
				"abs(v1) <= 6",
				"abs(v2) <= 6"
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(p)*(u1)+(q)*(v1)}}"
				},
				{
					"expectedAnswer": "{{eval:(p)*(u2)+(q)*(v2)}}"
				}
			],
			"correction": {
				"steps": [
					"On calcule **coordonnée par coordonnée** : abscisse avec abscisse, ordonnée avec ordonnée. Chaque coordonnée est multipliée par le nombre devant le vecteur.",
					"$\\vec{w}\\begin{pmatrix}{{p}}\\times{{u1;()}}+{{q;()}}\\times{{v1;()}}\\\\{{p}}\\times{{u2;()}}+{{q;()}}\\times{{v2;()}}\\end{pmatrix}$",
					"$\\vec{w}\\textcolor{{{color:primary.0}}}{\\begin{pmatrix}{{eval:(p)*(u1)+(q)*(v1)}}\\\\{{eval:(p)*(u2)+(q)*(v2)}}\\end{pmatrix}}$"
				]
			}
		}
	],

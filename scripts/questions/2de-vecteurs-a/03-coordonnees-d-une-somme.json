	"variations": [
		{
			"statement": "Dans un repère $(O\\,;\\vec{i},\\vec{j})$, on considère les vecteurs $\\vec{u}\\begin{pmatrix}{{u1}}\\\\{{u2}}\\end{pmatrix}$ et $\\vec{v}\\begin{pmatrix}{{v1}}\\\\{{v2}}\\end{pmatrix}$.\n\nDonne les coordonnées du vecteur $\\vec{u}+\\vec{v}$.\n\n$$\\vec{u}+\\vec{v}\\begin{pmatrix}?\\\\?\\end{pmatrix}$$",
			"variables": [
				{
					"name": "u1",
					"expression": "-9..9"
				},
				{
					"name": "u2",
					"expression": "-9..9"
				},
				{
					"name": "v1",
					"expression": "-9..9"
				},
				{
					"name": "v2",
					"expression": "-9..9"
				}
			],
			"conditions": ["abs(u1)+abs(u2) > 0", "abs(v1)+abs(v2) > 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(u1)+(v1)}}"
				},
				{
					"expectedAnswer": "{{eval:(u2)+(v2)}}"
				}
			],
			"correction": {
				"steps": [
					"On calcule **coordonnée par coordonnée** : abscisse avec abscisse, ordonnée avec ordonnée.",
					"$\\vec{u}+\\vec{v}\\begin{pmatrix}{{u1}}+{{v1;()}}\\\\{{u2}}+{{v2;()}}\\end{pmatrix}$, soit $\\vec{u}+\\vec{v}\\textcolor{{{color:primary.0}}}{\\begin{pmatrix}{{eval:(u1)+(v1)}}\\\\{{eval:(u2)+(v2)}}\\end{pmatrix}}$."
				]

	"variations": [
		{
			"statement": "Résous dans $\\mathbb{R}$ l'équation $({{eval:a*x+b}})\\left(e^{ {{eval:c*x+d}} }-1\\right)=0$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "b",
					"expression": "1..6;±"
				},
				{
					"name": "c",
					"expression": "1..4;±"
				},
				{
					"name": "d",
					"expression": "1..6;±"
				}
			],
			"conditions": ["b*c != a*d", "1-d != 0", "(1-d)*a != -b*c"],
			"blanks": [
				{
					"expectedAnswer": "\\{ {{eval:-b/a}} ; {{eval:-d/c}} \\}",
					"expectedErrors": [
						{
							"answer": "\\{ {{eval:-b/a}} ; {{eval:(1-d)/c}} \\}",
							"message": "$e^{u}=1$ équivaut à $u=0$, car $1=e^0$.",
							"label": "e^u = 1 lu u = 1"
						},
						{
							"answer": "\\{ {{eval:-b/a}} \\}",
							"message": "Le facteur exponentiel peut aussi s'annuler : résous aussi cette équation.",
							"label": "Facteur exponentiel oublié"
						},
						{
							"answer": "\\{ {{eval:-d/c}} \\}",
							"message": "Le premier facteur s'annule aussi : n'oublie pas sa solution.",
							"label": "Facteur affine oublié"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"Un produit est nul si et seulement si l'un de ses facteurs est nul.",
					"${{eval:a*x+b}}=0\\iff x={{eval:-b/a}}$.",
					"$e^{ {{eval:c*x+d}} }-1=0\\iff e^{ {{eval:c*x+d}} }=e^0\\iff {{eval:c*x+d}}=0\\iff x={{eval:-d/c}}$.",
					"Donc $S=\\textcolor{{{color:primary.0}}}{\\left\\{ {{eval:-b/a}}\\,;{{eval:-d/c}}\\right\\} }$."
				]
			},
			"hint": "Un produit est nul si et seulement si l'un de ses facteurs est nul. Pour un facteur exponentiel, écris le second membre sous la forme $e^{\\cdots}$, ou souviens-toi que $e^{u}>0$."
		},

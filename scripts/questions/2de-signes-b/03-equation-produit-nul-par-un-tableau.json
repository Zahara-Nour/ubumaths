	"variations": [
		{
			"statement": "Voici le tableau de signes de $A(x)=({{a}}x{{b;+}})({{c}}x{{d;+}})$.\n\n```variation\nvariable: x\ndomain: -inf, {{ra}}, {{rb}}, +inf\n\nsign: {{if:a==-1|-|}}{{if:a*a>1|{{a}}|}}x{{b;+}}\n  -inf,{{ra}}: {{if:a>0|-|+}}\n  {{ra}}: z\n  {{ra}},{{rb}}: {{if:a>0|+|-}}\n  {{rb}},+inf: {{if:a>0|+|-}}\n\nsign: {{if:c==-1|-|}}{{if:c*c>1|{{c}}|}}x{{d;+}}\n  -inf,{{ra}}: {{if:c>0|-|+}}\n  {{ra}},{{rb}}: {{if:c>0|-|+}}\n  {{rb}}: z\n  {{rb}},+inf: {{if:c>0|+|-}}\n\nsign: A(x)\n  -inf,{{ra}}: {{if:ac>0|+|-}}\n  {{ra}}: z\n  {{ra}},{{rb}}: {{if:ac>0|-|+}}\n  {{rb}}: z\n  {{rb}},+inf: {{if:ac>0|+|-}}\n```\n\nRésous l'équation $A(x)=0$.\n\n$S=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..3;±"
				},
				{
					"name": "ra",
					"expression": "-6..6!0"
				},
				{
					"name": "b",
					"expression": "eval:-(a)*(ra)"

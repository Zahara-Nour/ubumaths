	"variations": [
		{
			"statement": "La variable aléatoire $X$ a pour densité la fonction $f$ définie sur $\\left[0\\,;{{a}}\\right]$ par $f(x)={{eval:2/a^2}}x$.\n\nCalcule $E(X)=\\displaystyle\\int_{0}^{ {{a}} }x f(x)\\,\\mathrm{d}x$.\n\n$E(X)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*a/3}}"
				}
			],
			"correction": {
				"steps": [
					"$x f(x)={{eval:2/a^2}}x^{2}$, de primitive ${{eval:2/(3*a^2)}}x^{3}$.",
					"$E(X)=\\left[{{eval:2/(3*a^2)}}x^{3}\\right]_{0}^{ {{a}} }={{eval:2/(3*a^2)}}\\times {{a}}^{3}=\\textcolor{{{color:primary.0}}}{{{eval:2*a/3}}}$."
				]
			}
		},
		{
			"statement": "La variable aléatoire $X$ a pour densité la fonction $f$ définie sur $\\left[0\\,;1\\right]$ par $f(x)={{eval:k+1}}x^{ {{k}} }$.\n\nCalcule son espérance.\n\n$E(X)=?$",
			"variables": [
				{
					"name": "k",
					"expression": "2..6"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(k+1)/(k+2)}}"
				}
			],
			"correction": {
				"steps": [
					"$E(X)=\\displaystyle\\int_{0}^{1}x\\times {{eval:k+1}}x^{ {{k}} }\\,\\mathrm{d}x=\\int_{0}^{1}{{eval:k+1}}x^{ {{eval:k+1}} }\\,\\mathrm{d}x$.",
					"$E(X)=\\left[\\dfrac{ {{eval:k+1}} }{ {{eval:k+2}} }x^{ {{eval:k+2}} }\\right]_{0}^{1}=\\textcolor{{{color:primary.0}}}{{{eval:(k+1)/(k+2)}}}$."
				]
			}
		},
		{
			"statement": "La variable aléatoire $X$ a pour densité la fonction $f$ définie sur $\\left[0\\,;{{a}}\\right]$ par $f(x)={{eval:3/a^3}}x^{2}$.\n\nCalcule son espérance.\n\n$E(X)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..8"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:3*a/4}}"
				}
			],
			"correction": {
				"steps": [
					"$E(X)=\\displaystyle\\int_{0}^{ {{a}} }{{eval:3/a^3}}x^{3}\\,\\mathrm{d}x=\\left[{{eval:3/(4*a^3)}}x^{4}\\right]_{0}^{ {{a}} }$.",
					"$E(X)={{eval:3/(4*a^3)}}\\times {{a}}^{4}=\\textcolor{{{color:primary.0}}}{{{eval:3*a/4}}}$."
				]
			}
		}
	],

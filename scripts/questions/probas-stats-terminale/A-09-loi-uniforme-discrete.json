{
	"title": "Loi uniforme sur {1, …, n} : probabilités et espérance",
	"description": "X uniforme sur {1, …, n} : P(X = k) = 1/n, P(X ⩽ k) = k/n, P(a ⩽ X ⩽ b) = (b − a + 1)/n, E(X) = (n + 1)/2 (pièges : n/2, b − a au lieu de b − a + 1)",
	"grades": ["T_COMP"],
	"points": ["TCOMP-084", "TCOMP-098"],
	"theme": "Probabilités",
	"domain": "Lois discrètes",
	"subdomain": "Loi uniforme",
	"level": 1,
	"status": "draft",
	"delay": 60,
	"shared": {
		"blankDefaults": {
			"acceptDecimal": true
		}
	},
	"variations": [
		{
			"statement": "La variable aléatoire $X$ suit la loi uniforme sur $\\{1, 2, \\ldots, {{n}}\\}$.\n\nCalcule son espérance.\n\n$E(X)=?$",
			"variables": [
				{
					"name": "n",
					"expression": "5..30"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(n+1)/2}}"
				}
			],
			"correction": {
				"steps": [
					"Pour la loi uniforme sur $\\{1, \\ldots, n\\}$ : $E(X)=\\dfrac{n+1}{2}$.",
					"$E(X)=\\dfrac{ {{n}}+1}{2}=\\textcolor{{{color:primary.0}}}{{{eval:(n+1)/2}}}$."
				]
			}
		},
		{
			"statement": "La variable aléatoire $X$ suit la loi uniforme sur $\\{1, 2, \\ldots, {{n}}\\}$.\n\nCalcule $P(X\\leqslant {{k}})$.\n\n$P(X\\leqslant {{k}})=?$",
			"variables": [
				{
					"name": "n",
					"expression": "6..20"
				},
				{
					"name": "k",
					"expression": "2..{{eval:n-1}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:k/n}}"
				}
			],
			"correction": {
				"steps": [
					"Chaque valeur a la probabilité $\\dfrac{1}{ {{n}} }$, et $X\\leqslant {{k}}$ regroupe les ${{k}}$ valeurs $1, \\ldots, {{k}}$.",
					"$P(X\\leqslant {{k}})=\\dfrac{ {{k}} }{ {{n}} }=\\textcolor{{{color:primary.0}}}{{{eval:k/n}}}$."
				]
			}
		},
		{
			"statement": "La variable aléatoire $X$ suit la loi uniforme sur $\\{1, 2, \\ldots, {{n}}\\}$.\n\nCalcule $P({{a}}\\leqslant X\\leqslant {{b}})$.\n\n$P({{a}}\\leqslant X\\leqslant {{b}})=?$",
			"variables": [
				{
					"name": "n",
					"expression": "10..20"
				},
				{
					"name": "a",
					"expression": "2..5"
				},
				{
					"name": "b",
					"expression": "{{eval:a+2}}..{{eval:n-1}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(b-a+1)/n}}"
				}
			],
			"correction": {
				"steps": [
					"De ${{a}}$ à ${{b}}$ inclus, il y a ${{b}}-{{a}}+1={{eval:b-a+1}}$ valeurs, chacune de probabilité $\\dfrac{1}{ {{n}} }$.",
					"$P({{a}}\\leqslant X\\leqslant {{b}})=\\dfrac{ {{eval:b-a+1}} }{ {{n}} }=\\textcolor{{{color:primary.0}}}{{{eval:(b-a+1)/n}}}$."
				]
			}
		},
		{
			"statement": "On lance un dé équilibré à ${{n}}$ faces numérotées de $1$ à ${{n}}$ et on gagne, en euros, le double du numéro obtenu.\n\nQuel est le gain moyen, en euros ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "4|6|8|10|12|20"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n+1}}"
				}
			],
			"correction": {
				"steps": [
					"Le numéro $X$ suit la loi uniforme sur $\\{1, \\ldots, {{n}}\\}$ : $E(X)=\\dfrac{ {{n}}+1}{2}={{eval:(n+1)/2;d}}$.",
					"Le gain est $2X$, donc $E(2X)=2E(X)=\\textcolor{{{color:primary.0}}}{{{eval:n+1}}}$ euros."
				]
			}
		}
	],

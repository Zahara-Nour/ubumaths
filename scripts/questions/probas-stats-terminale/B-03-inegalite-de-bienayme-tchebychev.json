			"correction": {
				"steps": [
					"L'intervalle $\\left]{{eval:m-d}}\\,;{{eval:m+d}}\\right[$ est centré en $\\mu={{m}}$ : ${{eval:m-d}}<X<{{eval:m+d}}\\iff\\left|X-{{m}}\\right|<{{d}}$.",
					"Donc $P\\left({{eval:m-d}}<X<{{eval:m+d}}\\right)\\geqslant 1-\\dfrac{ {{v}} }{ {{d}}^{2} }=\\textcolor{{{color:primary.0}}}{{{eval:1-v/d^2}}}$."
				]
			}
		},
		{
			"statement": "Une variable aléatoire $X$ a pour espérance $\\mu={{m}}$ et pour **écart type** $\\sigma={{s}}$.\n\nDonne le majorant de $P\\left(\\left|X-{{m}}\\right|\\geqslant {{d}}\\right)$ fourni par l'inégalité de Bienaymé-Tchebychev.\n\n$P\\left(\\left|X-{{m}}\\right|\\geqslant {{d}}\\right)\\leqslant ?$",
			"variables": [

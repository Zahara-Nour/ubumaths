					"expression": "1..5"
				},
				{
					"name": "d",
					"expression": "2..12"
				}
			],
			"conditions": [
				"s < d"
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:s^2/d^2}}"
				}
			],
			"correction": {
				"steps": [
					"La variance est le carré de l'écart type : $V(X)={{s}}^{2}={{eval:s^2}}$.",
					"$P\\left(\\left|X-{{m}}\\right|\\geqslant {{d}}\\right)\\leqslant\\dfrac{ {{eval:s^2}} }{ {{d}}^{2} }=\\textcolor{{{color:primary.0}}}{{{eval:s^2/d^2}}}$."
				]
			}
		}

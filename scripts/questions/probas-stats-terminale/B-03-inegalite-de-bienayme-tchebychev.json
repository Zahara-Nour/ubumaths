	"variations": [
		{
			"statement": "Une variable aléatoire $X$ a pour espérance $\\mu={{m}}$ et pour variance $V(X)={{v}}$.\n\nDonne le majorant de $P\\left(\\left|X-{{m}}\\right|\\geqslant {{d}}\\right)$ fourni par l'inégalité de Bienaymé-Tchebychev.\n\n$P\\left(\\left|X-{{m}}\\right|\\geqslant {{d}}\\right)\\leqslant ?$",
			"variables": [
				{
					"name": "m",
					"expression": "5..50"
				},
				{
					"name": "v",
					"expression": "1..20"
				},
				{
					"name": "d",
					"expression": "2..10"
				}
			],
			"conditions": [
				"v < d^2"
			],
			"blanks": [

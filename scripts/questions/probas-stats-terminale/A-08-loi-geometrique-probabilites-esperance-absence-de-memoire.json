	"variations": [
		{
			"statement": "La variable aléatoire $X$ suit la loi géométrique $\\mathcal{G}\\left(\\dfrac{1}{ {{q}} }\\right)$.\n\nCalcule $P(X={{k}})$.\n\n$P(X={{k}})=?$",
			"variables": [
				{
					"name": "q",
					"expression": "2..6"
				},
				{
					"name": "k",
					"expression": "2..4"
				},
				{
					"name": "h",
					"expression": "{{eval:k-1}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(1-1/q)^h/q}}"
				}
			],
			"correction": {
				"steps": [
					"$P(X=k)=(1-p)^{k-1}p$ : ${{eval:k-1}}$ échec{{if:k>2|s|}}, puis le premier succès.",
					"$P(X={{k}})=\\left(\\dfrac{ {{eval:q-1}} }{ {{q}} }\\right)^{ {{eval:k-1}} }\\times\\dfrac{1}{ {{q}} }=\\textcolor{{{color:primary.0}}}{{{eval:(1-1/q)^h/q}}}$."
				]
			}
		},
		{
			"statement": "La variable aléatoire $X$ suit la loi géométrique $\\mathcal{G}\\left(\\dfrac{1}{ {{q}} }\\right)$.\n\nCalcule $P(X\\leqslant {{k}})$.\n\n$P(X\\leqslant {{k}})=?$",
			"variables": [
				{
					"name": "q",
					"expression": "2..6"
				},
				{
					"name": "k",
					"expression": "2..4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:1-(1-1/q)^k}}"
				}
			],
			"correction": {
				"steps": [
					"$X>{{k}}$ signifie que les ${{k}}$ premières épreuves sont des échecs : $P(X>{{k}})=\\left(\\dfrac{ {{eval:q-1}} }{ {{q}} }\\right)^{ {{k}} }$.",
					"$P(X\\leqslant {{k}})=1-P(X>{{k}})=1-{{eval:(1-1/q)^k}}=\\textcolor{{{color:primary.0}}}{{{eval:1-(1-1/q)^k}}}$."
				]
			}
		},
		{
			"statement": "La variable aléatoire $X$ suit la loi géométrique de paramètre $p={{eval:t/10;d}}$.\n\nCalcule $P(X>{{k}})$ (nombre décimal).\n\n$P(X>{{k}})=?$",
			"variables": [
				{
					"name": "t",
					"expression": "1..9"
				},
				{
					"name": "k",
					"expression": "2..3"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(1-t/10)^k;d}}"
				}
			],
			"correction": {
				"steps": [
					"$X>{{k}}$ : les ${{k}}$ premières épreuves sont des échecs.",
					"$P(X>{{k}})=(1-p)^{ {{k}} }={{eval:1-t/10;d}}^{ {{k}} }=\\textcolor{{{color:primary.0}}}{{{eval:(1-t/10)^k;d}}}$."
				]
			}
		},
		{
			"statement": "À chaque tentative, un joueur réussit un exercice d'adresse avec la probabilité ${{eval:t/100;d}}$, indépendamment des autres tentatives. Il recommence jusqu'à la première réussite.\n\nCombien de tentatives lui faut-il en moyenne ?\n\n$?$",
			"variables": [
				{
					"name": "t",
					"expression": "2|4|5|8|10|20|25|40|50"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:100/t}}"
				}
			],
			"correction": {
				"steps": [
					"Le rang $X$ de la première réussite suit la loi géométrique de paramètre $p={{eval:t/100;d}}$, d'espérance $E(X)=\\dfrac{1}{p}$.",
					"$E(X)=\\dfrac{1}{ {{eval:t/100;d}} }=\\textcolor{{{color:primary.0}}}{{{eval:100/t;d}}}$ tentatives en moyenne."
				]
			}
		},
		{
			"statement": "La durée de vie $X$, en jours entiers, d'un composant suit la loi géométrique $\\mathcal{G}\\left(\\dfrac{1}{ {{q}} }\\right)$. Le composant fonctionne encore après ${{m}}$ jours.\n\nQuelle est la probabilité qu'il fonctionne encore après ${{eval:m+j}}$ jours ?\n\n$P_{(X>{{m}})}(X>{{eval:m+j}})=?$",
			"variables": [
				{
					"name": "q",
					"expression": "2..6"
				},
				{
					"name": "m",
					"expression": "3..9"
				},
				{
					"name": "j",
					"expression": "1..3"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(1-1/q)^j}}"
				}
			],
			"correction": {
				"steps": [
					"La loi géométrique est **sans mémoire** : $P_{(X>m)}(X>m+n)=P(X>n)$.",
					"$P_{(X>{{m}})}(X>{{eval:m+j}})=P(X>{{j}})=\\left(\\dfrac{ {{eval:q-1}} }{ {{q}} }\\right)^{ {{j}} }=\\textcolor{{{color:primary.0}}}{{{eval:(1-1/q)^j}}}$."
				]
			}
		}
	],

{
	"title": "Factorielle, arrangements et formule des coefficients binomiaux",
	"description": "n!, nombre de k-uplets d'éléments distincts, C(n, 2) = n(n − 1)/2 et C(n, 3) par la formule (pièges : n(n − 1) sans diviser par 2, C(n, 3) pour un podium ordonné)",
	"grades": ["T_SPE"],
	"points": ["TSPE-038", "TSPE-039", "TSPE-035", "TSPE-036", "TSPE-034", "TSPE-044"],
	"theme": "Probabilités",
	"domain": "Dénombrement",
	"subdomain": "Coefficients binomiaux",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"variations": [
		{
			"statement": "Calcule $\\binom{ {{n}} }{2}$.\n\n$\\binom{ {{n}} }{2}=?$",
			"variables": [
				{
					"name": "n",
					"expression": "6..30"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n*(n-1)/2}}"
				}
			],
			"correction": {
				"steps": [
					"$\\binom{n}{2}=\\dfrac{n(n-1)}{2}$.",
					"$\\binom{ {{n}} }{2}=\\dfrac{ {{n}}\\times{{eval:n-1}} }{2}=\\textcolor{{{color:primary.0}}}{{{eval:n*(n-1)/2}}}$."
				]
			}
		},
		{
			"statement": "Calcule $\\binom{ {{n}} }{3}$.\n\n$\\binom{ {{n}} }{3}=?$",
			"variables": [
				{
					"name": "n",
					"expression": "6..12"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n*(n-1)*(n-2)/6}}"
				}
			],
			"correction": {
				"steps": [
					"$\\binom{n}{3}=\\dfrac{n!}{3!\\,(n-3)!}=\\dfrac{n(n-1)(n-2)}{3!}$, avec $3!=6$.",
					"$\\binom{ {{n}} }{3}=\\dfrac{ {{n}}\\times{{eval:n-1}}\\times{{eval:n-2}} }{6}=\\textcolor{{{color:primary.0}}}{{{eval:n*(n-1)*(n-2)/6}}}$."
				]
			}
		},
		{
			"statement": "De combien de façons peut-on ranger ${{n}}$ livres différents sur une étagère ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "4..7"
				},
				{
					"name": "f",
					"expression": "{{eval:factorial(n)}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{f}}"
				}
			],
			"correction": {
				"steps": [
					"Un rangement est une permutation des ${{n}}$ livres : il y en a $n!$.",
					"${{n}}!=\\textcolor{{{color:primary.0}}}{{{f}}}$."
				]
			}
		},
		{
			"statement": "${{n}}$ coureurs participent à une course. Combien de podiums (premier, deuxième, troisième) sont possibles ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "5..12"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n*(n-1)*(n-2)}}"
				}
			],
			"correction": {
				"steps": [
					"Un podium est un triplet **ordonné** de coureurs distincts : ${{n}}$ choix pour le premier, ${{eval:n-1}}$ pour le deuxième, ${{eval:n-2}}$ pour le troisième.",
					"${{n}}\\times{{eval:n-1}}\\times{{eval:n-2}}=\\textcolor{{{color:primary.0}}}{{{eval:n*(n-1)*(n-2)}}}$ (et non $\\binom{ {{n}} }{3}$, qui compte les groupes de trois sans ordre)."
				]
			}
		}
	],

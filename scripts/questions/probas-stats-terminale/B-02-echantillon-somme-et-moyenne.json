{
	"title": "Échantillon de taille n : espérance et variance de Sₙ et Mₙ",
	"description": "Pour un échantillon (X₁, …, Xₙ) d'espérance μ et de variance V : E(Sₙ) = nμ, V(Sₙ) = nV, E(Mₙ) = μ, V(Mₙ) = V/n, σ(Mₙ) = σ/√n (pièges : V/n² ou n²V, σ/n)",
	"grades": [
		"T_SPE"
	],
	"points": [
		"TSPE-246",
		"TSPE-247",
		"TSPE-248",
		"TSPE-250"
	],
	"theme": "Probabilités",
	"domain": "Sommes de variables aléatoires",
	"subdomain": "Échantillons",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"shared": {
		"blankDefaults": {
			"acceptDecimal": true
		}
	},
	"variations": [
		{
			"statement": "$(X_1, \\ldots, X_{ {{n}} })$ est un échantillon de taille ${{n}}$ d'une loi d'espérance $\\mu={{eval:m/10;d}}$. On pose $S=X_1+\\cdots+X_{ {{n}} }$.\n\nCalcule $E(S)$.\n\n$E(S)=?$",
			"variables": [
				{
					"name": "n",
					"expression": "10|20|25|50|100"
				},
				{
					"name": "m",
					"expression": "5..80"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n*m/10}}"
				}
			],
			"correction": {
				"steps": [
					"Par linéarité, $E(S)=E(X_1)+\\cdots+E(X_{ {{n}} })=n\\mu$.",
					"$E(S)={{n}}\\times{{eval:m/10;d}}=\\textcolor{{{color:primary.0}}}{{{eval:n*m/10;d}}}$."
				]
			}
		},
		{
			"statement": "$(X_1, \\ldots, X_{ {{n}} })$ est un échantillon de taille ${{n}}$ d'une loi de variance $V={{v}}$. On pose $S=X_1+\\cdots+X_{ {{n}} }$.\n\nCalcule $V(S)$.\n\n$V(S)=?$",
			"variables": [
				{
					"name": "n",
					"expression": "5..30"
				},
				{
					"name": "v",
					"expression": "2..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n*v}}"
				}
			],
			"correction": {
				"steps": [
					"Les $X_i$ sont **indépendantes** : les variances s'ajoutent, $V(S)=nV$.",
					"$V(S)={{n}}\\times{{v}}=\\textcolor{{{color:primary.0}}}{{{eval:n*v}}}$."
				]
			}
		},
		{
			"statement": "$(X_1, \\ldots, X_{ {{n}} })$ est un échantillon de taille ${{n}}$ d'une loi de variance $V={{v}}$. On note $M=\\dfrac{X_1+\\cdots+X_{ {{n}} }}{ {{n}} }$ la moyenne de l'échantillon.\n\nCalcule $V(M)$.\n\n$V(M)=?$",
			"variables": [
				{
					"name": "n",
					"expression": "10|20|25|40|50|100"
				},
				{
					"name": "v",
					"expression": "2..12"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:v/n}}"
				}
			],
			"correction": {
				"steps": [
					"$V(M)=V\\left(\\dfrac{S}{n}\\right)=\\dfrac{1}{n^{2}}V(S)=\\dfrac{nV}{n^{2}}=\\dfrac{V}{n}$.",
					"$V(M)=\\dfrac{ {{v}} }{ {{n}} }=\\textcolor{{{color:primary.0}}}{{{eval:v/n}}}$."
				]
			}
		},
		{
			"statement": "$(X_1, \\ldots, X_{ {{n}} })$ est un échantillon de taille ${{n}}$ d'une loi d'écart type $\\sigma={{s}}$. On note $M$ la moyenne de l'échantillon.\n\nCalcule l'écart type $\\sigma(M)$.\n\n$\\sigma(M)=?$",
			"variables": [
				{
					"name": "n",
					"expression": "4|9|16|25|36|49|64|100"
				},
				{
					"name": "s",
					"expression": "1..12"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:s/sqrt(n)}}"
				}
			],
			"correction": {
				"steps": [
					"$V(M)=\\dfrac{\\sigma^{2}}{n}$, donc $\\sigma(M)=\\dfrac{\\sigma}{\\sqrt{n}}$.",
					"$\\sigma(M)=\\dfrac{ {{s}} }{\\sqrt{ {{n}} }}=\\dfrac{ {{s}} }{ {{eval:sqrt(n)}} }=\\textcolor{{{color:primary.0}}}{{{eval:s/sqrt(n)}}}$."
				]
			}
		}
	],

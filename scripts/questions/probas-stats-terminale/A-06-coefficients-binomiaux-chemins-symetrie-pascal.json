	"variations": [
		{
			"statement": "On représente par un arbre un schéma de Bernoulli de ${{n}}$ épreuves (succès $S$, échec $\\overline{S}$).\n\nCombien de chemins de cet arbre comportent exactement ${{k}}$ succès ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "3..5"
				},
				{
					"name": "k",
					"expression": "1..{{eval:n-1}}"
				},
				{
					"name": "c",
					"expression": "{{eval:binom(n,k)}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{c}}"
				}
			],
			"correction": {
				"steps": [
					"Le nombre de chemins à ${{k}}$ succès parmi ${{n}}$ épreuves est, par définition, le coefficient binomial $\\binom{ {{n}} }{ {{k}} }$.",
					"On peut les lister (un chemin = une position des ${{k}}$ succès parmi les ${{n}}$ épreuves) : $\\binom{ {{n}} }{ {{k}} }=\\textcolor{{{color:primary.0}}}{{{c}}}$."
				]
			}
		},
		{
			"statement": "On donne $\\binom{ {{n}} }{ {{k}} }={{c}}$.\n\nSans calcul, donne $\\binom{ {{n}} }{ {{eval:n-k}} }$.\n\n$\\binom{ {{n}} }{ {{eval:n-k}} }=?$",
			"variables": [
				{
					"name": "n",
					"expression": "8..20"
				},
				{
					"name": "k",
					"expression": "2..4"
				},
				{
					"name": "c",
					"expression": "{{eval:binom(n,k)}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{c}}"
				}
			],
			"correction": {
				"steps": [
					"Symétrie : $\\binom{n}{n-k}=\\binom{n}{k}$ (choisir les ${{k}}$ succès revient à choisir les ${{eval:n-k}}$ échecs).",
					"$\\binom{ {{n}} }{ {{eval:n-k}} }=\\binom{ {{n}} }{ {{k}} }=\\textcolor{{{color:primary.0}}}{{{c}}}$."
				]
			}
		},
		{
			"statement": "On donne $\\binom{ {{n}} }{ {{k}} }={{A}}$ et $\\binom{ {{n}} }{ {{eval:k+1}} }={{B}}$.\n\nSans autre calcul, donne $\\binom{ {{eval:n+1}} }{ {{eval:k+1}} }$.\n\n$\\binom{ {{eval:n+1}} }{ {{eval:k+1}} }=?$",
			"variables": [
				{
					"name": "n",
					"expression": "6..15"
				},
				{
					"name": "k",
					"expression": "1..2"
				},
				{
					"name": "A",
					"expression": "{{eval:binom(n,k)}}"
				},
				{
					"name": "B",
					"expression": "{{eval:binom(n,k+1)}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:A+B}}"
				}
			],
			"correction": {
				"steps": [
					"Relation de Pascal : $\\binom{n}{k}+\\binom{n}{k+1}=\\binom{n+1}{k+1}$.",
					"$\\binom{ {{eval:n+1}} }{ {{eval:k+1}} }={{A}}+{{B}}=\\textcolor{{{color:primary.0}}}{{{eval:A+B}}}$."
				]
			}
		},
		{
			"statement": "Donne les coefficients binomiaux suivants.\n\n$\\binom{ {{n}} }{0}=?$ ; $\\binom{ {{n}} }{1}=?$ ; $\\binom{ {{n}} }{ {{n}} }=?$",
			"variables": [
				{
					"name": "n",
					"expression": "5..40"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "1"
				},
				{
					"expectedAnswer": "{{n}}"
				},
				{
					"expectedAnswer": "1"
				}
			],
			"correction": {
				"steps": [
					"$\\binom{ {{n}} }{0}=\\textcolor{{{color:primary.0}}}{1}$ : un seul chemin sans succès (que des échecs).",
					"$\\binom{ {{n}} }{1}=\\textcolor{{{color:primary.0}}}{{{n}}}$ : le succès unique peut être à l'une des ${{n}}$ épreuves.",
					"$\\binom{ {{n}} }{ {{n}} }=\\textcolor{{{color:primary.0}}}{1}$ : un seul chemin où tout est succès."
				]
			}
		},
		{
			"statement": "La ligne $n={{n}}$ du triangle de Pascal donne, dans l'ordre, les coefficients $\\binom{ {{n}} }{0}$, $\\binom{ {{n}} }{1}$, …, $\\binom{ {{n}} }{ {{n}} }$ :\n\n$1$ ; ${{c1}}$ ; ${{c2}}$ ; ${{c3}}$ ; ${{c4}}$ ; ${{c5}}${{if:n>=6| ; ${{c6}}$|}}{{if:n>=7| ; ${{c7}}$|}}\n\nDéduis-en $\\binom{ {{eval:n+1}} }{ {{k}} }$.\n\n$\\binom{ {{eval:n+1}} }{ {{k}} }=?$",
			"variables": [
				{
					"name": "n",
					"expression": "5..7"
				},
				{
					"name": "c0",
					"expression": "1"
				},
				{
					"name": "c1",

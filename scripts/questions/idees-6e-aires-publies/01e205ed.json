			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(10*n+q)^2/100;d}}\\unit{cm^2}",
					"unit": {
						"expected": true
					},
					"expectedErrors": [
						{
							"answer": "{{eval:2*(n+q/10);d}}\\unit{cm^2}",
							"message": "L'aire n'est pas le double du côté : c'est le côté multiplié par lui-même.",
							"label": "Double du côté"
						},
						{
							"answer": "{{eval:(10*n+q)^2/10;d}}\\unit{cm^2}",
							"message": "La virgule est mal placée : avec un chiffre après la virgule dans chaque facteur, le produit en a deux.",
							"label": "Virgule décalée"
						},
						{
							"answer": "{{eval:(100*n*n+q*q)/100;d}}\\unit{cm^2}",
							"message": "On ne multiplie pas la partie entière et la partie décimale chacune de son côté : multiplie le nombre entier par lui-même.",
							"label": "Parties multipliées à part"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"$${{eval:n+q/10;d}} \\times {{eval:n+q/10;d}} = \\textcolor{{{color:primary.0}}}{{{eval:(10*n+q)^2/100;d}}~\\unit{cm^2}}$$",
					"Pour calculer : ${{eval:10*n+q}} \\times {{eval:10*n+q}} = {{eval:(10*n+q)^2}}$, puis deux chiffres après la virgule (un dans chaque facteur)."
				]
			},
			"hint": "Calcule ${{eval:10*n+q}} \\times {{eval:10*n+q}}$, puis place la virgule."
		}
	],

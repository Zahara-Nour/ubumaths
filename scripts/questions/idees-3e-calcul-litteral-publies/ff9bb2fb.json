			],
			"correction": {
				"steps": [
					"$$\\begin{align}                 {{eval:a^2}}-{{eval:(bc)^2}}               &=  {{a}}^2-({{eval:bc}})^2 \\\\               &= {{solution}}                \\end{align}$$"
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "({{eval:bc}}+{{a}})({{eval:bc}}-{{a}})"
				}
			],
			"statement": "Factorise.\n\n$${{expression2}}$$",
			"variables": [
				{
					"name": "expression2",
					"expression": "{{eval:(bc)^2}}-{{eval:a^2}}"
				}
			],
			"correction": {
				"steps": [
					"$$\\begin{align}                 {{eval:(bc)^2}} - {{eval:a^2}}               &=  ({{eval:bc}})^2 - {{a}}^2 \\\\               &= {{solution}}                \\end{align}$$"
				]
			}
		},
		{
			"statement": "Factorise le plus possible.\n\n$${{k}}{{c}}^2-{{eval:k*a^2}}$$\n\n$?$",
			"variables": [
				{
					"name": "k",
					"expression": "2..5"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{k}}({{c}}+{{a}})({{c}}-{{a}})",
					"expectedErrors": [
						{
							"answer": "({{c}}+{{a}})({{c}}-{{a}})",
							"message": "Tu as oublié le facteur commun ${{k}}$ : ton produit ne vaut pas l'expression.",
							"label": "Facteur k oublié"
						},
						{
							"answer": "{{k}}({{c}}-{{a}})^2",
							"message": "Une différence de deux carrés se factorise en un produit d'une somme par une différence, pas en un carré.",
							"label": "Carré au lieu de a² − b²"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"On met d'abord le facteur commun $\\textcolor{{{color:primary.0}}}{{{k}}}$ en facteur.",
					"$$\\begin{align} {{k}}{{c}}^2-{{eval:k*a^2}} &= \\textcolor{{{color:primary.0}}}{{{k}}}({{c}}^2-{{eval:a^2}}) \\\\ &= \\textcolor{{{color:primary.0}}}{{{k}}}({{c}}^2-{{a}}^2) \\\\ &= {{solution}} \\end{align}$$",
					"On a utilisé $a^2 - b^2 = (a + b)(a - b)$ : la factorisation est finie, il ne reste que des facteurs du premier degré et un nombre."
				]
			},
			"hint": "Commence par mettre en facteur le nombre commun aux deux termes, puis regarde ce qui reste."
		}
	],

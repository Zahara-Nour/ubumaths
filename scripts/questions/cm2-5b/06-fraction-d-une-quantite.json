	"variations": [
		{
			"statement": "Calcule $\\frac{{{m}}}{{{k}}}$ de ${{n}}$ {{if:o==0|œufs|{{if:o==1|billes|{{if:o==2|élèves|{{if:o==3|images|timbres}}}}}}}}.\n\n$\\frac{{{m}}}{{{k}}}$ de ${{n}}$ {{if:o==0|œufs|{{if:o==1|billes|{{if:o==2|élèves|{{if:o==3|images|timbres}}}}}}}}, c'est $?$ {{if:o==0|œufs|{{if:o==1|billes|{{if:o==2|élèves|{{if:o==3|images|timbres}}}}}}}}.",

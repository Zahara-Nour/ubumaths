				},
				{
					"name": "m",
					"expression": "2..{{eval:k-1}}"
				},
				{
					"name": "p",
					"expression": "2..10"
				},
				{
					"name": "n",
					"expression": "eval:k*p"
				},
				{
					"name": "o",
					"expression": "0..4"
				}
			],
			"conditions": ["gcd(m,k)==1"],
			"blanks": [

					"expression": "0..40"
				},
				{
					"name": "c",
					"expression": "eval:100*a+b+k-20"
				},
				{
					"name": "r",
					"expression": "eval:sign(100*a+b-c)+1"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{r}}"
				}
			],
			"correction": {
				"steps": [
					"On écrit les deux longueurs dans la même unité : ${{a}}~\\unit{m}~{{b}}~\\unit{cm} = {{eval:100*a}}~\\unit{cm} + {{b}}~\\unit{cm} = {{eval:100*a+b}}~\\unit{cm}$.",
					"$${{eval:100*a+b}}~\\unit{cm} {{if:r==0|<|{{if:r==1|=|>}}}} {{c}}~\\unit{cm}$$",
					"$${{a}}~\\unit{m}~{{b}}~\\unit{cm} \\textcolor{{{color:primary.0}}}{{{if:r==0|<|{{if:r==1|=|>}}}}} {{c}}~\\unit{cm}$$"
				]
			}
		},
		{
			"statement": "Compare ces deux longueurs.\n\n$$1~\\unit{km} \\quad \\ldots \\quad {{b}}~\\unit{m}$$\n\n```choix\nmelanger: non\n- $<$\n- $=$\n- $>$\n```",

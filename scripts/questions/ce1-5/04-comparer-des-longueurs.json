	"variations": [
		{
			"statement": "Compare ces deux longueurs.\n\n$${{a}}~\\unit{m} \\quad \\ldots \\quad {{b}}~\\unit{cm}$$\n\n```choix\nmelanger: non\n- $<$\n- $=$\n- $>$\n```",
			"variables": [
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "k",
					"expression": "0..18"
				},
				{
					"name": "b",
					"expression": "eval:100*a+10*(k-9)"
				},
				{
					"name": "r",
					"expression": "eval:sign(100*a-b)+1"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{r}}"
				}
			],
			"correction": {
				"steps": [
					"On écrit les deux longueurs dans la même unité : ${{a}}~\\unit{m} = {{eval:100*a}}~\\unit{cm}$.",
					"$${{eval:100*a}}~\\unit{cm} {{if:r==0|<|{{if:r==1|=|>}}}} {{b}}~\\unit{cm}$$",
					"$${{a}}~\\unit{m} \\textcolor{{{color:primary.0}}}{{{if:r==0|<|{{if:r==1|=|>}}}}} {{b}}~\\unit{cm}$$"
				]
			}
		},
		{
			"statement": "Compare ces deux longueurs.\n\n$${{a}}~\\unit{m}~{{b}}~\\unit{cm} \\quad \\ldots \\quad {{c}}~\\unit{cm}$$\n\n```choix\nmelanger: non\n- $<$\n- $=$\n- $>$\n```",
			"variables": [

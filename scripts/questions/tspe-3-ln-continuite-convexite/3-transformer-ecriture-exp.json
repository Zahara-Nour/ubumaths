	"variations": [
		{
			"statement": "Complète pour que l'égalité soit vraie pour tout réel $x$.\n\n$e^{ {{p}}x}-{{a}}e^{{{if:q==1|x|{{q}}x}}}=e^{{{if:q==1|x|{{q}}x}}}\\left(e^{?x}-{{a}}\\right)$",
			"blanks": [
				{
					"expectedAnswer": "{{eval:p-q}}"
				}
			],
			"correction": {
				"steps": [
					"$e^{ {{p}}x}=e^{{{if:q==1|x|{{q}}x}}+{{eval:p-q}}x}=e^{{{if:q==1|x|{{q}}x}}}\\times e^{ {{eval:p-q}}x}$ (équation fonctionnelle).",
					"On factorise par $e^{{{if:q==1|x|{{q}}x}}}$ : il manque $\\textcolor{{{color:primary.0}}}{{{eval:p-q}}}$ à l'exposant."
				]
			},
			"variables": [
				{
					"name": "p",
					"expression": "2..5"
				},
				{
					"name": "q",
					"expression": "1..4"
				},
				{
					"name": "a",
					"expression": "2..9"
				}
			],
			"conditions": ["q < p"]
		},
		{
			"statement": "Complète pour que l'égalité soit vraie pour tout réel $x$.\n\n$\\dfrac{e^{x}-{{a}}}{e^{x}+{{b}}}=\\dfrac{1-{{a}}e^{?}}{1+{{b}}e^{?}}$",
			"blanks": [
				{
					"expectedAnswer": "-x"
				},
				{
					"expectedAnswer": "-x"
				}
			],
			"correction": {
				"steps": [
					"On divise le numérateur et le dénominateur par $e^{x}\\neq 0$.",
					"$\\dfrac{ {{a}} }{e^{x}}={{a}}e^{-x}$, donc les deux cases valent $\\textcolor{{{color:primary.0}}}{-x}$."
				]
			},
			"variables": [
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "b",
					"expression": "1..9"
				}
			]
		},
		{
			"statement": "Complète pour que l'égalité soit vraie pour tout réel $x$.\n\n$\\left(e^{x}{{if:s>0|+|-}}e^{-x}\\right)^2=e^{2x}+?+e^{-2x}$",
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*s}}"
				}
			],
			"correction": {
				"steps": [
					"Identités remarquables : $(a+b)^2=a^2+2ab+b^2$ et $(a-b)^2=a^2-2ab+b^2$, ici avec $a=e^{x}$ et $b=e^{-x}$.",
					"$e^{x}\\times e^{-x}=e^{x-x}=e^{0}=1$, donc le double produit vaut $\\textcolor{{{color:primary.0}}}{{{eval:2*s}}}$."
				]
			},
			"variables": [
				{
					"name": "s",
					"expression": "-1|1"
				}
			]
		},
		{
			"statement": "Complète pour que l'égalité soit vraie pour tout réel $x$.\n\n$e^{x}{{if:s>0|+|-}}e^{-x}=\\dfrac{e^{2x}{{if:s>0|+|-}}1}{?}$",
			"blanks": [
				{
					"expectedAnswer": "e^{x}"
				}
			],
			"correction": {
				"steps": [
					"$e^{-x}=\\dfrac{1}{e^{x}}$ et $e^{x}=\\dfrac{e^{x}\\times e^{x}}{e^{x}}=\\dfrac{e^{2x}}{e^{x}}$.",
					"Au même dénominateur : $e^{x}{{if:s>0|+|-}}e^{-x}=\\dfrac{e^{2x}{{if:s>0|+|-}}1}{\\textcolor{{{color:primary.0}}}{e^{x}}}$."
				]
			},
			"variables": [
				{
					"name": "s",
					"expression": "-1|1"
				}
			]
		}
	],

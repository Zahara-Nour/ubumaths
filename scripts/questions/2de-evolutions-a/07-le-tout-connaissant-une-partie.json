{
	"title": "Calculer le tout connaissant une partie",
	"description": "Effectif total à partir d'une partie et de sa proportion (fraction, décimal ou pourcentage)",
	"grades": ["2"],
	"theme": "Proportionnalité",
	"domain": "Pourcentages",
	"subdomain": "Proportion",
	"level": 6,
	"delay": 60,
	"status": "draft",
	"shared": {
		"blankDefaults": {
			"acceptDecimal": true
		}
	},
	"variations": [
		{
			"statement": "${{eval:(a)*(m)}}$ adhérents d'un club ont moins de $18$ ans, ce qui représente ${{if:f==0|\\dfrac{ {{a}} }{ {{b}} }|{{if:f==1|{{eval:(a)/(b);d}}|{{eval:100*(a)/(b);d}}\\,\\%}}}}$ des adhérents.\n\nCombien le club compte-t-il d'adhérents ?\n\n$?$ adhérents",
			"variables": [
				{
					"name": "b",
					"expression": "4|5|8|10|20"
				},
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "m",
					"expression": "2..12"
				},
				{
					"name": "f",
					"expression": "0|1|2"
				}
			],
			"conditions": ["a < b", "gcd(a,b) == 1"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(b)*(m)}}"
				}
			],
			"correction": {
				"steps": [
					"Partie $=$ proportion $\\times$ tout, donc tout $=\\dfrac{\\text{partie}}{\\text{proportion}}$.",
					"Ici la proportion vaut $\\dfrac{ {{a}} }{ {{b}} }$ : $\\dfrac{ {{eval:(a)*(m)}} }{ \\frac{ {{a}} }{ {{b}} } }={{eval:(a)*(m)}}\\times\\dfrac{ {{b}} }{ {{a}} }=\\textcolor{{{color:primary.0}}}{{{eval:(b)*(m)}}}$ adhérents.",
					"Vérification : $\\dfrac{ {{eval:(a)*(m)}} }{ {{eval:(b)*(m)}} }=\\dfrac{ {{a}} }{ {{b}} }$."
				]
			}
		}
	],

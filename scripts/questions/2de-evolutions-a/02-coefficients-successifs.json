{
	"title": "Coefficients multiplicateurs successifs",
	"description": "Le coefficient global de deux évolutions successives est le produit des coefficients ; retrouver un coefficient manquant",
	"grades": ["2"],
	"theme": "Proportionnalité",
	"domain": "Pourcentages",
	"subdomain": "Coefficient",
	"level": 4,
	"delay": 60,
	"status": "draft",
	"shared": {
		"blankDefaults": {
			"acceptDecimal": true
		}
	},
	"variations": [
		{
			"statement": "Une grandeur est multipliée par ${{eval:c1;d}}$, puis le résultat est multiplié par ${{eval:c2;d}}$.\n\nPar quel nombre la grandeur de départ est-elle multipliée en tout ?\n\nCoefficient multiplicateur global : $?$",
			"variables": [
				{
					"name": "c1",
					"expression": "1.1|1.2|1.25|1.5|2|0.9|0.8|0.75|0.6|0.5"
				},
				{
					"name": "c2",
					"expression": "1.1|1.2|1.25|1.5|2|0.9|0.8|0.75|0.6|0.5"
				}
			],
			"conditions": ["c1 != c2"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(c1)*(c2);d}}"
				}
			],
			"correction": {
				"steps": [
					"Des évolutions successives se composent en **multipliant les coefficients multiplicateurs**.",
					"$C={{eval:c1;d}}\\times {{eval:c2;d}}=\\textcolor{{{color:primary.0}}}{{{eval:(c1)*(c2);d}}}$."
				]
			}
		},
		{
			"statement": "Une grandeur est multipliée par ${{eval:c1;d}}$, puis par un nombre $k$. Au total, elle est multipliée par ${{eval:(c1)*(c2);d}}$.\n\nQuelle est la valeur de $k$ ?\n\n$k=?$",
			"variables": [
				{
					"name": "c1",
					"expression": "1.1|1.2|1.25|1.5|2|0.9|0.8|0.75|0.6|0.5"
				},
				{
					"name": "c2",
					"expression": "1.1|1.2|1.25|1.5|2|0.9|0.8|0.75|0.6|0.5"
				}
			],
			"conditions": ["c1 != c2"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:c2;d}}"
				}
			],
			"correction": {
				"steps": [
					"Le coefficient global est le produit des coefficients : ${{eval:c1;d}}\\times k={{eval:(c1)*(c2);d}}$.",
					"Donc $k=\\dfrac{ {{eval:(c1)*(c2);d}} }{ {{eval:c1;d}} }=\\textcolor{{{color:primary.0}}}{{{eval:c2;d}}}$."
				]
			}
		}
	],

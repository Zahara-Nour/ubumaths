	"variations": [
		{
			"statement": "Augmenter une quantité de ${{t}}~\\%$, c'est la multiplier par :\n\n$$?$$",
			"variables": [
				{
					"name": "t",
					"expression": "5|7|10|15|20|25|40|50|100"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:1+t/100;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Coefficient multiplicateur.** Augmenter de $t~\\%$, c'est multiplier par $1 + \\dfrac{t}{100}$.",
					"$$1 + \\frac{{{t}}}{100} = 1 + {{eval:t/100;d}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		},
		{
			"statement": "Un article coûte ${{P}}~\\unit{€}$. Son prix augmente de ${{t}}~\\%$.\n\nCalcule le nouveau prix à l'aide du coefficient multiplicateur.\n\n$$?~\\text{€}$$",
			"variables": [
				{
					"name": "t",
					"expression": "10|20|30|5|15|25"
				},
				{
					"name": "j",
					"expression": "2..30"
				},
				{
					"name": "P",
					"expression": "eval:10*j"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:P*(1+t/100);d}}"
				}
			],
			"correction": {
				"steps": [
					"**Coefficient multiplicateur.** Augmenter de $t~\\%$, c'est multiplier par $1 + \\dfrac{t}{100}$.",
					"Le coefficient multiplicateur est $1 + \\frac{{{t}}}{100} = {{eval:1+t/100;d}}$.",
					"$${{P}} \\times {{eval:1+t/100;d}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		},
		{
			"statement": "Multiplier une quantité par ${{x}}$, c'est l'augmenter de :\n\n$$?~\\%$$",
			"variables": [
				{
					"name": "K",
					"expression": "103|108|112|115|125|135|140|160"
				},
				{
					"name": "x",
					"expression": "eval:K/100;d"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:K-100}}"
				}
			],
			"correction": {
				"steps": [
					"**Coefficient multiplicateur.** Augmenter de $t~\\%$, c'est multiplier par $1 + \\dfrac{t}{100}$.",
					"$${{x}} = 1 + {{eval:(K-100)/100;d}} = 1 + \\frac{\\textcolor{{{color:primary.0}}}{{{solution}}}}{100}$$",
					"C'est une augmentation de $\\textcolor{{{color:primary.0}}}{{{solution}}~\\%}$."
				]
			}
		}
	],

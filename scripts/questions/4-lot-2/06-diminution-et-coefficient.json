{
	"title": "Diminution et coefficient multiplicateur",
	"description": "Traduire une diminution de t % par le coefficient 1 − t/100 : − 20 % → × 0,8 ; 120 € diminué de 20 % ; × 0,85 → − 15 %",
	"grades": ["4"],
	"theme": "Proportionnalité",
	"domain": "Pourcentages",
	"subdomain": "Coefficient",
	"level": 3,
	"delay": 30,
	"status": "draft",
	"variations": [
		{
			"statement": "Diminuer une quantité de ${{t}}~\\%$, c'est la multiplier par :\n\n$$?$$",
			"variables": [
				{
					"name": "t",
					"expression": "5|10|15|20|25|30|40|50|75"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:1-t/100;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Coefficient multiplicateur.** Diminuer de $t~\\%$, c'est multiplier par $1 - \\dfrac{t}{100}$.",
					"$$1 - \\frac{{{t}}}{100} = 1 - {{eval:t/100;d}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		},
		{
			"statement": "Un article coûte ${{P}}~\\unit{€}$. Son prix baisse de ${{t}}~\\%$.\n\nCalcule le nouveau prix à l'aide du coefficient multiplicateur.\n\n$$?~\\text{€}$$",
			"variables": [
				{
					"name": "t",
					"expression": "10|20|30|5|15|25"
				},
				{
					"name": "j",
					"expression": "2..30"
				},
				{
					"name": "P",
					"expression": "eval:10*j"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:P*(1-t/100);d}}"
				}
			],
			"correction": {
				"steps": [
					"**Coefficient multiplicateur.** Diminuer de $t~\\%$, c'est multiplier par $1 - \\dfrac{t}{100}$.",
					"Le coefficient multiplicateur est $1 - \\frac{{{t}}}{100} = {{eval:1-t/100;d}}$.",
					"$${{P}} \\times {{eval:1-t/100;d}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		},
		{
			"statement": "Multiplier une quantité par ${{x}}$, c'est la diminuer de :\n\n$$?~\\%$$",
			"variables": [
				{
					"name": "K",
					"expression": "97|92|85|80|75|65|60|40"
				},
				{
					"name": "x",
					"expression": "eval:K/100;d"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:100-K}}"
				}
			],
			"correction": {
				"steps": [
					"**Coefficient multiplicateur.** Diminuer de $t~\\%$, c'est multiplier par $1 - \\dfrac{t}{100}$.",
					"$${{x}} = 1 - {{eval:(100-K)/100;d}} = 1 - \\frac{\\textcolor{{{color:primary.0}}}{{{solution}}}}{100}$$",
					"C'est une diminution de $\\textcolor{{{color:primary.0}}}{{{solution}}~\\%}$."
				]
			}
		}
	],

{
	"title": "Retrouver la valeur initiale avant une évolution",
	"description": "Prix avant une hausse ou une baisse en pourcentage",
	"grades": ["1_SPE"],
	"theme": "Proportionnalité",
	"domain": "Pourcentages",
	"subdomain": "Variations",
	"level": 8,
	"delay": 30,
	"status": "draft",
	"variations": [
		{
			"statement": "Après une hausse de ${{t}}\\,\\%$, un article coûte ${{eval:v*(1+t/100);d}}$ €. Donne le prix initial.\n\nLe prix initial est $?$ €.",
			"variables": [
				{
					"name": "k",
					"expression": "2..30"
				},
				{
					"name": "v",
					"expression": "eval:10*k"
				},
				{
					"name": "t",
					"expression": "5|10|15|20|25|30|40|50|60|75"
				},
				{
					"name": "p",
					"expression": "eval:v*(1+t/100)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{v}}"
				}
			],
			"correction": {
				"steps": [
					"Le coefficient multiplicateur associé à une hausse de ${{t}}\\,\\%$ est $1+\\dfrac{ {{t}} }{100}={{eval:1+t/100;d}}$.",
					"Prix initial $\\times {{eval:1+t/100;d}} = {{eval:v*(1+t/100);d}}$ : pour retrouver le prix initial, on divise par le coefficient multiplicateur.",
					"Le prix initial est $\\dfrac{ {{eval:v*(1+t/100);d}} }{ {{eval:1+t/100;d}} }={{v}}$ €."
				]
			}
		},
		{
			"statement": "Après une baisse de ${{t}}\\,\\%$, un article coûte ${{eval:v*(1-t/100);d}}$ €. Donne le prix initial.\n\nLe prix initial est $?$ €.",
			"variables": [
				{
					"name": "k",
					"expression": "2..30"
				},
				{
					"name": "v",
					"expression": "eval:10*k"
				},
				{
					"name": "t",
					"expression": "5|10|15|20|25|30|40|50|60|75"
				},
				{
					"name": "p",
					"expression": "eval:v*(1-t/100)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{v}}"
				}
			],
			"correction": {
				"steps": [
					"Le coefficient multiplicateur associé à une baisse de ${{t}}\\,\\%$ est $1-\\dfrac{ {{t}} }{100}={{eval:1-t/100;d}}$.",
					"Prix initial $\\times {{eval:1-t/100;d}} = {{eval:v*(1-t/100);d}}$ : pour retrouver le prix initial, on divise par le coefficient multiplicateur.",
					"Le prix initial est $\\dfrac{ {{eval:v*(1-t/100);d}} }{ {{eval:1-t/100;d}} }={{v}}$ €."
				]
			}
		}
	],

{
	"title": "Trouver le taux d'évolution réciproque",
	"description": "Évolution qui ramène à la valeur initiale",
	"grades": ["1_SPE"],
	"points": [],
	"theme": "Proportionnalité",
	"domain": "Pourcentages",
	"subdomain": "Variations",
	"level": 9,
	"delay": 30,
	"status": "draft",
	"variations": [
		{
			"statement": "Une grandeur subit une hausse de ${{t}}\\,\\%$. Donne le taux d'évolution (en %) qui la ramène à sa valeur initiale.\n\nLe taux d'évolution réciproque est $?$.",
			"variables": [
				{
					"name": "t",
					"expression": "25|60|100|150|300|400|900"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:-100*t/(100+t);d}}%"
				}
			],
			"correction": {
				"steps": [
					"Le coefficient multiplicateur de la hausse est $1+\\dfrac{ {{t}} }{100}={{eval:1+t/100;d}}$.",
					"Le coefficient multiplicateur réciproque est son inverse : $\\dfrac{1}{ {{eval:1+t/100;d}} }={{eval:100/(100+t);d}}$.",
					"Or ${{eval:100/(100+t);d}}=1-{{eval:t/(100+t);d}}$, donc le taux d'évolution réciproque est ${{eval:-100*t/(100+t);d}}\\,\\%$ (une baisse de ${{eval:100*t/(100+t);d}}\\,\\%$)."
				]
			}
		},
		{
			"statement": "Une grandeur subit une baisse de ${{t}}\\,\\%$. Donne le taux d'évolution (en %) qui la ramène à sa valeur initiale.\n\nLe taux d'évolution réciproque est $?$.",
			"variables": [
				{
					"name": "t",
					"expression": "20|50|60|75|80|90"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:100*t/(100-t);d}}%"
				}
			],
			"correction": {
				"steps": [
					"Le coefficient multiplicateur de la baisse est $1-\\dfrac{ {{t}} }{100}={{eval:1-t/100;d}}$.",
					"Le coefficient multiplicateur réciproque est son inverse : $\\dfrac{1}{ {{eval:1-t/100;d}} }={{eval:100/(100-t);d}}$.",
					"Or ${{eval:100/(100-t);d}}=1+{{eval:t/(100-t);d}}$, donc le taux d'évolution réciproque est $+{{eval:100*t/(100-t);d}}\\,\\%$ (une hausse de ${{eval:100*t/(100-t);d}}\\,\\%$)."
				]
			}
		},
		{
			"statement": "Une grandeur subit une hausse de ${{t}}\\,\\%$. Donne le taux d'évolution (en %) qui la ramène à sa valeur initiale, arrondi à $0{,}1\\,\\%$ près.\n\nLe taux d'évolution réciproque est environ $?$.",
			"variables": [
				{
					"name": "t",
					"expression": "10|15|30|35|40|45|70|80"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:round(-1000*t/(100+t))/10;d}}%"
				}
			],
			"correction": {
				"steps": [
					"Le coefficient multiplicateur de la hausse est $1+\\dfrac{ {{t}} }{100}={{eval:1+t/100;d}}$.",
					"Le coefficient multiplicateur réciproque est son inverse : $\\dfrac{1}{ {{eval:1+t/100;d}} }\\approx{{eval:round(1000000/(100+t))/10000;d}}$.",
					"Le taux d'évolution réciproque est donc $\\dfrac{1}{ {{eval:1+t/100;d}} }-1\\approx{{eval:round(-10000*t/(100+t))/10000;d}}$, soit environ ${{eval:round(-1000*t/(100+t))/10;d}}\\,\\%$ (arrondi à $0{,}1\\,\\%$ près)."
				]
			}
		}
	],

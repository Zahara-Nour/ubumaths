	"variations": [
		{
			"statement": "Une grandeur augmente de ${{a}}\\,\\%$ puis diminue de ${{b}}\\,\\%$. Donne le coefficient multiplicateur global, puis le taux d'évolution global.\n\nLe coefficient multiplicateur global est $?$.\n\nLe taux d'évolution global est $?$.",
			"variables": [
				{
					"name": "a",
					"expression": "5|10|15|20|25|30|40|50"
				},
				{
					"name": "b",
					"expression": "5|10|15|20|25|30|40|50"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(1+a/100)*(1-b/100);d}}"
				},
				{
					"expectedAnswer": "{{eval:(100+a)*(100-b)/100-100;d}}%"
				}
			],
			"correction": {
				"steps": [
					"Les coefficients multiplicateurs sont $1+\\dfrac{ {{a}} }{100}={{eval:1+a/100;d}}$ et $1-\\dfrac{ {{b}} }{100}={{eval:1-b/100;d}}$.",
					"Le coefficient multiplicateur global est leur produit : ${{eval:1+a/100;d}}\\times{{eval:1-b/100;d}}={{eval:(1+a/100)*(1-b/100);d}}$.",
					"${{eval:(1+a/100)*(1-b/100);d}}-1={{eval:(100+a)*(100-b)/10000-1;d}}$, donc le taux d'évolution global est ${{eval:(100+a)*(100-b)/100-100;d,+}}\\,\\%$ (et non ${{eval:a-b;+}}\\,\\%$ : les taux ne s'additionnent pas)."
				]
			},
			"conditions": ["(100+a)*(100-b)!=10000", "mod(a*b,10)!=5"]
		},
		{
			"statement": "Une grandeur diminue de ${{a}}\\,\\%$ puis augmente de ${{b}}\\,\\%$. Donne le coefficient multiplicateur global, puis le taux d'évolution global.\n\nLe coefficient multiplicateur global est $?$.\n\nLe taux d'évolution global est $?$.",

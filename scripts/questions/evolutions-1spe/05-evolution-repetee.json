	"variations": [
		{
			"statement": "Une grandeur augmente de ${{t}}\\,\\%$ par an pendant ${{n}}$ ans. Donne le coefficient multiplicateur global.\n\nLe coefficient multiplicateur global est $?$.",
			"variables": [
				{
					"name": "t",
					"expression": "1|2|3|4|5|10"
				},
				{
					"name": "n",
					"expression": "2..10"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:1+t/100;d}}^{ {{n}} }",
					"acceptDecimal": true
				}
			],
			"correction": {
				"steps": [
					"Chaque année, la grandeur est multipliée par $1+\\dfrac{ {{t}} }{100}={{eval:1+t/100;d}}$.",
					"Au bout de ${{n}}$ ans, elle est multipliée ${{n}}$ fois par ${{eval:1+t/100;d}}$ : le coefficient multiplicateur global est ${{eval:1+t/100;d}}^{ {{n}} }$ (c'est le terme d'une suite géométrique de raison ${{eval:1+t/100;d}}$).",
					"Attention : ce n'est pas $1+\\dfrac{ {{n}}\\times{{t}} }{100}={{eval:1+n*t/100;d}}$, les taux ne s'additionnent pas."
				]
			}
		},
		{
			"statement": "Une grandeur diminue de ${{t}}\\,\\%$ par an pendant ${{n}}$ ans. Donne le coefficient multiplicateur global.\n\nLe coefficient multiplicateur global est $?$.",
			"variables": [
				{
					"name": "t",
					"expression": "1|2|3|4|5|10|20"
				},
				{
					"name": "n",
					"expression": "2..10"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:1-t/100;d}}^{ {{n}} }",
					"acceptDecimal": true
				}
			],
			"correction": {
				"steps": [
					"Chaque année, la grandeur est multipliée par $1-\\dfrac{ {{t}} }{100}={{eval:1-t/100;d}}$.",
					"Au bout de ${{n}}$ ans, elle est multipliée ${{n}}$ fois par ${{eval:1-t/100;d}}$ : le coefficient multiplicateur global est ${{eval:1-t/100;d}}^{ {{n}} }$ (c'est le terme d'une suite géométrique de raison ${{eval:1-t/100;d}}$).",
					"Attention : ce n'est pas $1-\\dfrac{ {{n}}\\times{{t}} }{100}={{eval:1-n*t/100;d}}$, les taux ne s'additionnent pas."
				]
			}
		}
	],

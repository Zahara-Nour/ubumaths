	"variations": [
		{
			"statement": "Un prix de ${{v}}$ € augmente de ${{t}}\\,\\%$. Donne le nouveau prix.\n\nLe nouveau prix est $?$ €.",
			"variables": [
				{
					"name": "k",
					"expression": "2..30"
				},
				{
					"name": "v",
					"expression": "eval:10*k"
				},
				{
					"name": "t",
					"expression": "5|10|15|20|25|30|40|50|60|75"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:v*(1+t/100);d}}"
				}
			],
			"correction": {
				"steps": [
					"Le coefficient multiplicateur associé à une hausse de ${{t}}\\,\\%$ est $1+\\dfrac{ {{t}} }{100}={{eval:1+t/100;d}}$.",
					"Le nouveau prix est ${{v}}\\times{{eval:1+t/100;d}}={{eval:v*(1+t/100);d}}$ €."
				]
			}
		},
		{
			"statement": "Un prix de ${{v}}$ € baisse de ${{t}}\\,\\%$. Donne le nouveau prix.\n\nLe nouveau prix est $?$ €.",
			"variables": [
				{
					"name": "k",
					"expression": "2..30"
				},
				{
					"name": "v",
					"expression": "eval:10*k"
				},
				{
					"name": "t",
					"expression": "5|10|15|20|25|30|40|50|60|75"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:v*(1-t/100);d}}"
				}
			],
			"correction": {
				"steps": [
					"Le coefficient multiplicateur associé à une baisse de ${{t}}\\,\\%$ est $1-\\dfrac{ {{t}} }{100}={{eval:1-t/100;d}}$.",
					"Le nouveau prix est ${{v}}\\times{{eval:1-t/100;d}}={{eval:v*(1-t/100);d}}$ €."
				]
			}
		}
	],

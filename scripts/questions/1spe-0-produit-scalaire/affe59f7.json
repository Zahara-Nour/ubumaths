	"variations": [
		{
			"blanks": [
				{
					"expectedAnswer": "{{R}}"
				}
			],
			"statement": "Deux vecteurs $\\vec{u}$ et $\\vec{v}$ vérifient $\\|\\vec{u}\\|={{a}}$, $\\|\\vec{v}\\|={{b}}$ et $\\|\\vec{u}+\\vec{v}\\|={{c}}$.\n\nCalcule $\\vec{u}\\cdot\\vec{v}$. Donne la valeur exacte.\n\n$\\vec{u}\\cdot\\vec{v}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..6"
				},
				{
					"name": "b",
					"expression": "2..6"
				},
				{
					"name": "c",
					"expression": "2..9"
				},
				{
					"name": "R",
					"expression": "{{eval:(c^2-a^2-b^2)/2}}"
				}
			],
			"conditions": ["c > abs(a-b)", "c < a+b", "c^2 != a^2+b^2"],
			"correction": {
				"steps": [
					"Par bilinéarité, $\\|\\vec{u}+\\vec{v}\\|^2=\\|\\vec{u}\\|^2+2\\,\\vec{u}\\cdot\\vec{v}+\\|\\vec{v}\\|^2$.",
					"Donc $\\vec{u}\\cdot\\vec{v}=\\dfrac{1}{2}\\left(\\|\\vec{u}+\\vec{v}\\|^2-\\|\\vec{u}\\|^2-\\|\\vec{v}\\|^2\\right)$.",
					"$\\vec{u}\\cdot\\vec{v}=\\dfrac{1}{2}\\left({{eval:c^2}}-{{eval:a^2}}-{{eval:b^2}}\\right)=\\dfrac{ {{eval:c^2-a^2-b^2}} }{2}=\\textcolor{{{color:primary.0}}}{ {{R}} }$"
				]
			}
		}
	],

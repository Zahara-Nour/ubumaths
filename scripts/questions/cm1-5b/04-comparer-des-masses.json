					"$${{eval:a+t/10;d}}~\\unit{t} \\textcolor{{{color:primary.0}}}{{{if:r==0|<|{{if:r==1|=|>}}}}} {{c}}~\\unit{kg}$$"
				]
			}
		},
		{
			"statement": "Range ces masses de la plus légère à la plus lourde.\n\n```ranger\nsigne: <\n- ${{eval:1000*b-250}}~\\unit{g}$\n- ${{eval:b-0.1;d}}~\\unit{kg}$\n- ${{eval:10*b+1}}~\\unit{hg}$\n```",
			"variables": [
				{
					"name": "b",
					"expression": "2..9"
				}
			],
			"correction": {
				"steps": [
					"On écrit toutes les masses en grammes : ${{eval:b-0.1;d}}~\\unit{kg} = {{eval:1000*b-100}}~\\unit{g}$ et ${{eval:10*b+1}}~\\unit{hg} = {{eval:1000*b+100}}~\\unit{g}$, car $1~\\unit{hg} = 100~\\unit{g}$.",
					"$${{eval:1000*b-250}}~\\unit{g} < {{eval:1000*b-100}}~\\unit{g} < {{eval:1000*b+100}}~\\unit{g}$$"
				]
			}
		},
		{
			"statement": "Range ces masses de la plus lourde à la plus légère.\n\n```ranger\nsigne: >\n- ${{eval:10*b+1}}~\\unit{hg}$\n- ${{eval:b-0.1;d}}~\\unit{kg}$\n- ${{eval:1000*b-250}}~\\unit{g}$\n```",
			"variables": [
				{
					"name": "b",
					"expression": "2..9"

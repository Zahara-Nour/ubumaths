{
	"title": "Comparer des masses d'unités différentes",
	"description": "1,5 kg et 1 200 g ; 2,4 t et 2 450 kg ; ranger trois masses en g, kg et hg ; 8,2 kg + 840 g ; 3 kg − 250 g",
	"grades": ["CM1"],
	"theme": "Grandeurs",
	"domain": "Masses",
	"subdomain": "Comparaison",
	"level": 4,
	"delay": 60,
	"status": "draft",
	"options": {
		"constraints": {
			"spacesFromFourDigits": true
		}
	},
	"variations": [
		{
			"statement": "Compare ces deux masses.\n\n$${{eval:a+t/10;d}}~\\unit{kg} \\quad \\ldots \\quad {{c}}~\\unit{g}$$\n\n```choix\nmelanger: non\n- $<$\n- $=$\n- $>$\n```",
			"variables": [
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "t",
					"expression": "1..9"
				},
				{
					"name": "k",
					"expression": "0..8"
				},
				{
					"name": "c",
					"expression": "eval:1000*a+1000*t/10+50*(k-4)"
				},
				{
					"name": "r",
					"expression": "eval:sign(1000*a+1000*t/10-c)+1"
				}
			],
			"conditions": ["c > 0"],
			"blanks": [
				{
					"expectedAnswer": "{{r}}"
				}
			],
			"correction": {
				"steps": [
					"On écrit les deux masses dans la même unité : ${{eval:a+t/10;d}}~\\unit{kg} = {{eval:1000*a+1000*t/10}}~\\unit{g}$.",
					"$${{eval:1000*a+1000*t/10}}~\\unit{g} {{if:r==0|<|{{if:r==1|=|>}}}} {{c}}~\\unit{g}$$",
					"$${{eval:a+t/10;d}}~\\unit{kg} \\textcolor{{{color:primary.0}}}{{{if:r==0|<|{{if:r==1|=|>}}}}} {{c}}~\\unit{g}$$"
				]
			}
		},
		{
			"statement": "Compare ces deux masses.\n\n$${{eval:a+t/10;d}}~\\unit{t} \\quad \\ldots \\quad {{c}}~\\unit{kg}$$\n\n```choix\nmelanger: non\n- $<$\n- $=$\n- $>$\n```",
			"variables": [
				{

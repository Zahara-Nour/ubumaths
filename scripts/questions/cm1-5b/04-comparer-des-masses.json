					"expression": "0..8"
				},
				{
					"name": "c",
					"expression": "eval:1000*a+1000*t/10+50*(k-4)"
				},
				{
					"name": "r",
					"expression": "eval:sign(1000*a+1000*t/10-c)+1"
				}
			],
			"conditions": ["c > 0"],
			"blanks": [
				{
					"expectedAnswer": "{{r}}"
				}
			],
			"correction": {
				"steps": [
					"On écrit les deux masses dans la même unité : ${{eval:a+t/10;d}}~\\unit{t} = {{eval:1000*a+1000*t/10}}~\\unit{kg}$.",

					"expectedAnswer": "{{eval:1000*a+100*t+b}}"
				}
			],
			"correction": {
				"steps": [
					"Pour ajouter deux masses, on les écrit dans la même unité : ${{eval:a+t/10;d}}~\\unit{kg} = {{eval:1000*a+100*t}}~\\unit{g}$.",
					"$${{eval:1000*a+100*t}}~\\unit{g} + {{b}}~\\unit{g} = \\textcolor{{{color:primary.0}}}{{{eval:1000*a+100*t+b}}}~\\unit{g}$$"
				]
			}
		},
		{
			"statement": "Complète.\n\n${{a}}~\\unit{kg} - {{b}}~\\unit{g} = ?~\\text{g}$",
			"variables": [
				{
					"name": "a",
					"expression": "1..5"
				},
				{
					"name": "k",
					"expression": "1..19"
				},
				{
					"name": "b",
					"expression": "eval:50*k"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:1000*a-b}}"
				}
			],
			"correction": {
				"steps": [
					"Pour soustraire deux masses, on les écrit dans la même unité : ${{a}}~\\unit{kg} = {{eval:1000*a}}~\\unit{g}$.",
					"$${{eval:1000*a}}~\\unit{g} - {{b}}~\\unit{g} = \\textcolor{{{color:primary.0}}}{{{eval:1000*a-b}}}~\\unit{g}$$"
				]
			}
		}
	],

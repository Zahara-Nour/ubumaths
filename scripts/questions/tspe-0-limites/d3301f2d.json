	"title": "Résoudre une équation avec ln",
	"description": "ln x = a, ln(ax + b) = c, 2 ln x = ln a ; valeur exacte (pièges : domaine x > 0 oublié, signe)",
	"grades": ["T_SPE", "T_COMP"],
	"theme": "Fonctions",
	"domain": "Fonction logarithme",
	"subdomain": "Équations et inéquations",
	"level": 2,

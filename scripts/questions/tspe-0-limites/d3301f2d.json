	"status": "draft",
	"variations": [
		{
			"blanks": [
				{
					"expectedAnswer": "e^{ {{a}} }"
				}
			],
			"statement": "Résous dans $\\left]0\\,;+\\infty\\right[$ l'équation $\\ln x={{a}}$.\n\n$x=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..6;±"
				}
			],
			"correction": {
				"steps": [
					"$\\ln x={{a}}\\iff x=e^{ {{a}} }$ (on compose par l'exponentielle).",
					"$x=\\textcolor{{{color:primary.0}}}{e^{ {{a}} }}$, qui appartient bien à $\\left]0\\,;+\\infty\\right[$."
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "\\dfrac{{{if:c==1|e|e^{ {{c}} }}}{{eval:-b;+}}}{ {{a}} }"
				}
			],
			"statement": "Résous l'équation $\\ln\\left({{a}}x{{b;+}}\\right)={{c}}$.\n\n$x=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..5"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				},
				{
					"name": "c",
					"expression": "1..4;±"
				}
			],
			"correction": {
				"steps": [
					"$\\ln\\left({{a}}x{{b;+}}\\right)={{c}}\\iff {{a}}x{{b;+}}={{if:c==1|e|e^{ {{c}} }}}$ (et alors ${{a}}x{{b;+}}>0$ : la solution est dans le domaine).",
					"$x=\\textcolor{{{color:primary.0}}}{\\dfrac{{{if:c==1|e|e^{ {{c}} }}}{{eval:-b;+}}}{ {{a}} }}$."
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "\\sqrt{ {{a}} }"
				}
			],
			"statement": "Résous dans $\\left]0\\,;+\\infty\\right[$ l'équation $2\\ln x=\\ln {{a}}$.\n\n$x=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2|3|5|6|7|10|11"
				}
			],
			"correction": {
				"steps": [
					"$2\\ln x=\\ln\\left(x^{2}\\right)$, donc l'équation équivaut à $x^{2}={{a}}$, soit $x=\\sqrt{ {{a}} }$ ou $x=-\\sqrt{ {{a}} }$.",
					"Seule la solution positive est dans le domaine $\\left]0\\,;+\\infty\\right[$ : $x=\\textcolor{{{color:primary.0}}}{\\sqrt{ {{a}} }}$."
				]
			}
		}
	],

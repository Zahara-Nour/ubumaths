	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)={{m}}x{{p;+}}$. Calcule sa valeur moyenne $\\mu$ sur l'intervalle $\\left[{{a}}\\,;{{b}}\\right]$.\n\n$\\mu=?$",
			"variables": [
				{
					"name": "a",
					"expression": "-2..1"
				},
				{
					"name": "b",
					"expression": "2..5"
				},
				{
					"name": "m",
					"expression": "1..6;±"
				},
				{
					"name": "p",
					"expression": "-5..5"
				}
			],
			"conditions": ["m*(a+b)/2+p != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:m*(a+b)/2+p}}"
				}
			],
			"correction": {
				"steps": [
					"$\\mu=\\dfrac{1}{ {{b}}-{{a;()}} }\\displaystyle\\int_{{{a}}}^{{{b}}}f(x)\\,\\mathrm{d}x$.",
					"Une primitive de $f$ est $F(x)={{eval:m/2}}x^2{{p;+}}x$, donc $\\displaystyle\\int_{{{a}}}^{{{b}}}f(x)\\,\\mathrm{d}x=F({{b}})-F({{a}})={{eval:(m*(b^2-a^2)/2+p*(b-a))}}$.",
					"$\\mu=\\dfrac{ {{eval:(m*(b^2-a^2)/2+p*(b-a))}} }{ {{eval:b-a}} }=\\textcolor{{{color:primary.0}}}{{{eval:m*(a+b)/2+p}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)={{k}}x^2$. Calcule sa valeur moyenne $\\mu$ sur l'intervalle $\\left[0\\,;{{b}}\\right]$.\n\n$\\mu=?$",
			"variables": [
				{
					"name": "k",
					"expression": "1..3"
				},
				{
					"name": "b",
					"expression": "2..4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:k*b^2/3}}"
				}
			],
			"correction": {
				"steps": [
					"Une primitive de $f$ est $F(x)={{eval:k/3}}x^3$, donc $\\displaystyle\\int_{0}^{{{b}}}f(x)\\,\\mathrm{d}x=F({{b}})-F(0)={{eval:k*b^3/3}}$.",
					"$\\mu=\\dfrac{1}{ {{b}} }\\times{{eval:k*b^3/3}}=\\textcolor{{{color:primary.0}}}{{{eval:k*b^2/3}}}$."
				]
			}
		},
		{
			"statement": "Calcule la valeur moyenne $\\mu$ de la fonction exponentielle sur l'intervalle $\\left[0\\,;{{b}}\\right]$.\n\n$\\mu=?$",
			"variables": [
				{
					"name": "b",
					"expression": "2..4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{e^{ {{b}} }-1}{ {{b}} }"
				}
			],
			"correction": {
				"steps": [
					"$\\displaystyle\\int_{0}^{{{b}}}e^{x}\\,\\mathrm{d}x=\\left[e^{x}\\right]_0^{ {{b}} }=e^{ {{b}} }-1$.",
					"$\\mu=\\dfrac{1}{ {{b}}-0}\\left(e^{ {{b}} }-1\\right)=\\textcolor{{{color:primary.0}}}{\\dfrac{e^{ {{b}} }-1}{ {{b}} }}$."
				]
			}
		},
		{
			"statement": "Calcule la valeur moyenne $\\mu$ de la fonction $f:x\\mapsto\\dfrac{1}{x}$ sur l'intervalle $\\left[1\\,;e\\right]$.\n\n$\\mu=?$",
			"blanks": [
				{
					"expectedAnswer": "\\frac{1}{e-1}"
				}
			],
			"correction": {
				"steps": [
					"$\\displaystyle\\int_{1}^{e}\\dfrac{1}{x}\\,\\mathrm{d}x=\\left[\\ln(x)\\right]_1^{e}=1-0=1$.",
					"$\\mu=\\dfrac{1}{e-1}\\times 1=\\textcolor{{{color:primary.0}}}{\\dfrac{1}{e-1}}$."
				]
			}
		}
	],

	"variations": [
		{
			"statement": "Calcule.\n\n$${{x}} + {{y}} = ?$$",
			"variables": [
				{
					"name": "A",
					"expression": "11..999"
				},
				{
					"name": "B",
					"expression": "101..999"
				},
				{
					"name": "x",
					"expression": "eval:A/10;d"
				},
				{
					"name": "y",
					"expression": "eval:B/100;d"
				}
			],
			"conditions": ["mod(A,10)!=0", "mod(B,10)!=0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(10*A+B)/100;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Additionner des décimaux.** On additionne les chiffres de même rang : unités avec unités, dixièmes avec dixièmes, centièmes avec centièmes. Pour ne pas se tromper, on écrit les deux nombres avec autant de chiffres après la virgule.",
					"${{x}} = {{x}}0$ : c'est ${{eval:10*A}}$ centièmes ; ${{y}}$, c'est ${{B}}$ centièmes. En tout : ${{eval:10*A}} + {{B}} = {{eval:10*A+B}}$ centièmes.",
					"$${{x}} + {{y}} = {{x}}0 + {{y}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		},
		{
			"statement": "Calcule astucieusement.\n\n$${{p}} + {{b}} + {{q}} = ?$$",
			"variables": [
				{
					"name": "u",
					"expression": "1..20"
				},
				{
					"name": "D",
					"expression": "5..95"
				},
				{
					"name": "w",
					"expression": "0..9"
				},
				{
					"name": "M",
					"expression": "11..99"
				},
				{
					"name": "p",
					"expression": "eval:u+D/100;d"
				},
				{
					"name": "q",
					"expression": "eval:w+(100-D)/100;d"
				},
				{
					"name": "b",
					"expression": "eval:M/10;d"
				}
			],
			"conditions": ["mod(D,10)!=0", "mod(M,10)!=0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:u+w+1+M/10;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Regrouper.** Dans une somme, on peut changer l'ordre des termes : on cherche deux nombres dont la somme est un entier.",
					"$\\textcolor{{{color:primary.0}}}{{{p}}} + \\textcolor{{{color:primary.0}}}{{{q}}} = {{eval:u+w+1}}$ : ${{D}}$ centièmes et ${{eval:100-D}}$ centièmes font $100$ centièmes, soit $1$ unité.",
					"$${{p}} + {{b}} + {{q}} = {{eval:u+w+1}} + {{b}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		},
		{
			"statement": "Calcule.\n\n$${{n}} + {{y}} = ?$$",
			"variables": [
				{
					"name": "n",
					"expression": "2..99"
				},
				{
					"name": "Y",
					"expression": "1..999"
				},
				{
					"name": "y",
					"expression": "eval:Y/100;d"
				}
			],
			"conditions": ["mod(Y,10)!=0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n+Y/100;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Additionner des décimaux.** On additionne les chiffres de même rang : unités avec unités, dixièmes avec dixièmes, centièmes avec centièmes. Pour ne pas se tromper, on écrit les deux nombres avec autant de chiffres après la virgule.",
					"${{n}}$ est un entier : ${{n}} = {{n}}.00$. On ajoute ses unités aux unités de ${{y}}$, les dixièmes et les centièmes ne changent pas.",
					"$${{n}} + {{y}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		}
	],

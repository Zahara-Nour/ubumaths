			"conditions": ["mod(P,10)!=0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:L*P/100;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Prix à payer** $=$ nombre de litres $\\times$ prix d'un litre.",
					"$${{L}} \\times {{eval:floor(P/100)}}.{{eval:floor(mod(P,100)/10)}}{{eval:mod(P,10)}} = \\textcolor{{{color:primary.0}}}{{{eval:floor((L*P)/100)}}.{{eval:floor(mod((L*P),100)/10)}}{{eval:mod((L*P),10)}}}$$",
					"Ordre de grandeur : ${{L}} \\times 2 = {{eval:2*L}}$ ; le résultat est un peu moins."
				]
			}
		},
		{
			"statement": "Le fromage coûte ${{eval:floor(pk/100)}}.{{eval:floor(mod(pk,100)/10)}}{{eval:mod(pk,10)}}~\\text{€}$ le kilogramme. Inès en achète $0.{{m}}~\\text{kg}$. Combien paie-t-elle ?\n\n$$?~\\text{€}$$",
			"variables": [
				{
					"name": "k",
					"expression": "12..99"
				},
				{
					"name": "pk",
					"expression": "eval:10*k"
				},
				{
					"name": "m",
					"expression": "2..9"
				}
			],
			"conditions": ["mod(k,10)!=0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:m*k/100;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Prix à payer** $=$ masse $\\times$ prix d'un kilogramme, même quand la masse est plus petite que $1$ kg.",
					"$$0.{{m}} \\times {{eval:floor(pk/100)}}.{{eval:floor(mod(pk,100)/10)}}{{eval:mod(pk,10)}} = \\textcolor{{{color:primary.0}}}{{{eval:floor((m*k)/100)}}.{{eval:floor(mod((m*k),100)/10)}}{{eval:mod((m*k),10)}}}$$",
					"Elle achète moins d'un kilogramme : elle paie moins que ${{eval:floor(pk/100)}}.{{eval:floor(mod(pk,100)/10)}}{{eval:mod(pk,10)}}~\\text{€}$."
				]
			}
		}
	],

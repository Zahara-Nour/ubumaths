				{
					"expectedAnswer": "{{eval:M*k/100;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Prix à payer** $=$ masse $\\times$ prix d'un kilogramme.",
					"$${{m}} \\times {{eval:floor(pk/100)}}.{{eval:floor(mod(pk,100)/10)}}{{eval:mod(pk,10)}} = \\textcolor{{{color:primary.0}}}{{{eval:floor((M*k)/100)}}.{{eval:floor(mod((M*k),100)/10)}}{{eval:mod((M*k),10)}}}$$",
					"Léa paie $\\textcolor{{{color:primary.0}}}{{{eval:floor((M*k)/100)}}.{{eval:floor(mod((M*k),100)/10)}}{{eval:mod((M*k),10)}}}~\\text{€}$."
				]
			}
		},
		{
			"statement": "Le litre d'essence coûte ${{eval:floor(P/100)}}.{{eval:floor(mod(P,100)/10)}}{{eval:mod(P,10)}}~\\text{€}$. Malik met ${{L}}$ litres dans sa voiture. Combien paie-t-il ?\n\n$$?~\\text{€}$$",
			"variables": [
				{
					"name": "P",
					"expression": "160..199"
				},
				{
					"name": "L",
					"expression": "20..50"

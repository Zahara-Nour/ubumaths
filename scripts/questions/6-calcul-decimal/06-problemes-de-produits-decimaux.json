	"variations": [
		{
			"statement": "Au marché, les {{if:f==0|pommes coûtent|{{if:f==1|poires coûtent|cerises coûtent}}}} ${{eval:floor(pk/100)}}.{{eval:floor(mod(pk,100)/10)}}{{eval:mod(pk,10)}}~\\text{€}$ le kilogramme. Léa en achète ${{m}}~\\text{kg}$. Combien paie-t-elle ?\n\n$$?~\\text{€}$$",
			"variables": [
				{

{
	"title": "Problèmes de division euclidienne",
	"description": "Interpréter le quotient et le reste : boîtes pleines et reste, nombre de cars (un de plus pour le reste), jours en semaines et jours, heures en jours, minutes en heures",
	"grades": ["6"],
	"theme": "Entiers",
	"domain": "Problèmes",
	"subdomain": "Division euclidienne",
	"level": 1,
	"delay": 60,
	"status": "draft",
	"variations": [
		{
			"statement": "On range ${{N}}$ œufs dans des boîtes de ${{d}}$. Combien de boîtes pleines obtient-on ? Combien d'œufs reste-t-il ?\n\n$$?~\\text{boîtes pleines et}~?~\\text{œufs restants}$$",
			"variables": [
				{
					"name": "sd",
					"expression": "0..3"
				},
				{
					"name": "d",
					"expression": "{{if:sd==0|6|{{if:sd==1|10|{{if:sd==2|12|30}}}}}}"
				},
				{
					"name": "q",
					"expression": "5..40"
				},
				{
					"name": "r",
					"expression": "1..{{eval:d-1}}"
				},
				{
					"name": "N",
					"expression": "eval:d*q+r"
				}
			],
			"conditions": ["N<1000"],
			"blanks": [
				{
					"expectedAnswer": "{{q}}"
				},
				{
					"expectedAnswer": "{{r}}"
				}
			],
			"correction": {
				"steps": [
					"**Division euclidienne.** Diviser $N$ par $d$, c'est trouver le quotient $q$ et le reste $r$ tels que $N = (d \\times q) + r$, avec un reste plus petit que $d$.",
					"$${{N}} = ({{d}} \\times \\textcolor{{{color:primary.0}}}{{{q}}}) + \\textcolor{{{color:primary.1}}}{{{r}}}$$",
					"On obtient $\\textcolor{{{color:primary.0}}}{{{q}}}$ boîtes pleines et il reste $\\textcolor{{{color:primary.1}}}{{{r}}}$ œuf{{if:r>1|s|}}."
				]
			}
		},
		{
			"statement": "${{E}}$ élèves partent en sortie. Un car a ${{c}}$ places. Combien de cars faut-il, au minimum, pour transporter tous les élèves ?\n\n$$?~\\text{cars}$$",
			"variables": [
				{
					"name": "c",
					"expression": "30..60"
				},
				{
					"name": "q",
					"expression": "2..9"
				},
				{
					"name": "r",
					"expression": "1..{{eval:c-1}}"
				},
				{
					"name": "E",
					"expression": "eval:c*q+r"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:q+1}}"
				}
			],
			"correction": {
				"steps": [
					"**Division euclidienne.** Diviser $N$ par $d$, c'est trouver le quotient $q$ et le reste $r$ tels que $N = (d \\times q) + r$, avec un reste plus petit que $d$.",
					"$${{E}} = ({{c}} \\times {{q}}) + \\textcolor{{{color:primary.1}}}{{{r}}}$$",
					"${{q}}$ cars pleins ne suffisent pas : il reste ${{r}}$ élève{{if:r>1|s|}}. Il faut un car de plus : $\\textcolor{{{color:primary.0}}}{{{solution}}}$ cars."
				]
			}
		},
		{
			"statement": "Complète.\n\n$${{N}}~\\text{{{if:s==0|jours|{{if:s==1|heures|minutes}}}}} = ?~\\text{{{if:s==0|semaines|{{if:s==1|jours|heures}}}}}~?~\\text{{{if:s==0|jours|{{if:s==1|heures|minutes}}}}}$$",
			"variables": [
				{
					"name": "s",
					"expression": "0..2"
				},
				{
					"name": "d",
					"expression": "{{if:s==0|7|{{if:s==1|24|60}}}}"
				},
				{
					"name": "q",
					"expression": "2..40"
				},
				{
					"name": "r",
					"expression": "1..{{eval:d-1}}"
				},
				{
					"name": "N",
					"expression": "eval:d*q+r"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{q}}"
				},
				{
					"expectedAnswer": "{{r}}"
				}
			],
			"correction": {
				"steps": [
					"Une {{if:s==0|semaine|{{if:s==1|journée|heure}}}} compte ${{d}}$ {{if:s==0|jours|{{if:s==1|heures|minutes}}}} : on fait la division euclidienne de ${{N}}$ par ${{d}}$.",
					"$${{N}} = ({{d}} \\times \\textcolor{{{color:primary.0}}}{{{q}}}) + \\textcolor{{{color:primary.1}}}{{{r}}}$$",
					"$${{N}}~\\text{{{if:s==0|jours|{{if:s==1|heures|minutes}}}}} = \\textcolor{{{color:primary.0}}}{{{q}}}~\\text{{{if:s==0|semaines|{{if:s==1|jours|heures}}}}}~\\textcolor{{{color:primary.1}}}{{{r}}}~\\text{{{if:s==0|jour|{{if:s==1|heure|minute}}}}{{if:r>1|s|}}}$$"
				]
			}
		}
	],
	"testSpecs": [
		{
			"description": "295 œufs, boîtes de 12 : 24 et 7",
			"variationIndex": 0,
			"variables": {
				"sd": "2",
				"d": "12",
				"q": "24",
				"r": "7",
				"N": "295"
			},
			"answers": ["24", "7"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : quotient et reste échangés",

{
	"title": "Ajouter 0,9 ; 1,9 ; 2,9 en compensant",
	"description": "Calcul astucieux : ajouter 0,9, 1,9 ou 2,9 à un décimal en ajoutant 1, 2 ou 3 puis en enlevant 0,1 (3,4 + 1,9 = 3,4 + 2 − 0,1)",
	"grades": ["6"],
	"theme": "Décimaux",
	"domain": "Additionner",
	"subdomain": "Somme astucieuse",
	"level": 4,
	"delay": 30,
	"status": "draft",
	"variations": [
		{
			"statement": "Calcule astucieusement.\n\n$${{x}} + {{y}} = ?$$",
			"variables": [
				{
					"name": "k",
					"expression": "0..2"
				},
				{
					"name": "A",
					"expression": "11..99"
				},
				{
					"name": "x",
					"expression": "eval:A/10;d"
				},
				{
					"name": "y",
					"expression": "eval:k+0.9;d"
				}
			],
			"conditions": ["mod(A,10)!=0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(A+10*k+9)/10;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Compenser.** ${{y}}$, c'est ${{eval:k+1}} - 0.1$ : on ajoute ${{eval:k+1}}$, puis on enlève $0.1$.",
					"$${{x}} + {{y}} = {{x}} + \\textcolor{{{color:primary.0}}}{{{eval:k+1}}} - \\textcolor{{{color:primary.1}}}{0.1} = {{eval:(A+10*k+10)/10;d}} - 0.1 = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		}
	],

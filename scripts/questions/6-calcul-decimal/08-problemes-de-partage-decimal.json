			"conditions": ["mod(n*Q,100)!=0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:Q/100;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Partager en parts égales**, c'est diviser : longueur d'un morceau $=$ longueur du ruban $\\div$ nombre de morceaux.",
					"$${{L}} \\div {{n}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$",
					"Vérification : ${{n}} \\times {{solution}} = {{L}}$."
				]
			}
		},
		{
			"statement": "${{n}}$ {{if:o==0|cahiers identiques coûtent|stylos identiques coûtent}} ${{eval:floor(C/100)}}.{{eval:floor(mod(C,100)/10)}}{{eval:mod(C,10)}}~\\text{€}$. Combien coûte un {{if:o==0|cahier|stylo}} ?\n\n$$?~\\text{€}$$",
			"variables": [
				{
					"name": "o",
					"expression": "0..1"
				},
				{
					"name": "n",
					"expression": "2..9"

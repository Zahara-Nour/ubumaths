	"variations": [
		{
			"statement": "${{n}}$ amis partagent {{if:o==0|un gain de|une cagnotte de}} ${{eval:floor(C/100)}}.{{eval:floor(mod(C,100)/10)}}{{eval:mod(C,10)}}~\\text{€}$ en parts égales. Combien chacun reçoit-il ?\n\n$$?~\\text{€}$$",
			"variables": [
				{
					"name": "o",

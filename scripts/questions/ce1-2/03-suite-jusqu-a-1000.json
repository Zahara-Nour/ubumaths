	"variations": [
		{
			"statement": "Le nombre qui suit ${{n}}$ est $?$.",
			"variables": [
				{
					"name": "n",
					"expression": "100..998"
				}
			],
			"conditions": ["mod(n,10) <= 8"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n+1}}"
				}
			],
			"correction": {
				"steps": [
					"Le nombre qui suit, c'est celui qu'on dit juste après en comptant : on avance de $1$.",
					"$${{n}} \\rightarrow {{solution}}$$"
				]
			}
		},
		{
			"statement": "Le nombre qui suit ${{n}}$ est $?$.",
			"variables": [
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "b",
					"expression": "0..9"
				},
				{
					"name": "n",
					"expression": "eval:100*a+10*b+9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n+1}}"
				}
			],
			"correction": {
				"steps": [
					"Le nombre qui suit, c'est celui qu'on dit juste après en comptant : on avance de $1$.",
					"{{if:b==9|${{n}}$ se termine par $99$ : on passe à la centaine suivante, les dizaines et les unités reviennent à $0$.|${{n}}$ se termine par $9$ : on passe à la dizaine suivante, le chiffre des unités revient à $0$.}}",
					"$${{n}} \\rightarrow {{solution}}$$"
				]
			}
		},
		{
			"statement": "Le nombre qui précède ${{n}}$ est $?$.",
			"variables": [
				{
					"name": "a",
					"expression": "1..10"
				},
				{
					"name": "b",
					"expression": "0..9"
				},
				{
					"name": "n",
					"expression": "eval:100*a+10*b"
				}
			],
			"conditions": ["100*a + 10*b <= 1000"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n-1}}"
				}
			],
			"correction": {
				"steps": [
					"Le nombre qui précède, c'est celui qu'on dit juste avant en comptant : on recule de $1$.",
					"{{if:b==0|${{n}}$ se termine par $00$ : on revient à la centaine précédente, les dizaines et les unités deviennent $9$.|${{n}}$ se termine par $0$ : on revient à la dizaine précédente, le chiffre des unités devient $9$.}}",
					"$${{solution}} \\rightarrow {{n}}$$"
				]
			}
		}
	],

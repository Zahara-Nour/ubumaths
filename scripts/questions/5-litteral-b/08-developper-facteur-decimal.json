			"conditions": ["K!=10", "K!=20"],
			"blanks": [
				{
					"expectedAnswer": "{{k}}x + {{eval:K*q/10;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Développer.** On multiplie le facteur par **chaque terme** de la parenthèse : $k(a + b) = k \\times a + k \\times b$ et $k(a - b) = k \\times a - k \\times b$.",
					"$${{k}}(x + {{q}}) = {{k}} \\times x + {{k}} \\times {{q}} = \\textcolor{{{color:primary.0}}}{{{k}}x + {{eval:K*q/10;d}}}$$"
				]
			}
		},

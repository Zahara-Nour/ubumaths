	"variations": [
		{
			"statement": "Une classe compte ${{f}}$ filles et ${{g}}$ garçons. On forme un groupe de travail de ${{a}}$ filles et ${{b}}$ garçons.\n\nCombien de groupes différents sont possibles ?\n\n$?$",
			"variables": [
				{
					"name": "f",
					"expression": "8..15"
				},
				{
					"name": "g",
					"expression": "8..15"
				},
				{
					"name": "a",
					"expression": "2..3"
				},
				{
					"name": "b",
					"expression": "2..3"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:binom(f,a)*binom(g,b)}}",
					"acceptCombinatorialNotation": true
				}
			],
			"correction": {
				"steps": [
					"On choisit les filles **et** les garçons : $\\binom{ {{f}} }{ {{a}} }={{eval:binom(f,a)}}$ choix pour les filles, $\\binom{ {{g}} }{ {{b}} }={{eval:binom(g,b)}}$ pour les garçons ; on multiplie.",
					"${{eval:binom(f,a)}}\\times{{eval:binom(g,b)}}=\\textcolor{{{color:primary.0}}}{{{eval:binom(f,a)*binom(g,b)}}}$."
				]
			}
		},
		{
			"statement": "On tire une main de $5$ cartes dans un jeu de $32$ cartes, qui contient $8$ cœurs.\n\nCombien de mains contiennent **exactement** ${{k}}$ cœur{{if:k>1|s|}} ?\n\n$?$",
			"variables": [
				{
					"name": "k",
					"expression": "1..3"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:binom(8,k)*binom(24,5-k)}}",
					"acceptCombinatorialNotation": true
				}
			],
			"correction": {
				"steps": [
					"On choisit ${{k}}$ cœur{{if:k>1|s|}} parmi $8$ **et** ${{eval:5-k}}$ cartes parmi les $24$ autres : $\\binom{ 8 }{ {{k}} }={{eval:binom(8,k)}}$ et $\\binom{ 24 }{ {{eval:5-k}} }={{eval:binom(24,5-k)}}$.",
					"${{eval:binom(8,k)}}\\times{{eval:binom(24,5-k)}}=\\textcolor{{{color:primary.0}}}{{{eval:binom(8,k)*binom(24,5-k)}}}$."
				]
			}
		},
		{
			"statement": "Une urne contient ${{r}}$ boules rouges et ${{w}}$ boules blanches. On tire simultanément $3$ boules.\n\nCombien de tirages comportent **exactement** $2$ boules rouges ?\n\n$?$",
			"variables": [
				{
					"name": "r",
					"expression": "4..8"
				},
				{
					"name": "w",
					"expression": "3..7"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:binom(r,2)*w}}",
					"acceptCombinatorialNotation": true
				}
			],
			"correction": {
				"steps": [
					"Exactement $2$ rouges sur $3$ : $2$ rouges parmi ${{r}}$ **et** $1$ blanche parmi ${{w}}$.",
					"$\\binom{ {{r}} }{ 2 }\\times\\binom{ {{w}} }{ 1 }={{eval:binom(r,2)}}\\times{{w}}=\\textcolor{{{color:primary.0}}}{{{eval:binom(r,2)*w}}}$."
				]
			}
		}
	],

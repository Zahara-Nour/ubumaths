	"variations": [
		{
			"statement": "Ce matin, le thermomètre indiquait $-{{a}}~\\unit{°C}$. Dans la journée, la température a monté de ${{b}}~\\unit{°C}$.\n\nQuelle température indique-t-il maintenant ?\n\n$?~\\unit{°C}$",
			"variables": [
				{
					"name": "a",
					"expression": "2..12"
				},
				{
					"name": "b",
					"expression": "3..20"
				}
			],
			"conditions": ["b>a"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:b-a}}"
				}
			],
			"correction": {
				"steps": [
					"**Monter**, c'est ajouter : on calcule $-{{a}} + {{b}}$.",
					"$$-{{a}} + {{b}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$",
					"Le thermomètre indique $\\textcolor{{{color:primary.0}}}{{{solution}}~\\unit{°C}}$."
				]
			}
		},
		{
			"statement": "À midi, le thermomètre indiquait ${{a}}~\\unit{°C}$. Dans la nuit, la température a baissé de ${{b}}~\\unit{°C}$.\n\nQuelle température indique-t-il maintenant ?\n\n$?~\\unit{°C}$",
			"variables": [
				{
					"name": "a",
					"expression": "2..12"
				},
				{
					"name": "b",
					"expression": "3..20"
				}
			],
			"conditions": ["b>a"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a-b}}"
				}
			],
			"correction": {
				"steps": [
					"**Baisser**, c'est soustraire : on calcule ${{a}} - {{b}}$.",
					"$${{a}} - {{b}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$",
					"Le thermomètre indique $\\textcolor{{{color:primary.0}}}{{{solution}}~\\unit{°C}}$."
				]
			}
		},
		{
			"statement": "Un sous-marin est à l'altitude $-{{a}}~\\unit{m}$. Il remonte de ${{b}}~\\unit{m}$.\n\nQuelle est sa nouvelle altitude ?\n\n$?~\\unit{m}$",
			"variables": [

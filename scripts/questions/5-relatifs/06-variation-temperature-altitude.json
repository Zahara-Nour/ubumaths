					"expression": "eval:10*A"
				},
				{
					"name": "b",
					"expression": "eval:10*B"
				}
			],
			"conditions": ["B<A"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:b-a}}"
				}
			],
			"correction": {
				"steps": [
					"**Remonter**, c'est ajouter : on calcule $-{{a}} + {{b}}$.",
					"$$-{{a}} + {{b}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$",
					"Le sous-marin est à l'altitude $\\textcolor{{{color:primary.0}}}{{{solution}}~\\unit{m}}$."
				]
			}
		},
		{
			"statement": "Un sous-marin est à l'altitude $-{{a}}~\\unit{m}$. Il descend de ${{b}}~\\unit{m}$.\n\nQuelle est sa nouvelle altitude ?\n\n$?~\\unit{m}$",
			"variables": [
				{
					"name": "A",
					"expression": "5..30"
				},
				{
					"name": "B",
					"expression": "1..20"
				},
				{
					"name": "a",
					"expression": "eval:10*A"
				},
				{
					"name": "b",
					"expression": "eval:10*B"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:-a-b}}"
				}
			],
			"correction": {
				"steps": [
					"**Descendre**, c'est soustraire : on calcule $-{{a}} - {{b}}$.",
					"$$-{{a}} - {{b}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$",
					"Le sous-marin est à l'altitude $\\textcolor{{{color:primary.0}}}{{{solution}}~\\unit{m}}$."
				]
			}
		}
	],

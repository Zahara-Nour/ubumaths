{
	"title": "Intercaler un nombre décimal",
	"description": "Écrire un nombre décimal compris entre deux dixièmes consécutifs (3,4 < 3,45 < 3,5), ou entre un dixième et l'entier suivant (1,9 < 1,95 < 2) ; toute réponse strictement entre est juste",
	"grades": ["CM1"],
	"theme": "Décimaux",
	"domain": "Apprivoiser",
	"subdomain": "Encadrer",
	"level": 6,
	"delay": 45,
	"status": "draft",
	"options": {
		"constraints": {
			"spacesFromFourDigits": true
		}
	},
	"variations": [
		{
			"statement": "Écris un nombre décimal compris entre ${{lo}}$ et ${{hi}}$.\n\n$${{lo}} < ? < {{hi}}$$",
			"variables": [
				{
					"name": "a",
					"expression": "0..20"
				},
				{
					"name": "b",
					"expression": "0..8"
				},
				{
					"name": "lo",
					"expression": "eval:a+b/10;d"
				},
				{
					"name": "hi",
					"expression": "eval:a+(b+1)/10;d"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a+b/10+0.05;d}}",
					"rulesSuffice": true,
					"validationRules": [
						{
							"type": "range",
							"min": "{{lo}}",
							"max": "{{hi}}",
							"inclusive": false
						}
					]
				}
			],
			"correction": {
				"steps": [
					"**Intercaler.** On écrit les deux nombres avec un chiffre de plus après la virgule, en centièmes : il apparaît de la place entre eux.",
					"${{lo}} = {{a}}.{{b}}0$ et ${{hi}} = {{a}}.{{eval:b+1}}0$ : par exemple $\\textcolor{{{color:primary.0}}}{{{eval:a+b/10+0.05;d}}}$ (mais aussi ${{eval:a+b/10+0.01;d}}$, ${{eval:a+b/10+0.08;d}}$…)."
				]
			}
		},
		{
			"statement": "Écris un nombre décimal compris entre ${{lo}}$ et ${{hi}}$.\n\n$${{lo}} < ? < {{hi}}$$",
			"variables": [
				{
					"name": "a",

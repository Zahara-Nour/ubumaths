				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a+0.95;d}}",
					"rulesSuffice": true,
					"validationRules": [
						{
							"type": "range",
							"min": "{{lo}}",
							"max": "{{hi}}",
							"inclusive": false
						}
					]
				}
			],
			"correction": {
				"steps": [
					"**Intercaler.** On écrit les deux nombres avec un chiffre de plus après la virgule, en centièmes : il apparaît de la place entre eux.",
					"${{lo}} = {{a}}.90$ et ${{hi}} = {{hi}}.00$ : par exemple $\\textcolor{{{color:primary.0}}}{{{eval:a+0.95;d}}}$ (mais aussi ${{eval:a+0.91;d}}$, ${{eval:a+0.99;d}}$…)."
				]
			}
		}
	],

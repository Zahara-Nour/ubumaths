{
	"title": "Placer un nombre décimal sur une demi-droite graduée",
	"description": "Placer un nombre décimal sur une demi-droite graduée en dixièmes (2,8), ou sur un morceau agrandi gradué en centièmes (339,16), en touchant la droite",
	"grades": ["CM1"],
	"theme": "Décimaux",
	"domain": "Apprivoiser",
	"subdomain": "Repérage",
	"level": 4,
	"delay": 45,
	"status": "draft",
	"options": {
		"constraints": {
			"spacesFromFourDigits": true
		}
	},
	"variations": [
		{
			"statement": "Place le nombre ${{x}}$ sur la demi-droite graduée.\n\n```line\nstart: {{q}}\nend: {{eval:q+1}}\nstep: 0.1\nmajor: 10\nplacer: {{x}}\n```",
			"variables": [
				{
					"name": "q",
					"expression": "0..20"
				},
				{
					"name": "k",
					"expression": "1..9"
				},
				{
					"name": "x",
					"expression": "eval:q+k/10;d"
				}
			],
			"correction": {
				"steps": [
					"**Ce que vaut un petit intervalle.** De ${{q}}$ à ${{eval:q+1}}$, l'unité est partagée en $10$ : chaque petit intervalle vaut $0.1$.",
					"${{x}} = {{q}} + {{k}} \\times 0.1$ : on part de ${{q}}$ et on avance de ${{k}}$ petit{{if:k>1|s|}} intervalle{{if:k>1|s|}}."
				]
			}
		},
		{
			"statement": "Place le nombre ${{x}}$ sur la demi-droite graduée.\n\n```line\nstart: {{lo}}\nend: {{hi}}\nstep: 0.01\nmajor: 10\nlabels: {{lo}}, {{hi}}\nplacer: {{x}}\n```",
			"variables": [
				{
					"name": "a",
					"expression": "1..999"
				},
				{
					"name": "b",
					"expression": "0..9"
				},
				{
					"name": "k",
					"expression": "1..9"
				},
				{
					"name": "lo",
					"expression": "eval:a+b/10;d"
				},
				{
					"name": "hi",
					"expression": "eval:a+(b+1)/10;d"
				},
				{
					"name": "x",
					"expression": "eval:a+b/10+k/100;d"
				}
			],
			"correction": {
				"steps": [
					"**Ce que vaut un petit intervalle.** De ${{lo}}$ à ${{hi}}$, il y a un dixième, partagé en $10$ : chaque petit intervalle vaut $0.01$.",
					"${{x}} = {{lo}} + {{k}} \\times 0.01$ : on part de ${{lo}}$ et on avance de ${{k}}$ petit{{if:k>1|s|}} intervalle{{if:k>1|s|}}."
				]
			}
		}
	],
	"testSpecs": [

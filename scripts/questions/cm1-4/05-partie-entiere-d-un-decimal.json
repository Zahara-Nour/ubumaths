	"variations": [
		{
			"statement": "Quelle est la partie entière de ${{x}}$ ?\n\n$$?$$",
			"variables": [
				{
					"name": "a",
					"expression": "0..99"
				},
				{
					"name": "t",
					"expression": "1..9"
				},
				{
					"name": "x",
					"expression": "eval:a+t/10;d"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{a}}"
				}
			],
			"correction": {
				"steps": [
					"**La partie entière**, c'est le nombre d'unités entières : ce qui est écrit avant la virgule.",
					"${{x}} = \\textcolor{{{color:primary.0}}}{{{a}}} + 0.{{t}}$"
				]
			}
		},
		{
			"statement": "Quelle est la partie entière de ${{x}}$ ?\n\n$$?$$",

			"correction": {
				"steps": [
					"À connaître : pour tout réel $x$, $(x^2)'=2x$.",
					"La fonction qui a pour dérivée $x\\mapsto 2x$ est donc $\\textcolor{{{color:primary.0}}}{x\\mapsto x^2}$.",
					"Vérification des autres : $(2x^2)'=4x$, $(2)'=0$ et $\\left(\\dfrac{x^2}{2}\\right)'=x$."
				]
			}
		}
	],

{
	"title": "Angles associés : simplifier une somme",
	"description": "Somme de cosinus et sinus d'angles associés, à réduire en a cos x + b sin x",
	"grades": ["1_SPE"],
	"points": ["1SPE-114"],
	"theme": "Fonctions",
	"domain": "Fonctions trigonométriques",
	"subdomain": "Propriétés",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"shared": {
		"cleanCoefficients": true
	},
	"variations": [
		{
			"statement": "Simplifie l'expression suivante, pour tout réel $x$.\n\n$A={{a}}cos(\\pi-x)+{{b}}cos(x+2\\pi)$\n\n$A=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..6"
				},
				{
					"name": "m",
					"expression": "2..3;±"
				},
				{
					"name": "b",
					"expression": "eval:a+m"
				}
			],
			"conditions": ["b >= 1"],
			"blanks": [
				{
					"expectedAnswer": "{{m}}\\cos x"
				}
			],
			"correction": {
				"steps": [
					"$\\cos(\\pi-x)=-\\cos x$ et $\\cos(x+2\\pi)=\\cos x$ (période $2\\pi$).",
					"$A=-{{a}}cos(x)+{{b}}cos(x)$, donc $A=\\textcolor{{{color:primary.0}}}{{{m}}\\cos x }$."
				]
			}
		},
		{
			"statement": "Simplifie l'expression suivante, pour tout réel $x$.\n\n$A={{a}}sin(\\pi-x)+{{b}}sin(\\pi+x)$\n\n$A=?$",
			"variables": [
				{
					"name": "b",
					"expression": "1..6"
				},
				{
					"name": "m",
					"expression": "2..3;±"
				},
				{
					"name": "a",
					"expression": "eval:b+m"
				}
			],
			"conditions": ["a >= 1"],
			"blanks": [
				{
					"expectedAnswer": "{{m}}\\sin x"
				}
			],
			"correction": {
				"steps": [
					"$\\sin(\\pi-x)=\\sin x$ et $\\sin(\\pi+x)=-\\sin x$.",
					"$A={{a}}sin(x)-{{b}}sin(x)$, donc $A=\\textcolor{{{color:primary.0}}}{{{m}}\\sin x }$."
				]
			}
		},
		{
			"statement": "Simplifie l'expression suivante, pour tout réel $x$.\n\n$A=\\cos(\\pi-x)+\\cos(-x)+\\sin(\\pi+x)+\\sin x$\n\n$A=?$",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"$\\cos(\\pi-x)=-\\cos x$, $\\cos(-x)=\\cos x$ et $\\sin(\\pi+x)=-\\sin x$.",
					"$A=-\\cos x+\\cos x-\\sin x+\\sin x=\\textcolor{{{color:primary.0}}}{0 }$."
				]
			}
		},
		{
			"statement": "Simplifie l'expression suivante, pour tout réel $x$.\n\n$A={{a}}cos(-x)+{{b}}sin(\\pi-x)+{{c}}cos(\\pi+x)+{{d}}sin(-x)$\n\n$A=?$",
			"variables": [
				{
					"name": "c",
					"expression": "1..5"
				},
				{
					"name": "d",
					"expression": "1..5"
				},
				{
					"name": "m",
					"expression": "2..3;±"
				},
				{
					"name": "n",
					"expression": "2..3;±"
				},
				{
					"name": "a",
					"expression": "eval:c+m"
				},
				{
					"name": "b",
					"expression": "eval:d+n"
				}
			],
			"conditions": ["a >= 1", "b >= 1", "abs(m) != abs(n)"],
			"blanks": [
				{
					"expectedAnswer": "{{m}}\\cos x{{n;+}}\\sin x"
				}
			],
			"correction": {
				"steps": [
					"$\\cos(-x)=\\cos x$, $\\sin(\\pi-x)=\\sin x$, $\\cos(\\pi+x)=-\\cos x$ et $\\sin(-x)=-\\sin x$.",
					"$A={{a}}cos(x)+{{b}}sin(x)-{{c}}cos(x)-{{d}}sin(x)$, donc $A=\\textcolor{{{color:primary.0}}}{{{m}}\\cos x{{n;+}}\\sin x }$."
				]
			}
		},
		{
			"statement": "Simplifie l'expression suivante, pour tout réel $x$.\n\n$A=\\cos\\left(\\dfrac{\\pi}{2}-x\\right)+\\sin(\\pi+x)+\\sin\\left(\\dfrac{\\pi}{2}-x\\right)+\\cos(-x)$\n\n$A=?$",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "2\\cos x"
				}
			],
			"correction": {
				"steps": [
					"$\\cos\\left(\\dfrac{\\pi}{2}-x\\right)=\\sin x$, $\\sin(\\pi+x)=-\\sin x$, $\\sin\\left(\\dfrac{\\pi}{2}-x\\right)=\\cos x$ et $\\cos(-x)=\\cos x$.",
					"$A=\\sin x-\\sin x+\\cos x+\\cos x=\\textcolor{{{color:primary.0}}}{2\\cos x }$."
				]
			}
		}
	],

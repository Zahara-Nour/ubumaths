					"```trig\npreset: custom\nangles: 0, pi\nequation: sin(x) > 0\nmode: arc\n```",
					"$S=\\textcolor{{{color:primary.0}}}{\\left]0\\,;\\pi\\right[ }$."
				]
			}
		}

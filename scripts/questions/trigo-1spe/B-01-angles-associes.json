			"correction": {
				"steps": [
					"On écrit $\\dfrac{\\pi}{2}+x=\\dfrac{\\pi}{2}-(-x)$, donc $\\sin\\left(\\dfrac{\\pi}{2}+x\\right)=\\cos(-x)=\\cos x$.",
					"Donc $\\textcolor{{{color:primary.0}}}{\\sin\\left(\\dfrac{\\pi}{2}+x\\right)=\\cos x }$."
				]
			}

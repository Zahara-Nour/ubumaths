	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\cos x$.\n\nLa fonction $f$ est :",
			"variables": [],
			"choices": [
				{
					"content": "paire"
				},
				{
					"content": "impaire"
				},
				{
					"content": "ni paire ni impaire"
				}
			],
			"correctChoiceIndex": ["0"],
			"correction": {
				"steps": [
					"$\\mathbb{R}$ est symétrique par rapport à $0$ et, pour tout réel $x$, $f(-x)=\\cos(-x)=\\cos x=f(x)$.",
					"La fonction cosinus est donc **paire** : sa courbe est symétrique par rapport à l'axe des ordonnées."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\sin x$.\n\nLa fonction $f$ est :",
			"variables": [],
			"choices": [
				{
					"content": "paire"
				},
				{
					"content": "impaire"
				},
				{
					"content": "ni paire ni impaire"
				}
			],
			"correctChoiceIndex": ["1"],
			"correction": {
				"steps": [
					"$\\mathbb{R}$ est symétrique par rapport à $0$ et, pour tout réel $x$, $f(-x)=\\sin(-x)=-\\sin x=-f(x)$.",
					"La fonction sinus est donc **impaire** : sa courbe est symétrique par rapport à l'origine."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\sin({{k}}x)$.\n\nLa fonction $f$ est :",
			"variables": [
				{
					"name": "k",

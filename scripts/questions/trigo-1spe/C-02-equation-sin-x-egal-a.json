	"variations": [
		{
			"statement": "Résous dans $\\left[0\\,;2\\pi\\right[$ l'équation $\\sin x={{eval:sin(n*pi/12)}}$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [
				{
					"name": "a",
					"expression": "\\frac{\\pi}{6}|\\frac{\\pi}{4}|\\frac{\\pi}{3}"
				},
				{
					"name": "n",
					"expression": "eval:12*a/\\pi"
				},
				{
					"name": "c",
					"expression": "eval:n/gcd(abs(n),12)"
				},
				{
					"name": "q",
					"expression": "eval:12/gcd(abs(n),12)"
				},
				{
					"name": "u",
					"expression": "eval:(12-n)/gcd(12-n,12)"
				},
				{
					"name": "w",
					"expression": "eval:12/gcd(12-n,12)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\{{{a}};\\frac{ {{u}}\\pi}{ {{w}} }\\}"
				}
			],
			"correction": {
				"steps": [
					"$\\sin {{a}}={{eval:sin(n*pi/12)}}$ et $\\sin(\\pi-x)=\\sin x$ : les points du cercle d'ordonnée ${{eval:sin(n*pi/12)}}$ sont associés à ${{a}}$ et $\\pi-{{a}}=\\frac{ {{u}}\\pi}{ {{w}} }$.",
					"```trig\npreset: custom\nangles: {{c}}*pi/{{q}}, {{u}}*pi/{{w}}\nequation: sin(x) = sin({{n}}*pi/12)\nmode: points\n```",
					"$S=\\textcolor{{{color:primary.0}}}{\\left\\{{{a}}\\,;\\frac{ {{u}}\\pi}{ {{w}} }\\right\\} }$."
				]
			}
		},
		{
			"statement": "Résous dans $\\left[0\\,;2\\pi\\right[$ l'équation $\\sin x={{eval:-sin(n*pi/12)}}$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [

				{
					"name": "w",
					"expression": "eval:12/gcd(12+n,12)"
				},
				{
					"name": "g",
					"expression": "eval:(24-n)/gcd(24-n,12)"
				},
				{
					"name": "h",
					"expression": "eval:12/gcd(24-n,12)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\{\\frac{ {{u}}\\pi}{ {{w}} };\\frac{ {{g}}\\pi}{ {{h}} }\\}"
				}
			],
			"correction": {
				"steps": [
					"$\\sin\\left(-{{a}}\\right)={{eval:-sin(n*pi/12)}}$ : un point est associé à $-{{a}}$, qui s'écrit $2\\pi-{{a}}=\\frac{ {{g}}\\pi}{ {{h}} }$ dans $\\left[0\\,;2\\pi\\right[$ ; l'autre à $\\pi+{{a}}=\\frac{ {{u}}\\pi}{ {{w}} }$.",
					"```trig\npreset: custom\nangles: {{u}}*pi/{{w}}, {{g}}*pi/{{h}}\nequation: sin(x) = sin(-{{n}}*pi/12)\nmode: points\n```",
					"$S=\\textcolor{{{color:primary.0}}}{\\left\\{\\frac{ {{u}}\\pi}{ {{w}} }\\,;\\frac{ {{g}}\\pi}{ {{h}} }\\right\\} }$."
				]
			}
		},
		{

		},
		{
			"statement": "Résous dans $\\left[0\\,;2\\pi\\right[$ l'équation $\\sin x=\\sin\\frac{ {{k}}\\pi}{ {{n}} }$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [
				{
					"name": "n",
					"expression": "5|7"

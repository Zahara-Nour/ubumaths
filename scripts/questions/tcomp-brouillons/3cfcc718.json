	"options": {
		"constraints": {
			"spaces": "off"
		}
	},
	"variations": [
		{
			"blanks": [
				{
					"expectedAnswer": "{{eval:1/(b-a)}}"
				}
			],
			"statement": "On définit sur $\\left[{{a}}\\,;{{b}}\\right]$ la fonction constante $f(x)=k$, avec $k$ réel.\n\nPour quelle valeur de $k$ la fonction $f$ est-elle une densité de probabilité sur $\\left[{{a}}\\,;{{b}}\\right]$ ?\n\n$k=?$",
			"variables": [
				{
					"name": "a",
					"expression": "0..5"
				},
				{
					"name": "b",
					"expression": "{{eval:a+2}}..{{eval:a+12}}"
				}
			],
			"correction": {
				"steps": [
					"Une densité est positive et l'aire sous sa courbe vaut $1$ : $\\displaystyle\\int_{ {{a}} }^{ {{b}} }k\\,\\mathrm{d}x=k\\times({{b}}-{{a}})=1$.",
					"$k=\\textcolor{{{color:primary.0}}}{{{eval:1/(b-a)}}}$."
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "{{eval:2/a^2}}"
				}
			],
			"statement": "On définit sur $\\left[0\\,;{{a}}\\right]$ la fonction $f(x)=kx$, avec $k$ réel strictement positif.\n\nPour quelle valeur de $k$ la fonction $f$ est-elle une densité de probabilité sur $\\left[0\\,;{{a}}\\right]$ ?\n\n$k=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..10"
				}
			],
			"correction": {
				"steps": [
					"$f$ est positive ; il faut $\\displaystyle\\int_{0}^{ {{a}} }kx\\,\\mathrm{d}x=\\left[\\dfrac{kx^{2}}{2}\\right]_{0}^{ {{a}} }=\\dfrac{ {{eval:a^2}}k}{2}=1$.",
					"$k=\\dfrac{2}{ {{eval:a^2}} }=\\textcolor{{{color:primary.0}}}{{{eval:2/a^2}}}$."
				]
			}
		}
	],

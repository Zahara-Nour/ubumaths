	"title": "Loi à densité : constante de normalisation",
	"description": "Constante k pour que f soit une densité (aire totale 1) (piège : b − a au lieu de 1/(b − a))",
	"grades": ["T_COMP"],
	"level": 2,
	"delay": 60,
	"status": "draft",
	"shared": {
		"blankDefaults": {
			"acceptDecimal": true
		}

	"variations": [
		{
			"statement": "Calcule la valeur exacte de $\\displaystyle\\int_{{{if:j==0|0}}{{if:j==1|0}}{{if:j==2|-\\frac{\\pi}{2}}}{{if:j==3|0}}}^{{{if:j==0|\\frac{\\pi}{6}}}{{if:j==1|\\frac{\\pi}{2}}}{{if:j==2|\\frac{\\pi}{2}}}{{if:j==3|\\pi}}}{{if:k<0|\\left(}}{{if:k==1||{{if:k==-1|-|{{k}}}}}}\\cos(x){{if:k<0|\\right)}}\\,\\mathrm{d}x$.\n\n$?$",
			"variables": [
				{
					"name": "k",
					"expression": "1..5;±"
				},
				{
					"name": "j",
					"expression": "0..3"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{if:j==0|{{eval:k/2}}}}{{if:j==1|{{k}}}}{{if:j==2|{{eval:2*k}}}}{{if:j==3|0}}",
					"expectedErrors": [
						{
							"answer": "{{if:j==0|{{eval:-k/2}}}}{{if:j==1|{{eval:-k}}}}{{if:j==2|{{eval:-2*k}}}}{{if:j==3|0}}",
							"message": "Une primitive de $\\cos$ est $\\sin$ (et non $-\\sin$), et l'on calcule $F\\left( b \\right) - F\\left( a \\right)$, borne du haut moins borne du bas.",
							"label": "Signe"
						},
						{
							"answer": "{{if:j==2|{{k}}|{{if:j==0|{{eval:k/2}}}}{{if:j==1|{{k}}}}{{if:j==2|{{eval:2*k}}}}{{if:j==3|0}}}}",
							"message": "Tu as oublié de retrancher $F\\left({{if:j==0|0}}{{if:j==1|0}}{{if:j==2|-\\frac{\\pi}{2}}}{{if:j==3|0}}\\right)$, qui ne vaut pas $0$ ici.",
							"label": "F(a) oublié"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"Une primitive de $x\\mapsto {{if:k==1||{{if:k==-1|-|{{k}}}}}}\\cos(x)$ est $F(x)={{if:k==1||{{if:k==-1|-|{{k}}}}}}\\sin(x)$.",
					"$\\displaystyle\\int_{{{if:j==0|0}}{{if:j==1|0}}{{if:j==2|-\\frac{\\pi}{2}}}{{if:j==3|0}}}^{{{if:j==0|\\frac{\\pi}{6}}}{{if:j==1|\\frac{\\pi}{2}}}{{if:j==2|\\frac{\\pi}{2}}}{{if:j==3|\\pi}}}{{if:k<0|\\left(}}{{if:k==1||{{if:k==-1|-|{{k}}}}}}\\cos(x){{if:k<0|\\right)}}\\,\\mathrm{d}x=F\\left({{if:j==0|\\frac{\\pi}{6}}}{{if:j==1|\\frac{\\pi}{2}}}{{if:j==2|\\frac{\\pi}{2}}}{{if:j==3|\\pi}}\\right)-F\\left({{if:j==0|0}}{{if:j==1|0}}{{if:j==2|-\\frac{\\pi}{2}}}{{if:j==3|0}}\\right)={{if:k==1||{{if:k==-1|-|{{k}}}}}}\\left(\\sin\\left({{if:j==0|\\frac{\\pi}{6}}}{{if:j==1|\\frac{\\pi}{2}}}{{if:j==2|\\frac{\\pi}{2}}}{{if:j==3|\\pi}}\\right)-\\sin\\left({{if:j==0|0}}{{if:j==1|0}}{{if:j==2|-\\frac{\\pi}{2}}}{{if:j==3|0}}\\right)\\right)={{k}}\\times{{if:j==0|\\frac{1}{2}}}{{if:j==1|1}}{{if:j==2|2}}{{if:j==3|0}}=\\textcolor{{{color:primary.0}}}{{{if:j==0|{{eval:k/2}}}}{{if:j==1|{{k}}}}{{if:j==2|{{eval:2*k}}}}{{if:j==3|0}}}$."
				]
			},
			"hint": "Cherche une primitive de $\\cos$, puis calcule $F(b)-F(a)$ avec les valeurs remarquables du sinus."
		},
		{
			"statement": "Calcule la valeur exacte de $\\displaystyle\\int_{{{if:j==0|0}}{{if:j==1|0}}{{if:j==2|-\\frac{\\pi}{2}}}{{if:j==3|\\frac{\\pi}{2}}}}^{{{if:j==0|\\frac{\\pi}{2}}}{{if:j==1|\\pi}}{{if:j==2|\\frac{\\pi}{2}}}{{if:j==3|\\pi}}}{{if:k<0|\\left(}}{{if:k==1||{{if:k==-1|-|{{k}}}}}}\\sin(x){{if:k<0|\\right)}}\\,\\mathrm{d}x$.\n\n$?$",
			"variables": [

					"$\\displaystyle\\int_{{{if:j==0|0}}{{if:j==1|0}}{{if:j==2|-\\frac{\\pi}{2}}}{{if:j==3|\\frac{\\pi}{2}}}}^{{{if:j==0|\\frac{\\pi}{2}}}{{if:j==1|\\pi}}{{if:j==2|\\frac{\\pi}{2}}}{{if:j==3|\\pi}}}{{if:k<0|\\left(}}{{if:k==1||{{if:k==-1|-|{{k}}}}}}\\sin(x){{if:k<0|\\right)}}\\,\\mathrm{d}x=F\\left({{if:j==0|\\frac{\\pi}{2}}}{{if:j==1|\\pi}}{{if:j==2|\\frac{\\pi}{2}}}{{if:j==3|\\pi}}\\right)-F\\left({{if:j==0|0}}{{if:j==1|0}}{{if:j==2|-\\frac{\\pi}{2}}}{{if:j==3|\\frac{\\pi}{2}}}\\right)={{if:k==-1||{{if:k==1|-|{{eval:-k}}}}}}\\left(\\cos\\left({{if:j==0|\\frac{\\pi}{2}}}{{if:j==1|\\pi}}{{if:j==2|\\frac{\\pi}{2}}}{{if:j==3|\\pi}}\\right)-\\cos\\left({{if:j==0|0}}{{if:j==1|0}}{{if:j==2|-\\frac{\\pi}{2}}}{{if:j==3|\\frac{\\pi}{2}}}\\right)\\right)={{eval:-k;()}}\\times\\left({{if:j==0|0-1}}{{if:j==1|-1-1}}{{if:j==2|0-0}}{{if:j==3|-1-0}}\\right)=\\textcolor{{{color:primary.0}}}{{{if:j==0|{{k}}}}{{if:j==1|{{eval:2*k}}}}{{if:j==2|0}}{{if:j==3|{{k}}}}}$."

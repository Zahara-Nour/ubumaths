	"variations": [
		{
			"statement": "La suite $(u_n)$ est définie par $u_0={{eval:u0}}$, $u_1={{eval:u1}}$ et, pour tout entier naturel $n$, $u_{n+2}={{eval:a}}u_{n+1}+({{eval:b}})u_n$.\n\nCalcule $u_2$ et $u_3$.\n\n$u_2=?$ et $u_3=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..3;±"
				},
				{
					"name": "b",
					"expression": "1..3;±"
				},
				{
					"name": "u0",
					"expression": "-3..3"
				},
				{
					"name": "u1",
					"expression": "1..3;±"
				},
				{
					"name": "u2",
					"expression": "eval:(a)*(u1)+(b)*(u0)"
				}

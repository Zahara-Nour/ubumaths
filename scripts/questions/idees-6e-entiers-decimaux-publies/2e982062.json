		{
			"statement": "Écris un nombre décimal compris entre ${{lo}}$ et ${{hi}}$.\n\n$${{lo}} < ? < {{hi}}$$",
			"variables": [
				{
					"name": "t",
					"expression": "0..2"
				},
				{
					"name": "a",
					"expression": "0..20"
				},
				{
					"name": "b",
					"expression": "0..8"
				},
				{
					"name": "c",
					"expression": "0..9"
				},
				{
					"name": "d",
					"expression": "1..9"
				},
				{
					"name": "LO",
					"expression": "eval:1000*a+(1-min(t,1))*990+min(max(t-1,0),1)*(100*b+10*c+d)"
				},
				{
					"name": "HI",
					"expression": "eval:1000*a+(1-min(t,1))*1000+(1-min(abs(t-1),1))*100+min(max(t-1,0),1)*100*(b+1)"
				},
				{
					"name": "lo",
					"expression": "eval:LO/1000;d"
				},
				{
					"name": "hi",
					"expression": "eval:HI/1000;d"
				},
				{
					"name": "EX",
					"expression": "eval:(LO+(1-min(t,1))*5+(1-min(abs(t-1),1))*50+min(max(t-1,0),1)*(HI-LO-1))/1000;d"
				}
			],
			"conditions": ["10*c+d<89"],
			"blanks": [
				{
					"rulesSuffice": true,
					"expectedAnswer": "{{EX}}",

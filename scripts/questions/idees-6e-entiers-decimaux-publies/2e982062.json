							"type": "range",
							"inclusive": false
						}
					]
				}
			],
			"correction": {
				"steps": [
					"**Intercaler.** On écrit les deux nombres avec autant de chiffres après la virgule, puis on en ajoute un : il apparaît de la place entre eux.",
					"{{if:t==0|${{lo}} = {{a}}.990$ et ${{hi}} = {{hi}}.000$ : tout nombre de millièmes entre $990$ et $1000$ convient après ${{a}}$, par exemple $\\textcolor{{{color:primary.0}}}{{{solution}}}$ (mais aussi ${{a}}.991$, ${{a}}.999$…).|{{if:t==1|${{lo}} = {{a}}.00$ et ${{hi}} = {{a}}.10$ : tout nombre de centièmes entre $0$ et $10$ convient, par exemple $\\textcolor{{{color:primary.0}}}{{{solution}}}$ (mais aussi ${{a}}.01$, ${{a}}.09$…).|${{hi}} = {{a}}.{{eval:b+1}}00$ : il suffit d'un nombre de millièmes entre ${{b}}{{c}}{{d}}$ et ${{eval:b+1}}00$, par exemple $\\textcolor{{{color:primary.0}}}{{{solution}}}$ (mais aussi ${{eval:(HI-10)/1000;d}}$…).}}}}"
				]
			},
			"hint": "Écris les deux nombres avec le même nombre de chiffres après la virgule, puis ajoute un chiffre : de la place apparaît entre eux."
		}

			],
			"statement": "Dans le nombre ${{n}}$, quel est le chiffre des {{if:r==0|unités|{{if:r==1|dizaines|{{if:r==2|centaines|{{if:r==3|unités de mille|{{if:r==4|dizaines de mille|{{if:r==5|centaines de mille|{{if:r==6|unités de millions|{{if:r==7|dizaines de millions|{{if:r==8|centaines de millions|{{if:r==9|unités de milliards|{{if:r==10|dizaines de milliards|centaines de milliards}}}}}}}}}}}}}}}}}}}}}} ?\n\n$$?$$",
			"variables": [
				{
					"name": "c",
					"expression": "6..12"
				},
				{
					"name": "n",
					"expression": "digits:c"
				},
				{
					"name": "cm",
					"expression": "eval:c-1"
				},
				{
					"name": "r",
					"expression": "1..{{cm}}"
				},
				{
					"name": "k",
					"expression": "eval:floor(r/3)"
				},
				{
					"name": "ch",
					"expression": "eval:mod(floor(n/10^r),10)"
				}
			],
			"conditions": ["mod(floor(n/10^(r+1)),10)!=ch", "mod(floor(n/10^(r-1)),10)!=ch"],
			"correction": {
				"steps": [
					"**Les rangs.** On découpe le nombre en classes de trois chiffres à partir de la droite : classe des unités, des mille, des millions, des milliards. Dans chaque classe, de droite à gauche : unités, dizaines, centaines.",
					"Le chiffre des {{if:r==0|unités|{{if:r==1|dizaines|{{if:r==2|centaines|{{if:r==3|unités de mille|{{if:r==4|dizaines de mille|{{if:r==5|centaines de mille|{{if:r==6|unités de millions|{{if:r==7|dizaines de millions|{{if:r==8|centaines de millions|{{if:r==9|unités de milliards|{{if:r==10|dizaines de milliards|centaines de milliards}}}}}}}}}}}}}}}}}}}}}} est dans la classe des {{if:k==0|unités|{{if:k==1|mille|{{if:k==2|millions|milliards}}}}}}. Dans ${{n}}$, c'est $\\textcolor{{{color:primary.0}}}{{{solution}}}$."
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "{{ch}}"
				}
			],
			"statement": "Dans le nombre ${{x}}$, quel est le chiffre des {{if:t==0|millièmes|{{if:t==1|centièmes|{{if:t==2|dixièmes|{{if:t==3|unités|{{if:t==4|dizaines|centaines}}}}}}}}}} ?\n\n$$?$$",
			"variables": [

		{
			"statement": "Comment lit-on cette écriture ?\n\n$${{a}}{{if:s==0|+|-}}{{b}}$$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				},
				{
					"name": "b",
					"expression": "1..8"
				},
				{
					"name": "r",
					"expression": "0..2"
				},
				{
					"name": "s",
					"expression": "eval:ceil(r/2)"
				}
			],
			"conditions": ["a > b"],
			"choices": [
				{
					"content": "« ${{a}}$ plus ${{b}}$ »"
				},
				{
					"content": "« ${{a}}$ moins ${{b}}$ »"
				},
				{
					"content": "« ${{a}}$ égale ${{b}}$ »"
				}
			],
			"correctChoiceIndex": ["{{s}}"],
			"correction": {
				"steps": [
					"{{if:s==0|Le signe $+$ se lit « plus » : on part de ${{a}}$ et on **ajoute** ${{b}}$.|Le signe $-$ se lit « moins » : on part de ${{a}}$ et on **enlève** ${{b}}$.}}",
					"$${{a}}{{if:s==0|+|-}}{{b}}={{if:s==0|{{eval:a+b}}|{{eval:a-b}}}}$$"
				]
			}

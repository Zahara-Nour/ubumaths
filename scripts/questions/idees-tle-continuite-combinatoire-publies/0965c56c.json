			"spaces": "off"
		}
	},
	"variations": [
		{
			"blanks": [
				{
					"expectedAnswer": "{{eval:factorial(n)/factorial(n-k)}}",
					"acceptCombinatorialNotation": true
				}
			],
			"statement": "Un code est formé de ${{k}}$ chiffres (de $0$ à $9$) **tous différents**.\n\nCombien de codes différents existe-t-il ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "10"
				},
				{
					"name": "k",
					"expression": "3..5"
				}
			],
			"correction": {
				"steps": [
					"L'ordre compte et les chiffres sont distincts : on compte des ${{k}}$-uplets d'éléments distincts de $\\{0,\\dots,9\\}$.",
					"$\\dfrac{10!}{ {{eval:10-k}}! }=\\textcolor{{{color:primary.0}}}{{{eval:factorial(n)/factorial(n-k)}}}$ (et non $10^{ {{k}} }$, qui autorise les répétitions)."
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "{{eval:n*(n-1)*(n-2)*(n-3)}}",
					"acceptCombinatorialNotation": true
				}
			],
			"statement": "Une association de ${{n}}$ membres élit son bureau : un président, un vice-président, un trésorier et un secrétaire, quatre personnes différentes.\n\nCombien de bureaux différents sont possibles ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "10..25"
				}
			],
			"correction": {
				"steps": [
					"Les rôles sont différents : l'ordre compte. On compte des $4$-uplets de membres distincts.",
					"${{n}}\\times{{eval:n-1}}\\times{{eval:n-2}}\\times{{eval:n-3}}=\\textcolor{{{color:primary.0}}}{{{eval:n*(n-1)*(n-2)*(n-3)}}}$ (et non $\\binom{ {{n}} }{4}$, qui ignore les rôles)."
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "{{eval:factorial(n)/factorial(n-k)}}",
					"acceptCombinatorialNotation": true
				}
			],
			"statement": "${{k}}$ amis entrent dans une salle de cinéma où une rangée de ${{n}}$ fauteuils est libre.\n\nDe combien de façons peuvent-ils s'asseoir dans cette rangée, un par fauteuil ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "8..12"
				},
				{
					"name": "k",
					"expression": "3..4"
				}
			],
			"correction": {
				"steps": [
					"On attribue à chaque ami un fauteuil, deux amis n'ayant jamais le même : ${{k}}$-uplets de fauteuils distincts.",
					"$\\dfrac{ {{n}}! }{ {{eval:n-k}}! }=\\textcolor{{{color:primary.0}}}{{{eval:factorial(n)/factorial(n-k)}}}$."
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "720",
					"acceptCombinatorialNotation": true
				}
			],
			"statement": "Une anagramme d'un mot est un mot (ayant un sens ou non) formé avec exactement les mêmes lettres.\n\nCombien le mot PYTHON a-t-il d'anagrammes, lui-même compris ?\n\n$?$",
			"correction": {
				"steps": [
					"Les $6$ lettres de PYTHON sont toutes différentes : une anagramme est une permutation de ces $6$ lettres.",
					"$6!=\\textcolor{{{color:primary.0}}}{720}$."
				]
			}
		},
		{
			"statement": "Un code est formé de ${{n}}$ chiffres (de $0$ à $9$, chacun pouvant se répéter), suivis de ${{p}}$ lettres **toutes différentes** choisies parmi les ${{L}}$ lettres de A à {{if:L==5|E|{{if:L==6|F|{{if:L==7|G|H}}}}}}.\n\nCombien de codes différents existe-t-il ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "2..4"
				},
				{
					"name": "p",
					"expression": "2..3"
				},
				{
					"name": "L",
					"expression": "5..8"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{eval:10^n*factorial(L)/factorial(L-p)}}",
					"acceptCombinatorialNotation": true,
					"expectedErrors": [
						{
							"answer": "{{eval:10^n*L^p}}",
							"message": "Les lettres sont toutes différentes : il reste une lettre de moins à chaque choix.",
							"label": "Lettres répétées"
						},
						{
							"answer": "{{eval:factorial(10)/factorial(10-n)*factorial(L)/factorial(L-p)}}",
							"message": "Les chiffres peuvent se répéter : ${{eval:10^n}}$ façons de les choisir.",
							"label": "Chiffres distincts"
						},
						{
							"answer": "{{eval:10^n+factorial(L)/factorial(L-p)}}",
							"message": "On choisit les chiffres ET les lettres : on multiplie les nombres de choix.",
							"label": "Somme au lieu du produit"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"Les chiffres peuvent se répéter : $10^{ {{n}} }={{eval:10^n}}$ façons de les choisir.",
					"Les lettres sont distinctes et l'ordre compte : $\\dfrac{ {{L}}! }{ {{eval:L-p}}! }={{eval:factorial(L)/factorial(L-p)}}$ façons.",
					"Principe multiplicatif : ${{eval:10^n}}\\times{{eval:factorial(L)/factorial(L-p)}}=\\textcolor{{{color:primary.0}}}{ {{eval:10^n*factorial(L)/factorial(L-p)}} }$."
				]
			},
			"hint": "Compte séparément les choix des chiffres et ceux des lettres, puis combine-les."
		}
	],

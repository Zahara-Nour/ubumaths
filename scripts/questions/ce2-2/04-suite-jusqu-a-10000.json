			],
			"correction": {
				"steps": [
					"Le nombre qui suit, c'est celui qu'on dit juste après en comptant : on avance de $1$.",
					"{{if:b==9|${{n}}$ se termine par $999$ : on passe au millier suivant, les centaines, les dizaines et les unités reviennent à $0$.|${{n}}$ se termine par $99$ : on passe à la centaine suivante, les dizaines et les unités reviennent à $0$.}}",
					"$${{n}} \\rightarrow {{solution}}$$"
				]
			}
		},
		{
			"statement": "Le nombre qui précède ${{n}}$ est $?$.",
			"variables": [
				{
					"name": "a",
					"expression": "1..10"
				},
				{
					"name": "b",
					"expression": "0..9"
				},
				{
					"name": "c",
					"expression": "0..9"
				},
				{
					"name": "n",
					"expression": "eval:1000*a+100*b+10*c"
				}
			],
			"conditions": ["1000*a + 100*b + 10*c <= 10000"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n-1}}"
				}
			],
			"correction": {
				"steps": [
					"Le nombre qui précède, c'est celui qu'on dit juste avant en comptant : on recule de $1$.",
					"{{if:c>0|${{n}}$ se termine par $0$ : on revient à la dizaine précédente, le chiffre des unités devient $9$.|{{if:b>0|${{n}}$ se termine par $00$ : on revient à la centaine précédente, les dizaines et les unités deviennent $9$.|${{n}}$ se termine par $000$ : on revient au millier précédent, les centaines, les dizaines et les unités deviennent $9$.}}}}",
					"$${{solution}} \\rightarrow {{n}}$$"
				]
			}
		}
	],

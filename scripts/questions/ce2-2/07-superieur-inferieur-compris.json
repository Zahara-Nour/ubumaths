				"steps": [
					"Un nombre supérieur à ${{n}}$ est plus grand que ${{n}}$ : il vient après dans la suite des nombres.",
					"Par exemple ${{eval:n+1}}$ ou ${{eval:n+10}}$ : $${{eval:n+1}} > {{n}}$$"

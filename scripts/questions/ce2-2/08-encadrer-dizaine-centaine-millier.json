				{
					"expectedAnswer": "{{eval:n-1}}"
				},
				{
					"expectedAnswer": "{{eval:n+1}}"
				}
			],
			"correction": {
				"steps": [
					"Le nombre juste avant, c'est celui qui précède ; le nombre juste après, celui qui suit.",
					"$${{eval:n-1}} < {{n}} < {{eval:n+1}}$$"
				]
			}
		},

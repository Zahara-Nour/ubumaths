					"expression": "2..3"
				},
				{
					"name": "p",
					"expression": "1..4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:m^p}}"
				}
			],
			"correction": {
				"steps": [
					"Par définition, ${{eval:m^q}}^{\\frac{{{eval:p}}}{{{eval:q}}}}=e^{\\frac{{{eval:p}}}{{{eval:q}}}\\ln({{eval:m^q}})}$, et $\\ln({{eval:m^q}})=\\ln({{eval:m}}^{{{eval:q}}})={{eval:q}}\\ln({{eval:m}})$.",
					"Donc ${{eval:m^q}}^{\\frac{{{eval:p}}}{{{eval:q}}}}=e^{{{eval:p}}\\ln({{eval:m}})}={{eval:m}}^{{{eval:p}}}$.",
					"Donc $\\textcolor{{{color:primary.0}}}{{{eval:m^q}}^{\\frac{{{eval:p}}}{{{eval:q}}}}={{eval:m^p}}}$."
				]
			},
			"conditions": ["gcd(p,q) == 1"]
		},
		{
			"statement": "Pour tout réel $x>0$ et tout réel $a$, on définit $x^a=e^{a\\ln(x)}$.\n\nLa fonction $f$ est définie sur $]0;+\\infty[$ par $f(x)=x^{\\frac{{{eval:p}}}{{{eval:q}}}}$.\n\nComplète.\n\n$f'(x)=?\\,x^{?}$",
			"variables": [
				{
					"name": "q",
					"expression": "2..4"
				},
				{
					"name": "p",
					"expression": "1..7"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:p/q}}"
				},
				{
					"expectedAnswer": "{{eval:(p-q)/q}}"
				}
			],
			"correction": {
				"steps": [
					"$f(x)=e^{\\frac{{{eval:p}}}{{{eval:q}}}\\ln(x)}$, donc $f'(x)=\\frac{{{eval:p}}}{{{eval:q}}}\\times\\dfrac{1}{x}\\times e^{\\frac{{{eval:p}}}{{{eval:q}}}\\ln(x)}=\\frac{{{eval:p}}}{{{eval:q}}}\\times\\dfrac{x^{\\frac{{{eval:p}}}{{{eval:q}}}}}{x}$.",
					"Or $\\dfrac{x^{\\frac{{{eval:p}}}{{{eval:q}}}}}{x}=e^{\\frac{{{eval:p}}}{{{eval:q}}}\\ln(x)-\\ln(x)}=x^{\\frac{{{eval:p}}}{{{eval:q}}}-1}$.",
					"Donc $\\textcolor{{{color:primary.0}}}{f'(x)=\\frac{{{eval:p}}}{{{eval:q}}}x^{{{if:p<q|-|}}\\frac{{{eval:abs(p-q)}}}{{{eval:q}}}}}$ : la formule $(x^n)'=nx^{n-1}$ reste vraie pour un exposant réel."
				]
			},
			"conditions": ["gcd(p,q) == 1"]
		},
		{
			"statement": "Pour tout réel $x>0$ et tout réel $a$, on définit $x^a=e^{a\\ln(x)}$.\n\nLa fonction $f$ est définie sur $]0;+\\infty[$ par $f(x)=x^{-\\frac{{{eval:p}}}{{{eval:q}}}}$.\n\nQuelle phrase la décrit ?\n\n```choix\n- $f$ est strictement décroissante, de limite $0$ en $+\\infty$\n- $f$ est strictement croissante, de limite $+\\infty$ en $+\\infty$\n- $f$ est strictement décroissante, de limite $-\\infty$ en $+\\infty$\n- $f$ est strictement décroissante, de limite $1$ en $+\\infty$\n```",
			"variables": [
				{
					"name": "q",
					"expression": "2..4"
				},
				{
					"name": "p",
					"expression": "1..7"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"$f(x)=e^{-\\frac{{{eval:p}}}{{{eval:q}}}\\ln(x)}$ et $f'(x)=-\\frac{{{eval:p}}}{{{eval:q}}}\\times\\dfrac{1}{x}\\,e^{-\\frac{{{eval:p}}}{{{eval:q}}}\\ln(x)}<0$ : $f$ est strictement décroissante.",
					"Quand $x\\to+\\infty$, $-\\frac{{{eval:p}}}{{{eval:q}}}\\ln(x)\\to-\\infty$, et $e^{X}\\to 0$ quand $X\\to-\\infty$.",
					"Donc $\\textcolor{{{color:primary.0}}}{f\\text{ est strictement décroissante, de limite }0}$ en $+\\infty$."
				]
			},
			"conditions": ["gcd(p,q) == 1"]
		},
		{
			"statement": "Pour tout réel $x>0$ et tout réel $a$, on définit $x^a=e^{a\\ln(x)}$.\n\nPourquoi a-t-on $x^{\\frac{1}{2}}=\\sqrt{x}$ pour tout $x>0$ ?\n\n```choix\n- $x^{\\frac{1}{2}}=e^{\\frac{1}{2}\\ln(x)}$ est positif et son carré vaut $e^{\\ln(x)}=x$\n- Parce que $\\dfrac{1}{2}\\ln(x)=\\ln\\left(\\dfrac{x}{2}\\right)$\n- Parce que $x^{\\frac{1}{2}}=\\dfrac{x}{2}$\n- Parce que $e^{\\ln(x)}=x$ suffit\n```",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"$x^{\\frac{1}{2}}=e^{\\frac{1}{2}\\ln(x)}>0$, comme toute exponentielle.",
					"$\\left(e^{\\frac{1}{2}\\ln(x)}\\right)^2=e^{2\\times\\frac{1}{2}\\ln(x)}=e^{\\ln(x)}=x$.",
					"$\\sqrt{x}$ est le seul réel positif de carré $x$ : $\\textcolor{{{color:primary.0}}}{x^{\\frac{1}{2}}=\\sqrt{x}}$."
				]
			}
		}
	],

	"domain": "Polynôme du second degré",
	"subdomain": "Racines",
	"level": 3,
	"delay": 20,
	"status": "published",
	"options": {
		"orderIndependent": true
	},
	"variations": [
		{
			"blanks": [
				{
					"expectedAnswer": "{{eval:-(b)}}"
				},
				{
					"expectedAnswer": "{{eval:-(c)}}"
				}
			],
			"statement": "Détermine les racines de ce polynôme du second degré.\n\n$${{a}}(x{{eval:b;+}})(x{{eval:c;+}})$$\n\nLes racines sont $?$ et $?$.",
			"variables": [
				{
					"name": "a",
					"expression": "2..5;±"
				},
				{
					"name": "b",
					"expression": "1..5;±"
				},
				{
					"name": "c",
					"expression": "1..5;±"
				}
			],
			"conditions": ["abs(b) != abs(c)"],
			"correction": {
				"steps": [
					"Un produit de facteurs est nul si et seulement si l'un de ses facteurs est nul ($a = {{a}} \\ne 0$) :",
					"$x{{eval:b;+}} = 0$ ou $x{{eval:c;+}} = 0$, donc les racines sont ${{eval:-(b)}}$ et ${{eval:-(c)}}$."
				]
			}
		}
	],

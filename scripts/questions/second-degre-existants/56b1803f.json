				{
					"name": "c",
					"expression": "1..5;±"
				}
			],
			"correction": {
				"steps": [
					"Cette expression est la forme canonique $a(x-\\alpha)^2+\\beta$ avec $a = {{a}}$, $\\alpha = {{eval:-(b)}}$ et $\\beta = {{c}}$.",
					"Le sommet de la parabole est donc $S\\left( \\textcolor{{{color:primary.0}}}{{{eval:-(b)}}} \\,;\\, \\textcolor{{{color:primary.0}}}{{{c}}} \\right)$."
				]
			}
		}
	],

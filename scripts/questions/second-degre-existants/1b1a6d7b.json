					"expectedAnswer": "{{eval:-(c)}}"
				}
			],
			"statement": "Détermine les racines de ce polynôme du second degré.\n\n$$({{a}}x{{eval:a*(b);+}})(x{{eval:c;+}})$$\n\nLes racines sont $?$ et $?$.",
			"correction": {
				"steps": [
					"Le polynôme n'est **pas** complètement factorisé : on factorise ${{a}}$ dans le premier facteur, $({{a}}x{{eval:a*(b);+}}) = {{a}}(x{{eval:b;+}})$.",
					"La forme factorisée est ${{a}}(x{{eval:b;+}})(x{{eval:c;+}})$.",
					"Les racines sont donc ${{eval:-(b)}}$ et ${{eval:-(c)}}$."
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "{{eval:-(b)}}"

		"variables": [
			{
				"name": "a",
				"expression": "1..9"
			},
			{
				"name": "c",
				"expression": "x|y|z"
			}
		]
	},
	"variations": [
		{
			"blanks": [
				{
					"requiredForm": {
						"pattern": "u^2",
						"acceptable": "u*v"
					},
					"expectedAnswer": "({{c}}-{{a}})^2"
				}
			],
			"statement": "Factorise.\n\n$${{expression1}}$$",
			"variables": [
				{
					"name": "expression1",
					"expression": "{{c}}^2-{{eval:2*a}}{{c}}+{{eval:a^2}}"
				}
			],
			"correction": {
				"steps": [
					"On reconnaît l'identité remarquable $a^2-2ab+b^2=(a-b)^2$, avec $a={{c}}$ et $b={{a}}$ :",
					"$$\\begin{align} {{c}}^2 - {{eval:2*a}}{{c}} + {{eval:a^2}} &= {{c}}^2 - 2 \\times {{c}} \\times {{a}} + {{a}}^2 \\\\ &= {{solution}} \\end{align}$$",
					"L'écriture $({{a}}-{{c}})^2$ est aussi juste : $({{a}}-{{c}})^2=(-({{c}}-{{a}}))^2=({{c}}-{{a}})^2$."
				]
			}
		},
		{
			"blanks": [
				{
					"requiredForm": {
						"pattern": "u^2",
						"acceptable": "u*v"
					},
					"expectedAnswer": "({{c}}+{{a}})^2"
				}
			],
			"statement": "Factorise.\n\n$${{expression2}}$$",
			"variables": [
				{
					"name": "expression2",
					"expression": "{{c}}^2+{{eval:2*a}}{{c}}+{{eval:a^2}}"
				}
			],
			"correction": {
				"steps": [
					"On reconnaît l'identité remarquable $a^2+2ab+b^2=(a+b)^2$, avec $a={{c}}$ et $b={{a}}$ :",
					"$$\\begin{align} {{c}}^2 + {{eval:2*a}}{{c}} + {{eval:a^2}} &= {{c}}^2 + 2 \\times {{c}} \\times {{a}} + {{a}}^2 \\\\ &= {{solution}} \\end{align}$$",
					"L'écriture $(-{{c}}-{{a}})^2$ est aussi juste : $(-{{c}}-{{a}})^2=(-({{c}}+{{a}}))^2=({{c}}+{{a}})^2$."
				]
			}
		}
	],

{{if:s==1|R|}}{{if:s==2|E|}}.x + ({{am}}/{{ab}})*({{if:s==0|B|}}{{if:s==1|S|}}{{if:s==2|F|}}.x - {{if:s==0|A|}}{{if:s==1|R|}}{{if:s==2|E|}}.x), {{if:s==0|A|}}{{if:s==1|R|}}{{if:s==2|E|}}.y + ({{am}}/{{ab}})*({{if:s==0|B|}}{{if:s==1|S|}}{{if:s==2|F|}}.y - {{if:s==0|A|}}{{if:s==1|R|}}{{if:s==2|E|}}.y), etiquette=\"{{if:o==0|bas|haut}}\")\n{{if:s==0|N|}}{{if:s==1|V|}}{{if:s==2|L|}} = point({{if:s==0|A|}}{{if:s==1|R|}}{{if:s==2|E|}}.x + ({{an}}/{{ac}})*({{if:s==0|C|}}{{if:s==1|T|}}{{if:s==2|G|}}.x - {{if:s==0|A|}}{{if:s==1|R|}}{{if:s==2|E|}}.x), {{if:s==0|A|}}{{if:s==1|R|}}{{if:s==2|E|}}.y + ({{an}}/{{ac}})*({{if:s==0|C|}}{{if:s==1|T|}}{{if:s==2|G|}}.y - {{if:s==0|A|}}{{if:s==1|R|}}{{if:s==2|E|}}.y), etiquette=\"{{if:o==0|haut-gauche|bas-gauche}}\")\nsegment({{if:s==0|A|}}{{if:s==1|R|}}{{if:s==2|E|}}, {{if:s==0|B|}}{{if:s==1|S|}}{{if:s==2|F|}})\nsegment({{if:s==0|A|}}{{if:s==1|R|}}{{if:s==2|E|}}, {{if:s==0|C|}}{{if:s==1|T|}}{{if:s==2|G|}})\nsegment({{if:s==0|B|}}{{if:s==1|S|}}{{if:s==2|F|}}, {{if:s==0|C|}}{{if:s==1|T|}}{{if:s==2|G|}})\nsegment({{if:s==0|M|}}{{if:s==1|U|}}{{if:s==2|K|}}, {{if:s==0|N|}}{{if:s==1|V|}}{{if:s==2|L|}})\n```\n\n```choix\n- Elles sont parallèles, d'après la réciproque du théorème de Thalès.\n- Elles ne sont pas parallèles, d'après la contraposée du théorème de Thalès.\n- Elles sont parallèles, d'après le théorème de Thalès.\n- Elles ne sont pas parallèles, d'après la réciproque du théorème de Thalès.\n```",

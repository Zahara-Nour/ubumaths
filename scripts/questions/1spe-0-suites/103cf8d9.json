	"variations": [
		{
			"blanks": [
				{
					"expectedAnswer": "{{eval:C*(1+n*t/100)}}"
				}
			],
			"statement": "On place ${{C}}~\\unit{€}$ à **intérêts simples** au taux annuel de ${{t}}\\,\\%$ : chaque année, on ajoute au capital ${{t}}\\,\\%$ du capital initial.\n\nQuel est le capital au bout de ${{n}}$ années ?\n\nLe capital est de $?$ €.",
			"variables": [
				{
					"name": "k",
					"expression": "5..50"
				},
				{
					"name": "C",
					"expression": "eval:100*k"
				},
				{
					"name": "t",
					"expression": "1..6"
				},
				{
					"name": "n",
					"expression": "2..15"
				}
			],
			"correction": {
				"steps": [
					"Les intérêts annuels sont constants : $\\dfrac{ {{t}} }{100}\\times{{C}}={{eval:C*t/100}}~\\unit{€}$. Le capital $u_n$ au bout de $n$ années est une suite arithmétique de premier terme $u_0={{C}}$ et de raison ${{eval:C*t/100}}$.",
					"$$u_{ {{n}} }=u_0+{{n}}\\times{{eval:C*t/100}}={{C}}+{{eval:n*C*t/100}}=\\mathbf{ {{eval:C*(1+n*t/100)}} }$$"
				]
			}
		}
	],

					"expression": "eval:(a)^2+(c)"
				},
				{
					"name": "u2",
					"expression": "eval:(u1)^2+(c)"
				}
			],
			"correction": {
				"steps": [
					"Chaque terme est l'image du précédent par $f$ : $u_{n+1}=f(u_n)=u_n^2{{eval:c;+}}$.",
					"$$u_1=f(u_0)={{eval:a;()}}^2{{eval:c;+}}=\\textcolor{{{color:primary.0}}}{{{u1}}}$$",
					"$$u_2=f(u_1)=\\textcolor{{{color:primary.0}}}{{{eval:u1;()}}}^2{{eval:c;+}}={{solution}}$$"
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "{{u3}}"
				}
			],
			"statement": "Calcule le terme demandé.\n\n$u_1={{a}}$ et, pour tout entier $n\\geqslant 1$, $u_{n+1}=f(u_n)$ où $f(x)=\\dfrac{{{k}}}{x+1}$.\n\n$u_3=?$",
			"variables": [
				{
					"name": "a",
					"expression": "0..5"
				},
				{
					"name": "k",
					"expression": "2..6"
				},
				{
					"name": "u2",
					"expression": "eval:k/(a+1)"
				},
				{
					"name": "u3",
					"expression": "eval:k*(a+1)/(k+a+1)"
				}
			],
			"conditions": ["mod(k*(a+1), k+a+1) != 0", "mod(k,a+1) != 0"],
			"correction": {
				"steps": [
					"Le premier terme est $u_1$ : le terme suivant est $u_2=f(u_1)$, puis $u_3=f(u_2)$.",
					"$$u_2=f(u_1)=\\dfrac{{{k}}}{{{a}}+1}=\\textcolor{{{color:primary.0}}}{{{u2}}}$$",
					"$$\\begin{align*} u_3=f(u_2)&=\\dfrac{{{k}}}{\\textcolor{{{color:primary.0}}}{{{u2}}}+1}=\\dfrac{{{k}}}{{{eval:(k+a+1)/(a+1)}}}\\\\ &={{k}}\\times{{eval:(a+1)/(k+a+1)}}={{solution}} \\end{align*}$$",
					"Diviser par une fraction, c'est multiplier par son inverse ; on donne le résultat sous forme de fraction irréductible."
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "{{u2}}"
				}
			],
			"statement": "Calcule le terme demandé.\n\n$u_0={{a}}$ et, pour tout entier naturel $n$, $u_{n+1}=f(u_n)$ où $f(x)=\\dfrac{x}{{{eval:k*x+1}}}$.\n\n$u_2=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..5"
				},
				{
					"name": "k",
					"expression": "1..3"
				},
				{
					"name": "u1",
					"expression": "eval:a/(k*a+1)"
				},
				{
					"name": "u2",
					"expression": "eval:a/(2*k*a+1)"
				}
			],
			"correction": {
				"steps": [
					"Chaque terme est l'image du précédent par $f$ : $u_{n+1}=f(u_n)$.",
					"$$u_1=f(u_0)=\\dfrac{{{a}}}{{{k}}\\times {{a}}+1}=\\textcolor{{{color:primary.0}}}{{{u1}}}$$",
					"$$\\begin{align*} u_2=f(u_1)&=\\dfrac{\\textcolor{{{color:primary.0}}}{{{u1}}}}{{{k}}\\times\\textcolor{{{color:primary.0}}}{{{u1}}}+1}=\\dfrac{{{u1}}}{{{eval:(2*k*a+1)/(k*a+1)}}}\\\\ &={{u1}}\\times{{eval:(k*a+1)/(2*k*a+1)}}={{solution}} \\end{align*}$$"
				]
			}
		}
	],

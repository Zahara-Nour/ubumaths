	},
	"variations": [
		{
			"blanks": [
				{
					"expectedAnswer": "{{eval:m/k}}"
				}
			],
			"statement": "Détermine la raison de cette suite géométrique.\n\n$u_{ {{p}} }={{c}}$ et $u_{ {{eval:p+1}} }={{d}}$\n\nLa raison est $?$.",
			"variables": [
				{
					"name": "p",
					"expression": "1..12"
				},
				{
					"name": "k",
					"expression": "2..5"
				},
				{
					"name": "m",
					"expression": "1..7;±!cd(k)"
				},
				{
					"name": "j",
					"expression": "1..4;±"
				},
				{
					"name": "c",
					"expression": "eval:k*(j)"
				},
				{
					"name": "d",
					"expression": "eval:m*(j)"
				}
			],
			"correction": {
				"steps": [
					"Les deux termes sont consécutifs : on passe de $u_{ {{p}} }$ à $u_{ {{eval:p+1}} }$ en multipliant par la raison $q$, donc $q=\\dfrac{u_{ {{eval:p+1}} }}{u_{ {{p}} }}$.",
					"$q=\\dfrac{ {{d}} }{ {{c}} }={{solution}}$ (fraction simplifiée)"
				]
			}
		}
	],

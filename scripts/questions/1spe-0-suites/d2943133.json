			],
			"correction": {
				"steps": [
					"$$u_{n+1}-u_n={{k}}^{n+1}+{{c}}-\\left({{k}}^n+{{c}}\\right)={{k}}^{n+1}-{{k}}^n={{k}}^n\\times\\left({{k}}-1\\right)$$",
					"La différence **dépend de $n$** : la suite n'est **pas arithmétique**."
				]
			},
			"correctChoiceIndex": ["1"]
		}

			"conditions": ["p == 1 || mod(q, p) != 0", "(p)*(r)-(u2)*(v1) != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(p)*(r)-(u2)*(v1)}}"
				}
			],
			"correction": {
				"steps": [
					"$\\det(\\vec{u},\\vec{v})=\\begin{vmatrix}x&x'\\\\y&y'\\end{vmatrix}=xy'-yx'$ : produit en croix, **différence** des deux produits.",
					"$$\\det(\\vec{u},\\vec{v})=\\dfrac{ {{p}} }{ {{q}} }\\times{{eval:(q)*(r);()}}-{{u2;()}}\\times{{v1;()}}={{eval:(p)*(r)}}-{{eval:(u2)*(v1);()}}=\\textcolor{{{color:primary.0}}}{{{eval:(p)*(r)-(u2)*(v1)}}}$$"
				]
			}
		},
		{
			"statement": "Dans un repère orthonormé $(O\\,;\\vec{i},\\vec{j})$, on considère les points $A({{ax}}\\,;\\,{{ay}})$, $B({{bx}}\\,;\\,{{by}})$ et $C({{cx}}\\,;\\,{{cy}})$.\n\nCalcule $\\det(\\overrightarrow{AB},\\overrightarrow{AC})$.\n\n$$\\det(\\overrightarrow{AB},\\overrightarrow{AC})=?$$",
			"variables": [
				{
					"name": "ax",
					"expression": "-6..6"
				},
				{
					"name": "ay",
					"expression": "-6..6"
				},
				{
					"name": "bx",
					"expression": "-6..6"
				},
				{
					"name": "by",
					"expression": "-6..6"
				},
				{
					"name": "cx",
					"expression": "-6..6"
				},
				{
					"name": "cy",
					"expression": "-6..6"
				}
			],
			"conditions": [
				"bx != ax",
				"by != ay",
				"cx != ax",
				"cy != ay",
				"cx != bx",
				"((bx)-(ax))*((cy)-(ay))-((by)-(ay))*((cx)-(ax)) != 0"
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:((bx)-(ax))*((cy)-(ay))-((by)-(ay))*((cx)-(ax))}}"
				}
			],
			"correction": {
				"steps": [
					"On calcule d'abord les coordonnées des deux vecteurs : $\\overrightarrow{AB}\\begin{pmatrix}{{eval:(bx)-(ax)}}\\\\{{eval:(by)-(ay)}}\\end{pmatrix}$ et $\\overrightarrow{AC}\\begin{pmatrix}{{eval:(cx)-(ax)}}\\\\{{eval:(cy)-(ay)}}\\end{pmatrix}$.",
					"$\\det(\\vec{u},\\vec{v})=\\begin{vmatrix}x&x'\\\\y&y'\\end{vmatrix}=xy'-yx'$ : produit en croix, **différence** des deux produits.",
					"$$\\det(\\overrightarrow{AB},\\overrightarrow{AC})={{eval:(bx)-(ax);()}}\\times{{eval:(cy)-(ay);()}}-{{eval:(by)-(ay);()}}\\times{{eval:(cx)-(ax);()}}=\\textcolor{{{color:primary.0}}}{{{eval:((bx)-(ax))*((cy)-(ay))-((by)-(ay))*((cx)-(ax))}}}$$"
				]
			}
		}
	],

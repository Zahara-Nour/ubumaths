	"variations": [
		{
			"statement": "Dans un repère orthonormé $(O\\,;\\vec{i},\\vec{j})$, on considère les vecteurs $\\vec{u}\\begin{pmatrix}{{u1}}\\\\{{u2}}\\end{pmatrix}$ et $\\vec{v}\\begin{pmatrix}{{v1}}\\\\{{v2}}\\end{pmatrix}$.\n\nCalcule $\\det(\\vec{u},\\vec{v})$.\n\n$$\\det(\\vec{u},\\vec{v})=?$$",
			"variables": [
				{
					"name": "u1",
					"expression": "-9..9"
				},
				{
					"name": "u2",
					"expression": "-9..9"
				},
				{
					"name": "v1",
					"expression": "-9..9"
				},
				{
					"name": "v2",
					"expression": "-9..9"
				}
			],
			"conditions": ["u1 != 0", "u2 != 0", "v1 != 0", "v2 != 0", "(u1)*(v2)-(u2)*(v1) != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(u1)*(v2)-(u2)*(v1)}}"
				}
			],
			"correction": {
				"steps": [
					"$\\det(\\vec{u},\\vec{v})=\\begin{vmatrix}x&x'\\\\y&y'\\end{vmatrix}=xy'-yx'$ : produit en croix, **différence** des deux produits.",
					"$$\\det(\\vec{u},\\vec{v})={{u1;()}}\\times{{v2;()}}-{{u2;()}}\\times{{v1;()}}={{eval:(u1)*(v2)}}-{{eval:(u2)*(v1);()}}=\\textcolor{{{color:primary.0}}}{{{eval:(u1)*(v2)-(u2)*(v1)}}}$$"
				]
			}
		},
		{
			"statement": "Dans un repère orthonormé $(O\\,;\\vec{i},\\vec{j})$, on considère les vecteurs $\\vec{u}\\begin{pmatrix}\\dfrac{ {{p}} }{ {{q}} }\\\\{{u2}}\\end{pmatrix}$ et $\\vec{v}\\begin{pmatrix}{{v1}}\\\\{{eval:(q)*(r)}}\\end{pmatrix}$.\n\nCalcule $\\det(\\vec{u},\\vec{v})$.\n\n$$\\det(\\vec{u},\\vec{v})=?$$",
			"variables": [

	"variations": [
		{
			"statement": "Dans un repère orthonormé $(O\\,;\\vec{i},\\vec{j})$, on considère les points $A({{ax}}\\,;\\,{{ay}})$, $B({{eval:(ax)+(r1)}}\\,;\\,{{eval:(ay)+(r2)}})$, $C({{cx}}\\,;\\,{{cy}})$ et $D({{eval:(cx)+(k)*(r1)}}\\,;\\,{{eval:(cy)+(k)*(r2)+(w)}})$.\n\nLes droites $(AB)$ et $(CD)$ sont-elles parallèles ?\n\n```choix\nmelanger: non\n- Oui\n- Non\n```",
			"variables": [
				{
					"name": "ax",
					"expression": "-5..5"
				},
				{
					"name": "ay",
					"expression": "-5..5"
				},
				{
					"name": "r1",
					"expression": "1..3;±"
				},
				{
					"name": "r2",
					"expression": "1..3;±"
				},
				{
					"name": "cx",
					"expression": "-5..5"
				},
				{
					"name": "cy",
					"expression": "-5..5"
				},
				{
					"name": "k",
					"expression": "2|3|-1|-2"
				},
				{
					"name": "w",
					"expression": "0|1"
				}
			],
			"conditions": [
				"(r1)*((cy)-(ay)) - (r2)*((cx)-(ax)) != 0",
				"abs(cx+(k)*(r1)) <= 12",
				"abs(cy+(k)*(r2)+w) <= 12"
			],
			"blanks": [
				{
					"expectedAnswer": "{{w}}"
				}
			],
			"correction": {
				"steps": [
					"$(AB)$ et $(CD)$ sont parallèles si et seulement si $\\overrightarrow{AB}$ et $\\overrightarrow{CD}$ sont colinéaires, c'est-à-dire $\\det(\\overrightarrow{AB},\\overrightarrow{CD})=0$.",
					"$\\overrightarrow{AB}\\begin{pmatrix}{{r1}}\\\\{{r2}}\\end{pmatrix}$ et $\\overrightarrow{CD}\\begin{pmatrix}{{eval:(k)*(r1)}}\\\\{{eval:(k)*(r2)+(w)}}\\end{pmatrix}$.",
					"$$\\det(\\overrightarrow{AB},\\overrightarrow{CD})={{r1;()}}\\times{{eval:(k)*(r2)+(w);()}}-{{r2;()}}\\times{{eval:(k)*(r1);()}}=\\textcolor{{{color:primary.0}}}{{{eval:(r1)*(w)}}}$$",
					"{{if:w==0|Le déterminant est nul : **les droites sont parallèles**.|Le déterminant n'est pas nul : **les droites ne sont pas parallèles**.}}"
				]
			}
		},
		{
			"statement": "Dans un repère orthonormé $(O\\,;\\vec{i},\\vec{j})$, on considère les points $A({{ax}}\\,;\\,{{ay}})$, $B({{eval:(ax)+(r1)}}\\,;\\,{{eval:(ay)+(r2)}})$, $C({{cx}}\\,;\\,{{cy}})$ et $D({{eval:(cx)+(k)*(r1)}}\\,;\\,m)$, où $m$ est un réel.\n\nDétermine $m$ pour que les droites $(AB)$ et $(CD)$ soient parallèles.\n\n$$m=?$$",
			"variables": [
				{
					"name": "ax",
					"expression": "-5..5"
				},
				{
					"name": "ay",
					"expression": "-5..5"
				},
				{
					"name": "r1",
					"expression": "1..3;±"
				},
				{
					"name": "r2",
					"expression": "1..3;±"
				},
				{
					"name": "cx",
					"expression": "-5..5"
				},
				{
					"name": "cy",
					"expression": "-5..5"
				},
				{
					"name": "k",
					"expression": "2|3|-1|-2"
				}
			],
			"conditions": [
				"(r1)*((cy)-(ay)) - (r2)*((cx)-(ax)) != 0",
				"cy != 0",
				"abs(r1) != 1",
				"abs(cx+(k)*(r1)) <= 12",
				"abs(cy+(k)*(r2)) <= 12"
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(cy)+(k)*(r2)}}"
				}
			],
			"correction": {
				"steps": [
					"$(AB)$ et $(CD)$ sont parallèles si et seulement si $\\overrightarrow{AB}$ et $\\overrightarrow{CD}$ sont colinéaires, c'est-à-dire $\\det(\\overrightarrow{AB},\\overrightarrow{CD})=0$.",
					"$\\overrightarrow{AB}\\begin{pmatrix}{{r1}}\\\\{{r2}}\\end{pmatrix}$ et $\\overrightarrow{CD}\\begin{pmatrix}{{eval:(k)*(r1)}}\\\\m-{{cy;()}}\\end{pmatrix}$.",
					"$$\\det(\\overrightarrow{AB},\\overrightarrow{CD})={{r1;()}}\\times\\left(m-{{cy;()}}\\right)-{{r2;()}}\\times{{eval:(k)*(r1);()}}$$",
					"Il est nul si et seulement si ${{r1;()}}\\left(m-{{cy;()}}\\right)={{eval:(r2)*(k)*(r1)}}$, soit $m-{{cy;()}}={{eval:(k)*(r2)}}$ et $m=\\textcolor{{{color:primary.0}}}{{{eval:(cy)+(k)*(r2)}}}$."
				]
			}
		}
	],

				]
			}
		},
		{
			"statement": "Pour tout entier $n\\geqslant1$, on pose $u_n=\\dfrac{ {{a}}n+{{c}}\\times(-1)^{n} }{ {{b}}n}$.\n\nDétermine la limite de la suite $(u_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}u_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9;±"

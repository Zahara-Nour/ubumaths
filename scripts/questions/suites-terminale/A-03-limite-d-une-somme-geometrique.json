	"variations": [
		{
			"statement": "Pour tout entier naturel $n$, on pose $S_n=1+\\dfrac{1}{ {{r}} }+\\dfrac{1}{ {{r}}^{2} }+\\cdots+\\dfrac{1}{ {{r}}^{n} }$.\n\nDétermine la limite de la suite $(S_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}S_n=?$",
			"variables": [
				{
					"name": "r",
					"expression": "2..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:r/(r-1)}}"
				}
			],
			"correction": {
				"steps": [
					"$S_n$ est la somme des $n+1$ premiers termes de la suite géométrique de premier terme $1$ et de raison $q=\\dfrac{1}{ {{r}} }$ : $S_n=\\dfrac{1-q^{n+1}}{1-q}$.",
					"$0<q<1$, donc $\\displaystyle\\lim_{n\\to+\\infty}q^{n+1}=0$.",
					"$\\displaystyle\\lim_{n\\to+\\infty}S_n=\\dfrac{1}{1-\\frac{1}{ {{r}} }}=\\textcolor{{{color:primary.0}}}{ {{eval:r/(r-1)}} }$."
				]
			}
		},
		{
			"statement": "Pour tout entier naturel $n$, on pose $S_n=1+{{eval:k/10;d}}+{{eval:k/10;d}}^{2}+\\cdots+{{eval:k/10;d}}^{n}$.\n\nDétermine la limite de la suite $(S_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}S_n=?$",
			"variables": [
				{
					"name": "k",
					"expression": "1..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:10/(10-k)}}"
				}
			],
			"correction": {
				"steps": [
					"$S_n=\\dfrac{1-{{eval:k/10;d}}^{n+1}}{1-{{eval:k/10;d}}}$ (somme de termes d'une suite géométrique de raison ${{eval:k/10;d}}$).",
					"$0<{{eval:k/10;d}}<1$, donc $\\displaystyle\\lim_{n\\to+\\infty}{{eval:k/10;d}}^{n+1}=0$.",
					"$\\displaystyle\\lim_{n\\to+\\infty}S_n=\\dfrac{1}{ {{eval:1-k/10;d}} }=\\textcolor{{{color:primary.0}}}{ {{eval:10/(10-k)}} }$."
				]
			}
		},
		{
			"statement": "$(u_n)$ est la suite géométrique de premier terme $u_0={{a}}$ et de raison $q={{eval:k/10;d}}$. Pour tout entier naturel $n$, on pose $S_n=u_0+u_1+\\cdots+u_n$.\n\nDétermine la limite de la suite $(S_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}S_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				},
				{
					"name": "k",
					"expression": "1..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:10*a/(10-k)}}"
				}
			],
			"correction": {
				"steps": [
					"$S_n=u_0\\times\\dfrac{1-q^{n+1}}{1-q}={{a}}\\times\\dfrac{1-{{eval:k/10;d}}^{n+1}}{ {{eval:1-k/10;d}} }$.",
					"$0<q<1$, donc $\\displaystyle\\lim_{n\\to+\\infty}{{eval:k/10;d}}^{n+1}=0$.",
					"$\\displaystyle\\lim_{n\\to+\\infty}S_n=\\dfrac{ {{a}} }{ {{eval:1-k/10;d}} }=\\textcolor{{{color:primary.0}}}{ {{eval:10*a/(10-k)}} }$."
				]
			}
		},
		{
			"statement": "$(u_n)$ est la suite géométrique de premier terme $u_0={{a}}$ et de raison $q=\\dfrac{ {{j}} }{ {{eval:j+1}} }$. Pour tout entier naturel $n$, on pose $S_n=u_0+u_1+\\cdots+u_n$.\n\nDétermine la limite de la suite $(S_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}S_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				},
				{
					"name": "j",
					"expression": "1..4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*(j+1)}}"
				}
			],
			"correction": {
				"steps": [
					"$S_n=u_0\\times\\dfrac{1-q^{n+1}}{1-q}$ et $0<q<1$, donc $\\displaystyle\\lim_{n\\to+\\infty}q^{n+1}=0$.",
					"$1-q=\\dfrac{1}{ {{eval:j+1}} }$, donc $\\displaystyle\\lim_{n\\to+\\infty}S_n=\\dfrac{u_0}{1-q}={{a}}\\times{{eval:j+1}}=\\textcolor{{{color:primary.0}}}{ {{eval:a*(j+1)}} }$."
				]
			}
		}
	],

	"variations": [
		{
			"statement": "Soit $(u_n)$ la suite définie pour tout entier naturel $n$ par $u_n={{a}}\\times{{q}}^{n}{{b;+}}$.\n\nDétermine la limite de la suite $(u_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}u_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9;±"
				},
				{
					"name": "q",
					"expression": "2..5"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:a>0|+\\infty|-\\infty}}"
				}
			],
			"correction": {
				"steps": [
					"${{q}}>1$, donc $\\displaystyle\\lim_{n\\to+\\infty}{{q}}^{n}=+\\infty$.",
					"${{a}}{{if:a>0|>|<}}0$, donc $\\displaystyle\\lim_{n\\to+\\infty}{{a}}\\times{{q}}^{n}={{if:a>0|+\\infty|-\\infty}}$ ; ajouter ${{b}}$ ne change pas cette limite.",
					"$\\displaystyle\\lim_{n\\to+\\infty}u_n=\\textcolor{{{color:primary.0}}}{{{if:a>0|+\\infty|-\\infty}}}$."
				]
			}
		},
		{
			"statement": "Soit $(u_n)$ la suite définie pour tout entier naturel $n$ par $u_n={{a}}\\times{{eval:k/10;d}}^{n}{{b;+}}$.\n\nDétermine la limite de la suite $(u_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}u_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9;±"
				},
				{
					"name": "k",
					"expression": "1..9"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{b}}"
				}
			],
			"correction": {
				"steps": [
					"$0<{{eval:k/10;d}}<1$, donc $\\displaystyle\\lim_{n\\to+\\infty}{{eval:k/10;d}}^{n}=0$, puis $\\displaystyle\\lim_{n\\to+\\infty}{{a}}\\times{{eval:k/10;d}}^{n}=0$.",
					"Donc $\\displaystyle\\lim_{n\\to+\\infty}u_n=0+{{b;()}}=\\textcolor{{{color:primary.0}}}{ {{b}} }$."
				]
			}
		},
		{
			"statement": "Soit $(u_n)$ la suite définie pour tout entier naturel $n$ par $u_n={{b}}{{a;+}}\\left(\\dfrac{ {{j}} }{ {{eval:j+1}} }\\right)^{n}$.\n\nDétermine la limite de la suite $(u_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}u_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9;±"
				},
				{
					"name": "j",
					"expression": "1..5"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{b}}"
				}
			],
			"correction": {
				"steps": [
					"$0<\\dfrac{ {{j}} }{ {{eval:j+1}} }<1$, donc $\\displaystyle\\lim_{n\\to+\\infty}\\left(\\dfrac{ {{j}} }{ {{eval:j+1}} }\\right)^{n}=0$.",
					"Donc $\\displaystyle\\lim_{n\\to+\\infty}u_n={{b}}{{a;+}}\\times0=\\textcolor{{{color:primary.0}}}{ {{b}} }$."
				]
			}
		},
		{
			"statement": "Soit $(u_n)$ la suite définie pour tout entier naturel $n$ par $u_n={{a}}\\times{{eval:1+t/100;d}}^{n}{{b;+}}$.\n\nDétermine la limite de la suite $(u_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}u_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9;±"
				},
				{
					"name": "t",
					"expression": "1|2|5|10|20"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:a>0|+\\infty|-\\infty}}"
				}
			],
			"correction": {
				"steps": [
					"${{eval:1+t/100;d}}>1$ (même proche de $1$), donc $\\displaystyle\\lim_{n\\to+\\infty}{{eval:1+t/100;d}}^{n}=+\\infty$.",
					"${{a}}{{if:a>0|>|<}}0$, donc $\\displaystyle\\lim_{n\\to+\\infty}u_n=\\textcolor{{{color:primary.0}}}{{{if:a>0|+\\infty|-\\infty}}}$."
				]
			}
		}
	],

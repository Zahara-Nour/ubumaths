	"variations": [
		{
			"statement": "La suite $(u_n)$ est définie par $u_0={{eval:10*m+d}}$ et, pour tout entier naturel $n$, $u_{n+1}={{eval:k/10;d}}u_n{{eval:m*(10-k);+}}$.\n\nOn pose $v_n=u_n-{{eval:10*m;()}}$ et on admet que $(v_n)$ est géométrique de raison ${{eval:k/10;d}}$.\n\nExprime $u_n$ en fonction de $n$.\n\n$u_n=?$",
			"variables": [
				{
					"name": "k",
					"expression": "1..9"
				},
				{
					"name": "m",
					"expression": "1..9;±"
				},
				{
					"name": "d",
					"expression": "2..20;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{d}}\\times{{eval:k/10;d}}^{n}{{eval:10*m;+}}"
				}
			],
			"correction": {
				"steps": [
					"$v_0=u_0-{{eval:10*m;()}}={{d}}$, et $(v_n)$ est géométrique de raison ${{eval:k/10;d}}$ : $v_n={{d}}\\times{{eval:k/10;d}}^{n}$.",
					"$u_n=v_n+{{eval:10*m;()}}$, donc $u_n=\\textcolor{{{color:primary.0}}}{ {{d}}\\times{{eval:k/10;d}}^{n}{{eval:10*m;+}} }$."
				]
			}
		},
		{
			"statement": "La suite $(u_n)$ est définie par $u_0={{eval:10*m+d}}$ et, pour tout entier naturel $n$, $u_{n+1}={{eval:k/10;d}}u_n{{eval:m*(10-k);+}}$.\n\nExprime $u_n$ en fonction de $n$ (on pourra chercher le réel $\\ell$ tel que $\\ell={{eval:k/10;d}}\\ell{{eval:m*(10-k);+}}$, puis étudier $v_n=u_n-\\ell$).\n\n$u_n=?$",
			"variables": [
				{
					"name": "k",
					"expression": "1..9"
				},
				{
					"name": "m",
					"expression": "1..9;±"
				},
				{
					"name": "d",
					"expression": "2..20;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{d}}\\times{{eval:k/10;d}}^{n}{{eval:10*m;+}}"
				}
			],
			"correction": {
				"steps": [
					"$\\ell={{eval:k/10;d}}\\ell{{eval:m*(10-k);+}}\\iff{{eval:1-k/10;d}}\\ell={{eval:m*(10-k)}}\\iff\\ell={{eval:10*m}}$.",
					"$v_{n+1}=u_{n+1}-\\ell={{eval:k/10;d}}u_n{{eval:m*(10-k);+}}-\\left({{eval:k/10;d}}\\ell{{eval:m*(10-k);+}}\\right)={{eval:k/10;d}}v_n$ : $(v_n)$ est géométrique de raison ${{eval:k/10;d}}$, de premier terme $v_0={{eval:10*m+d}}-{{eval:10*m;()}}={{d}}$.",
					"$u_n=v_n+\\ell=\\textcolor{{{color:primary.0}}}{ {{d}}\\times{{eval:k/10;d}}^{n}{{eval:10*m;+}} }$."
				]
			}
		},
		{
			"statement": "La suite $(u_n)$ est définie par $u_0={{eval:2*b+d}}$ et, pour tout entier naturel $n$, $u_{n+1}=\\dfrac{1}{2}u_n{{b;+}}$.\n\nExprime $u_n$ en fonction de $n$ (on pourra chercher le réel $\\ell$ tel que $\\ell=\\dfrac{1}{2}\\ell{{b;+}}$, puis étudier $v_n=u_n-\\ell$).\n\n$u_n=?$",
			"variables": [
				{
					"name": "b",
					"expression": "1..9;±"
				},
				{
					"name": "d",
					"expression": "2..12;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{d}}\\left(\\frac{1}{2}\\right)^{n}{{eval:2*b;+}}"
				}
			],
			"correction": {
				"steps": [
					"$\\ell=\\dfrac{1}{2}\\ell{{b;+}}\\iff\\dfrac{1}{2}\\ell={{b}}\\iff\\ell={{eval:2*b}}$.",
					"$(v_n)$, avec $v_n=u_n-{{eval:2*b;()}}$, est géométrique de raison $\\dfrac{1}{2}$ et de premier terme $v_0={{d}}$.",
					"$u_n=v_n+\\ell=\\textcolor{{{color:primary.0}}}{ {{d}}\\left(\\dfrac{1}{2}\\right)^{n}{{eval:2*b;+}} }$."
				]
			}
		}
	],

	"variations": [
		{
			"statement": "La suite $(u_n)$ vérifie, pour tout entier naturel $n$, $u_{n+1}={{eval:k/10;d}}u_n{{eval:m*(10-k);+}}$.\n\nDétermine le réel $\\ell$ tel que $\\ell={{eval:k/10;d}}\\ell{{eval:m*(10-k);+}}$ (la suite constante égale à $\\ell$ vérifie la même relation).\n\n$\\ell=?$",
			"variables": [
				{
					"name": "k",
					"expression": "1..9"
				},
				{
					"name": "m",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:10*m}}"
				}
			],
			"correction": {
				"steps": [
					"$\\ell={{eval:k/10;d}}\\ell{{eval:m*(10-k);+}}\\iff\\ell-{{eval:k/10;d}}\\ell={{eval:m*(10-k)}}\\iff{{eval:1-k/10;d}}\\ell={{eval:m*(10-k)}}$.",
					"$\\ell=\\dfrac{ {{eval:m*(10-k)}} }{ {{eval:1-k/10;d}} }=\\textcolor{{{color:primary.0}}}{ {{eval:10*m}} }$."
				]
			}
		},
		{
			"statement": "La suite $(u_n)$ vérifie, pour tout entier naturel $n$, $u_{n+1}=\\dfrac{ {{j}} }{ {{eval:j+1}} }u_n{{b;+}}$.\n\nDétermine le réel $\\ell$ tel que $\\ell=\\dfrac{ {{j}} }{ {{eval:j+1}} }\\ell{{b;+}}$ (la suite constante égale à $\\ell$ vérifie la même relation).\n\n$\\ell=?$",
			"variables": [
				{
					"name": "j",
					"expression": "1..4"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:b*(j+1)}}"
				}
			],
			"correction": {
				"steps": [
					"$\\ell-\\dfrac{ {{j}} }{ {{eval:j+1}} }\\ell={{b}}\\iff\\dfrac{1}{ {{eval:j+1}} }\\ell={{b}}$.",
					"$\\ell={{eval:j+1}}\\times{{b;()}}=\\textcolor{{{color:primary.0}}}{ {{eval:b*(j+1)}} }$."
				]
			}
		},
		{
			"statement": "La suite $(u_n)$ vérifie, pour tout entier naturel $n$, $u_{n+1}={{a}}u_n{{b;+}}$.\n\nDétermine le réel $\\ell$ tel que $\\ell={{a}}\\ell{{b;+}}$ (la suite constante égale à $\\ell$ vérifie la même relation).\n\n$\\ell=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..4"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:b/(1-a)}}"
				}
			],
			"correction": {
				"steps": [
					"$\\ell={{a}}\\ell{{b;+}}\\iff\\ell-{{a}}\\ell={{b}}\\iff\\ell\\left(1-{{a}}\\right)={{b}}$.",
					"$\\ell=\\dfrac{ {{b}} }{ {{eval:1-a}} }=\\textcolor{{{color:primary.0}}}{ {{eval:b/(1-a)}} }$."
				]
			}
		},
		{
			"statement": "La suite $(u_n)$ est définie par $u_0={{eval:10*m+d}}$ et, pour tout entier naturel $n$, $u_{n+1}={{eval:k/10;d}}u_n{{eval:m*(10-k);+}}$.\n\nDétermine la limite de la suite $(u_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}u_n=?$",
			"variables": [
				{
					"name": "k",
					"expression": "1..9"
				},
				{
					"name": "m",
					"expression": "1..9;±"
				},
				{
					"name": "d",
					"expression": "1..20;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:10*m}}"
				}
			],
			"correction": {
				"steps": [
					"La solution constante vérifie $\\ell={{eval:k/10;d}}\\ell{{eval:m*(10-k);+}}$, soit $\\ell=\\dfrac{ {{eval:m*(10-k)}} }{ {{eval:1-k/10;d}} }={{eval:10*m}}$.",
					"La suite $v_n=u_n-{{eval:10*m;()}}$ est géométrique de raison ${{eval:k/10;d}}$ et $v_0={{d}}$, donc $u_n={{d}}\\times{{eval:k/10;d}}^{n}{{eval:10*m;+}}$.",
					"$0<{{eval:k/10;d}}<1$ donc $\\displaystyle\\lim_{n\\to+\\infty}{{eval:k/10;d}}^{n}=0$ et $\\displaystyle\\lim_{n\\to+\\infty}u_n=\\textcolor{{{color:primary.0}}}{ {{eval:10*m}} }$."
				]
			}
		},
		{
			"statement": "La suite $(u_n)$ est définie par $u_0={{eval:c+dd}}$ et, pour tout entier naturel $n$, $u_{n+1}={{a}}u_n{{eval:c*(1-a);+}}$.\n\nDétermine la limite de la suite $(u_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}u_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..3"
				},
				{
					"name": "c",
					"expression": "1..9;±"
				},
				{
					"name": "dd",
					"expression": "1..5;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:dd>0|+\\infty|-\\infty}}"
				}
			],
			"correction": {
				"steps": [
					"La solution constante vérifie $\\ell={{a}}\\ell{{eval:c*(1-a);+}}$, soit $\\ell={{c}}$.",
					"La suite $v_n=u_n-{{c;()}}$ est géométrique de raison ${{a}}$ et $v_0={{dd}}$, donc $u_n={{dd}}\\times{{a}}^{n}{{c;+}}$.",
					"${{a}}>1$ donc $\\displaystyle\\lim_{n\\to+\\infty}{{a}}^{n}=+\\infty$ ; comme ${{dd}}{{if:dd>0|>|<}}0$, $\\displaystyle\\lim_{n\\to+\\infty}u_n=\\textcolor{{{color:primary.0}}}{ {{if:dd>0|+\\infty|-\\infty}} }$."
				]
			}
		}
	],

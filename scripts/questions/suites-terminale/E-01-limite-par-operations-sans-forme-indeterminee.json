	"variations": [
		{
			"statement": "Pour tout entier $n\\geqslant1$, on pose $u_n={{a}}+\\dfrac{ {{b}} }{n}$.\n\nDétermine la limite de la suite $(u_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}u_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9;±"
				},
				{
					"name": "b",
					"expression": "1..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{a}}"
				}
			],
			"correction": {
				"steps": [
					"$\\displaystyle\\lim_{n\\to+\\infty}\\dfrac{ {{b}} }{n}=0$ (un nombre divisé par une quantité qui tend vers $+\\infty$).",
					"Par somme, $\\displaystyle\\lim_{n\\to+\\infty}u_n={{a}}+0=\\textcolor{{{color:primary.0}}}{ {{a}} }$."
				]
			}
		},
		{
			"statement": "Pour tout entier naturel $n$, on pose $u_n={{a}}n^{2}+{{eval:sign(a)*bb}}n{{c;+}}$.\n\nDétermine la limite de la suite $(u_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}u_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "bb",
					"expression": "1..9"
				},
				{
					"name": "c",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:a>0|+\\infty|-\\infty}}"
				}
			],
			"correction": {
				"steps": [
					"$\\displaystyle\\lim_{n\\to+\\infty}{{a}}n^{2}={{if:a>0|+\\infty|-\\infty}}$ et $\\displaystyle\\lim_{n\\to+\\infty}{{eval:sign(a)*bb}}n={{if:a>0|+\\infty|-\\infty}}$ : les deux termes tendent vers le **même** infini, pas de forme indéterminée.",
					"Par somme, $\\displaystyle\\lim_{n\\to+\\infty}u_n=\\textcolor{{{color:primary.0}}}{{{if:a>0|+\\infty|-\\infty}}}$."
				]
			}
		},
		{
			"statement": "Pour tout entier $n\\geqslant1$, on pose $u_n=\\left({{a}}+\\dfrac{1}{n}\\right)\\left({{b}}-\\dfrac{ {{d}} }{n^{2}}\\right)$.\n\nDétermine la limite de la suite $(u_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}u_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9;±"
				},
				{
					"name": "b",
					"expression": "2..9;±"
				},
				{
					"name": "d",
					"expression": "1..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*b}}"
				}
			],
			"correction": {
				"steps": [
					"$\\displaystyle\\lim_{n\\to+\\infty}\\left({{a}}+\\dfrac{1}{n}\\right)={{a}}$ et $\\displaystyle\\lim_{n\\to+\\infty}\\left({{b}}-\\dfrac{ {{d}} }{n^{2}}\\right)={{b}}$.",
					"Par produit, $\\displaystyle\\lim_{n\\to+\\infty}u_n={{a}}\\times{{b;()}}=\\textcolor{{{color:primary.0}}}{ {{eval:a*b}} }$."
				]
			}
		},
		{
			"statement": "Pour tout entier $n\\geqslant1$, on pose $u_n=\\dfrac{ {{a}}+\\frac{1}{n} }{ {{b}}+\\frac{ {{d}} }{\\sqrt{n} } }$.\n\nDétermine la limite de la suite $(u_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}u_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9;±"
				},
				{
					"name": "b",
					"expression": "2..9"
				},
				{
					"name": "d",
					"expression": "1..9"
				}
			],
			"conditions": ["a != b"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a/b}}"
				}
			],
			"correction": {
				"steps": [
					"Le numérateur tend vers ${{a}}$ ; $\\displaystyle\\lim_{n\\to+\\infty}\\sqrt{n}=+\\infty$, donc le dénominateur tend vers ${{b}}\\neq0$.",
					"Par quotient, $\\displaystyle\\lim_{n\\to+\\infty}u_n=\\dfrac{ {{a}} }{ {{b}} }=\\textcolor{{{color:primary.0}}}{ {{eval:a/b}} }$."
				]
			}
		},
		{
			"statement": "Pour tout entier $n\\geqslant1$, on pose $u_n={{a}}\\sqrt{n}+\\dfrac{ {{b}} }{n}$.\n\nDétermine la limite de la suite $(u_n)$.\n\n$\\displaystyle\\lim_{n\\to+\\infty}u_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9;±"
				},
				{
					"name": "b",
					"expression": "1..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:a>0|+\\infty|-\\infty}}"
				}
			],
			"correction": {
				"steps": [
					"$\\displaystyle\\lim_{n\\to+\\infty}\\sqrt{n}=+\\infty$, donc $\\displaystyle\\lim_{n\\to+\\infty}{{a}}\\sqrt{n}={{if:a>0|+\\infty|-\\infty}}$ ; et $\\displaystyle\\lim_{n\\to+\\infty}\\dfrac{ {{b}} }{n}=0$.",
					"Par somme, $\\displaystyle\\lim_{n\\to+\\infty}u_n=\\textcolor{{{color:primary.0}}}{{{if:a>0|+\\infty|-\\infty}}}$."
				]
			}
		}
	],

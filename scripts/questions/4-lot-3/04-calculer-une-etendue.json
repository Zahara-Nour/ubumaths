				},
				{
					"name": "t7",
					"expression": "-6..12"
				}
			],
			"conditions": [
				"min(t1,t2,t3,t4,t5,t6,t7)<0",
				"max(t1,t2,t3,t4,t5,t6,t7)>3",
				"abs(t7-t1)!=max(t1,t2,t3,t4,t5,t6,t7)-min(t1,t2,t3,t4,t5,t6,t7)"
			],
			"blanks": [
				{

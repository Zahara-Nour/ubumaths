	"variations": [
		{
			"statement": "Le polynôme $P(x)={{eval:ax^2+bx+c}}$ a pour racines ${{r}}$ et ${{s}}$. Écris-le sous forme factorisée.\n\n$P(x)=?$",
			"blanks": [
				{
					"requiredForm": {
						"pattern": "u*($x+v)*($x+w)"
					},
					"expectedAnswer": "{{eval:a*(x-r)*(x-s)}}"
				}
			],
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..3;±"
				},
				{
					"name": "r",
					"expression": "1..6;±"
				},
				{
					"name": "s",
					"expression": "1..6;±"
				},
				{
					"name": "b",
					"expression": "eval:-a*(r+s)"
				},
				{
					"name": "c",
					"expression": "eval:a*r*s"
				}
			],
			"correction": {
				"steps": [
					"Un polynôme du second degré de racines $x_1$ et $x_2$ s'écrit $a(x-x_1)(x-x_2)$, où $a$ est le coefficient de $x^2$.",
					"Ici $a={{a}}$, $x_1={{r}}$ et $x_2={{s}}$ : $P(x)={{eval:a*(x-r)*(x-s)}}$."
				]
			},
			"conditions": ["r < s", "r != -s"]
		},
		{
			"statement": "${{r}}$ est une racine de $P(x)={{eval:ax^2+bx+c}}$.\n\nComplète : $P(x)=(x{{eval:-(r);+}})(\\,?\\,x+\\,?\\,)$.",
			"blanks": [
				{
					"expectedAnswer": "{{a}}"
				},
				{
					"expectedAnswer": "{{eval:-a*s}}"
				}
			],
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..3;±"
				},
				{
					"name": "r",
					"expression": "1..6;±"
				},
				{
					"name": "s",
					"expression": "1..6;±"
				},
				{
					"name": "b",
					"expression": "eval:-a*(r+s)"
				},
				{
					"name": "c",
					"expression": "eval:a*r*s"
				}
			],
			"correction": {
				"steps": [
					"On cherche $P(x)=(x{{eval:-(r);+}})(mx+p)$.",
					"Terme en $x^2$ : $x\\times mx=mx^2$, donc $m={{a}}$.",
					"Terme constant : ${{eval:-r}}\\times p={{c}}$, donc $p={{eval:-a*s}}$.",
					"$P(x)=(x{{eval:-(r);+}})({{eval:a*x-a*s}})$."
				]
			},
			"conditions": ["r != s", "r != -s"]
		},
		{
			"statement": "Factorise $P(x)={{eval:ax^2+bx}}$ (une de ses racines est évidente).\n\n$P(x)=x(\\,?\\,x+\\,?\\,)$",
			"blanks": [
				{
					"expectedAnswer": "{{a}}"
				},
				{
					"expectedAnswer": "{{b}}"
				}
			],
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"correction": {
				"steps": [
					"$P(0)=0$ : $0$ est une racine évidente, et $x$ est facteur commun.",
					"$P(x)=x({{eval:ax+b}})$."
				]
			}
		}
	],

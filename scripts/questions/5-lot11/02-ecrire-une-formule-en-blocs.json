			"correction": {
				"steps": [
					"${{a}}x$, c'est ${{a}} \\times x$ : en blocs, ${{a}}$ × nombre choisi.",
					"On ajoute ${{b}}$ : la multiplication se fait d'abord, sans parenthèses.",
					"Un programme juste : afficher ${{a}}$ × nombre $+\\ {{b}}$."
				]
			}
		},

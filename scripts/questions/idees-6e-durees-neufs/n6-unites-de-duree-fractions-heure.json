							"label": "Fraction recopiée"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"Une heure, c'est $60$ min. {{if:f==0|$\\frac{1}{4}$ d'heure : $60 \\div 4 = \\textcolor{{{color:primary.0}}}{15}$ min.|{{if:f==1|$\\frac{1}{2}$ heure : $60 \\div 2 = \\textcolor{{{color:primary.0}}}{30}$ min.|$\\frac{3}{4}$ d'heure : $3 \\times 15 = \\textcolor{{{color:primary.0}}}{45}$ min.}}}}"
				]
			},
			"hint": "Une heure fait $60$ min : partage-la en parts égales."
		},
		{
			"statement": "Écris cette durée en heure, avec une fraction ou un nombre décimal.\n\n${{v}}~\\unit{min} = ?~\\unit{h}$",
			"variables": [
				{
					"name": "f",
					"expression": "0..2"
				},
				{
					"name": "v",
					"expression": "eval:(15)*(1-min(abs(f-0),1))+(30)*(1-min(abs(f-1),1))+(45)*(1-min(abs(f-2),1))"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{if:f==0|\\frac{1}{4}|{{if:f==1|\\frac{1}{2}|\\frac{3}{4}}}}}",
					"expectedErrors": [
						{
							"answer": "{{eval:v/100;d}}",
							"message": "Une heure fait $60$ min, pas $100$ : ${{v}}$ min ne s'écrivent pas ${{eval:v/100;d}}$ h.",
							"label": "Minutes écrites après la virgule"
						},
						{
							"answer": "{{eval:v/10;d}}",
							"message": "Ce n'est même pas une heure : la réponse est plus petite que $1$.",
							"label": "Minutes prises pour des dixièmes"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"${{v}}~\\unit{min}$, c'est {{if:f==0|un quart|{{if:f==1|la moitié|les trois quarts}}}} de $60$ min.",
					"${{v}}~\\unit{min} = \\textcolor{{{color:primary.0}}}{{{if:f==0|\\frac{1}{4}|{{if:f==1|\\frac{1}{2}|\\frac{3}{4}}}}}~\\unit{h}} = {{if:f==0|0{,}25|{{if:f==1|0{,}5|0{,}75}}}}~\\unit{h}$."
				]
			},
			"hint": "Une heure fait $60$ min : quelle part de l'heure font ${{v}}$ min ?"
		}
	],

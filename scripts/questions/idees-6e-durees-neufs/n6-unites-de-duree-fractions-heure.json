	"title": "Unités de durée et fractions d'heure",
	"description": "Relations entre jour, heure, minute, seconde et semaine ; retrouver l'unité ; quart, demie et trois quarts d'heure en minutes, et retour ; pièges : 100 min dans une heure, 0,45 h pour 45 min",
	"grades": ["6"],
	"level": 17,
	"delay": 15,
	"status": "draft",
	"options": {
		"constraints": {
			"form": "off"
		}
	},
	"variations": [
		{
			"statement": "Complète.\n\n${{if:t==0|1~\\text{jour}|{{if:t==1|1~\\text{heure}|{{if:t==2|1~\\text{minute}|1~\\text{semaine}}}}}}} = ?~{{if:t==0|\\text{heures}|{{if:t==1|\\text{minutes}|{{if:t==2|\\text{secondes}|\\text{jours}}}}}}}$",
			"variables": [
				{
					"name": "t",
					"expression": "0..3"
				},
				{
					"name": "v",
					"expression": "eval:(24)*(1-min(abs(t-0),1))+(60)*(1-min(abs(t-1),1))+(60)*(1-min(abs(t-2),1))+(7)*(1-min(abs(t-3),1))"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{v}}",
					"expectedErrors": [
						{
							"answer": "100",
							"message": "Les durées ne se comptent pas par $100$ : retiens les nombres $24$, $60$ et $7$.",
							"label": "Comptage par 100"
						},
						{
							"answer": "{{if:t==0|12|{{if:t==3|5|10}}}}",
							"message": "{{if:t==0|$12$ heures, c'est une demi-journée.|{{if:t==3|Une semaine compte tous les jours, pas seulement les jours d'école.|Les durées ne se comptent pas par $10$.}}}}",
							"label": "Nombre courant mais faux"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"${{if:t==0|1~\\text{jour}|{{if:t==1|1~\\text{heure}|{{if:t==2|1~\\text{minute}|1~\\text{semaine}}}}}}} = \\textcolor{{{color:primary.0}}}{{{v}}~{{if:t==0|\\text{heures}|{{if:t==1|\\text{minutes}|{{if:t==2|\\text{secondes}|\\text{jours}}}}}}}}$."
				]
			},
			"hint": "Pense à une horloge, ou à un calendrier."
		},
		{
			"statement": "Quelle unité de durée complète l'égalité ?\n\n$1~\\ldots = {{if:t==0|60~\\text{minutes}|{{if:t==1|60~\\text{secondes}|{{if:t==2|24~\\text{heures}|7~\\text{jours}}}}}}}$\n\n```choix\nmelanger: non\n- semaine\n- jour\n- heure\n- minute\n- seconde\n```",
			"variables": [
				{
					"name": "t",
					"expression": "0..3"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{if:t==0|2|{{if:t==1|3|{{if:t==2|1|0}}}}}}"
				}
			],
			"correction": {
				"steps": [
					"$1~\\text{{{if:t==0|heure|{{if:t==1|minute|{{if:t==2|jour|semaine}}}}}}} = {{if:t==0|60~\\text{minutes}|{{if:t==1|60~\\text{secondes}|{{if:t==2|24~\\text{heures}|7~\\text{jours}}}}}}}$ : c'est $\\textcolor{{{color:primary.0}}}{\\text{{{if:t==0|l'heure|{{if:t==1|la minute|{{if:t==2|le jour|la semaine}}}}}}}}$."
				]
			},
			"hint": "Range les unités de la plus petite à la plus grande : seconde, minute, heure, jour, semaine."
		},
		{
			"statement": "Complète.\n\n${{if:f==0|\\frac{1}{4}|{{if:f==1|\\frac{1}{2}|\\frac{3}{4}}}}}~\\text{d'heure} = ?~\\unit{min}$",
			"variables": [
				{
					"name": "f",
					"expression": "0..2"
				},
				{
					"name": "v",
					"expression": "eval:(15)*(1-min(abs(f-0),1))+(30)*(1-min(abs(f-1),1))+(45)*(1-min(abs(f-2),1))"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{v}}",
					"expectedErrors": [
						{
							"answer": "{{if:f==0|25|{{if:f==1|50|75}}}}",

	"title": "Convertir des durées avec les secondes",
	"description": "Secondes en minutes et secondes, heures et minutes en secondes, secondes en heures, minutes et secondes, et retour ; pièges : 1 min = 100 s, 1 h = 60 s, une unité non convertie",
	"grades": ["6"],
	"level": 15,
	"delay": 45,
	"status": "draft",
	"variations": [
		{
			"statement": "Convertis.\n\n${{n}}~\\unit{s} = ?~\\unit{min}~?~\\unit{s}$",
			"variables": [
				{
					"name": "q",
					"expression": "2..9"
				},
				{
					"name": "r",
					"expression": "1..59"
				},
				{
					"name": "n",
					"expression": "eval:60*q+r"
				}
			],
			"conditions": ["floor(n/100)!=q", "mod(n,100)!=r", "n-60!=r"],
			"blanks": [
				{
					"expectedAnswer": "{{q}}",
					"expectedErrors": [
						{
							"answer": "{{eval:floor(n/100)}}",
							"message": "Une minute fait $60$ s, pas $100$.",
							"label": "Division par 100"
						}
					]
				},
				{
					"expectedAnswer": "{{r}}",
					"expectedErrors": [
						{
							"answer": "{{eval:mod(n,100)}}",
							"message": "Une minute fait $60$ s, pas $100$.",
							"label": "Division par 100"
						},
						{
							"answer": "{{eval:n-60}}",
							"message": "Il reste plus de $60$ s : il y a encore des minutes dedans.",
							"label": "Une seule minute sortie"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"$1~\\unit{min} = 60~\\unit{s}$. Dans ${{n}}$, combien de fois $60$ ?",
					"${{q}} \\times 60 = {{eval:60*q}}$ et ${{n}} - {{eval:60*q}} = {{r}}$.",
					"${{n}}~\\unit{s} = \\textcolor{{{color:primary.0}}}{{{q}}~\\unit{min}~{{r}}~\\unit{s}}$."
				]
			},
			"hint": "Combien de fois $60$ s dans ${{n}}$ s ? Ce qui reste, ce sont des secondes."
		},
		{
			"statement": "Convertis.\n\n${{h}}~\\unit{h}~{{m}}~\\unit{min} = ?~\\unit{s}$",
			"variables": [

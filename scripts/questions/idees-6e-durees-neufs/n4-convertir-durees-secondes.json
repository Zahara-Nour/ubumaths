			"correction": {
				"steps": [
					"${{h}}~\\unit{h}~{{m}}~\\unit{min} = {{eval:60*h}}~\\unit{min} + {{m}}~\\unit{min} = {{eval:60*h+m}}~\\unit{min}$.",
					"${{eval:60*h+m}} \\times 60 = \\textcolor{{{color:primary.0}}}{{{eval:3600*h+60*m}}~\\unit{s}}$."
				]

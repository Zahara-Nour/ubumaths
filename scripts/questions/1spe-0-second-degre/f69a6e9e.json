				{
					"name": "c",
					"expression": "eval:r*s"
				}
			],
			"conditions": ["r != s && r != -s"],
			"correction": {
				"steps": [
					"On identifie $a={{a}}$, $b={{b}}$ et $c={{c}}$, puis on calcule le discriminant.",
					"$$\\begin{align}\\Delta &= b^2-4ac \\\\ &= {{eval:b;()}}^2-4\\times{{eval:a;()}}\\times{{eval:c;()}} \\\\ &= {{eval:b^2-4*a*c}}\\end{align}$$",
					"$\\Delta>0$, donc le polynôme a deux racines ; de plus $\\sqrt{\\Delta}=\\sqrt{ {{eval:b^2-4*a*c}} }={{eval:sqrt(b^2-4*a*c)}}$.",
					"$$\\begin{align}x_1 &= \\dfrac{-b-\\sqrt{\\Delta}}{2a} = \\dfrac{ {{eval:-b}}-{{eval:sqrt(b^2-4*a*c)}} }{ {{eval:2*a}} } = {{eval:(-b-sqrt(b^2-4*a*c))/(2*a)}} \\\\ x_2 &= \\dfrac{-b+\\sqrt{\\Delta}}{2a} = \\dfrac{ {{eval:-b}}+{{eval:sqrt(b^2-4*a*c)}} }{ {{eval:2*a}} } = {{eval:(-b+sqrt(b^2-4*a*c))/(2*a)}}\\end{align}$$"
				]
			}
		},

					"expression": "eval:-2*a*h"
				},
				{
					"name": "c",
					"expression": "eval:a*h^2+k"
				}
			],
			"conditions": ["c != 0", "a != 1"],
			"correction": {
				"steps": [
					"On met $a={{a}}$ en facteur dans les deux premiers termes : $P(x)={{if:a==-1|-|{{a}}}}\\left({{eval:x^2-2*h*x}}\\right){{eval:c;+}}$.",
					"On complète le carré : $(x{{eval:-h;+}})^2={{eval:x^2-2*h*x+h^2}}$, donc ${{eval:x^2-2*h*x}}=(x{{eval:-h;+}})^2-{{eval:h^2}}$.",
					"$$\\begin{align}P(x) &= {{if:a==-1|-|{{a}}}}\\left[(x{{eval:-h;+}})^2-{{eval:h^2}}\\right]{{eval:c;+}} \\\\ &= {{if:a==-1|-|{{a}}}}(x{{eval:-h;+}})^2{{eval:-a*h^2;+}}{{eval:c;+}} \\\\ &= {{if:a==-1|-|{{a}}}}(x{{eval:-h;+}})^2{{eval:k;+}}\\end{align}$$",
					"Donc $P(x)={{if:a==-1|-|{{a}}}}(x{{eval:-h;+}})^2{{eval:k;+}}$."
				]
			}
		},

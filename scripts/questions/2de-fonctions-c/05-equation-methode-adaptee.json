					"expression": "-3..3!0"
				},
				{
					"name": "k",
					"expression": "eval:(a)*(r)^3+(c)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\{ {{r}} \\}",
					"answerKind": "intervalles"
				}
			],
			"correction": {
				"steps": [
					"On **isole** la fonction de référence :",
					"$${{a}}x^3{{c;+}}={{k}}\\iff {{a}}x^3={{eval:(k)-(c)}}\\iff x^3={{eval:(r)^3}}$$",
					"On est ramené à une équation $x^3=k$ (**fonction cube**) : **une seule** solution, ${{r}}$, car $({{r}})^3={{eval:(r)^3}}$.",
					"$S=\\textcolor{{{color:primary.0}}}{\\{ {{r}} \\}}$."
				]
			}
		}

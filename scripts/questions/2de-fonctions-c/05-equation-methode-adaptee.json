		"blankDefaults": {
			"acceptDecimal": true
		}
	},
	"variations": [
		{
			"statement": "On considère la fonction $f$ définie par $f(x)={{a}}x^2{{c;+}}$.\n\nRésous dans $\\mathbb{R}$ l'équation $f(x)={{k}}$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [
				{
					"name": "a",
					"expression": "2..5"
				},
				{
					"name": "c",
					"expression": "1..9;±"
				},
				{
					"name": "r",
					"expression": "1..4"
				},
				{
					"name": "k",
					"expression": "eval:(a)*(r)^2+(c)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\{ {{eval:-(r)}} ; {{r}} \\}",
					"answerKind": "intervalles"
				}
			],
			"correction": {
				"steps": [
					"On **isole** la fonction de référence :",
					"$${{a}}x^2{{c;+}}={{k}}\\iff {{a}}x^2={{eval:(k)-(c)}}\\iff x^2={{eval:(r)^2}}$$",
					"On est ramené à une équation $x^2=k$ (**fonction carré**) avec $k>0$ : **deux** solutions opposées, ${{r}}$ et $-{{r}}$.",
					"$S=\\textcolor{{{color:primary.0}}}{\\{ -{{r}}\\,;{{r}} \\}}$."
				]
			}
		},
		{
			"statement": "On considère la fonction $f$ définie par $f(x)=\\dfrac{ {{a}} }{x}{{c;+}}$.\n\nRésous dans $\\mathbb{R}$ l'équation $f(x)={{k}}$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [
				{
					"name": "a",
					"expression": "1..6;±"
				},
				{
					"name": "c",
					"expression": "1..5;±"
				},
				{
					"name": "k",
					"expression": "-6..6"
				}
			],
			"conditions": ["k != c"],
			"blanks": [
				{
					"expectedAnswer": "\\{ {{eval:(a)/((k)-(c))}} \\}",
					"answerKind": "intervalles"
				}
			],
			"correction": {
				"steps": [
					"$f$ est définie pour $x\\neq 0$. On **isole** la fonction de référence :",
					"$$\\dfrac{ {{a}} }{x}{{c;+}}={{k}}\\iff \\dfrac{ {{a}} }{x}={{eval:(k)-(c)}}\\iff x=\\dfrac{ {{a}} }{ {{eval:(k)-(c)}} }$$",
					"On est ramené à une équation $\\dfrac{1}{x}=k$ (**fonction inverse**) avec $k\\neq 0$ : **une seule** solution, l'inverse.",
					"$S=\\textcolor{{{color:primary.0}}}{\\left\\{ {{eval:(a)/((k)-(c))}} \\right\\}}$."
				]
			}
		},
		{
			"statement": "On considère la fonction $f$ définie par $f(x)={{a}}\\sqrt{x}{{c;+}}$.\n\nRésous dans $\\mathbb{R}$ l'équation $f(x)={{k}}$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [
				{

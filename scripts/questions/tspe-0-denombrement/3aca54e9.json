			"correction": {
				"steps": [
					"L'ordre dans lequel on coche ne compte pas et on ne coche pas deux fois un numéro : une grille est une partie à ${{k}}$ éléments.",
					"$\\binom{ {{n}} }{ {{k}} }=\\textcolor{{{color:primary.0}}}{{{eval:binom(n,k)}}}$."
				]
			}
		},
		{
			"blanks": [

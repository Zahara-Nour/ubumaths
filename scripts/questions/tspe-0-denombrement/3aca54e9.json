				}
			],
			"statement": "À une réunion, ${{n}}$ personnes se serrent la main, chacune une fois avec chacune des autres.\n\nCombien de poignées de main sont échangées ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "6..30"
				},
				{
					"name": "k",
					"expression": "2"
				}
			],
			"correction": {
				"steps": [
					"Une poignée de main correspond à une paire de personnes (partie à $2$ éléments) : « A serre la main de B » et « B serre la main de A » sont la même.",
					"$\\binom{ {{n}} }{ 2 }=\\dfrac{ {{n}}\\times{{eval:n-1}} }{2}=\\textcolor{{{color:primary.0}}}{{{eval:binom(n,k)}}}$ (et non ${{n}}\\times{{eval:n-1}}$, qui compte chaque poignée deux fois)."
				]
			}
		}

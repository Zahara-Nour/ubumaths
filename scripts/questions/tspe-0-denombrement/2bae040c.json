			"statement": "Un ensemble $E$ contient ${{n}}$ éléments.\n\nCombien de parties de $E$ ont **au moins deux** éléments ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "4..10"
				}
			],
			"correction": {
				"steps": [
					"$E$ a $2^{ {{n}} }$ parties. On retire celles qui ont moins de deux éléments : la partie vide ($\\binom{ {{n}} }{ 0 }=1$) et les ${{n}}$ singletons ($\\binom{ {{n}} }{ 1 }={{n}}$).",
					"$2^{ {{n}} }-1-{{n}}=\\textcolor{{{color:primary.0}}}{{{eval:2^n-1-n}}}$."
				]
			}
		}

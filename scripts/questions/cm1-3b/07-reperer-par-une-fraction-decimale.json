			"variationIndex": 1,
			"variables": {
				"t": "23",
				"r": "7",
				"n": "237"
			},
			"answers": ["\\frac{7}{100}"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "Erreur : 30/10 (dixième suivant)",
			"variationIndex": 1,
			"variables": {
				"t": "23",
				"r": "7",
				"n": "237"
			},
			"answers": ["\\frac{30}{10}"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "Erreur : 27/10 (centièmes lus comme des dixièmes)",
			"variationIndex": 1,
			"variables": {
				"t": "23",
				"r": "7",
				"n": "237"
			},
			"answers": ["\\frac{27}{10}"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "Forme : 2,37 (écriture à virgule)",
			"variationIndex": 1,
			"variables": {
				"t": "23",
				"r": "7",
				"n": "237"
			},
			"answers": ["2.37"],
			"expected": {
				"status": "bad_form",
				"constraintViolations": ["form"]
			}
		}
	]
}

	"variations": [
		{
			"statement": "Pour tous réels $a>0$ et $b>0$, $\\log(ab)$ est égal à :\n\n```choix\n- $\\log(a)+\\log(b)$\n- $\\log(a)\\times\\log(b)$\n- $\\log(a+b)$\n- $a\\log(b)$\n```",
			"variables": [],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"À connaître : le logarithme transforme un produit en somme.",
					"Pour $a>0$ et $b>0$ : $\\log(ab)=\\textcolor{{{color:primary.0}}}{\\log(a)+\\log(b)}$."
				]
			}
		},
		{
			"statement": "Sans calculatrice, calcule $\\log({{a}})+\\log({{eval:b;d}})$.\n\n$\\log({{a}})+\\log({{eval:b;d}})=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2|4|5|8|20|25"
				},
				{
					"name": "k",
					"expression": "1..3"
				},
				{
					"name": "b",
					"expression": "eval:10^k/a"
				}
			],
			"conditions": ["10^k > a"],
			"blanks": [
				{
					"expectedAnswer": "{{k}}"
				}
			],
			"correction": {
				"steps": [
					"Pour $a>0$ et $b>0$ : $\\log(ab)=\\log(a)+\\log(b)$.",
					"$\\log({{a}})+\\log({{eval:b;d}})=\\log({{a}}\\times{{eval:b;d}})=\\log({{eval:10^k}})=\\textcolor{{{color:primary.0}}}{{{k}}}$."
				]
			}
		},
		{
			"statement": "Écris sous la forme $\\log(n)$, avec $n$ entier : $\\log({{a}})+\\log({{b}})$.\n\n$\\log({{a}})+\\log({{b}})=\\log(?)$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				},
				{
					"name": "b",
					"expression": "2..9"

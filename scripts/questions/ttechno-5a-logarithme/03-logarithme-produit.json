			"conditions": ["a != b", "a+b != a*b"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*b}}"
				}
			],
			"correction": {
				"steps": [
					"Pour $a>0$ et $b>0$ : $\\log(ab)=\\log(a)+\\log(b)$.",
					"$\\log({{a}})+\\log({{b}})=\\log({{a}}\\times{{b}})=\\log(\\textcolor{{{color:primary.0}}}{{{eval:a*b}}})$."
				]
			}
		},
		{
			"statement": "Complète sans calculatrice.\n\n$\\log({{eval:a*10^k}})=\\log({{a}})+?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				},
				{
					"name": "k",
					"expression": "1..3"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{k}}"
				}
			],
			"correction": {
				"steps": [
					"Pour $a>0$ et $b>0$ : $\\log(ab)=\\log(a)+\\log(b)$.",
					"${{eval:a*10^k}}={{a}}\\times{{eval:10^k}}$, donc $\\log({{eval:a*10^k}})=\\log({{a}})+\\log({{eval:10^k}})=\\log({{a}})+\\textcolor{{{color:primary.0}}}{{{k}}}$."
				]
			}
		},
		{
			"statement": "On donne $\\log({{a}})\\approx{{eval:la;d}}$ et $\\log({{b}})\\approx{{eval:lb;d}}$. Déduis-en une valeur approchée de $\\log({{eval:a*b}})$.\n\n$\\log({{eval:a*b}})\\approx ?$",
			"variables": [
				{
					"name": "a",
					"expression": "2|3"
				},
				{
					"name": "b",
					"expression": "5|7"
				},
				{
					"name": "la",
					"expression": "eval:round(1000*log(a))/1000"
				},
				{
					"name": "lb",
					"expression": "eval:round(1000*log(b))/1000"
				}
			],
			"conditions": ["a*b != 10"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:la+lb;d}}"
				}
			],
			"correction": {
				"steps": [
					"Pour $a>0$ et $b>0$ : $\\log(ab)=\\log(a)+\\log(b)$.",
					"$\\log({{eval:a*b}})=\\log({{a}})+\\log({{b}})\\approx{{eval:la;d}}+{{eval:lb;d}}\\approx\\textcolor{{{color:primary.0}}}{{{eval:la+lb;d}}}$."
				]
			}
		}
	],

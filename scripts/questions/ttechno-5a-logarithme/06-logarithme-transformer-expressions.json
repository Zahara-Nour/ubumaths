			"conditions": ["m*b != a+b-c"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:m*b}}"
				}
			],
			"correction": {
				"steps": [
					"Pour $a>0$ et $b>0$ : $\\log(ab)=\\log(a)+\\log(b)$. Pour $a>0$ et $b>0$ : $\\log\\left(\\dfrac{a}{b}\\right)=\\log(a)-\\log(b)$ ; en particulier $\\log\\left(\\dfrac{1}{b}\\right)=-\\log(b)$.",
					"$A=\\log\\left(\\dfrac{ {{a}}\\times{{b}} }{ {{c}} }\\right)=\\log(\\textcolor{{{color:primary.0}}}{{{eval:m*b}}})$."
				]
			}
		},
		{
			"statement": "Pour tout réel $x>0$, complète.\n\n$\\log({{eval:10^k}}x)=?+\\log(x)$",
			"variables": [

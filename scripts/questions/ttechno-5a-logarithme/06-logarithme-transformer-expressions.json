			],
			"correction": {
				"steps": [
					"Pour $a>0$ et $n$ entier naturel : $\\log\\left(a^n\\right)=n\\log(a)$.",
					"$\\log\\left(x^{ {{n}} }\\right)+\\log\\left(x^{ {{m}} }\\right)={{n}}\\log(x)+{{m}}\\log(x)=\\textcolor{{{color:primary.0}}}{{{eval:n+m}}}\\log(x)$."
				]
			}
		},
		{
			"statement": "Pour tout réel $x>0$, complète.\n\n$\\log\\left(\\dfrac{ {{eval:10^k}} }{x^{ {{n}} }}\\right)=?-?\\log(x)$",
			"variables": [
				{
					"name": "k",
					"expression": "1..3"

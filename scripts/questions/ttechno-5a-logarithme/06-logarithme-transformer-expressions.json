	"variations": [
		{
			"statement": "Écris $\\log({{eval:2^p*3^q}})$ en fonction de $\\log(2)$ et $\\log(3)$.\n\n$\\log({{eval:2^p*3^q}})=?\\log(2)+?\\log(3)$",
			"variables": [
				{
					"name": "p",
					"expression": "1..4"
				},
				{
					"name": "q",
					"expression": "1..3"
				}
			],
			"conditions": ["p+q >= 3"],
			"blanks": [
				{
					"expectedAnswer": "{{p}}"
				},
				{
					"expectedAnswer": "{{q}}"
				}
			],
			"correction": {
				"steps": [
					"Pour $a>0$ et $b>0$ : $\\log(ab)=\\log(a)+\\log(b)$. Pour $a>0$ et $n$ entier naturel : $\\log\\left(a^n\\right)=n\\log(a)$.",
					"${{eval:2^p*3^q}}={{if:p==1|2|2^{ {{p}} }}}\\times{{if:q==1|3|3^{ {{q}} }}}$, donc $\\log({{eval:2^p*3^q}})=\\log\\left({{if:p==1|2|2^{ {{p}} }}}\\right)+\\log\\left({{if:q==1|3|3^{ {{q}} }}}\\right)=\\textcolor{{{color:primary.0}}}{{{p}}}\\log(2)+\\textcolor{{{color:primary.0}}}{{{q}}}\\log(3)$."
				]
			}
		},
		{
			"statement": "Écris $A=\\log({{a}})+\\log({{b}})-\\log({{c}})$ sous la forme $\\log(n)$, avec $n$ entier.\n\n$A=\\log(?)$",
			"variables": [
				{
					"name": "c",
					"expression": "2..5"
				},
				{
					"name": "m",
					"expression": "2..5"
				},
				{

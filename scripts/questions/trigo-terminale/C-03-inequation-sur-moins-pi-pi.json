	"variations": [
		{
			"statement": "Résous dans $\\left[-\\pi\\,;\\pi\\right]$ l'inéquation $\\cos x\\leqslant{{eval:cos(n*pi/12)}}$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [
				{
					"name": "a",
					"expression": "\\frac{\\pi}{6}|\\frac{\\pi}{4}|\\frac{\\pi}{3}|\\frac{2\\pi}{3}|\\frac{3\\pi}{4}|\\frac{5\\pi}{6}"
				},
				{
					"name": "n",
					"expression": "eval:12*a/\\pi"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "[-\\pi;-{{a}}]\\cup[{{a}};\\pi]"
				}
			],
			"correction": {
				"steps": [
					"$\\cos x={{eval:cos(n*pi/12)}}$ pour $x=-{{a}}$ et $x={{a}}$ ; $\\cos x$ est plus petit quand le point du cercle est plus à gauche.",
					"```trig\npreset: custom\nangles: -{{n}}*pi/12, {{n}}*pi/12, pi\nequation: cos(x) <= cos({{n}}*pi/12)\nmode: arc\nmesures: principales\n```",
					"Sur $\\left[-\\pi\\,;\\pi\\right]$, bornes $-\\pi$ et $\\pi$ comprises : $S=\\textcolor{{{color:primary.0}}}{\\left[-\\pi\\,;-{{a}}\\right]\\cup\\left[{{a}}\\,;\\pi\\right]}$."
				]
			}
		},
		{
			"statement": "Résous dans $\\left[-\\pi\\,;\\pi\\right]$ l'inéquation $\\cos x>{{eval:cos(n*pi/12)}}$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [

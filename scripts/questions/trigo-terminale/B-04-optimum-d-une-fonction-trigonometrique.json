			"correction": {
				"steps": [
					"$f'(x)=1-2\\cos x$ : $f$ décroît sur $\\left[0\\,;\\frac{\\pi}{3}\\right]$ et croît sur $\\left[\\frac{\\pi}{3}\\,;\\pi\\right]$.",
					"$m=f\\left(\\frac{\\pi}{3}\\right)=\\frac{\\pi}{3}-2\\times\\frac{\\sqrt{3}}{2}=\\textcolor{{{color:primary.0}}}{\\frac{\\pi}{3}-\\sqrt{3}}$."
				]
			}
		}

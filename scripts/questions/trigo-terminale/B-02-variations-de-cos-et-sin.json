	"variations": [
		{
			"statement": "Sur l'intervalle $\\left[-\\pi\\,;\\pi\\right]$, détermine le plus grand intervalle sur lequel la fonction $\\cos$ est **croissante**.\n\n$I=?$",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "[-\\pi;0]"
				}
			],
			"correction": {
				"steps": [
					"$\\cos'(x)=-\\sin x$, et $-\\sin x\\geqslant0\\iff\\sin x\\leqslant0\\iff x\\in\\left[-\\pi\\,;0\\right]$ (sur $\\left[-\\pi\\,;\\pi\\right]$).",
					"```trig\npreset: quarters\nequation: sin(x) <= 0\nmode: arc\nmesures: principales\n```",
					"$\\cos$ est croissante sur $\\textcolor{{{color:primary.0}}}{\\left[-\\pi\\,;0\\right]}$ (de $-1$ à $1$)."
				]
			}
		},
		{
			"statement": "Sur l'intervalle $\\left[-\\pi\\,;\\pi\\right]$, détermine le plus grand intervalle sur lequel la fonction $\\cos$ est **décroissante**.\n\n$I=?$",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "[0;\\pi]"
				}
			],
			"correction": {
				"steps": [
					"$\\cos'(x)=-\\sin x\\leqslant0\\iff\\sin x\\geqslant0\\iff x\\in\\left[0\\,;\\pi\\right]$ (sur $\\left[-\\pi\\,;\\pi\\right]$).",
					"$\\cos$ est décroissante sur $\\textcolor{{{color:primary.0}}}{\\left[0\\,;\\pi\\right]}$ (de $1$ à $-1$)."
				]
			}
		},
		{
			"statement": "Sur l'intervalle $\\left[-\\pi\\,;\\pi\\right]$, détermine le plus grand intervalle sur lequel la fonction $\\sin$ est **croissante**.\n\n$I=?$",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "[-\\frac{\\pi}{2};\\frac{\\pi}{2}]"
				}
			],
			"correction": {
				"steps": [
					"$\\sin'(x)=\\cos x\\geqslant0\\iff x\\in\\left[-\\frac{\\pi}{2}\\,;\\frac{\\pi}{2}\\right]$ (sur $\\left[-\\pi\\,;\\pi\\right]$).",
					"```trig\npreset: quarters\nequation: cos(x) >= 0\nmode: arc\nmesures: principales\n```",
					"$\\sin$ est croissante sur $\\textcolor{{{color:primary.0}}}{\\left[-\\frac{\\pi}{2}\\,;\\frac{\\pi}{2}\\right]}$ (de $-1$ à $1$)."
				]
			}
		},
		{
			"statement": "Sur l'intervalle $\\left[-\\pi\\,;\\pi\\right]$, sur quel ensemble la fonction $\\sin$ est-elle **décroissante** ? Donne la réunion des plus grands intervalles.\n\n$I=?$",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "[-\\pi;-\\frac{\\pi}{2}]\\cup[\\frac{\\pi}{2};\\pi]"
				}
			],
			"correction": {
				"steps": [
					"$\\sin'(x)=\\cos x\\leqslant0\\iff x\\in\\left[-\\pi\\,;-\\frac{\\pi}{2}\\right]\\cup\\left[\\frac{\\pi}{2}\\,;\\pi\\right]$ (sur $\\left[-\\pi\\,;\\pi\\right]$).",
					"$\\sin$ est décroissante sur $\\textcolor{{{color:primary.0}}}{\\left[-\\pi\\,;-\\frac{\\pi}{2}\\right]}$ et sur $\\textcolor{{{color:primary.0}}}{\\left[\\frac{\\pi}{2}\\,;\\pi\\right]}$."
				]
			}
		}
	],

	"delay": 60,
	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\cos({{a}}x)$.\n\nDonne la plus petite période strictement positive de $f$.\n\n$T=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..6"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:a==2|\\pi|{{if:a==4|\\frac{\\pi}{2}|{{if:a==6|\\frac{\\pi}{3}|\\frac{2\\pi}{ {{a}} }}}}}}}"
				}
			],
			"correction": {
				"steps": [
					"$f(x+T)=\\cos({{a}}x+{{a}}T)$ : quand $x$ augmente de $T$, ${{a}}x$ augmente de ${{a}}T$.",
					"La période de $\\cos$ est $2\\pi$ : il faut ${{a}}T=2\\pi$, donc $T=\\dfrac{2\\pi}{ {{a}} }=\\textcolor{{{color:primary.0}}}{{{if:a==2|\\pi|{{if:a==4|\\frac{\\pi}{2}|{{if:a==6|\\frac{\\pi}{3}|\\frac{2\\pi}{ {{a}} }}}}}}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\sin({{a}}x{{b;+}})$.\n\nDonne la plus petite période strictement positive de $f$.\n\n$T=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..6"
				},
				{
					"name": "b",
					"expression": "1..5;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:a==2|\\pi|{{if:a==4|\\frac{\\pi}{2}|{{if:a==6|\\frac{\\pi}{3}|\\frac{2\\pi}{ {{a}} }}}}}}}"
				}
			],
			"correction": {
				"steps": [
					"$f(x+T)=\\sin({{a}}x+{{a}}T{{b;+}})$ : il faut ${{a}}T=2\\pi$ ; la constante ${{b}}$ ne change pas la période.",
					"$T=\\dfrac{2\\pi}{ {{a}} }=\\textcolor{{{color:primary.0}}}{{{if:a==2|\\pi|{{if:a==4|\\frac{\\pi}{2}|{{if:a==6|\\frac{\\pi}{3}|\\frac{2\\pi}{ {{a}} }}}}}}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\cos\\left(\\dfrac{x}{ {{a}} }\\right)$.\n\nDonne la plus petite période strictement positive de $f$.\n\n$T=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*a}}\\pi"
				}
			],
			"correction": {
				"steps": [
					"$f(x)=\\cos\\left(\\frac{1}{ {{a}} }x\\right)$ : il faut $\\frac{1}{ {{a}} }T=2\\pi$.",
					"$T=\\textcolor{{{color:primary.0}}}{{{eval:2*a}}\\pi}$ : la courbe est « étirée », la période est plus grande que $2\\pi$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)={{k}}\\sin(\\pi x)$.\n\nDonne la plus petite période strictement positive de $f$.\n\n$T=?$",
			"variables": [
				{
					"name": "k",
					"expression": "2..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "2"
				}
			],
			"correction": {
				"steps": [
					"Il faut $\\pi T=2\\pi$ : $f(x+2)={{k}}\\sin(\\pi x+2\\pi)=f(x)$.",
					"$T=\\textcolor{{{color:primary.0}}}{2}$ (un nombre sans $\\pi$ : la variable est multipliée par $\\pi$)."
				]
			}
		}
	],

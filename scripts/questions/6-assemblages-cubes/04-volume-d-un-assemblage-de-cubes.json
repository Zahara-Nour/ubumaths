				},
				{
					"name": "p",
					"expression": "2..3"
				},
				{
					"name": "h",
					"expression": "1..3"
				},
				{
					"name": "R",
					"expression": "{{if:l==2|{{h}} {{h}}|{{if:l==3|{{h}} {{h}} {{h}}|{{h}} {{h}} {{h}} {{h}}}}}}"
				},
				{
					"name": "H",
					"expression": "{{if:p==2|{{R}} / {{R}}|{{R}} / {{R}} / {{R}}}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:l*p*h}}"
				}
			],
			"correction": {
				"steps": [
					"**Étage par étage.** Un étage a ${{p}}$ rangées de ${{l}}$ cubes : ${{l}} \\times {{p}} = {{eval:l*p}}$ cubes.",
					"{{if:h==1|Il n'y a qu'un étage : ${{eval:l*p}}$ cubes.|Il y a ${{h}}$ étages : ${{eval:l*p}} \\times {{h}} = {{eval:l*p*h}}$ cubes.}}",
					"Un cube d'arête $1~\\unit{cm}$ a un volume de $1~\\unit{cm^3}$. Le volume est $\\textcolor{{{color:primary.0}}}{{{eval:l*p*h}}~\\unit{cm^3}}$."
				]
			}
		},
		{
			"statement": "Chaque cube a une arête de $1~\\unit{cm}$. Quel est le volume de cet assemblage ?\n\n```cubes\nhauteurs: {{H}}\n```\n\n$$?~\\text{cm}^3$$",
			"variables": [

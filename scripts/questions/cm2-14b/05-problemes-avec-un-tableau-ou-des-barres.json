				},
				{
					"name": "a2",
					"expression": "eval:100*u2"
				},
				{
					"name": "a3",
					"expression": "eval:100*u3"
				},
				{
					"name": "a4",
					"expression": "eval:100*u4"
				},
				{
					"name": "a5",
					"expression": "eval:100*u5"
				},
				{
					"name": "w",
					"expression": "1..9"
				},
				{
					"name": "s",
					"expression": "eval:a1+a2+a3"
				},
				{
					"name": "n",
					"expression": "eval:50*w"
				},
				{
					"name": "T",
					"expression": "eval:s+n"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{n}}"
				}
			],
			"correction": {
				"steps": [
					"De janvier à mars : ${{a1}} + {{a2}} + {{a3}} = {{s}}$ visiteurs.",
					"Ce qui manque pour aller à ${{T}}$ : ${{T}} - {{s}} = \\textcolor{{{color:primary.0}}}{{{n}}}$ visiteurs."
				]
			}
		}
	],

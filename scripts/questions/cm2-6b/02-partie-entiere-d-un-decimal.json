{
	"title": "Donner la partie entière d'un nombre décimal",
	"description": "Donner la partie entière d'un nombre décimal à une, deux ou trois décimales (3,7 → 3 ; 105,78 → 105 ; 0,045 → 0)",
	"grades": ["CM2"],
	"theme": "Décimaux",
	"domain": "Apprivoiser",
	"subdomain": "Arrondir",
	"level": 6,
	"delay": 30,
	"status": "draft",
	"options": {
		"constraints": {
			"spacesFromFourDigits": true
		}
	},
	"variations": [
		{
			"statement": "Quelle est la partie entière de ${{x}}$ ?\n\n$$?$$",
			"variables": [
				{
					"name": "a",
					"expression": "0..99"
				},
				{
					"name": "k",
					"expression": "1..3"
				},
				{
					"name": "D",
					"expression": "1..{{eval:10^k-1}}"
				},
				{
					"name": "x",
					"expression": "eval:(10^k*a+D)/10^k;d"
				}
			],
			"conditions": ["mod(D,10)!=0"],
			"blanks": [
				{
					"expectedAnswer": "{{a}}"
				}
			],
			"correction": {
				"steps": [
					"**La partie entière**, c'est le nombre d'unités entières : ce qui est écrit avant la virgule.",
					"${{x}} = \\textcolor{{{color:primary.0}}}{{{a}}} + {{eval:D/10^k;d}}$"
				]
			}
		},
		{
			"statement": "Quelle est la partie entière de ${{x}}$ ?\n\n$$?$$",

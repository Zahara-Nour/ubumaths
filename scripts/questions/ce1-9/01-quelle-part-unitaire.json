				{
					"name": "d",
					"expression": "eval:2*c"
				},
				{
					"name": "r",
					"expression": "1..{{d}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{1}{{{d}}}",
					"requiredForm": "fraction"
				}
			],
			"correction": {
				"steps": [
					"**La figure est partagée en $2 \\times {{c}} = {{d}}$ parts égales** : une part, c'est $\\frac{1}{{{d}}}$ de la figure, un {{if:d==2|demi|{{if:d==3|tiers|{{if:d==4|quart|{{if:d==5|cinquième|{{if:d==6|sixième|{{if:d==8|huitième|dixième}}}}}}}}}}}}.",
					"Une seule part est coloriée : $\\textcolor{{{color:primary.0}}}{\\frac{1}{{{d}}}}$."
				]
			}
		},
		{
			"statement": "Quelle fraction de la figure est coloriée ?\n\n```partage\nforme: carre-diagonales\ngris: {{r}},\n```\n\n$$?$$",
			"variables": [
				{
					"name": "r",
					"expression": "1..4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{1}{4}",
					"requiredForm": "fraction"
				}
			],
			"correction": {
				"steps": [
					"**Le carré est partagé en $4$ triangles égaux** : un triangle, c'est $\\frac{1}{4}$ du carré, un quart.",
					"Un seul triangle est colorié : $\\textcolor{{{color:primary.0}}}{\\frac{1}{4}}$."
				]
			}
		}
	],

				},
				{
					"name": "r",
					"expression": "1..{{d}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{1}{{{d}}}",
					"requiredForm": "fraction"
				}
			],
			"correction": {
				"steps": [
					"**La figure est partagée en ${{d}}$ parts égales** : une part, c'est $\\frac{1}{{{d}}}$ de la figure, un {{if:d==2|demi|{{if:d==3|tiers|{{if:d==4|quart|{{if:d==5|cinquième|{{if:d==6|sixième|{{if:d==8|huitième|dixième}}}}}}}}}}}}.",
					"Une seule part est coloriée : $\\textcolor{{{color:primary.0}}}{\\frac{1}{{{d}}}}$."
				]
			}
		},
		{
			"statement": "Quelle fraction de la figure est coloriée ?\n\n```partage\nforme: grille 2×{{c}}\ngris: {{r}},\n```\n\n$$?$$",

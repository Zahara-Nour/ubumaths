	"variations": [
		{
			"statement": "Quelle fraction de la figure est coloriée ?\n\n```partage\nforme: {{if:k==0|bande|disque}} {{d}}\ngris: {{r}},\n```\n\n$$?$$",
			"variables": [
				{
					"name": "k",
					"expression": "0..1"

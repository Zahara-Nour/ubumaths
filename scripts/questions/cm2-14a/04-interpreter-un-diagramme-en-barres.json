				},
				{
					"name": "n",
					"expression": "eval:min(1,max(0,u1-s))+min(1,max(0,u2-s))+min(1,max(0,u3-s))+min(1,max(0,u4-s))+min(1,max(0,u5-s))+min(1,max(0,u6-s))"
				}
			],
			"conditions": [
				"(u1-s)*(u1-s) > 0",
				"(u2-s)*(u2-s) > 0",
				"(u3-s)*(u3-s) > 0",
				"(u4-s)*(u4-s) > 0",
				"(u5-s)*(u5-s) > 0",
				"(u6-s)*(u6-s) > 0",
				"n > 0",
				"n < 6"
			],
			"blanks": [
				{
					"expectedAnswer": "{{n}}"
				}
			],
			"correction": {
				"steps": [
					"On repère le trait ${{eval:100*s}}$ sur l'axe, et on compte les barres qui le dépassent.",
					"Il y en a $\\textcolor{{{color:primary.0}}}{{{n}}}$."
				]
			}
		}

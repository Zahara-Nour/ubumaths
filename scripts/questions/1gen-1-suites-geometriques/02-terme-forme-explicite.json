	"delay": 30,
	"status": "draft",
	"shared": {},
	"variations": [
		{
			"statement": "La suite $(u_n)$ est définie, pour tout entier naturel $n$, par $u_n={{a}}\\times{{q}}^n$.\n\nCalcule $u_{{k}}$.\n\n$u_{{k}}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "q",
					"expression": "2|3"
				},
				{
					"name": "k",
					"expression": "2..5"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*q^k;d}}"
				}
			],
			"correction": {
				"steps": [
					"On remplace $n$ par ${{k}}$ : $u_{{k}}={{a}}\\times{{q}}^{{k}}$.",
					"On calcule d'abord la puissance : ${{q}}^{{k}}={{eval:q^k}}$, puis $u_{{k}}={{a}}\\times{{eval:q^k}}=\\textcolor{{{color:primary.0}}}{{{eval:a*q^k;d}}}$."
				]
			}
		},
		{
			"statement": "Un village compte ${{c}}$ habitants en 2025. On modélise sa population $n$ années après 2025 par $u_n={{c}}\\times{{q}}^n$.\n\nCalcule $u_{ {{k}} }$, arrondi à l'unité.\n\n$u_{ {{k}} }\\approx ?$",
			"variables": [
				{
					"name": "c",
					"expression": "1000|2000|5000"
				},
				{
					"name": "q",
					"expression": "1.02|1.03|1.05"
				},
				{
					"name": "k",
					"expression": "5..12"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{eval:round(c*q^k)}}"
				}
			],
			"correction": {
				"steps": [
					"On remplace $n$ par ${{k}}$ : $u_{ {{k}} }={{c}}\\times{{q}}^{ {{k}} }$.",
					"À la calculatrice, $u_{ {{k}} }\\approx\\textcolor{{{color:primary.0}}}{{{eval:round(c*q^k)}}}$ habitants."
				]
			}
		}
	],

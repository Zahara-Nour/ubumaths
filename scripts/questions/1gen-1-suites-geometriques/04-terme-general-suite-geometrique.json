					"name": "q",
					"expression": "2..5"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{a}}\\times{{q}}^{n-1}"
				}
			],
			"correction": {
				"steps": [
					"Le premier terme est $u_1$ : pour aller de $u_1$ à $u_n$, on multiplie $n-1$ fois par la raison. Donc $u_n=u_1\\times q^{n-1}$.",
					"$u_n=\\textcolor{{{color:primary.0}}}{{{a}}\\times{{q}}^{n-1}}$."
				]
			}
		},
		{
			"statement": "On place ${{c}}~\\unit{€}$ à ${{t}}~\\%$ d'intérêts composés par an. On note $u_n$ la somme disponible au bout de $n$ années, donc $u_0={{c}}$.\n\nExprime $u_n$ en fonction de $n$.\n\n$u_n=?$",
			"variables": [
				{
					"name": "c",
					"expression": "500|1000|2000"
				},
				{
					"name": "t",
					"expression": "2..5"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{c}}\\times{{eval:1+t/100;d}}^n"
				}
			],
			"correction": {
				"steps": [
					"Chaque année, la somme augmente de ${{t}}~\\%$ : elle est multipliée par $1+\\dfrac{{{t}}}{100}={{eval:1+t/100;d}}$. La suite $(u_n)$ est géométrique de raison ${{eval:1+t/100;d}}$.",
					"Son premier terme est $u_0={{c}}$, donc $u_n=\\textcolor{{{color:primary.0}}}{{{c}}\\times{{eval:1+t/100;d}}^n}$."
				]
			}
		}
	],

			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{a}}\\times{{q}}^n"
				}
			],
			"correction": {
				"steps": [
					"Le premier terme est $u_0$ : pour aller de $u_0$ à $u_n$, on multiplie $n$ fois par la raison. Donc $u_n=u_0\\times q^n$.",
					"$u_n=\\textcolor{{{color:primary.0}}}{{{a}}\\times{{q}}^n}$."
				]
			}
		},
		{
			"statement": "$(u_n)$ est la suite géométrique de premier terme $u_1={{a}}$ et de raison $q={{q}}$.\n\nExprime $u_n$ en fonction de $n$.\n\n$u_n=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				},

			],
			"statement": "Soit $f$ la fonction définie pour $x\\neq{{eval:-b/a}}$ par $f(x)={1}/{ {{a}}x{{eval:b;+}} }$.\n\nCalcule $f'(x)$.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..6"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"conditions": ["gcd(a,b) = 1"],
			"correction": {
				"steps": [
					"$f=\\frac{1}{v}$ : $\\left(\\frac{1}{v}\\right)'=-\\frac{v'}{v^2}$.",
					"Avec $v(x)={{a}}x{{eval:b;+}}$ : $v'(x)={{a}}$.",
					"$$f'(x)=\\textcolor{{{color:primary.0}}}{-\\frac{ {{a}} }{({{eval:a*x+b}})^2} }$$"
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "-\\frac{ {{eval:k*a}} }{({{eval:a*x+b}})^2}"
				}
			],
			"statement": "Soit $f$ la fonction définie pour $x\\neq{{eval:-b/a}}$ par $f(x)={ {{k}} }/{ {{a}}x{{eval:b;+}} }$.\n\nCalcule $f'(x)$.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "k",
					"expression": "2..9"
				},
				{
					"name": "a",
					"expression": "1..5"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"conditions": ["gcd(a,b) = 1"],
			"correction": {
				"steps": [
					"$f=k\\times\\frac{1}{v}$ avec $k={{k}}$ : $\\left(\\frac{k}{v}\\right)'=-\\frac{kv'}{v^2}$.",
					"Avec $v(x)={{a}}x{{eval:b;+}}$ : $v'(x)={{a}}$.",
					"$$f'(x)=-{ {{k}}*{{a}} }/{({{a}}x{{eval:b;+}})^2}$$ $$f'(x)=\\textcolor{{{color:primary.0}}}{-\\frac{ {{eval:k*a}} }{({{eval:a*x+b}})^2} }$$"
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "-\\frac{ {{eval:2*k}}x}{(x^2+{{c}})^2}"
				}
			],
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\frac{ {{k}} }{x^2+{{c}}}$.\n\nCalcule $f'(x)$.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "k",
					"expression": "2..6"
				},
				{
					"name": "c",
					"expression": "1..9"
				}
			],
			"correction": {
				"steps": [
					"$f=k\\times\\frac{1}{v}$ avec $k={{k}}$ : $\\left(\\frac{k}{v}\\right)'=-\\frac{kv'}{v^2}$.",
					"Avec $v(x)=x^2+{{c}}$ : $v'(x)=2x$. On a bien $v(x)>0$ pour tout réel $x$.",
					"$$f'(x)=-\\frac{ {{k}}\\times2x}{(x^2+{{c}})^2}=\\textcolor{{{color:primary.0}}}{-\\frac{ {{eval:2*k}}x}{(x^2+{{c}})^2} }$$"
				]
			}
		}
	],

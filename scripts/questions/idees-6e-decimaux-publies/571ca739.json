				}
			],
			"statement": "Sachant que ${{eval:a;d}} * {{eval:b;d}}={{eval:a*b;d}}$, calcule :\n\n$${{expression1}}$$",
			"variables": [
				{
					"name": "expression1",
					"expression": "{{eval:a*c;d}}* {{b}}"
				}
			],
			"correction": {
				"steps": [
					"${{eval:a*c;d}}$ est $\\textcolor{{{color:primary.0}}}{{{eval:c}}\\text{ fois}}$ plus grand que ${{eval:a;d}}$,",
					"donc le résultat de ${{eval:a*c;d}} \\times {{eval:b;d}}$ est  $\\textcolor{{{color:primary.0}}}{{{eval:c}}\\text{ fois}}$ plus grand que celui de ${{eval:a;d}}\\times{{eval:b;d}}$,",
					" c'est-à-dire $\\textcolor{{{color:primary.0}}}{{{eval:c}}\\times} {{eval:a*b;d}} = {{solution}}$"
				]
			}
		},
		{
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*c*b;d}}"

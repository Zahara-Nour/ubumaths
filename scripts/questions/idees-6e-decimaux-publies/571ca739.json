				{
					"name": "expression2",
					"expression": "{{b}}*{{eval:a*c;d}}"
				}
			],
			"correction": {
				"steps": [
					"${{eval:a*c;d}}$ est $\\textcolor{{{color:primary.0}}}{{{eval:c}}\\text{ fois}}$ plus grand que ${{eval:a;d}}$,",
					"donc le résultat de ${{eval:b;d}} \\times {{eval:a*c;d}} $ est  $\\textcolor{{{color:primary.0}}}{{{eval:c}}\\text{ fois}}$ plus grand que celui de ${{eval:b;d}} \\times {{eval:a;d}}$,",
					"c'est-à-dire $\\textcolor{{{color:primary.0}}}{{{eval:c}}\\times} {{eval:a*b;d}} = {{solution}}$"
				]
			}
		},
		{
			"statement": "Sachant que ${{A}} \\times {{B}} = {{eval:A*B}}$, calcule :\n\n$${{x}} \\times {{y}} = ?$$",
			"variables": [
				{
					"name": "A",
					"expression": "11..99"
				},
				{
					"name": "B",
					"expression": "11..99"
				},
				{
					"name": "u",
					"expression": "1..2"
				},
				{
					"name": "v",
					"expression": "1..2"
				},
				{
					"name": "x",
					"expression": "eval:A/10^u;d"
				},
				{
					"name": "y",
					"expression": "eval:B/10^v;d"
				},
				{
					"name": "M",
					"expression": "{{if:u>=v|{{u}}|{{v}}}}"
				}
			],
			"conditions": ["mod(A,10)!=0", "mod(B,10)!=0", "mod(A*B,10)!=0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:A*B/10^(u+v);d}}",
					"expectedErrors": [
						{
							"answer": "{{eval:A*B/10^M;d}}",
							"message": "Tu n'as compté les décimales que d'un seul facteur : ${{x}}$ en a ${{u}}$ et ${{y}}$ en a ${{v}}$.",
							"label": "Décimales d'un seul facteur"
						},
						{
							"answer": "{{eval:A*B}}",
							"message": "Les deux facteurs sont plus petits que ${{A}}$ et ${{B}}$ : le produit est plus petit que ${{eval:A*B}}$.",
							"label": "Produit des entiers recopié"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"${{x}}$ est ${{eval:10^u}}$ fois plus petit que ${{A}}$, et ${{y}}$ est ${{eval:10^v}}$ fois plus petit que ${{B}}$.",
					"Donc ${{x}} \\times {{y}}$ est ${{eval:10^u}} \\times {{eval:10^v}} = {{eval:10^(u+v)}}$ fois plus petit que ${{A}} \\times {{B}}$ : $\\textcolor{{{color:primary.0}}}{{{u}}+{{v}}={{eval:u+v}}\\text{ décimales}}$.",
					"$${{x}} \\times {{y}} = {{eval:A*B}} \\div {{eval:10^(u+v)}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			},
			"hint": "Compare chaque facteur à ${{A}}$ et à ${{B}}$ : combien de fois est-il plus petit ?"
		}
	],

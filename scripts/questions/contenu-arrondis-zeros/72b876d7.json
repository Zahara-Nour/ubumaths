			],
			"statement": "$(u_n)$ est une suite géométrique à termes positifs telle que $u_{{k}}={{eval:a*q^(2*s)}}$ et $u_{{k2}}={{eval:a*q^(2-2*s)}}$.\n\nCalcule $u_{{k1}}$.\n\n$u_{{k1}}=?$",
			"variables": [
				{
					"name": "k",
					"expression": "0..6"
				},
				{
					"name": "k1",
					"expression": "eval:k+1"
				},
				{
					"name": "k2",
					"expression": "eval:k+2"
				},
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "q",
					"expression": "2..5"
				},
				{
					"name": "s",
					"expression": "0|1"
				}
			],
			"conditions": ["a*q^2 <= 400"],
			"correction": {
				"steps": [
					"Dans une suite géométrique à termes positifs, chaque terme est la moyenne géométrique du terme qui le précède et du terme qui le suit.",
					"$u_{{k1}}=\\sqrt{u_{{k}}\\times u_{{k2}}}=\\sqrt{ {{eval:a*q^(2*s)}}\\times{{eval:a*q^(2-2*s)}} }=\\sqrt{ {{eval:a^2*q^2}} }=\\textcolor{{{color:primary.0}}}{{{eval:a*q}}}$."
				]
			}
		}
	],

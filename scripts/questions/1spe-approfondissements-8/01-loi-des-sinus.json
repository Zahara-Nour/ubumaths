	"variations": [
		{
			"statement": "Dans un triangle $ABC$, on admet la loi des sinus :\n\n$$\\dfrac{BC}{\\sin\\widehat{A}}=\\dfrac{AC}{\\sin\\widehat{B}}=\\dfrac{AB}{\\sin\\widehat{C}}$$\n\nDans le triangle $ABC$, $\\widehat{A}=30^\\circ$, $\\widehat{B}=45^\\circ$ et $BC={{eval:a}}$ cm. Calcule $AC$, en valeur exacte.\n\n$AC=?$ cm",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a}}\\sqrt{2}"
				}
			],
			"correction": {
				"steps": [
					"La loi des sinus donne $\\dfrac{AC}{\\sin\\widehat{B}}=\\dfrac{BC}{\\sin\\widehat{A}}$, donc $AC=\\dfrac{BC\\times\\sin\\widehat{B}}{\\sin\\widehat{A}}$.",
					"$\\sin 30^\\circ=\\dfrac{1}{2}$ et $\\sin 45^\\circ=\\dfrac{\\sqrt{2}}{2}$ : $AC=\\dfrac{{{eval:a}}\\times\\frac{\\sqrt{2}}{2}}{\\frac{1}{2}}$.",
					"Donc $AC=\\textcolor{{{color:primary.0}}}{{{eval:a}}\\sqrt{2}}$ cm."
				]
			}
		},
		{
			"statement": "Dans un triangle $ABC$, on admet la loi des sinus :\n\n$$\\dfrac{BC}{\\sin\\widehat{A}}=\\dfrac{AC}{\\sin\\widehat{B}}=\\dfrac{AB}{\\sin\\widehat{C}}$$\n\nDans le triangle $ABC$, $\\widehat{A}=45^\\circ$, $\\widehat{B}=60^\\circ$ et $BC={{eval:k}}\\sqrt{2}$ cm. Calcule $AC$, en valeur exacte.\n\n$AC=?$ cm",

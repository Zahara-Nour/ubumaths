{
	"title": "Soustraire une fraction d'un entier",
	"description": "Entier moins fraction (1 − 3/8, 2 − 3/4) : écrire l'entier comme une fraction de même dénominateur",
	"grades": ["6"],
	"theme": "Fractions",
	"domain": "Calculer",
	"subdomain": "Addition et Soustraction",
	"level": 13,
	"delay": 30,
	"status": "draft",
	"variations": [
		{
			"statement": "Calcule. Donne le résultat sous forme d'une fraction.\n\n$${{n}} - \\frac{{{c}}}{{{d}}} = ?$$",
			"variables": [
				{
					"name": "n",
					"expression": "1..3"
				},
				{
					"name": "d",
					"expression": "2..9"
				},
				{
					"name": "c",
					"expression": "1..{{eval:d-1}}"
				}
			],
			"conditions": ["gcd(c,d)==1"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{eval:n*d-c}}}{{{d}}}"
				}
			],
			"correction": {
				"steps": [
					"**Soustraire des fractions.** On écrit les deux fractions avec le même dénominateur, puis on soustrait les numérateurs ; le dénominateur ne change pas.",
					"${{n}} = \\frac{{{eval:n*d}}}{{{d}}}$ : {{if:n==1|une unité, c'est|${{n}}$ unités, c'est}} ${{eval:n*d}}$ fois $\\frac{1}{{{d}}}$.",
					"$${{n}} - \\frac{{{c}}}{{{d}}} = \\frac{{{eval:n*d}}}{{{d}}} - \\frac{{{c}}}{{{d}}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		}
	],
	"testSpecs": [
		{
			"description": "1 − 3/8 = 5/8",
			"variationIndex": 0,
			"variables": {

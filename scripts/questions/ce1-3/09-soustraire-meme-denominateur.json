{
	"title": "Soustraire des fractions de même dénominateur",
	"description": "4/5 − 1/5 ; 1 − 3/10 (exemples du BO)",
	"grades": ["CE1"],
	"theme": "Fractions",
	"domain": "Calculer",
	"subdomain": "Addition et Soustraction",
	"level": 14,
	"delay": 60,
	"status": "draft",
	"options": {
		"constraints": {
			"reducedFractions": "off"
		}
	},
	"variations": [
		{
			"statement": "Calcule.\n\n$$\\frac{{{a}}}{{{d}}} - \\frac{{{b}}}{{{d}}} = ?$$",
			"variables": [
				{
					"name": "d",
					"expression": "3|4|5|6|8|10"
				},
				{
					"name": "a",
					"expression": "2..{{d}}"
				},
				{
					"name": "b",
					"expression": "1..{{eval:a-1}}"
				},
				{
					"name": "s",
					"expression": "eval:a-b"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{s}}}{{{d}}}"
				}
			],
			"correction": {
				"steps": [
					"On enlève des parts de même taille : ${{a}}$ {{if:d==2|demis|{{if:d==3|tiers|{{if:d==4|quarts|{{if:d==5|cinquièmes|{{if:d==6|sixièmes|{{if:d==8|huitièmes|dixièmes}}}}}}}}}}}} moins ${{b}}$ {{if:b==1|{{if:d==2|demi|{{if:d==3|tiers|{{if:d==4|quart|{{if:d==5|cinquième|{{if:d==6|sixième|{{if:d==8|huitième|dixième}}}}}}}}}}}}|{{if:d==2|demis|{{if:d==3|tiers|{{if:d==4|quarts|{{if:d==5|cinquièmes|{{if:d==6|sixièmes|{{if:d==8|huitièmes|dixièmes}}}}}}}}}}}}}}, il reste ${{s}}$ {{if:s==1|{{if:d==2|demi|{{if:d==3|tiers|{{if:d==4|quart|{{if:d==5|cinquième|{{if:d==6|sixième|{{if:d==8|huitième|dixième}}}}}}}}}}}}|{{if:d==2|demis|{{if:d==3|tiers|{{if:d==4|quarts|{{if:d==5|cinquièmes|{{if:d==6|sixièmes|{{if:d==8|huitièmes|dixièmes}}}}}}}}}}}}}}. **Le dénominateur ne change pas.**",
					"$$\\frac{{{a}}}{{{d}}} - \\frac{{{b}}}{{{d}}} = \\textcolor{{{color:primary.0}}}{\\frac{{{s}}}{{{d}}}}$$"
				]
			}
		},
		{
			"statement": "Calcule.\n\n$$1 - \\frac{{{a}}}{{{d}}} = ?$$",
			"variables": [
				{
					"name": "d",
					"expression": "2|3|4|5|6|8|10"
				},
				{
					"name": "a",
					"expression": "1..{{eval:d-1}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{eval:d-a}}}{{{d}}}"
				}
			],
			"correction": {
				"steps": [
					"Le tout, c'est ${{d}}$ {{if:d==2|demis|{{if:d==3|tiers|{{if:d==4|quarts|{{if:d==5|cinquièmes|{{if:d==6|sixièmes|{{if:d==8|huitièmes|dixièmes}}}}}}}}}}}} : $1 = \\frac{{{d}}}{{{d}}}$.",
					"$$1 - \\frac{{{a}}}{{{d}}} = \\frac{{{d}}}{{{d}}} - \\frac{{{a}}}{{{d}}} = \\textcolor{{{color:primary.0}}}{\\frac{{{eval:d-a}}}{{{d}}}}$$"
				]
			}
		}
	],
	"testSpecs": [
		{
			"description": "BO : 4/5 − 1/5 = 3/5",
			"variationIndex": 0,
			"variables": {
				"d": "5",
				"a": "4",
				"b": "1",
				"s": "3"
			},
			"answers": ["\\frac{3}{5}"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : 3/0 (dénominateurs soustraits)",
			"variationIndex": 0,
			"variables": {
				"d": "5",
				"a": "4",
				"b": "1",
				"s": "3"
			},
			"answers": ["\\frac{3}{0}"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "Erreur : 3 (dénominateur oublié)",
			"variationIndex": 0,
			"variables": {
				"d": "5",
				"a": "4",
				"b": "1",
				"s": "3"
			},
			"answers": ["3"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "BO : 2/3 − 1/3 = 1/3",
			"variationIndex": 0,
			"variables": {
				"d": "3",
				"a": "2",
				"b": "1",
				"s": "1"
			},
			"answers": ["\\frac{1}{3}"],
			"expected": {
				"status": "correct"
			}
		},
		{

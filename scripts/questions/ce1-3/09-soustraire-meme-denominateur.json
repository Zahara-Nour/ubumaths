		},
		{
			"description": "1 − 3/10 = 7/10",
			"variationIndex": 1,
			"variables": {
				"d": "10",
				"a": "3"
			},
			"answers": ["\\frac{7}{10}"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : 1 − 3/10, 2/10 (1 − 3 lu 3 − 1)",
			"variationIndex": 1,
			"variables": {
				"d": "10",
				"a": "3"
			},
			"answers": ["\\frac{2}{10}"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "Erreur : 1 − 3/10, 3/10 recopié",
			"variationIndex": 1,
			"variables": {
				"d": "10",
				"a": "3"
			},
			"answers": ["\\frac{3}{10}"],
			"expected": {

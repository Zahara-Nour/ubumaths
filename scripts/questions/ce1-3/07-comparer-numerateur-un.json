{
	"title": "Comparer des fractions de numérateur 1",
	"description": "Comparer 1/5 et 1/3 : plus on fait de parts, plus chaque part est petite",
	"grades": ["CE1"],
	"theme": "Fractions",
	"domain": "Apprivoiser",
	"subdomain": "Comparer",
	"level": 7,
	"delay": 30,
	"status": "draft",
	"options": {
		"constraints": {
			"reducedFractions": "off"
		}
	},
	"variations": [
		{
			"statement": "Complète avec le symbole qui convient.\n\n$$\\frac{1}{{{p}}} \\ldots \\frac{1}{{{q}}}$$\n\n```choix\nmelanger: non\n- $$<$$\n- $$=$$\n- $$>$$\n```",
			"variables": [
				{
					"name": "p",
					"expression": "2|3|4|5|6|8|10"
				},
				{
					"name": "q",
					"expression": "2|3|4|5|6|8|10"
				},
				{
					"name": "r",
					"expression": "eval:sign(q-p)+1"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{r}}"
				}
			],
			"correction": {
				"steps": [
					"D'un côté, le tout est partagé en ${{p}}$ parts égales ; de l'autre, en ${{q}}$ parts égales. **Plus on fait de parts, plus chaque part est petite.**",
					"$$\\frac{1}{{{p}}} \\textcolor{{{color:primary.0}}}{{{if:r==0|<|{{if:r==1|=|>}}}}} \\frac{1}{{{q}}}$$"
				]
			}
		}
	],
	"testSpecs": [
		{
			"description": "BO : 1/5 < 1/3",
			"variationIndex": 0,
			"variables": {
				"p": "5",
				"q": "3",
				"r": "0"
			},
			"answers": ["0"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : 1/5 > 1/3 (car 5 > 3)",
			"variationIndex": 0,
			"variables": {
				"p": "5",
				"q": "3",
				"r": "0"
			},
			"answers": ["2"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "1/3 > 1/6",
			"variationIndex": 0,
			"variables": {
				"p": "3",
				"q": "6",
				"r": "2"
			},
			"answers": ["2"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : 1/3 < 1/6 (car 3 < 6)",
			"variationIndex": 0,
			"variables": {
				"p": "3",
				"q": "6",
				"r": "2"
			},
			"answers": ["0"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "égalité : 1/4 = 1/4",
			"variationIndex": 0,
			"variables": {
				"p": "4",
				"q": "4",
				"r": "1"
			},
			"answers": ["1"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "borne : 1/2 > 1/10",
			"variationIndex": 0,
			"variables": {
				"p": "2",
				"q": "10",
				"r": "2"
			},
			"answers": ["2"],
			"expected": {

{
	"title": "Écrire en chiffres une fraction unitaire",
	"description": "Écrire en chiffres un demi, un tiers, un quart… un dixième : un quart → 1/4",
	"grades": ["CE1"],
	"theme": "Fractions",
	"domain": "Apprivoiser",
	"subdomain": "Ecriture",
	"level": 1,
	"delay": 30,
	"status": "draft",
	"options": {
		"constraints": {
			"reducedFractions": "off"
		}
	},
	"variations": [
		{
			"statement": "Écris en chiffres la fraction « **un {{if:d==2|demi|{{if:d==3|tiers|{{if:d==4|quart|{{if:d==5|cinquième|{{if:d==6|sixième|{{if:d==8|huitième|dixième}}}}}}}}}}}}** ».\n\n$$?$$",
			"variables": [
				{
					"name": "d",
					"expression": "2|3|4|5|6|8|10"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{1}{{{d}}}"
				}
			],
			"correction": {
				"steps": [
					"« Un {{if:d==2|demi|{{if:d==3|tiers|{{if:d==4|quart|{{if:d==5|cinquième|{{if:d==6|sixième|{{if:d==8|huitième|dixième}}}}}}}}}}}} » : on partage le tout en ${{d}}$ parts égales et on en prend $1$.",
					"$$\\textcolor{{{color:primary.0}}}{\\frac{1}{{{d}}}}$$"
				]
			}
		}
	],
	"testSpecs": [
		{
			"description": "un quart : 1/4",
			"variationIndex": 0,
			"variables": {
				"d": "4"
			},
			"answers": ["\\frac{1}{4}"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : un quart, 4/1",
			"variationIndex": 0,
			"variables": {
				"d": "4"
			},
			"answers": ["\\frac{4}{1}"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "Erreur : un quart, 4",
			"variationIndex": 0,
			"variables": {
				"d": "4"
			},
			"answers": ["4"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "un tiers : 1/3",
			"variationIndex": 0,
			"variables": {
				"d": "3"
			},
			"answers": ["\\frac{1}{3}"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : un tiers, 1/4 (tiers ≠ quart)",
			"variationIndex": 0,
			"variables": {
				"d": "3"
			},
			"answers": ["\\frac{1}{4}"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "borne : un demi, 1/2",
			"variationIndex": 0,
			"variables": {
				"d": "2"
			},
			"answers": ["\\frac{1}{2}"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "borne : un dixième, 1/10",
			"variationIndex": 0,
			"variables": {
				"d": "10"
			},
			"answers": ["\\frac{1}{10}"],
			"expected": {
				"status": "correct"
			}
		}
	]
}

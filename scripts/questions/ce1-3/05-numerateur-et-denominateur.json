	"variations": [
		{
			"statement": "Dans la fraction $\\frac{{{n}}}{{{d}}}$, quel est le **numérateur** ?\n\nLe numérateur est $?$.",
			"variables": [
				{
					"name": "d",
					"expression": "2|3|4|5|6|8|10"
				},
				{
					"name": "n",
					"expression": "1..{{eval:d-1}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{n}}"
				}
			],
			"correction": {
				"steps": [
					"Le **dénominateur** (en bas) dit en combien de parts égales on partage le tout ; le **numérateur** (en haut) dit combien de parts on prend.",
					"Dans $\\frac{{{n}}}{{{d}}}$, le numérateur est $\\textcolor{{{color:primary.0}}}{{{n}}}$."
				]
			}
		},
		{
			"statement": "Dans la fraction $\\frac{{{n}}}{{{d}}}$, quel est le **dénominateur** ?\n\nLe dénominateur est $?$.",
			"variables": [
				{
					"name": "d",
					"expression": "2|3|4|5|6|8|10"
				},
				{
					"name": "n",
					"expression": "1..{{eval:d-1}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{d}}"
				}
			],
			"correction": {
				"steps": [
					"Le **dénominateur** (en bas) dit en combien de parts égales on partage le tout ; le **numérateur** (en haut) dit combien de parts on prend.",
					"Dans $\\frac{{{n}}}{{{d}}}$, le dénominateur est $\\textcolor{{{color:primary.0}}}{{{d}}}$."
				]
			}
		},
		{
			"statement": "On partage une bande de papier en ${{d}}$ parts égales et on en colorie ${{n}}$.\n\nQuel est le **{{if:t==0|numérateur|dénominateur}}** de la fraction coloriée ?\n\nC'est $?$.",
			"variables": [
				{
					"name": "d",
					"expression": "2|3|4|5|6|8|10"
				},
				{
					"name": "n",
					"expression": "1..{{eval:d-1}}"
				},
				{
					"name": "t",
					"expression": "0..1"
				},
				{
					"name": "r",
					"expression": "eval:(1-t)*n+t*d"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{r}}"
				}
			],
			"correction": {
				"steps": [
					"Le **dénominateur** (en bas) dit en combien de parts égales on partage le tout ; le **numérateur** (en haut) dit combien de parts on prend.",
					"La partie coloriée est $\\frac{{{n}}}{{{d}}}$ de la bande : son {{if:t==0|numérateur|dénominateur}} est $\\textcolor{{{color:primary.0}}}{{{r}}}$."
				]
			}
		}
	],

				},
				{
					"name": "py1",
					"expression": "eval:(yc)+(1-min(abs((r1)-0),1))*((b))+(1-min(abs((r1)-1),1))*(-(b))+(1-min(abs((r1)-2),1))*((a))+(1-min(abs((r1)-3),1))*(-(b))"
				},

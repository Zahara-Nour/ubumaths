					"expression": "eval:(xc)+(1-min(abs((r0)-0),1))*((a))+(1-min(abs((r0)-1),1))*(-(a))+(1-min(abs((r0)-2),1))*((b))+(1-min(abs((r0)-3),1))*((a))"
				},
				{

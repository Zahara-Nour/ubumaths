{
	"title": "Dériver g(ax + b)",
	"description": "Dérivée d'une composée avec une fonction affine : (ax + b)ⁿ et √(ax + b)",
	"grades": ["1_SPE"],
	"theme": "Fonctions",
	"domain": "Dérivation",
	"subdomain": "Fonctions dérivées",
	"level": 6,
	"status": "draft",
	"delay": 60,
	"shared": {
		"cleanCoefficients": true
	},
	"options": {
		"constraints": {
			"form": "warn"
		}
	},
	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=({{eval:a*x+b}})^{ {{n}} }$.\n\nCalcule $f'(x)$.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				},
				{
					"name": "n",
					"expression": "3..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n*a}}({{eval:a*x+b}})^{ {{eval:n-1}} }"
				}
			],
			"correction": {
				"steps": [
					"La dérivée de $x\\mapsto g(ax+b)$ est $x\\mapsto a\\,g'(ax+b)$. Ici $g(X)=X^{ {{n}} }$, donc $g'(X)={{n}}X^{ {{eval:n-1}} }$, et $a={{a}}$.",
					"$$f'(x)={{eval:a;()}}\\times{{n}}({{eval:a*x+b}})^{ {{eval:n-1}} }=\\textcolor{{{color:primary.0}}}{ {{eval:n*a}}({{eval:a*x+b}})^{ {{eval:n-1}} } }$$",
					"On ne développe pas : la forme factorisée est la plus simple."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie par $f(x)=\\sqrt{ {{eval:a*x+b}} }$. Elle est dérivable sur $\\left]{{eval:-b/a}}\\,;+\\infty\\right[$.\n\nCalcule $f'(x)$ sur cet intervalle.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1|3|5|7"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"conditions": ["gcd(a,b) = 1"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{ {{a}} }{2\\sqrt{ {{eval:a*x+b}} }}"
				}
			],
			"correction": {
				"steps": [
					"La dérivée de $x\\mapsto g(ax+b)$ est $x\\mapsto a\\,g'(ax+b)$. Ici $g(X)=\\sqrt{X}$, donc $g'(X)=\\frac{1}{2\\sqrt{X}}$, et $a={{a}}$.",
					"$$f'(x)={{a}}\\times\\frac{1}{2\\sqrt{ {{eval:a*x+b}} }}=\\textcolor{{{color:primary.0}}}{\\frac{ {{a}} }{2\\sqrt{ {{eval:a*x+b}} }} }$$"
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie par $f(x)=\\sqrt{ {{eval:a*x+b}} }$. Elle est dérivable sur $\\left]{{eval:-b/a}}\\,;+\\infty\\right[$.\n\nCalcule $f'(x)$ sur cet intervalle.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "2|4|6|8"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"conditions": ["gcd(a,b) = 1"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{ {{eval:a/2}} }{\\sqrt{ {{eval:a*x+b}} }}"
				}
			],
			"correction": {
				"steps": [
					"La dérivée de $x\\mapsto g(ax+b)$ est $x\\mapsto a\\,g'(ax+b)$. Ici $g(X)=\\sqrt{X}$, donc $g'(X)=\\frac{1}{2\\sqrt{X}}$, et $a={{a}}$.",
					"$$f'(x)={{a}}\\times\\frac{1}{2\\sqrt{ {{eval:a*x+b}} }}=\\frac{ {{a}} }{2\\sqrt{ {{eval:a*x+b}} }}$$",
					"On simplifie par 2 : $f'(x)=\\textcolor{{{color:primary.0}}}{\\frac{ {{eval:a/2}} }{\\sqrt{ {{eval:a*x+b}} }} }$."
				]
			}
		}
	],
	"testSpecs": [
		{
			"description": "(2x−1)³ : 6(2x−1)²",
			"variationIndex": 0,
			"variables": { "a": "2", "b": "-1", "n": "3" },
			"answers": ["6(2x-1)^2"],
			"expected": { "status": "correct" }
		},
		{
			"description": "développé 24x²−24x+6 (non optimal)",
			"variationIndex": 0,
			"variables": { "a": "2", "b": "-1", "n": "3" },
			"answers": ["24x^2-24x+6"],
			"expected": { "status": "unoptimal_form", "constraintViolations": ["form"] }
		},
		{
			"description": "facteur a oublié : 3(2x−1)²",
			"variationIndex": 0,
			"variables": { "a": "2", "b": "-1", "n": "3" },
			"answers": ["3(2x-1)^2"],
			"expected": { "status": "incorrect" }
		},
		{
			"description": "exposant non abaissé : 6(2x−1)³",
			"variationIndex": 0,
			"variables": { "a": "2", "b": "-1", "n": "3" },
			"answers": ["6(2x-1)^3"],
			"expected": { "status": "incorrect" }
		},
		{
			"description": "a < 0 : (−3x+2)⁴ → −12(−3x+2)³",
			"variationIndex": 0,
			"variables": { "a": "-3", "b": "2", "n": "4" },
			"answers": ["-12(-3x+2)^3"],
			"expected": { "status": "correct" }
		},
		{
			"description": "a < 0 : signe sorti de la puissance, 12(3x−2)³ (jugé non optimal, écart à l'attendu)",
			"variationIndex": 0,
			"variables": { "a": "-3", "b": "2", "n": "4" },
			"answers": ["12(3x-2)^3"],
			"expected": { "status": "unoptimal_form", "constraintViolations": ["form"] }
		},
		{
			"description": "a < 0 : facteur a oublié, 4(−3x+2)³",
			"variationIndex": 0,
			"variables": { "a": "-3", "b": "2", "n": "4" },
			"answers": ["4(-3x+2)^3"],
			"expected": { "status": "incorrect" }
		},
		{
			"description": "√(3x+1) : 3/(2√(3x+1))",
			"variationIndex": 1,
			"variables": { "a": "3", "b": "1" },
			"answers": ["\\frac{3}{2\\sqrt{3x+1}}"],
			"expected": { "status": "correct" }
		},
		{
			"description": "facteur a oublié : 1/(2√(3x+1))",
			"variationIndex": 1,
			"variables": { "a": "3", "b": "1" },
			"answers": ["\\frac{1}{2\\sqrt{3x+1}}"],
			"expected": { "status": "incorrect" }
		},
		{
			"description": "(√u)′ = 1/√u : 3/√(3x+1)",
			"variationIndex": 1,
			"variables": { "a": "3", "b": "1" },
			"answers": ["\\frac{3}{\\sqrt{3x+1}}"],
			"expected": { "status": "incorrect" }
		},
		{
			"description": "produit non effectué 3×1/(2√(3x+1)) (non optimal)",
			"variationIndex": 1,
			"variables": { "a": "3", "b": "1" },
			"answers": ["3\\times\\frac{1}{2\\sqrt{3x+1}}"],
			"expected": { "status": "unoptimal_form", "constraintViolations": ["products", "form"] }
		},
		{
			"description": "√(4x−3) : 2/√(4x−3)",
			"variationIndex": 2,
			"variables": { "a": "4", "b": "-3" },
			"answers": ["\\frac{2}{\\sqrt{4x-3}}"],
			"expected": { "status": "correct" }
		},
		{
			"description": "fraction non simplifiée 4/(2√(4x−3)) (non optimal)",
			"variationIndex": 2,
			"variables": { "a": "4", "b": "-3" },
			"answers": ["\\frac{4}{2\\sqrt{4x-3}}"],
			"expected": { "status": "unoptimal_form", "constraintViolations": ["reducedFractions"] }
		},
		{
			"description": "facteur a oublié : 1/(2√(4x−3))",
			"variationIndex": 2,
			"variables": { "a": "4", "b": "-3" },
			"answers": ["\\frac{1}{2\\sqrt{4x-3}}"],
			"expected": { "status": "incorrect" }
		},
		{
			"description": "a = 2 : √(2x+5) → 1/√(2x+5)",
			"variationIndex": 2,
			"variables": { "a": "2", "b": "5" },
			"answers": ["\\frac{1}{\\sqrt{2x+5}}"],
			"expected": { "status": "correct" }
		}
	]
}

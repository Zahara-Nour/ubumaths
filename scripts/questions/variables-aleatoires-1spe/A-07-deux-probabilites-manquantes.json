		"blankDefaults": {
			"acceptDecimal": true
		}
	},
	"variations": [
		{
			"statement": "Le tableau ci-dessous donne la loi de probabilité d'une variable aléatoire $X$, dont deux probabilités sont effacées.\n\n| $x_k$ | ${{u}}$ | ${{eval:u+s}}$ | ${{eval:u+s+t}}$ | ${{eval:u+s+t+w}}$ |\n|---|---|---|---|---|\n| $P(X=x_k)$ | ${{eval:a/20;d}}$ | ${{eval:b/20;d}}$ | $\\dots$ | $\\dots$ |\n\nOn sait de plus que $P(X={{eval:u+s+t}})={{k}}\\times P(X={{eval:u+s+t+w}})$.\n\nRéponds par une fraction irréductible ou par un nombre décimal exact.\n\n$P(X={{eval:u+s+t+w}})=?$\n\n$P(X={{eval:u+s+t}})=?$",
			"variables": [
				{
					"name": "u",
					"expression": "-4..1"
				},
				{
					"name": "s",
					"expression": "1..3"
				},
				{
					"name": "t",
					"expression": "1..3"
				},
				{
					"name": "w",
					"expression": "1..3"
				},
				{
					"name": "k",
					"expression": "2..4"
				},
				{
					"name": "q",
					"expression": "1..4"
				},
				{
					"name": "a",
					"expression": "2..8"
				},
				{
					"name": "b",
					"expression": "eval:20-a-(k+1)*q"
				}
			],
			"conditions": ["b >= 1", "b != a"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:q/20}}"
				},
				{
					"expectedAnswer": "{{eval:k*q/20}}"
				}
			],
			"correction": {
				"steps": [
					"Notons $q=P(X={{eval:u+s+t+w}})$. Alors $P(X={{eval:u+s+t}})={{k}}q$.",
					"La somme des probabilités vaut $1$ : ${{eval:a/20;d}}+{{eval:b/20;d}}+{{k}}q+q=1$, soit ${{eval:k+1}}q=1-{{eval:(a+b)/20;d}}={{eval:(k+1)*q/20;d}}$.",
					"Donc $q=P(X={{eval:u+s+t+w}})=\\textcolor{{{color:primary.0}}}{ {{eval:q/20;d}} }$ et $P(X={{eval:u+s+t}})={{k}}\\times{{eval:q/20;d}}=\\textcolor{{{color:primary.0}}}{ {{eval:k*q/20;d}} }$."
				]
			}
		},
		{
			"statement": "Le tableau ci-dessous donne la loi de probabilité d'une variable aléatoire $X$. Les valeurs extrêmes ${{u}}$ et ${{eval:u+s+t+w}}$ ont la même probabilité, notée $p$.\n\n| $x_k$ | ${{u}}$ | ${{eval:u+s}}$ | ${{eval:u+s+t}}$ | ${{eval:u+s+t+w}}$ |\n|---|---|---|---|---|\n| $P(X=x_k)$ | $p$ | ${{eval:b/m}}$ | ${{eval:c/m}}$ | $p$ |\n\nRéponds par une fraction irréductible.\n\n$p=?$",
			"variables": [
				{
					"name": "u",
					"expression": "-4..1"
				},
				{
					"name": "s",
					"expression": "1..3"
				},
				{
					"name": "t",
					"expression": "1..3"
				},
				{
					"name": "w",
					"expression": "1..3"
				},
				{
					"name": "m",
					"expression": "20|24|30"
				},
				{
					"name": "q",
					"expression": "1..{{eval:floor(m/4)+1}}"
				},
				{
					"name": "b",
					"expression": "1..{{eval:m/2}}"
				},
				{
					"name": "c",
					"expression": "eval:m-2*q-b"
				}
			],
			"conditions": ["c >= 1", "b != c"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:q/m}}"
				}
			],
			"correction": {
				"steps": [
					"La somme des probabilités vaut $1$ : $p+{{eval:b/m}}+{{eval:c/m}}+p=1$, soit $2p=1-{{eval:(b+c)/m}}={{eval:2*q/m}}$.",
					"Donc $p=\\textcolor{{{color:primary.0}}}{ {{eval:q/m}} }$."
				]
			}
		},
		{
			"statement": "Le tableau ci-dessous donne la loi de probabilité d'une variable aléatoire $X$, dont deux probabilités sont effacées.\n\n| $x_k$ | ${{u}}$ | ${{eval:u+s}}$ | ${{eval:u+s+t}}$ | ${{eval:u+s+t+w}}$ |\n|---|---|---|---|---|\n| $P(X=x_k)$ | ${{eval:a/20;d}}$ | $\\dots$ | ${{eval:c/20;d}}$ | $\\dots$ |\n\nOn sait de plus que $P(X\\leqslant {{eval:u+s}})={{eval:(a+y)/20;d}}$.\n\nRéponds par une fraction irréductible ou par un nombre décimal exact.\n\n$P(X={{eval:u+s}})=?$\n\n$P(X={{eval:u+s+t+w}})=?$",
			"variables": [
				{
					"name": "u",
					"expression": "-4..1"
				},
				{
					"name": "s",
					"expression": "1..3"
				},
				{
					"name": "t",
					"expression": "1..3"
				},
				{
					"name": "w",
					"expression": "1..3"
				},
				{
					"name": "a",
					"expression": "1..6"
				},
				{
					"name": "y",
					"expression": "1..6"
				},
				{
					"name": "c",
					"expression": "1..8"
				},
				{
					"name": "z",
					"expression": "eval:20-a-y-c"
				}
			],
			"conditions": ["z >= 1", "y != z"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:y/20}}"
				},
				{
					"expectedAnswer": "{{eval:z/20}}"
				}
			],
			"correction": {
				"steps": [
					"$\\{X\\leqslant {{eval:u+s}}\\}$ est réalisé quand $X$ vaut ${{u}}$ ou ${{eval:u+s}}$ : $P(X={{u}})+P(X={{eval:u+s}})={{eval:(a+y)/20;d}}$.",
					"Donc $P(X={{eval:u+s}})={{eval:(a+y)/20;d}}-{{eval:a/20;d}}=\\textcolor{{{color:primary.0}}}{ {{eval:y/20;d}} }$.",
					"La somme des probabilités vaut $1$ : $P(X={{eval:u+s+t+w}})=1-{{eval:(a+y)/20;d}}-{{eval:c/20;d}}=\\textcolor{{{color:primary.0}}}{ {{eval:z/20;d}} }$."
				]
			}
		}
	],

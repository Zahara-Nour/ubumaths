	"variations": [
		{
			"statement": "Le tableau ci-dessous donne la loi de probabilité d'une variable aléatoire $X$, dont une probabilité $p$ est inconnue.\n\n| $x_k$ | ${{u}}$ | ${{eval:u+s}}$ | ${{eval:u+s+t}}$ | ${{eval:u+s+t+w}}$ |\n|---|---|---|---|---|\n| $P(X=x_k)$ | ${{eval:a/100;d}}$ | ${{eval:b/100;d}}$ | ${{eval:c/100;d}}$ | $p$ |\n\nRéponds par une fraction irréductible ou par un nombre décimal exact.\n\n$p=?$",
			"variables": [
				{ "name": "u", "expression": "-5..2" },
				{ "name": "s", "expression": "1..4" },
				{ "name": "t", "expression": "1..4" },
				{ "name": "w", "expression": "1..4" },
				{ "name": "a", "expression": "3..35" },
				{ "name": "b", "expression": "3..35" },
				{ "name": "c", "expression": "3..35" },
				{ "name": "d", "expression": "eval:100-a-b-c" }
			],
			"conditions": ["d >= 3", "mod(a,10) != 0", "mod(b,10) != 0", "mod(c,5) != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:d/100}}"
				}
			],
			"correction": {
				"steps": [
					"La somme des probabilités d'une loi de probabilité vaut $1$ : ${{eval:a/100;d}}+{{eval:b/100;d}}+{{eval:c/100;d}}+p=1$.",
					"$p=1-{{eval:(a+b+c)/100;d}}=\\textcolor{{{color:primary.0}}}{ {{eval:d/100;d}} }$, soit ${{eval:d/100}}$."
				]
			}
		},
		{
			"statement": "Le tableau ci-dessous donne la loi de probabilité d'une variable aléatoire $X$, dont une probabilité $p$ est inconnue.\n\n| $x_k$ | ${{u}}$ | ${{eval:u+s}}$ | ${{eval:u+s+t}}$ | ${{eval:u+s+t+w}}$ |\n|---|---|---|---|---|\n| $P(X=x_k)$ | ${{eval:a/12}}$ | $p$ | ${{eval:b/12}}$ | ${{eval:c/12}}$ |\n\nRéponds par une fraction irréductible.\n\n$p=?$",
			"variables": [
				{ "name": "u", "expression": "-3..3" },
				{ "name": "s", "expression": "1..3" },
				{ "name": "t", "expression": "1..3" },
				{ "name": "w", "expression": "1..3" },
				{ "name": "a", "expression": "1..5" },
				{ "name": "b", "expression": "1..5" },
				{ "name": "c", "expression": "1..5" },
				{ "name": "d", "expression": "eval:12-a-b-c" }
			],
			"conditions": [
				"d >= 1",
				"a != b",
				"b != c",
				"a != c",
				"gcd(a,12) + gcd(b,12) + gcd(c,12) > 3"
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:d/12}}"
				}
			],
			"correction": {
				"steps": [
					"La somme des probabilités vaut $1$. On écrit toutes les probabilités avec le dénominateur commun $12$ : ${{eval:a/12}}=\\dfrac{ {{a}} }{12}$, ${{eval:b/12}}=\\dfrac{ {{b}} }{12}$ et ${{eval:c/12}}=\\dfrac{ {{c}} }{12}$.",
					"$p=1-\\dfrac{ {{a}}+{{b}}+{{c}} }{12}=\\dfrac{ {{d}} }{12}=\\textcolor{{{color:primary.0}}}{ {{eval:d/12}} }$."
				]
			}
		},
		{
			"statement": "Un joueur achète un ticket de loterie. On note $X$ son gain algébrique, en euros (le prix du ticket est déduit). La loi de $X$ est donnée dans le tableau ci-dessous, mais la probabilité $p$ de perdre ${{m}}$ euros a été effacée.\n\n| $x_k$ | $-{{m}}$ | ${{g}}$ | ${{eval:g+h}}$ | ${{eval:g+h+j}}$ |\n|---|---|---|---|---|\n| $P(X=x_k)$ | $p$ | ${{eval:b/100;d}}$ | ${{eval:c/100;d}}$ | ${{eval:d/100;d}}$ |\n\nRéponds par une fraction irréductible ou par un nombre décimal exact.\n\n$p=?$\n\nProbabilité que le joueur gagne au moins ${{eval:g+h}}$ euros : $P(X\\geqslant {{eval:g+h}})=?$",
			"variables": [
				{ "name": "m", "expression": "2..5" },
				{ "name": "g", "expression": "1..5" },
				{ "name": "h", "expression": "3..15" },
				{ "name": "j", "expression": "10..50" },
				{ "name": "b", "expression": "5..30" },
				{ "name": "c", "expression": "2..12" },
				{ "name": "d", "expression": "1..5" },
				{ "name": "a", "expression": "eval:100-b-c-d" }
			],
			"conditions": ["mod(b,5) != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a/100}}"
				},
				{
					"expectedAnswer": "{{eval:(c+d)/100}}"
				}
			],
			"correction": {
				"steps": [
					"La somme des probabilités vaut $1$ : $p=1-({{eval:b/100;d}}+{{eval:c/100;d}}+{{eval:d/100;d}})=1-{{eval:(b+c+d)/100;d}}=\\textcolor{{{color:primary.0}}}{ {{eval:a/100;d}} }$.",
					"« Gagner au moins ${{eval:g+h}}$ euros » : $X$ vaut ${{eval:g+h}}$ ou ${{eval:g+h+j}}$. $P(X\\geqslant {{eval:g+h}})={{eval:c/100;d}}+{{eval:d/100;d}}=\\textcolor{{{color:primary.0}}}{ {{eval:(c+d)/100;d}} }$."
				]
			}
		}
	],

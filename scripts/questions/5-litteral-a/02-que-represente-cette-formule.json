	"variations": [
		{
			"statement": "Pour un nombre $n$, que représente $2n$ ?\n\n```choix\n- le double de $n$\n- le carré de $n$\n- le successeur de $n$\n- la moitié de $n$\n```",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"$2n = 2 \\times n$ : c'est $n$ multiplié par $2$.",
					"$2n$ représente **le double** de $n$."
				]
			}
		},
		{
			"statement": "Pour un nombre $n$, que représente $3n$ ?\n\n```choix\n- le triple de $n$\n- le double de $n$\n- le carré de $n$\n- le successeur de $n$\n```",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"$3n = 3 \\times n$ : c'est $n$ multiplié par $3$.",
					"$3n$ représente **le triple** de $n$."
				]
			}
		},
		{
			"statement": "Pour un nombre $n$, que représente $\\dfrac{n}{2}$ ?\n\n```choix\n- la moitié de $n$\n- le double de $n$\n- le prédécesseur de $n$\n- le carré de $n$\n```",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"$\\dfrac{n}{2} = n \\div 2$ : c'est $n$ divisé par $2$.",
					"$\\dfrac{n}{2}$ représente **la moitié** de $n$."
				]
			}
		},
		{
			"statement": "Pour un nombre $n$, que représente $n^2$ ?\n\n```choix\n- le carré de $n$\n- le double de $n$\n- le triple de $n$\n- le successeur de $n$\n```",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"$n^2 = n \\times n$ : c'est $n$ multiplié par lui-même (et pas par $2$).",
					"$n^2$ représente **le carré** de $n$."
				]
			}
		},
		{
			"statement": "Pour un nombre $n$, que représente $n + 1$ ?\n\n```choix\n- le successeur de $n$\n- le prédécesseur de $n$\n- le double de $n$\n- le carré de $n$\n```",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"$n + 1$ : on ajoute $1$ à $n$, on obtient le nombre qui le suit.",
					"$n + 1$ représente **le successeur** de $n$."
				]
			}
		},
		{
			"statement": "Pour un nombre $n$, que représente $n - 1$ ?\n\n```choix\n- le prédécesseur de $n$\n- le successeur de $n$\n- la moitié de $n$\n- le double de $n$\n```",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"$n - 1$ : on retire $1$ à $n$, on obtient le nombre qui le précède.",
					"$n - 1$ représente **le prédécesseur** de $n$."
				]
			}
		}
	],

{
	"title": "Additionner des fractions dont un dénominateur est multiple de l'autre",
	"description": "1/2 + 1/4 ; 1/3 + 1/6 : on écrit les deux fractions avec le même dénominateur",
	"grades": ["CE2"],
	"theme": "Fractions",
	"domain": "Calculer",
	"subdomain": "Addition et Soustraction",
	"level": 18,
	"delay": 60,

				{
					"name": "n",
					"expression": "eval:d*k"
				}
			],
			"conditions": ["d*k <= 12", "a*k + b <= d*k"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{eval:a*k+b}}}{{{n}}}"
				}
			],
			"correction": {
				"steps": [
					"Les dénominateurs ne sont pas les mêmes : on écrit $\\frac{{{a}}}{{{d}}}$ en {{if:n==2|demis|{{if:n==3|tiers|{{if:n==4|quarts|{{if:n==5|cinquièmes|{{if:n==6|sixièmes|{{if:n==7|septièmes|{{if:n==8|huitièmes|{{if:n==9|neuvièmes|{{if:n==10|dixièmes|{{if:n==11|onzièmes|douzièmes}}}}}}}}}}}}}}}}}}}}. $\\frac{{{a}}}{{{d}}} = \\frac{{{a}} \\times {{k}}}{{{d}} \\times {{k}}} = \\frac{{{eval:a*k}}}{{{eval:d*k}}}$.",
					"$$\\frac{{{b}}}{{{n}}} + \\frac{{{a}}}{{{d}}} = \\frac{{{b}}}{{{n}}} + \\frac{{{eval:a*k}}}{{{n}}} = \\textcolor{{{color:primary.0}}}{\\frac{{{eval:a*k+b}}}{{{n}}}}$$"
				]
			}
		}

{
	"title": "Égalité de fractions : le dénominateur manquant",
	"description": "1/2 = 4/? ; 6/8 = 3/?",
	"grades": ["CE2"],
	"theme": "Fractions",
	"domain": "Apprivoiser",
	"subdomain": "Egalité de fractions",
	"level": 7,
	"delay": 45,
	"status": "draft",
	"options": {
		"constraints": {
			"reducedFractions": "off"
		}
	},
	"variations": [
		{
			"statement": "Complète.\n\n$$\\frac{{{a}}}{{{d}}} = \\frac{{{eval:a*k}}}{?}$$",
			"variables": [
				{
					"name": "d",
					"expression": "2..6"
				},
				{
					"name": "k",
					"expression": "2..6"
				},
				{
					"name": "a",
					"expression": "1..{{eval:d-1}}"
				}
			],
			"conditions": ["d*k <= 12"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:d*k}}"
				}
			],
			"correction": {
				"steps": [
					"On ne change pas une fraction quand on multiplie (ou qu'on divise) son numérateur **et** son dénominateur par le même nombre.",
					"${{eval:a*k}} = {{a}} \\times {{k}}$ : le numérateur est multiplié par ${{k}}$, on multiplie aussi le dénominateur par ${{k}}$.",
					"$$\\frac{{{a}}}{{{d}}} = \\frac{{{a}} \\times {{k}}}{{{d}} \\times {{k}}} = \\frac{{{eval:a*k}}}{\\textcolor{{{color:primary.0}}}{{{eval:d*k}}}}$$"
				]
			}
		},
		{
			"statement": "Complète.\n\n$$\\frac{{{eval:a*k}}}{{{eval:d*k}}} = \\frac{{{a}}}{?}$$",
			"variables": [
				{
					"name": "d",
					"expression": "2..6"
				},
				{
					"name": "k",
					"expression": "2..6"
				},
				{
					"name": "a",
					"expression": "1..{{eval:d-1}}"
				}
			],
			"conditions": ["d*k <= 12", "a >= 2"],
			"blanks": [
				{
					"expectedAnswer": "{{d}}"
				}
			],
			"correction": {
				"steps": [
					"On ne change pas une fraction quand on multiplie (ou qu'on divise) son numérateur **et** son dénominateur par le même nombre.",
					"${{eval:a*k}} = {{a}} \\times {{k}}$ : le numérateur est divisé par ${{k}}$, on divise aussi le dénominateur par ${{k}}$.",
					"$$\\frac{{{eval:a*k}}}{{{eval:d*k}}} = \\frac{{{a}}}{\\textcolor{{{color:primary.0}}}{{{d}}}}$$"
				]
			}
		}
	],

					"$$\\frac{{{a}}}{{{d}}} - \\frac{{{b}}}{{{d}}} = \\textcolor{{{color:primary.0}}}{\\frac{{{s}}}{{{d}}}}$$"
				]
			}
		},
		{
			"statement": "Calcule.\n\n$$1 - \\frac{{{a}}}{{{d}}} = ?$$",
			"variables": [
				{
					"name": "d",
					"expression": "2..12"

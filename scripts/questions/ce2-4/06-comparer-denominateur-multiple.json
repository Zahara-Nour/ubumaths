{
	"title": "Comparer des fractions dont un dénominateur est multiple de l'autre",
	"description": "Comparer 7/12 et 5/6 : on écrit 5/6 en douzièmes",
	"grades": ["CE2"],
	"theme": "Fractions",
	"domain": "Apprivoiser",
	"subdomain": "Comparer",
	"level": 13,
	"delay": 45,
	"status": "draft",
	"options": {
		"constraints": {
			"reducedFractions": "off"
		}
	},
	"variations": [
		{
			"statement": "Complète avec le symbole qui convient.\n\n$$\\frac{{{a}}}{{{d}}} \\ldots \\frac{{{b}}}{{{eval:d*k}}}$$\n\n```choix\nmelanger: non\n- $$<$$\n- $$=$$\n- $$>$$\n```",
			"variables": [
				{
					"name": "d",
					"expression": "2..6"
				},
				{
					"name": "k",
					"expression": "2..6"
				},
				{
					"name": "a",
					"expression": "1..{{eval:d-1}}"
				},
				{
					"name": "b",
					"expression": "1..{{eval:d*k-1}}"
				},
				{
					"name": "r",
					"expression": "eval:sign(a*k-b)+1"
				}
			],
			"conditions": ["d*k <= 12"],
			"blanks": [
				{
					"expectedAnswer": "{{r}}"
				}
			],
			"correction": {
				"steps": [
					"$\\frac{{{a}}}{{{d}}} = \\frac{{{a}} \\times {{k}}}{{{d}} \\times {{k}}} = \\frac{{{eval:a*k}}}{{{eval:d*k}}}$ : les deux fractions ont maintenant le même dénominateur, la plus grande est celle qui prend **le plus de parts**.",
					"$$\\frac{{{eval:a*k}}}{{{eval:d*k}}} \\textcolor{{{color:primary.0}}}{{{if:r==0|<|{{if:r==1|=|>}}}}} \\frac{{{b}}}{{{eval:d*k}}}$$",
					"Donc :$$\\frac{{{a}}}{{{d}}} \\textcolor{{{color:primary.0}}}{{{if:r==0|<|{{if:r==1|=|>}}}}} \\frac{{{b}}}{{{eval:d*k}}}$$"
				]
			}
		},
		{
			"statement": "Complète avec le symbole qui convient.\n\n$$\\frac{{{b}}}{{{eval:d*k}}} \\ldots \\frac{{{a}}}{{{d}}}$$\n\n```choix\nmelanger: non\n- $$<$$\n- $$=$$\n- $$>$$\n```",
			"variables": [
				{
					"name": "d",
					"expression": "2..6"
				},
				{
					"name": "k",
					"expression": "2..6"
				},
				{
					"name": "a",
					"expression": "1..{{eval:d-1}}"
				},
				{
					"name": "b",
					"expression": "1..{{eval:d*k-1}}"
				},
				{
					"name": "r",
					"expression": "eval:sign(b-a*k)+1"
				}
			],
			"conditions": ["d*k <= 12"],
			"blanks": [
				{
					"expectedAnswer": "{{r}}"
				}
			],
			"correction": {
				"steps": [
					"$\\frac{{{a}}}{{{d}}} = \\frac{{{a}} \\times {{k}}}{{{d}} \\times {{k}}} = \\frac{{{eval:a*k}}}{{{eval:d*k}}}$ : les deux fractions ont maintenant le même dénominateur, la plus grande est celle qui prend **le plus de parts**.",
					"$$\\frac{{{b}}}{{{eval:d*k}}} \\textcolor{{{color:primary.0}}}{{{if:r==0|<|{{if:r==1|=|>}}}}} \\frac{{{eval:a*k}}}{{{eval:d*k}}}$$",
					"Donc :$$\\frac{{{b}}}{{{eval:d*k}}} \\textcolor{{{color:primary.0}}}{{{if:r==0|<|{{if:r==1|=|>}}}}} \\frac{{{a}}}{{{d}}}$$"
				]
			}
		}
	],

{
	"title": "Égalité de fractions : le numérateur manquant",
	"description": "1/2 = ?/8 ; 6/8 = ?/4 ; 1 = ?/8 (exemples du BO)",
	"grades": ["CE2"],
	"theme": "Fractions",
	"domain": "Apprivoiser",
	"subdomain": "Egalité de fractions",
	"level": 6,
	"delay": 45,
	"status": "draft",
	"options": {
		"constraints": {
			"reducedFractions": "off"
		}
	},
	"variations": [
		{
			"statement": "Complète.\n\n$$\\frac{{{a}}}{{{d}}} = \\frac{?}{{{eval:d*k}}}$$",
			"variables": [
				{
					"name": "d",
					"expression": "2..6"
				},
				{
					"name": "k",
					"expression": "2..6"
				},
				{
					"name": "a",
					"expression": "1..{{eval:d-1}}"
				}
			],
			"conditions": ["d*k <= 12"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*k}}"
				}
			],
			"correction": {
				"steps": [
					"On ne change pas une fraction quand on multiplie (ou qu'on divise) son numérateur **et** son dénominateur par le même nombre.",
					"${{eval:d*k}} = {{d}} \\times {{k}}$ : le dénominateur est multiplié par ${{k}}$, on multiplie aussi le numérateur par ${{k}}$.",
					"$$\\frac{{{a}}}{{{d}}} = \\frac{{{a}} \\times {{k}}}{{{d}} \\times {{k}}} = \\frac{\\textcolor{{{color:primary.0}}}{{{eval:a*k}}}}{{{eval:d*k}}}$$"
				]
			}
		},
		{
			"statement": "Complète.\n\n$$\\frac{{{eval:a*k}}}{{{eval:d*k}}} = \\frac{?}{{{d}}}$$",
			"variables": [
				{
					"name": "d",
					"expression": "2..6"
				},
				{
					"name": "k",
					"expression": "2..6"
				},
				{
					"name": "a",
					"expression": "1..{{eval:d-1}}"
				}
			],
			"conditions": ["d*k <= 12"],
			"blanks": [
				{
					"expectedAnswer": "{{a}}"
				}
			],
			"correction": {
				"steps": [
					"On ne change pas une fraction quand on multiplie (ou qu'on divise) son numérateur **et** son dénominateur par le même nombre.",
					"${{eval:d*k}} = {{d}} \\times {{k}}$ : le dénominateur est divisé par ${{k}}$, on divise aussi le numérateur par ${{k}}$.",
					"$$\\frac{{{eval:a*k}}}{{{eval:d*k}}} = \\frac{\\textcolor{{{color:primary.0}}}{{{a}}}}{{{d}}}$$"
				]
			}
		},
		{
			"statement": "Complète.\n\n$$1 = \\frac{?}{{{d}}}$$",
			"variables": [
				{
					"name": "d",
					"expression": "2..12"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{d}}"
				}
			],
			"correction": {
				"steps": [
					"$1$, c'est le tout : le tout partagé en ${{d}}$ parts égales, c'est ${{d}}$ {{if:d==2|demis|{{if:d==3|tiers|{{if:d==4|quarts|{{if:d==5|cinquièmes|{{if:d==6|sixièmes|{{if:d==7|septièmes|{{if:d==8|huitièmes|{{if:d==9|neuvièmes|{{if:d==10|dixièmes|{{if:d==11|onzièmes|douzièmes}}}}}}}}}}}}}}}}}}}}.",
					"$$1 = \\frac{\\textcolor{{{color:primary.0}}}{{{d}}}}{{{d}}}$$"
				]
			}
		}
	],

{
	"title": "Soustraire des fractions dont un dénominateur est multiple de l'autre",
	"description": "3/4 − 1/2 ; 2/3 − 1/6 : on écrit les deux fractions avec le même dénominateur",
	"grades": ["CE2"],
	"theme": "Fractions",
	"domain": "Calculer",
	"subdomain": "Addition et Soustraction",
	"level": 21,
	"delay": 60,
	"status": "draft",
	"options": {
		"constraints": {
			"reducedFractions": "off"
		}
	},
	"variations": [
		{
			"statement": "Calcule.\n\n$$\\frac{{{a}}}{{{d}}} - \\frac{{{b}}}{{{n}}} = ?$$",
			"variables": [
				{
					"name": "d",
					"expression": "2..6"
				},
				{
					"name": "k",
					"expression": "2..6"
				},
				{
					"name": "a",
					"expression": "1..{{eval:d-1}}"
				},
				{
					"name": "b",
					"expression": "1..{{eval:d*k-1}}"
				},
				{
					"name": "n",
					"expression": "eval:d*k"
				}
			],
			"conditions": ["d*k <= 12", "b < a*k"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{eval:a*k-b}}}{{{n}}}"
				}
			],
			"correction": {
				"steps": [
					"Les dénominateurs ne sont pas les mêmes : on écrit $\\frac{{{a}}}{{{d}}}$ en {{if:n==2|demis|{{if:n==3|tiers|{{if:n==4|quarts|{{if:n==5|cinquièmes|{{if:n==6|sixièmes|{{if:n==7|septièmes|{{if:n==8|huitièmes|{{if:n==9|neuvièmes|{{if:n==10|dixièmes|{{if:n==11|onzièmes|douzièmes}}}}}}}}}}}}}}}}}}}}. $\\frac{{{a}}}{{{d}}} = \\frac{{{a}} \\times {{k}}}{{{d}} \\times {{k}}} = \\frac{{{eval:a*k}}}{{{eval:d*k}}}$.",
					"$$\\frac{{{a}}}{{{d}}} - \\frac{{{b}}}{{{n}}} = \\frac{{{eval:a*k}}}{{{n}}} - \\frac{{{b}}}{{{n}}} = \\textcolor{{{color:primary.0}}}{\\frac{{{eval:a*k-b}}}{{{n}}}}$$"
				]
			}
		},
		{
			"statement": "Calcule.\n\n$$\\frac{{{b}}}{{{n}}} - \\frac{{{a}}}{{{d}}} = ?$$",
			"variables": [
				{
					"name": "d",
					"expression": "2..6"
				},
				{
					"name": "k",
					"expression": "2..6"
				},
				{
					"name": "a",
					"expression": "1..{{eval:d-1}}"
				},
				{
					"name": "b",
					"expression": "1..{{eval:d*k-1}}"
				},
				{
					"name": "n",
					"expression": "eval:d*k"
				}
			],
			"conditions": ["d*k <= 12", "b > a*k"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{eval:b-a*k}}}{{{n}}}"
				}
			],
			"correction": {
				"steps": [
					"Les dénominateurs ne sont pas les mêmes : on écrit $\\frac{{{a}}}{{{d}}}$ en {{if:n==2|demis|{{if:n==3|tiers|{{if:n==4|quarts|{{if:n==5|cinquièmes|{{if:n==6|sixièmes|{{if:n==7|septièmes|{{if:n==8|huitièmes|{{if:n==9|neuvièmes|{{if:n==10|dixièmes|{{if:n==11|onzièmes|douzièmes}}}}}}}}}}}}}}}}}}}}. $\\frac{{{a}}}{{{d}}} = \\frac{{{a}} \\times {{k}}}{{{d}} \\times {{k}}} = \\frac{{{eval:a*k}}}{{{eval:d*k}}}$.",
					"$$\\frac{{{b}}}{{{n}}} - \\frac{{{a}}}{{{d}}} = \\frac{{{b}}}{{{n}}} - \\frac{{{eval:a*k}}}{{{n}}} = \\textcolor{{{color:primary.0}}}{\\frac{{{eval:b-a*k}}}{{{n}}}}$$"
				]
			}
		}
	],
	"testSpecs": [

{
	"title": "Les heures du matin et de l'après-midi",
	"description": "3 heures de l'après-midi = 15 h ; 14 : 15, le matin ou l'après-midi ? ; 20 h = 8 heures du soir",
	"grades": ["CE1"],
	"theme": "Grandeurs",
	"domain": "Durées",
	"subdomain": "Moments de la journée",

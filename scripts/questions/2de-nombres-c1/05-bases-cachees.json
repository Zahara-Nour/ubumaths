					"$${{A}}^{ {{m}} }=\\left(\\textcolor{{{color:primary.0}}}{{{b}}^{3}}\\right)^{ {{m}} }={{b}}^{3\\times{{m}}}={{b}}^{ {{x}} }\\quad\\text{et}\\quad{{B}}^{ {{n}} }=\\left(\\textcolor{{{color:primary.1}}}{{{b}}^{2}}\\right)^{ {{n}} }={{b}}^{2\\times{{n}}}={{b}}^{ {{y}} }$$",
					"$$\\dfrac{ {{b}}^{ {{x}} }\\times{{b}}^{ {{y}} } }{ {{b}}^{ {{r}} } }={{b}}^{ {{x}}+{{y}}-{{r}} }=\\textcolor{{{color:primary.2}}}{{{b}}^{ {{k}} }}$$"
				]
			}

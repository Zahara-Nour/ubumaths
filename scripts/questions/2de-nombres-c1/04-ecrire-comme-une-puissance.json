			"blanks": [
				{
					"expectedAnswer": "{{eval:(d)/10;d}}"
				}
			],
			"correction": {
				"steps": [
					"On cherche le nombre positif dont la puissance ${{n}}$ vaut ${{eval:(d)^(n)/10^(n);d}}$ : un produit de ${{n}}$ facteurs égaux à ce nombre.",
					"${{d}}^{ {{n}} }={{eval:(d)^(n)}}$, et ${{eval:(d)^(n)/10^(n);d}}$ a ${{n}}$ chiffres après la virgule : la base a $1$ chiffre après la virgule.",
					"$${{if:n==2|{{eval:(d)/10;d}}\\times {{eval:(d)/10;d}}|{{eval:(d)/10;d}}\\times {{eval:(d)/10;d}}\\times {{eval:(d)/10;d}}}}={{eval:(d)^(n)/10^(n);d}}\\quad\\text{donc}\\quad{{eval:(d)^(n)/10^(n);d}}=\\textcolor{{{color:primary.0}}}{{{eval:(d)/10;d}}}^{ {{n}} }$$"
				]
			}
		},
		{
			"statement": "Complète.\n\n$$\\dfrac{1}{ {{N}} }={{a}}^{?}$$",
			"variables": [
				{
					"name": "a",
					"expression": "2|3|5"
				},
				{
					"name": "n",
					"expression": "2..6"
				},
				{
					"name": "N",
					"expression": "eval:(a)^(n)"
				}
			],
			"conditions": ["(a)^(n) <= 999"],
			"blanks": [
				{
					"expectedAnswer": "-{{n}}"
				}
			],
			"correction": {
				"steps": [
					"On écrit d'abord le dénominateur comme une puissance de ${{a}}$, puis on utilise $\\dfrac{1}{a^n}=a^{-n}$.",
					"${{N}}={{a}}^{ {{n}} }$, donc $\\dfrac{1}{ {{N}} }=\\dfrac{1}{ {{a}}^{ {{n}} } }=\\textcolor{{{color:primary.0}}}{{{a}}^{-{{n}} }}$."
				]
			}
		}
	],

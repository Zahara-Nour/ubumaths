				"steps": [
					"On divise ${{N}}$ par ${{a}}$ autant de fois que possible, ou on calcule les puissances successives de ${{a}}$ jusqu'à trouver ${{N}}$.",
					"${{if:n==3|{{a}}\\times {{a}}\\times {{a}}|{{if:n==4|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}|{{if:n==5|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}|{{if:n==6|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}|{{if:n==7|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}|{{if:n==8|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}}}}}}}}}}}}}={{N}}$ : il y a ${{n}}$ facteurs.",
					"$${{N}}=\\textcolor{{{color:primary.0}}}{{{a}}^{ {{n}} }}$$"
				]
			}
		},
		{
			"statement": "Complète par un nombre positif.\n\n$${{eval:(d)^(n)/10^(n);d}}=?^{ {{n}} }$$",
			"variables": [
				{
					"name": "d",
					"expression": "2..9"

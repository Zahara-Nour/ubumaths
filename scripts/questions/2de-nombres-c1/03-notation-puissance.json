			"correction": {
				"steps": [
					"$a^n$ est le produit de $n$ facteurs tous égaux à $a$ : la base est le facteur répété, l'exposant est le nombre de facteurs.",
					"Le facteur ${{a}}$ est répété ${{n}}$ fois : ${{if:n==3|{{a}}\\times {{a}}\\times {{a}}|{{if:n==4|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}|{{if:n==5|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}|{{if:n==6|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}}}}}}}}}=\\textcolor{{{color:primary.0}}}{{{a}}^{ {{n}} }}$."
				]
			}
		},

					"expression": "2..9"
				},
				{
					"name": "n",
					"expression": "2..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "(-{{a}})^{ {{n}} }"
				}
			],
			"correction": {
				"steps": [
					"$a^n$ est le produit de $n$ facteurs tous égaux à $a$ ; ici le facteur répété est $-{{a}}$, il reste entre parenthèses.",
					"Le facteur $(-{{a}})$ est répété ${{n}}$ fois : ${{if:n==2|(-{{a}})\\times (-{{a}})|{{if:n==3|(-{{a}})\\times (-{{a}})\\times (-{{a}})|{{if:n==4|(-{{a}})\\times (-{{a}})\\times (-{{a}})\\times (-{{a}})|(-{{a}})\\times (-{{a}})\\times (-{{a}})\\times (-{{a}})\\times (-{{a}})}}}}}}=\\textcolor{{{color:primary.0}}}{(-{{a}})^{ {{n}} }}$.",
					"Sans parenthèses, $-{{a}}^{ {{n}} }$ serait l'opposé de ${{a}}^{ {{n}} }$ : ce n'est pas le même nombre quand l'exposant est pair."
				]
			}
		},
		{
			"statement": "Écris sous la forme d'une puissance.\n\n$$\\dfrac{1}{{{if:n==2|{{a}}\\times {{a}}|{{if:n==3|{{a}}\\times {{a}}\\times {{a}}|{{if:n==4|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}}}}}}}}=?$$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				},
				{
					"name": "n",
					"expression": "2..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{a}}^{-{{n}} }"
				}
			],
			"correction": {
				"steps": [
					"$a^{-n}=\\dfrac{1}{a^n}$ : l'inverse d'une puissance s'écrit avec un exposant négatif.",
					"$$\\dfrac{1}{{{if:n==2|{{a}}\\times {{a}}|{{if:n==3|{{a}}\\times {{a}}\\times {{a}}|{{if:n==4|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}|{{a}}\\times {{a}}\\times {{a}}\\times {{a}}\\times {{a}}}}}}}}}=\\dfrac{1}{ {{a}}^{ {{n}} } }=\\textcolor{{{color:primary.0}}}{{{a}}^{-{{n}} }}$$"
				]
			}
		}
	],

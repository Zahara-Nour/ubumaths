	"title": "Résoudre une équation du type eᵘ = eᵛ",
	"description": "e^u = e^v ⇔ u = v avec u et v affines, et e^u = 1/e^v",
	"grades": ["1_SPE"],
	"theme": "Fonctions",
	"domain": "Fonction exponentielle",
	"subdomain": "Équations et inéquations",
	"level": 2,
	"delay": 60,
	"status": "draft",
	"variations": [
		{
			"blanks": [
				{
					"acceptDecimal": true,
					"expectedAnswer": "{{eval:(d-b)/(a-c)}}"
				}
			],
			"statement": "Résous dans $\\mathbb{R}$ l'équation $e^{ {{eval:a*x+b}} }=e^{ {{eval:c*x+d}} }$.\n\n$x=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..6;±"
				},
				{
					"name": "b",
					"expression": "-9..9"
				},
				{
					"name": "c",
					"expression": "1..6;±"
				},
				{
					"name": "d",
					"expression": "-9..9"
				}
			],
			"conditions": ["a != c", "b != d", "a-c != 1", "a-c != -1"],
			"correction": {
				"steps": [
					"La fonction exponentielle est strictement croissante : $e^u=e^v\\iff u=v$.",
					"$e^{ {{eval:a*x+b}} }=e^{ {{eval:c*x+d}} }\\iff {{eval:a*x+b}}={{eval:c*x+d}}\\iff {{eval:(a-c)*x}}={{eval:d-b}}$.",
					"$x={{if:gcd(d-b,a-c)!=1|{{if:a-c<0|\\dfrac{ {{eval:-(d-b)}} }{ {{eval:-(a-c)}} }|\\dfrac{ {{eval:d-b}} }{ {{eval:a-c}} }}}=|}}\\textcolor{{{color:primary.0}}}{{{eval:(d-b)/(a-c)}} }$."
				]
			}
		},
		{
			"blanks": [
				{
					"acceptDecimal": true,
					"expectedAnswer": "{{eval:-(b+d)/(a+c)}}"
				}
			],
			"statement": "Résous dans $\\mathbb{R}$ l'équation $e^{ {{eval:a*x+b}} }=\\dfrac{1}{e^{ {{eval:c*x+d}} }}$.\n\n$x=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..6;±"
				},
				{
					"name": "b",
					"expression": "-9..9"
				},
				{
					"name": "c",
					"expression": "1..6;±"
				},
				{
					"name": "d",
					"expression": "-9..9"
				}
			],
			"conditions": ["a+c != 0", "b+d != 0", "a+c != 1", "a+c != -1"],
			"correction": {
				"steps": [
					"D'abord $\\dfrac{1}{e^{ {{eval:c*x+d}} }}=e^{ {{eval:-c*x-d}} }$.",
					"Puis $e^u=e^v\\iff u=v$ : ${{eval:a*x+b}}={{eval:-c*x-d}}\\iff {{eval:(a+c)*x}}={{eval:-b-d}}$.",
					"$x={{if:gcd(-b-d,a+c)!=1|{{if:a+c<0|\\dfrac{ {{eval:-(-b-d)}} }{ {{eval:-(a+c)}} }|\\dfrac{ {{eval:-b-d}} }{ {{eval:a+c}} }}}=|}}\\textcolor{{{color:primary.0}}}{{{eval:-(b+d)/(a+c)}} }$."
				]
			}
		}
	],

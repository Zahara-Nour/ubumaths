					"name": "n",
					"expression": "eval:q*k"
				}
			],
			"conditions": ["gcd(p,q)==1", "p!=q", "n<=100", "p>=2"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:p*k}}"
				}
			],
			"correction": {
				"steps": [
					"**Fraction d'un nombre.** Pour calculer une fraction d'un nombre entier, on multiplie la fraction par le nombre : « de » se traduit par « $\\times$ ».",
					"$\\frac{{{p}}}{{{q}}}$ de ${{n}}$, c'est ${{p}}$ fois $\\frac{1}{{{q}}}$ de ${{n}}$ ; on simplifie d'abord : ${{n}} \\div {{q}} = {{k}}$.",
					"$$\\frac{{{p}}}{{{q}}} \\times {{n}} = {{p}} \\times \\frac{{{n}}}{{{q}}} = {{p}} \\times {{k}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		},
		{
			"statement": "Calcule. Donne le résultat sous forme d'une fraction.\n\n$$\\frac{{{p}}}{{{q}}} \\text{ de } {{n}} = ?$$",
			"variables": [
				{
					"name": "q",
					"expression": "2..9"
				},
				{
					"name": "p",
					"expression": "1..9"
				},
				{
					"name": "n",
					"expression": "2..9"
				}
			],
			"conditions": ["gcd(p,q)==1", "gcd(n,q)==1", "p!=q", "p>=2"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{eval:p*n}}}{{{q}}}"
				}
			],
			"correction": {
				"steps": [
					"**Fraction d'un nombre.** Pour calculer une fraction d'un nombre entier, on multiplie la fraction par le nombre : « de » se traduit par « $\\times$ ».",
					"$\\frac{{{p}}}{{{q}}}$ de ${{n}}$, c'est ${{p}}$ fois $\\frac{1}{{{q}}}$ de ${{n}}$, c'est-à-dire ${{p}}$ fois $\\frac{{{n}}}{{{q}}}$.",
					"$$\\frac{{{p}}}{{{q}}} \\times {{n}} = {{p}} \\times \\frac{{{n}}}{{{q}}} = \\frac{{{p}} \\times {{n}}}{{{q}}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		}
	],

				{
					"name": "r",
					"expression": "1..{{eval:b-1}}"
				},
				{
					"name": "a",
					"expression": "eval:q*b+r"
				}
			],
			"conditions": ["gcd(r,b)==1"],
			"blanks": [
				{
					"expectedAnswer": "{{q}}"
				},
				{
					"expectedAnswer": "{{eval:q+1}}"
				}
			],
			"correction": {
				"steps": [
					"**Nombre mixte.** On cherche combien de fois ${{b}}$ va dans ${{a}}$ : ${{a}} = {{q}} \\times {{b}} + {{r}}$.",
					"$$\\frac{{{a}}}{{{b}}} = \\frac{{{eval:q*b}}}{{{b}}} + \\frac{{{r}}}{{{b}}} = {{q}} + \\frac{{{r}}}{{{b}}}$$",

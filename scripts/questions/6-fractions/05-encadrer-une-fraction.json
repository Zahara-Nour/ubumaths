		{
			"statement": "Encadre cette fraction par deux nombres entiers consécutifs.\n\n$$? < \\frac{{{a}}}{{{b}}} < ?$$",
			"variables": [
				{
					"name": "b",
					"expression": "2..6"
				},
				{
					"name": "q",
					"expression": "1..4"

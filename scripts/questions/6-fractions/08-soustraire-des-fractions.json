	"variations": [
		{
			"statement": "Calcule. Donne le résultat sous forme d'une fraction simplifiée.\n\n$$\\frac{{{a}}}{{{b}}} - \\frac{{{c}}}{{{b}}} = ?$$",
			"variables": [
				{
					"name": "b",
					"expression": "3..12"
				},
				{
					"name": "a",
					"expression": "2..{{eval:2*b-1}}"
				},
				{
					"name": "c",
					"expression": "1..{{eval:a-1}}"
				}
			],
			"conditions": ["mod(a-c,b)!=0", "mod(a,b)!=0", "mod(c,b)!=0"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{eval:(a-c)/gcd(a-c,b)}}}{{{eval:(b)/gcd(a-c,b)}}}"
				}
			],
			"correction": {
				"steps": [
					"**Soustraire des fractions.** On écrit les deux fractions avec le même dénominateur, puis on soustrait les numérateurs ; le dénominateur ne change pas.",
					"$$\\frac{{{a}}}{{{b}}} - \\frac{{{c}}}{{{b}}} = \\frac{{{a}} - {{c}}}{{{b}}} = {{if:gcd(a-c,b)>1|\\frac{{{eval:a-c}}}{{{b}}} = |}}\\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		},
		{
			"statement": "Calcule. Donne le résultat sous forme d'une fraction simplifiée.\n\n$${{if:a*d>c*b|\\frac{{{a}}}{{{b}}} - \\frac{{{c}}}{{{d}}}|\\frac{{{c}}}{{{d}}} - \\frac{{{a}}}{{{b}}}}} = ?$$",
			"variables": [
				{
					"name": "b",
					"expression": "2..6"
				},
				{
					"name": "m",
					"expression": "2..3"
				},
				{
					"name": "a",
					"expression": "1..{{eval:2*b-1}}"
				},
				{
					"name": "d",
					"expression": "eval:b*m"
				},
				{
					"name": "c",
					"expression": "1..{{eval:2*d-1}}"
				},
				{
					"name": "L",
					"expression": "eval:b*d/gcd(b,d)"
				},
				{
					"name": "N",
					"expression": "eval:abs(a*L/b-c*L/d)"
				}
			],
			"conditions": ["gcd(a,b)==1", "gcd(c,d)==1", "a*d!=c*b", "mod(N,L)!=0"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{eval:(N)/gcd(N,L)}}}{{{eval:(L)/gcd(N,L)}}}"
				}
			],
			"correction": {
				"steps": [
					"**Soustraire des fractions.** On écrit les deux fractions avec le même dénominateur, puis on soustrait les numérateurs ; le dénominateur ne change pas.",
					"Dénominateur commun ${{L}}$ : $\\frac{{{a}}}{{{b}}} = \\frac{{{eval:a*L/b}}}{{{L}}}$ et $\\frac{{{c}}}{{{d}}} = \\frac{{{eval:c*L/d}}}{{{L}}}$.",
					"$${{if:a*d>c*b|\\frac{{{a}}}{{{b}}} - \\frac{{{c}}}{{{d}}}|\\frac{{{c}}}{{{d}}} - \\frac{{{a}}}{{{b}}}}} = {{if:a*d>c*b|\\frac{{{eval:a*L/b}}}{{{L}}} - \\frac{{{eval:c*L/d}}}{{{L}}}|\\frac{{{eval:c*L/d}}}{{{L}}} - \\frac{{{eval:a*L/b}}}{{{L}}}}} = {{if:gcd(N,L)>1|\\frac{{{N}}}{{{L}}} = |}}\\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		},
		{
			"statement": "Calcule. Donne le résultat sous forme d'une fraction simplifiée.\n\n$${{if:a*d>c*b|\\frac{{{a}}}{{{b}}} - \\frac{{{c}}}{{{d}}}|\\frac{{{c}}}{{{d}}} - \\frac{{{a}}}{{{b}}}}} = ?$$",

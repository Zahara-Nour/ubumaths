{
	"title": "Soustraire des fractions",
	"description": "Différence de deux fractions : même dénominateur (7/9 − 2/9), dénominateurs multiples (2/3 − 1/6), quelconques dans des cas simples (7/2 − 3/5), entier moins fraction (1 − 3/8)",
	"grades": ["6"],
	"theme": "Fractions",
	"domain": "Calculer",
	"subdomain": "Addition et Soustraction",
	"level": 11,
	"delay": 30,

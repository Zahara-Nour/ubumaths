			"conditions": ["gcd(a,b)==1", "gcd(c,d)==1", "a*d!=c*b", "mod(N,L)!=0", "gcd(b,d)==1"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{eval:(N)/gcd(N,L)}}}{{{eval:(L)/gcd(N,L)}}}"

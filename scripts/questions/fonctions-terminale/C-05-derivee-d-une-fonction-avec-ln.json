		"cleanCoefficients": true
	},
	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\left]0\\,;+\\infty\\right[$ par $f(x)={{a}}\\ln x{{b;+}}x{{c;+}}$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9;±"
				},
				{
					"name": "b",
					"expression": "2..9;±"
				},
				{
					"name": "c",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:a>0|\\dfrac{ {{a}} }{x}|-\\dfrac{ {{eval:-a}} }{x}}}{{b;+}}"
				}
			],
			"correction": {
				"steps": [
					"$(\\ln x)'=\\dfrac{1}{x}$ et la dérivée d'une constante est nulle.",
					"$f'(x)=\\textcolor{{{color:primary.0}}}{{{if:a>0|\\dfrac{ {{a}} }{x}|-\\dfrac{ {{eval:-a}} }{x}}}{{b;+}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\left]0\\,;+\\infty\\right[$ par $f(x)=x\\ln x$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "z",
					"expression": "1"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\ln x+1"
				}
			],
			"correction": {
				"steps": [
					"$f=uv$ avec $u(x)=x$, $v(x)=\\ln x$ : $f'=u'v+uv'$.",
					"$f'(x)=1\\times\\ln x+x\\times\\dfrac{1}{x}=\\textcolor{{{color:primary.0}}}{\\ln x+1}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\left]0\\,;+\\infty\\right[$ par $f(x)=\\dfrac{\\ln x}{x}$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "z",
					"expression": "1"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\dfrac{1-\\ln x}{x^{2}}"
				}
			],
			"correction": {
				"steps": [
					"$f=\\dfrac{u}{v}$ avec $u(x)=\\ln x$, $v(x)=x$ : $f'=\\dfrac{u'v-uv'}{v^{2}}$.",
					"$f'(x)=\\dfrac{\\frac{1}{x}\\times x-\\ln x\\times1}{x^{2}}=\\textcolor{{{color:primary.0}}}{\\dfrac{1-\\ln x}{x^{2}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\left]0\\,;+\\infty\\right[$ par $f(x)=\\left(\\ln x\\right)^{2}$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "z",
					"expression": "1"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\dfrac{2\\ln x}{x}"
				}
			],
			"correction": {
				"steps": [
					"$f=u^{2}$ avec $u(x)=\\ln x$ : $f'=2u'u$.",
					"$f'(x)=2\\times\\dfrac{1}{x}\\times\\ln x=\\textcolor{{{color:primary.0}}}{\\dfrac{2\\ln x}{x}}$."
				]
			}
		}
	],

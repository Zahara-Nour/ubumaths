	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}^*$ par $f(x)={{a}}+\\dfrac{ {{b}} }{x^{2}}$.\n\nDétermine la limite de $f$ en $+\\infty$.\n\n$\\displaystyle\\lim_{x\\to+\\infty}f(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9;±"
				},
				{
					"name": "b",
					"expression": "1..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{a}}"
				}
			],
			"correction": {
				"steps": [
					"$\\displaystyle\\lim_{x\\to+\\infty}x^{2}=+\\infty$, donc $\\displaystyle\\lim_{x\\to+\\infty}\\dfrac{ {{b}} }{x^{2}}=0$.",
					"Par somme, $\\displaystyle\\lim_{x\\to+\\infty}f(x)={{a}}+0=\\textcolor{{{color:primary.0}}}{{{a}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)={{a}}e^{x}{{b;+}}$.\n\nDétermine la limite de $f$ en $-\\infty$.\n\n$\\displaystyle\\lim_{x\\to-\\infty}f(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9;±"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{b}}"
				}
			],
			"correction": {
				"steps": [
					"$\\displaystyle\\lim_{x\\to-\\infty}e^{x}=0$, donc $\\displaystyle\\lim_{x\\to-\\infty}{{a}}e^{x}=0$.",
					"Par somme, $\\displaystyle\\lim_{x\\to-\\infty}f(x)=0{{b;+}}=\\textcolor{{{color:primary.0}}}{{{b}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\left[0\\,;+\\infty\\right[$ par $f(x)={{a}}x^{3}{{eval:sign(a)*bb;+}}\\sqrt{x}$.\n\nDétermine la limite de $f$ en $+\\infty$.\n\n$\\displaystyle\\lim_{x\\to+\\infty}f(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..5;±"
				},
				{
					"name": "bb",
					"expression": "1..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:a>0|+\\infty|-\\infty}}"
				}
			],
			"correction": {
				"steps": [
					"$\\displaystyle\\lim_{x\\to+\\infty}x^{3}=+\\infty$ et $\\displaystyle\\lim_{x\\to+\\infty}\\sqrt{x}=+\\infty$.",
					"Les coefficients ${{a}}$ et ${{eval:sign(a)*bb}}$ ont le même signe : les deux termes tendent vers {{if:a>0|+\\infty|-\\infty}}, pas de forme indéterminée.",
					"Par somme, $\\displaystyle\\lim_{x\\to+\\infty}f(x)=\\textcolor{{{color:primary.0}}}{{{if:a>0|+\\infty|-\\infty}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\left]0\\,;+\\infty\\right[$ par $f(x)={{a}}{{if:b>0|+|-}}\\dfrac{ {{eval:abs(b)}} }{x}$.\n\nDétermine la limite de $f$ en $0$ (on a $x>0$).\n\n$\\displaystyle\\lim_{x\\to0}f(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9;±"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:b>0|+\\infty|-\\infty}}"
				}
			],
			"correction": {
				"steps": [
					"Quand $x$ tend vers $0$ avec $x>0$, $\\dfrac{1}{x}$ tend vers $+\\infty$ (inverse d'un nombre positif de plus en plus petit).",
					"Donc ${{if:b>0|\\dfrac{ {{b}} }{x}|-\\dfrac{ {{eval:abs(b)}} }{x}}}$ tend vers {{if:b>0|$+\\infty$|$-\\infty$ (coefficient négatif)}}, et ${{a}}$ ne change rien : $\\displaystyle\\lim_{x\\to0}f(x)=\\textcolor{{{color:primary.0}}}{{{if:b>0|+\\infty|-\\infty}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\left]0\\,;+\\infty\\right[$ par $f(x)={{b}}{{a;+}}\\ln x$.\n\nDétermine la limite de $f$ en $0$ (on a $x>0$).\n\n$\\displaystyle\\lim_{x\\to0}f(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..5;±"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:a>0|-\\infty|+\\infty}}"
				}
			],
			"correction": {
				"steps": [
					"$\\displaystyle\\lim_{x\\to0}\\ln x=-\\infty$ (avec $x>0$).",
					"Le coefficient ${{a}}$ est {{if:a>0|positif : ${{a}}\\ln x$ tend vers $-\\infty$|négatif : ${{a}}\\ln x$ tend vers $+\\infty$}}.",
					"Par somme, $\\displaystyle\\lim_{x\\to0}f(x)=\\textcolor{{{color:primary.0}}}{{{if:a>0|-\\infty|+\\infty}}}$."
				]
			}
		}
	],

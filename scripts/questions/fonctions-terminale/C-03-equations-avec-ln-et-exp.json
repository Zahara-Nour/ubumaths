{
	"title": "Résoudre une équation avec ln ou exp",
	"description": "ln x = a, eˣ = b, ln(ax+b) = c, e^{ax+b} = k, 2 ln x = ln a ; valeur exacte (pièges : ln et exp confondus, domaine x > 0 oublié, signe)",
	"grades": ["T_SPE", "T_COMP"],
	"points": ["TCOMP-036", "TCOMP-022", "TSPE-174", "TSPE-167"],
	"theme": "Fonctions",
	"domain": "Fonction logarithme",
	"subdomain": "Équations et inéquations",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"variations": [
		{
			"statement": "Résous dans $\\left]0\\,;+\\infty\\right[$ l'équation $\\ln x={{a}}$.\n\n$x=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..6;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "e^{ {{a}} }"
				}
			],
			"correction": {
				"steps": [
					"$\\ln x={{a}}\\iff x=e^{ {{a}} }$ (on compose par l'exponentielle).",
					"$x=\\textcolor{{{color:primary.0}}}{e^{ {{a}} }}$, qui appartient bien à $\\left]0\\,;+\\infty\\right[$."
				]
			}
		},
		{
			"statement": "Résous dans $\\mathbb{R}$ l'équation $e^{x}={{b}}$.\n\n$x=?$",
			"variables": [
				{
					"name": "b",
					"expression": "2|3|4|5|6|7|8|9|10|12|15"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\ln {{b}}"
				}
			],
			"correction": {
				"steps": [
					"${{b}}>0$ : $e^{x}={{b}}\\iff x=\\ln {{b}}$.",
					"$x=\\textcolor{{{color:primary.0}}}{\\ln {{b}}}$."
				]
			}
		},
		{
			"statement": "Résous l'équation $\\ln\\left({{a}}x{{b;+}}\\right)={{c}}$.\n\n$x=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..5"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				},
				{
					"name": "c",
					"expression": "1..4;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\dfrac{{{if:c==1|e|e^{ {{c}} }}}{{eval:-b;+}}}{ {{a}} }"
				}
			],
			"correction": {
				"steps": [
					"$\\ln\\left({{a}}x{{b;+}}\\right)={{c}}\\iff {{a}}x{{b;+}}={{if:c==1|e|e^{ {{c}} }}}$ (et alors ${{a}}x{{b;+}}>0$ : la solution est dans le domaine).",
					"$x=\\textcolor{{{color:primary.0}}}{\\dfrac{{{if:c==1|e|e^{ {{c}} }}}{{eval:-b;+}}}{ {{a}} }}$."
				]
			}
		},
		{
			"statement": "Résous dans $\\mathbb{R}$ l'équation $e^{ {{a}}x{{b;+}} }={{k}}$.\n\n$x=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..5"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				},
				{
					"name": "k",
					"expression": "2|3|5|6|7"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\dfrac{\\ln {{k}}{{eval:-b;+}}}{ {{a}} }"
				}
			],
			"correction": {
				"steps": [
					"$e^{ {{a}}x{{b;+}} }={{k}}\\iff {{a}}x{{b;+}}=\\ln {{k}}$.",
					"$x=\\textcolor{{{color:primary.0}}}{\\dfrac{\\ln {{k}}{{eval:-b;+}}}{ {{a}} }}$."
				]
			}
		},
		{
			"statement": "Résous dans $\\left]0\\,;+\\infty\\right[$ l'équation $2\\ln x=\\ln {{a}}$.\n\n$x=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2|3|5|6|7|10|11"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\sqrt{ {{a}} }"
				}
			],
			"correction": {
				"steps": [
					"$2\\ln x=\\ln\\left(x^{2}\\right)$, donc l'équation équivaut à $x^{2}={{a}}$, soit $x=\\sqrt{ {{a}} }$ ou $x=-\\sqrt{ {{a}} }$.",
					"Seule la solution positive est dans le domaine $\\left]0\\,;+\\infty\\right[$ : $x=\\textcolor{{{color:primary.0}}}{\\sqrt{ {{a}} }}$."
				]
			}
		}
	],

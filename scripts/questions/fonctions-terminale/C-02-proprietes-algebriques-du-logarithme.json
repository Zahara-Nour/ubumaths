	"variations": [
		{
			"statement": "Écris $\\ln {{eval:2^p*3^q}}$ en fonction de $\\ln 2$ et $\\ln 3$.\n\n$\\ln {{eval:2^p*3^q}}=?\\ln 2+?\\ln 3$",
			"variables": [
				{
					"name": "p",
					"expression": "1..4"
				},
				{
					"name": "q",
					"expression": "1..3"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{p}}"
				},
				{
					"expectedAnswer": "{{q}}"
				}
			],
			"correction": {
				"steps": [
					"${{eval:2^p*3^q}}={{if:p==1|2|2^{ {{p}} }}}\\times{{if:q==1|3|3^{ {{q}} }}}$.",
					"$\\ln(ab)=\\ln a+\\ln b$ et $\\ln\\left(a^{n}\\right)=n\\ln a$ : $\\ln {{eval:2^p*3^q}}=\\ln\\left({{if:p==1|2|2^{ {{p}} }}}\\right)+\\ln\\left({{if:q==1|3|3^{ {{q}} }}}\\right)=\\textcolor{{{color:primary.0}}}{{{if:p==1||{{p}}}}\\ln 2+{{if:q==1||{{q}}}}\\ln 3}$."
				]
			}
		},
		{
			"statement": "Écris $A=\\ln {{a}}+\\ln {{b}}-\\ln {{c}}$ sous la forme $\\ln n$, avec $n$ entier.\n\n$A=\\ln(?)$",
			"variables": [
				{
					"name": "c",
					"expression": "2..5"
				},
				{
					"name": "m",
					"expression": "2..5"
				},
				{
					"name": "a",
					"expression": "{{eval:c*m}}"
				},
				{
					"name": "b",
					"expression": "2..9"
				}
			],
			"conditions": ["m*b != a+b-c"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:m*b}}"
				}
			],
			"correction": {
				"steps": [
					"$\\ln a+\\ln b=\\ln(ab)$ et $\\ln a-\\ln b=\\ln\\dfrac{a}{b}$.",
					"$A=\\ln\\dfrac{ {{a}}\\times{{b}} }{ {{c}} }=\\ln\\textcolor{{{color:primary.0}}}{{{eval:m*b}}}$."
				]
			}
		},
		{
			"statement": "Complète.\n\n$\\ln\\left(\\dfrac{1}{ {{a}}^{ {{n}} } }\\right)=?\\ln {{a}}$",
			"variables": [
				{
					"name": "a",
					"expression": "2..7"
				},
				{
					"name": "n",
					"expression": "2..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:-n}}"
				}
			],
			"correction": {
				"steps": [
					"$\\ln\\dfrac{1}{x}=-\\ln x$ et $\\ln\\left(x^{n}\\right)=n\\ln x$.",
					"$\\ln\\left(\\dfrac{1}{ {{a}}^{ {{n}} } }\\right)=-\\ln\\left({{a}}^{ {{n}} }\\right)=\\textcolor{{{color:primary.0}}}{-{{n}}\\ln {{a}}}$."
				]
			}
		},
		{
			"statement": "Complète.\n\n$\\ln\\sqrt{ {{a}} }=?\\ln {{a}}$",
			"variables": [
				{
					"name": "a",
					"expression": "2|3|5|6|7|10"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\dfrac{1}{2}"
				}
			],
			"correction": {
				"steps": [
					"$\\sqrt{ {{a}} }={{a}}^{\\frac{1}{2}}$ et $\\ln\\left(x^{n}\\right)=n\\ln x$.",
					"$\\ln\\sqrt{ {{a}} }=\\textcolor{{{color:primary.0}}}{\\dfrac{1}{2}\\ln {{a}}}$ (et non $\\sqrt{\\ln {{a}}}$)."
				]
			}
		},
		{
			"statement": "Calcule sans calculatrice.\n\n$\\dfrac{\\ln {{eval:a^n}}}{\\ln {{a}}}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..3"
				},
				{
					"name": "n",
					"expression": "2..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{n}}"
				}
			],
			"correction": {
				"steps": [
					"${{eval:a^n}}={{a}}^{ {{n}} }$, donc $\\ln {{eval:a^n}}={{n}}\\ln {{a}}$.",
					"$\\dfrac{\\ln {{eval:a^n}}}{\\ln {{a}}}=\\dfrac{ {{n}}\\ln {{a}}}{\\ln {{a}}}=\\textcolor{{{color:primary.0}}}{{{n}}}$. Attention : un quotient de logarithmes n'est **pas** $\\ln\\left({{eval:a^n}}-{{a}}\\right)$."
				]
			}
		}
	],

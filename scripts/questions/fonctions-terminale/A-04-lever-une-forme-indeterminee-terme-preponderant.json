					"expression": "1..5;±"
				},
				{
					"name": "bb",
					"expression": "1..9"
				},
				{
					"name": "c",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:a>0|-\\infty|+\\infty}}"
				}
			],
			"correction": {
				"steps": [
					"En $-\\infty$, ${{a}}x^{3}$ tend vers {{if:a>0|$-\\infty$|$+\\infty$}} et ${{eval:sign(a)*bb}}x^{2}$ vers {{if:a>0|$+\\infty$|$-\\infty$}} : forme indéterminée « $\\infty-\\infty$ ».",
					"On factorise par $x^{3}$ : $f(x)=x^{3}\\left({{a}}{{if:a>0|+|-}}\\dfrac{ {{bb}} }{x}{{if:c>0|+|-}}\\dfrac{ {{eval:abs(c)}} }{x^{3}}\\right)$ ; la parenthèse tend vers ${{a}}$.",
					"Donc $\\displaystyle\\lim_{x\\to-\\infty}f(x)=\\lim_{x\\to-\\infty}{{a}}x^{3}=\\textcolor{{{color:primary.0}}}{{{if:a>0|-\\infty|+\\infty}}}$."
				]
			}
		},

	"variations": [
		{
			"statement": "Résous dans $\\left]0\\,;+\\infty\\right[$ l'inéquation $\\ln x<{{a}}$.\n\n$S=?$",
			"variables": [
				{
					"name": "a",
					"expression": "0..4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "]0;{{if:a==0|1|e^{ {{a}} }}}["
				}
			],
			"correction": {
				"steps": [
					"La fonction $\\ln$ est strictement croissante sur $\\left]0\\,;+\\infty\\right[$ : $\\ln x<{{a}}\\iff x<e^{ {{a}} }${{if:a==0| $=1$|}}.",
					"Sans oublier $x>0$ : $S=\\textcolor{{{color:primary.0}}}{\\left]0\\,;{{if:a==0|1|e^{ {{a}} }}}\\right[}$."
				]
			}
		},
		{
			"statement": "Résous dans $\\left]0\\,;+\\infty\\right[$ l'inéquation $\\ln x\\geqslant{{a}}$.\n\n$S=?$",
			"variables": [
				{
					"name": "a",
					"expression": "0..4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "[{{if:a==0|1|e^{ {{a}} }}};+\\infty["
				}
			],
			"correction": {
				"steps": [
					"$\\ln$ est strictement croissante sur $\\left]0\\,;+\\infty\\right[$ : $\\ln x\\geqslant{{a}}\\iff x\\geqslant {{if:a==0|1|e^{ {{a}} }}}$.",
					"$S=\\textcolor{{{color:primary.0}}}{\\left[{{if:a==0|1|e^{ {{a}} }}}\\,;+\\infty\\right[}$."
				]
			}
		},
		{
			"statement": "Résous dans $\\mathbb{R}$ l'inéquation $e^{x}>{{b}}$.\n\n$S=?$",
			"variables": [
				{
					"name": "b",
					"expression": "2|3|5|6|7|10"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "]\\ln {{b}};+\\infty["
				}
			],
			"correction": {
				"steps": [
					"$\\ln$ est strictement croissante sur $\\left]0\\,;+\\infty\\right[$ et ${{b}}>0$ : $e^{x}>{{b}}\\iff x>\\ln {{b}}$.",
					"$S=\\textcolor{{{color:primary.0}}}{\\left]\\ln {{b}}\\,;+\\infty\\right[}$."
				]
			}
		},
		{
			"statement": "Résous l'inéquation $\\ln\\left({{a}}x{{b;+}}\\right)\\leqslant0$.\n\n$S=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..5"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "]{{eval:-b/a}};{{eval:(1-b)/a}}]"
				}
			],
			"correction": {
				"steps": [
					"Domaine : ${{a}}x{{b;+}}>0\\iff x>{{eval:-b/a}}$.",
					"$\\ln X\\leqslant0\\iff X\\leqslant1$ : ${{a}}x{{b;+}}\\leqslant1\\iff x\\leqslant{{eval:(1-b)/a}}$.",
					"$S=\\textcolor{{{color:primary.0}}}{\\left]{{eval:-b/a}}\\,;{{eval:(1-b)/a}}\\right]}$."
				]
			}
		},
		{
			"statement": "Résous dans $\\mathbb{R}$ l'inéquation $e^{-x}\\geqslant{{k}}$.\n\n$S=?$",
			"variables": [
				{
					"name": "k",
					"expression": "2|3|5|6|7"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "]-\\infty;-\\ln {{k}}]"
				}
			],
			"correction": {
				"steps": [
					"$e^{-x}\\geqslant{{k}}\\iff -x\\geqslant\\ln {{k}}$ ($\\ln$ est croissante).",
					"On multiplie par $-1$ : le sens change, $x\\leqslant-\\ln {{k}}$.",
					"$S=\\textcolor{{{color:primary.0}}}{\\left]-\\infty\\,;-\\ln {{k}}\\right]}$."
				]
			}
		}
	],

	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\left]0\\,;+\\infty\\right[$ par $f(x)=x-{{a}}\\ln x$.\n\nDétermine le plus grand intervalle sur lequel $f$ est **croissante**.\n\n$I=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "[{{a}};+\\infty["
				}
			],
			"correction": {
				"steps": [
					"$f'(x)=1-\\dfrac{ {{a}} }{x}=\\dfrac{x-{{a}}}{x}$ ; sur $\\left]0\\,;+\\infty\\right[$, $x>0$, donc $f'(x)$ est du signe de $x-{{a}}$.",
					"$f'(x)\\geqslant0\\iff x\\geqslant{{a}}$ : $f$ est croissante sur $\\textcolor{{{color:primary.0}}}{\\left[{{a}}\\,;+\\infty\\right[}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\left]0\\,;+\\infty\\right[$ par $f(x)=x-{{a}}\\ln x$.\n\nDétermine le plus grand intervalle sur lequel $f$ est **décroissante**.\n\n$I=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "]0;{{a}}]"
				}
			],
			"correction": {
				"steps": [
					"$f'(x)=1-\\dfrac{ {{a}} }{x}=\\dfrac{x-{{a}}}{x}$, du signe de $x-{{a}}$ car $x>0$.",
					"$f'(x)\\leqslant0\\iff 0<x\\leqslant{{a}}$ : $f$ est décroissante sur $\\textcolor{{{color:primary.0}}}{\\left]0\\,;{{a}}\\right]}$ ($0$ est exclu : $\\ln 0$ n'existe pas)."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\left]0\\,;+\\infty\\right[$ par $f(x)={{a}}\\ln x-{{b}}x$.\n\nDétermine le plus grand intervalle sur lequel $f$ est **croissante**.\n\n$I=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				},
				{
					"name": "b",
					"expression": "2..5"
				}
			],
			"conditions": ["a != b"],
			"blanks": [
				{
					"expectedAnswer": "]0;{{eval:a/b}}]"
				}
			],
			"correction": {
				"steps": [
					"$f'(x)=\\dfrac{ {{a}} }{x}-{{b}}=\\dfrac{ {{a}}-{{b}}x}{x}$, du signe de ${{a}}-{{b}}x$ car $x>0$.",
					"$f'(x)\\geqslant0\\iff x\\leqslant{{eval:a/b}}$ : $f$ est croissante sur $\\textcolor{{{color:primary.0}}}{\\left]0\\,;{{eval:a/b}}\\right]}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\left]0\\,;+\\infty\\right[$ par $f(x)=x\\ln x-{{a}}x$.\n\nDétermine le plus grand intervalle sur lequel $f$ est **croissante**.\n\n$I=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "[{{if:a==2|e|e^{ {{eval:a-1}} }}};+\\infty["
				}
			],
			"correction": {
				"steps": [
					"$f'(x)=1\\times\\ln x+x\\times\\dfrac{1}{x}-{{a}}=\\ln x-{{eval:a-1}}$.",
					"$f'(x)\\geqslant0\\iff\\ln x\\geqslant{{eval:a-1}}\\iff x\\geqslant {{if:a==2|e|e^{ {{eval:a-1}} }}}$ (la fonction exponentielle est croissante).",
					"$f$ est croissante sur $\\textcolor{{{color:primary.0}}}{\\left[{{if:a==2|e|e^{ {{eval:a-1}} }}}\\,;+\\infty\\right[}$."
				]
			}
		}
	],

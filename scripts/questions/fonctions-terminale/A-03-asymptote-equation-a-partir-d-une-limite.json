	"variations": [
		{
			"statement": "Soit $f$ une fonction définie sur $\\mathbb{R}$, de courbe $\\mathcal{C}_f$, telle que $\\displaystyle\\lim_{x\\to {{s}}\\infty}f(x)={{b}}$.\n\nDonne une équation de l'asymptote à $\\mathcal{C}_f$ que l'on en déduit.\n\n$?$",
			"variables": [
				{
					"name": "s",
					"expression": "+|-"
				},
				{
					"name": "b",
					"expression": "-9..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "y={{b}}",
					"answerKind": "equation"
				}
			],
			"correction": {
				"steps": [
					"Une limite **finie** ${{b}}$ en ${{s}}\\infty$ donne une asymptote **horizontale** en ${{s}}\\infty$.",
					"Son équation est $\\textcolor{{{color:primary.0}}}{y={{b}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ une fonction définie sur $\\left]{{a}}\\,;+\\infty\\right[$, de courbe $\\mathcal{C}_f$, telle que $\\displaystyle\\lim_{x\\to {{a}}}f(x)={{s}}\\infty$.\n\nDonne une équation de l'asymptote à $\\mathcal{C}_f$ que l'on en déduit.\n\n$?$",
			"variables": [
				{
					"name": "s",
					"expression": "+|-"
				},
				{
					"name": "a",
					"expression": "-9..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "x={{a}}",
					"answerKind": "equation"
				}
			],
			"correction": {
				"steps": [
					"Une limite **infinie** en un réel ${{a}}$ donne une asymptote **verticale**.",
					"Son équation est $\\textcolor{{{color:primary.0}}}{x={{a}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}\\setminus\\left\\{ {{a}} \\right\\}$ par $f(x)={{b}}+\\dfrac{ {{k}} }{x{{eval:-a;+}}}$, de courbe $\\mathcal{C}_f$.\n\nDonne une équation de l'asymptote **horizontale** à $\\mathcal{C}_f$ en $+\\infty$.\n\n$?$",
			"variables": [
				{
					"name": "a",
					"expression": "-6..6"
				},
				{
					"name": "b",
					"expression": "-6..6"
				},
				{
					"name": "k",
					"expression": "1..9"
				}
			],
			"conditions": ["a != 0", "b != 0", "a != b"],
			"blanks": [
				{
					"expectedAnswer": "y={{b}}",
					"answerKind": "equation"
				}
			],
			"correction": {
				"steps": [
					"$\\displaystyle\\lim_{x\\to+\\infty}\\dfrac{ {{k}} }{x{{eval:-a;+}}}=0$, donc $\\displaystyle\\lim_{x\\to+\\infty}f(x)={{b}}$.",
					"L'asymptote horizontale a pour équation $\\textcolor{{{color:primary.0}}}{y={{b}}}$ (et $x={{a}}$ est l'asymptote verticale)."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}\\setminus\\left\\{ {{a}} \\right\\}$ par $f(x)={{b}}+\\dfrac{ {{k}} }{x{{eval:-a;+}}}$, de courbe $\\mathcal{C}_f$.\n\nDonne une équation de l'asymptote **verticale** à $\\mathcal{C}_f$.\n\n$?$",
			"variables": [
				{
					"name": "a",
					"expression": "-6..6"
				},
				{
					"name": "b",
					"expression": "-6..6"
				},
				{
					"name": "k",
					"expression": "1..9"
				}
			],
			"conditions": ["a != 0", "b != 0", "a != b"],
			"blanks": [
				{
					"expectedAnswer": "x={{a}}",
					"answerKind": "equation"
				}
			],
			"correction": {
				"steps": [
					"Le dénominateur s'annule en ${{a}}$ et le numérateur ${{k}}$ ne s'annule pas : $f$ a une limite infinie en ${{a}}$ (à gauche et à droite).",
					"L'asymptote verticale a pour équation $\\textcolor{{{color:primary.0}}}{x={{a}}}$ (et $y={{b}}$ est l'asymptote horizontale)."
				]
			}
		}
	],

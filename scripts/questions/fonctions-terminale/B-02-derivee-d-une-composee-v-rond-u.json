	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\sqrt{x^{2}+{{c}}}$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "c",
					"expression": "1..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\dfrac{x}{\\sqrt{x^{2}+{{c}}}}"
				}
			],
			"correction": {
				"steps": [
					"$f=\\sqrt{u}$ avec $u(x)=x^{2}+{{c}}>0$, donc $f'=\\dfrac{u'}{2\\sqrt{u}}$.",
					"$u'(x)=2x$, d'où $f'(x)=\\dfrac{2x}{2\\sqrt{x^{2}+{{c}}}}=\\textcolor{{{color:primary.0}}}{\\dfrac{x}{\\sqrt{x^{2}+{{c}}}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\left(x^{2}{{b;+}}\\right)^{ {{n}} }$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "b",
					"expression": "1..9;±"
				},
				{
					"name": "n",
					"expression": "3..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*n}}x\\left(x^{2}{{b;+}}\\right)^{ {{eval:n-1}} }"
				}
			],
			"correction": {
				"steps": [
					"$f=u^{ {{n}} }$ avec $u(x)=x^{2}{{b;+}}$, donc $f'={{n}}u'u^{ {{eval:n-1}} }$.",
					"$u'(x)=2x$, d'où $f'(x)={{n}}\\times2x\\left(x^{2}{{b;+}}\\right)^{ {{eval:n-1}} }=\\textcolor{{{color:primary.0}}}{{{eval:2*n}}x\\left(x^{2}{{b;+}}\\right)^{ {{eval:n-1}} }}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\cos\\left({{a}}x{{b;+}}\\right)$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..6"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "-{{a}}\\sin\\left({{a}}x{{b;+}}\\right)"
				}
			],
			"correction": {
				"steps": [
					"$(\\cos u)'=-u'\\sin u$ avec $u(x)={{a}}x{{b;+}}$ et $u'(x)={{a}}$.",
					"$f'(x)=\\textcolor{{{color:primary.0}}}{-{{a}}\\sin\\left({{a}}x{{b;+}}\\right)}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\sin\\left({{a}}x^{2}\\right)$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*a}}x\\cos\\left({{a}}x^{2}\\right)"
				}
			],
			"correction": {
				"steps": [
					"$(\\sin u)'=u'\\cos u$ avec $u(x)={{a}}x^{2}$ et $u'(x)={{eval:2*a}}x$.",
					"$f'(x)=\\textcolor{{{color:primary.0}}}{{{eval:2*a}}x\\cos\\left({{a}}x^{2}\\right)}$."
				]
			}
		}
	],

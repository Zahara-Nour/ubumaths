	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=e^{ {{a}}x^{2}{{b;+}} }$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*a}}xe^{ {{a}}x^{2}{{b;+}} }"
				}
			],
			"correction": {
				"steps": [
					"$f=e^{u}$ avec $u(x)={{a}}x^{2}{{b;+}}$, donc $f'=u'e^{u}$.",
					"$u'(x)={{eval:2*a}}x$, d'où $f'(x)=\\textcolor{{{color:primary.0}}}{{{eval:2*a}}xe^{ {{a}}x^{2}{{b;+}} }}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\left]{{eval:-b/a}}\\,;+\\infty\\right[$ par $f(x)=\\ln\\left({{a}}x{{b;+}}\\right)$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..6"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\dfrac{ {{a}} }{ {{a}}x{{b;+}} }"
				}
			],
			"correction": {
				"steps": [
					"$f=\\ln u$ avec $u(x)={{a}}x{{b;+}}>0$ sur l'intervalle, donc $f'=\\dfrac{u'}{u}$.",
					"$u'(x)={{a}}$, d'où $f'(x)=\\textcolor{{{color:primary.0}}}{\\dfrac{ {{a}} }{ {{a}}x{{b;+}} }}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\ln\\left(x^{2}+{{c}}\\right)$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "c",
					"expression": "1..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\dfrac{2x}{x^{2}+{{c}}}"
				}
			],
			"correction": {
				"steps": [
					"$x^{2}+{{c}}>0$ pour tout réel $x$ : $f=\\ln u$ avec $u(x)=x^{2}+{{c}}$, donc $f'=\\dfrac{u'}{u}$.",
					"$u'(x)=2x$, d'où $f'(x)=\\textcolor{{{color:primary.0}}}{\\dfrac{2x}{x^{2}+{{c}}}}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\left({{a}}x{{b;+}}\\right)^{2}$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..6;±"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*a}}\\left({{a}}x{{b;+}}\\right)"
				}
			],
			"correction": {
				"steps": [
					"$f=u^{2}$ avec $u(x)={{a}}x{{b;+}}$, donc $f'=2u'u$.",
					"$u'(x)={{a}}$, d'où $f'(x)=2\\times{{a;()}}\\times\\left({{a}}x{{b;+}}\\right)=\\textcolor{{{color:primary.0}}}{{{eval:2*a}}\\left({{a}}x{{b;+}}\\right)}$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=\\left(x^{2}{{b;+}}\\right)^{2}$.\n\nDétermine sa fonction dérivée.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "b",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "4x\\left(x^{2}{{b;+}}\\right)"
				}
			],
			"correction": {
				"steps": [
					"$f=u^{2}$ avec $u(x)=x^{2}{{b;+}}$, donc $f'=2u'u$.",
					"$u'(x)=2x$, d'où $f'(x)=2\\times2x\\times\\left(x^{2}{{b;+}}\\right)=\\textcolor{{{color:primary.0}}}{4x\\left(x^{2}{{b;+}}\\right)}$."
				]
			}
		}
	],

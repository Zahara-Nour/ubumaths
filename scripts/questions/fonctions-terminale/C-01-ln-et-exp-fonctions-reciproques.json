				{
					"expectedAnswer": "{{k}}"
				}
			],
			"correction": {
				"steps": [
					"$\\ln$ est la réciproque de l'exponentielle : pour tout réel $x$, $\\ln\\left(e^{x}\\right)=x$.",
					"$\\ln\\left(e^{ {{k}} }\\right)=\\textcolor{{{color:primary.0}}}{{{k}}}$."
				]
			}
		},
		{
			"statement": "Calcule sans calculatrice.\n\n$e^{\\ln {{k}}}=?$",
			"variables": [
				{
					"name": "k",
					"expression": "2..20"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{k}}"
				}
			],
			"correction": {
				"steps": [
					"Pour tout réel $x>0$, $e^{\\ln x}=x$.",
					"$e^{\\ln {{k}}}=\\textcolor{{{color:primary.0}}}{{{k}}}$."
				]
			}
		},
		{
			"statement": "Calcule sans calculatrice.\n\n$e^{ {{n}}\\ln {{b}}}=?$",
			"variables": [
				{
					"name": "n",
					"expression": "2..3"
				},
				{
					"name": "b",
					"expression": "2..5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:b^n}}"
				}
			],
			"correction": {
				"steps": [
					"${{n}}\\ln {{b}}=\\ln\\left({{b}}^{ {{n}} }\\right)$, donc $e^{ {{n}}\\ln {{b}}}=e^{\\ln\\left({{b}}^{ {{n}} }\\right)}={{b}}^{ {{n}} }=\\textcolor{{{color:primary.0}}}{{{eval:b^n}}}$."
				]
			}
		},
		{
			"statement": "Calcule sans calculatrice.\n\n$\\ln\\left(\\dfrac{1}{e^{ {{k}} }}\\right)=?$",
			"variables": [
				{
					"name": "k",
					"expression": "2..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:-k}}"
				}
			],
			"correction": {
				"steps": [
					"$\\dfrac{1}{e^{ {{k}} }}=e^{-{{k}}}$, donc $\\ln\\left(\\dfrac{1}{e^{ {{k}} }}\\right)=\\ln\\left(e^{-{{k}}}\\right)=\\textcolor{{{color:primary.0}}}{{{eval:-k}}}$."
				]
			}
		},
		{
			"statement": "Calcule sans calculatrice.\n\n$e^{-\\ln {{k}}}=?$",
			"variables": [
				{
					"name": "k",
					"expression": "2..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\dfrac{1}{ {{k}} }"
				}
			],
			"correction": {
				"steps": [
					"$-\\ln {{k}}=\\ln\\dfrac{1}{ {{k}} }$, donc $e^{-\\ln {{k}}}=e^{\\ln\\frac{1}{ {{k}} }}=\\textcolor{{{color:primary.0}}}{\\dfrac{1}{ {{k}} }}$."
				]
			}
		}
	],

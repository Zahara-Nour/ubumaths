			"conditions": ["a*x<=12", "b<a*a*x*x"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*a*x*x-b}}"
				}
			],
			"correction": {
				"steps": [
					"**Remplacer.** On remplace $x$ par sa valeur, puis on calcule en respectant les priorités : d'abord les puissances, puis les multiplications, enfin les additions et les soustractions.",
					"Les parenthèses : le carré porte sur tout le produit ${{a}}x$.",
					"$$A = ({{a}} \\times \\textcolor{{{color:primary.1}}}{{{x}}})^2 - {{b}} = {{eval:a*x}}^2 - {{b}} = {{eval:a*a*x*x}} - {{b}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		},
		{
			"statement": "Calcule $A$ pour $x = {{x}}$.\n\n$$A = x^3 + {{b}}$$\n\n$$A = ?$$",
			"variables": [
				{
					"name": "x",
					"expression": "2..5"
				},
				{
					"name": "b",
					"expression": "1..20"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:x*x*x+b}}"
				}
			],
			"correction": {
				"steps": [
					"**Remplacer.** On remplace $x$ par sa valeur, puis on calcule en respectant les priorités : d'abord les puissances, puis les multiplications, enfin les additions et les soustractions.",
					"$x^3 = x \\times x \\times x$.",
					"$$A = \\textcolor{{{color:primary.1}}}{{{x}}^3} + {{b}} = {{x}} \\times {{x}} \\times {{x}} + {{b}} = {{eval:x*x*x}} + {{b}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		}

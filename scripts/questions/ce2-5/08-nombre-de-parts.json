					"name": "n",
					"expression": "6|8|9|12"
				},
				{
					"name": "q",
					"expression": "10..80"
				},
				{
					"name": "r",
					"expression": "1..{{eval:n-1}}"
				}
			],
			"conditions": ["n * q + r <= 1000"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:q}}"
				}
			],
			"correction": {
				"steps": [
					"On remplit des boîtes de ${{n}}$ œufs : ${{q}}$ boîtes, c'est ${{eval:n*q}}$ œufs.",
					"$${{q}} \\times {{n}} = {{eval:n*q}}$$",
					"Il reste ${{eval:n*q+r}} - {{eval:n*q}} = {{r}}$ {{if:r==1|œuf|œufs}} : pas assez pour remplir une boîte de plus.",
					"Il va vendre $\\textcolor{{{color:primary.0}}}{{{q}}}$ boîtes."
				]
			}
		}

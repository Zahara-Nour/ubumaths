				{
					"expectedAnswer": "{{eval:g}}"
				}
			],
			"correction": {
				"steps": [
					"On cherche combien de fois il y a ${{n}}$ élèves dans ${{eval:g*n}}$ élèves : chaque groupe de ${{n}}$ est une équipe.",
					"$$\\textcolor{{{color:primary.0}}}{{{g}}} \\times {{n}} = {{eval:g*n}}$$",
					"Il y aura ${{g}}$ équipes."
				]
			}
		},
		{
			"statement": "Je veux ranger mes ${{eval:p*q+r}}$ photos dans un album. Je peux ranger ${{p}}$ photos par page.\n\nCombien de pages me faut-il pour ranger **toutes** mes photos ?\n\nIl me faut $?$ pages.",
			"variables": [
				{
					"name": "p",
					"expression": "4|6|8|10"
				},
				{
					"name": "q",
					"expression": "10..100"
				},
				{
					"name": "r",
					"expression": "1..{{eval:p-1}}"
				}
			],
			"conditions": ["p * q + r <= 1000"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:q+1}}"
				}
			],
			"correction": {
				"steps": [
					"${{eval:p*q+r}}$ photos par ${{p}}$ : ${{q}}$ pages pleines de ${{p}}$ photos, et il reste ${{r}}$ {{if:r==1|photo|photos}}.",
					"Le reste doit aussi être rangé : il faut une page de plus.",
					"$${{q}} + 1 = \\textcolor{{{color:primary.0}}}{{{eval:q+1}}}$$",
					"Il me faut ${{eval:q+1}}$ pages."
				]
			}
		},
		{
			"statement": "Un fermier a ${{eval:n*q+r}}$ œufs à vendre au marché. Il les vend par boîtes de ${{n}}$ œufs.\n\nCombien de boîtes pleines va-t-il pouvoir vendre ?\n\nIl va vendre $?$ boîtes.",
			"variables": [

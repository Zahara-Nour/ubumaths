	"title": "Lire un nombre sur une demi-droite graduée",
	"description": "Pas de 1 à 100 000, à déduire de deux graduations écrites ; nombres jusqu'à 999 999",
	"grades": ["CM1"],
	"level": 4,
	"delay": 45,

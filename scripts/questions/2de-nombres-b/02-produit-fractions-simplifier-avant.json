			"conditions": ["p!=q", "gcd(a,b)==1", "gcd(c,d)==1", "gcd(u*v,t*w)==1", "t*w>1"],
			"blanks": [
				{
					"expectedAnswer": "-\\frac{ {{N}} }{ {{D}} }"

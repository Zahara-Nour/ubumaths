				{
					"expectedAnswer": "\\frac{ {{N}} }{ {{D}} }"
				}
			],
			"correction": {
				"steps": [
					"On multiplie l'entier par le numérateur seulement, mais on simplifie avant de calculer :",
					"$${{n}}\\times\\dfrac{ {{a}} }{ {{b}} }=\\dfrac{ {{n}}\\times{{a}} }{ {{b}} }=\\dfrac{ {{q}}\\times{{u}}\\times{{a}} }{ {{q}}\\times{{t}} }$$",
					"On simplifie par ${{q}}$ :",
					"$${{n}}\\times\\dfrac{ {{a}} }{ {{b}} }=\\dfrac{ {{u}}\\times{{a}} }{ {{t}} }=\\textcolor{{{color:primary.0}}}{\\dfrac{ {{N}} }{ {{D}} }}$$"
				]
			}
		}

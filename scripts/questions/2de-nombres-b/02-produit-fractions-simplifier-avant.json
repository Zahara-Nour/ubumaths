			"conditions": ["gcd(a,b)==1", "gcd(u*a,t)==1"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{ {{N}} }{ {{D}} }",
					"expectedErrors": [
						{
							"answer": "\\frac{ {{eval:n*a}} }{ {{eval:n*b}} }",
							"message": "Tu as multiplié aussi le dénominateur par l'entier : l'entier ne multiplie que le numérateur.",
							"label": "Entier multiplié en haut et en bas"
						},
						{
							"answer": "\\frac{ {{a}} }{ {{eval:n*b}} }",
							"message": "Tu as multiplié le dénominateur par l'entier : c'est le numérateur qu'il faut multiplier.",
							"label": "Entier multiplié au dénominateur"
						},
						{
							"answer": "\\frac{ {{eval:n*b+a}} }{ {{b}} }",
							"message": "Tu as additionné l'entier et la fraction au lieu de les multiplier.",
							"label": "Addition au lieu de multiplication"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"On multiplie l'entier par le numérateur seulement, mais on simplifie avant de calculer :",
					"$${{n}}\\times\\dfrac{ {{a}} }{ {{b}} }=\\dfrac{ {{n}}\\times{{a}} }{ {{b}} }=\\dfrac{ {{q}}\\times{{u}}\\times{{a}} }{ {{q}}\\times{{t}} }$$",
					"On simplifie par ${{q}}$ :",
					"$${{n}}\\times\\dfrac{ {{a}} }{ {{b}} }=\\dfrac{ {{u}}\\times{{a}} }{ {{t}} }=\\textcolor{{{color:primary.0}}}{\\dfrac{ {{N}} }{ {{D}} }}$$"
				]
			},
			"hint": "L'entier ne multiplie que le numérateur. Avant de calculer, cherche un facteur commun à ${{n}}$ et à ${{b}}$."
		}
	],

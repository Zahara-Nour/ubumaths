			"blanks": [
				{
					"expectedAnswer": "-\\frac{ {{N}} }{ {{D}} }",
					"expectedErrors": [
						{
							"answer": "\\frac{ {{N}} }{ {{D}} }",
							"message": "Ton résultat a le mauvais signe : un seul des deux facteurs est négatif.",
							"label": "Signe moins oublié"
						},
						{
							"answer": "-\\frac{ {{eval:a*d}} }{ {{eval:b*c}} }",
							"message": "Tu as multiplié en croix : pour un produit, on multiplie les numérateurs entre eux et les dénominateurs entre eux.",
							"label": "Produit en croix"
						},
						{
							"answer": "\\frac{ {{eval:a*d-b*c}} }{ {{eval:b*d}} }",
							"message": "Tu as soustrait les deux fractions au lieu de les multiplier.",
							"label": "Soustraction au lieu de multiplication"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"On ne multiplie pas tout de suite : on décompose pour repérer les facteurs communs.",
					"$$\\dfrac{ {{a}} }{ {{b}} }\\times\\left(-\\dfrac{ {{c}} }{ {{d}} }\\right)=-\\dfrac{ {{p}}{{if:u>1|\\times{{u}}}}\\times{{q}}{{if:v>1|\\times{{v}}}} }{ {{q}}{{if:t>1|\\times{{t}}}}\\times{{p}}{{if:w>1|\\times{{w}}}} }$$",
					"On simplifie par ${{p}}$ et par ${{q}}$ (un seul signe moins : le produit est négatif) :",
					"$$\\dfrac{ {{a}} }{ {{b}} }\\times\\left(-\\dfrac{ {{c}} }{ {{d}} }\\right)=-\\dfrac{ {{if:u==1|{{v}}|{{if:v==1|{{u}}|{{u}}\\times{{v}}}}}} }{ {{if:t==1|{{w}}|{{if:w==1|{{t}}|{{t}}\\times{{w}}}}}} }=\\textcolor{{{color:primary.0}}}{-\\dfrac{ {{N}} }{ {{D}} }}$$"
				]
			},
			"hint": "Ne multiplie pas tout de suite : décompose ${{a}}$, ${{b}}$, ${{c}}$ et ${{d}}$ pour repérer les facteurs communs. Compte aussi les signes moins."

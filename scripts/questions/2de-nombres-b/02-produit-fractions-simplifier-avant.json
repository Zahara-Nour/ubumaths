{
	"id": "3e4a8f6c-55fe-49d1-bf7d-0ae352e1451a",
	"title": "Produit de fractions, en simplifiant avant",
	"description": "Calculer un produit de fractions en simplifiant avant de multiplier (14/15 × 3/7 = 2/5), avec un facteur négatif, puis entier × fraction (pièges : multiplier aussi le dénominateur par l'entier, ne pas simplifier)",
	"grades": ["2"],
	"level": 3,
	"delay": 90,
	"status": "draft",
	"variations": [
		{
			"statement": "Donne le résultat sous la forme d'une fraction irréductible.\n\n$\\dfrac{ {{a}} }{ {{b}} }\\times\\dfrac{ {{c}} }{ {{d}} }=?$",
			"variables": [
				{
					"name": "p",
					"expression": "3|5|7"
				},
				{
					"name": "q",
					"expression": "3|5|7"
				},
				{
					"name": "u",
					"expression": "1|2|4"
				},
				{
					"name": "v",
					"expression": "1|2|4"
				},
				{
					"name": "t",
					"expression": "1|3|5|7"
				},
				{
					"name": "w",
					"expression": "1|3|5|7"
				},
				{
					"name": "a",
					"expression": "eval:p*u"
				},
				{
					"name": "b",
					"expression": "eval:q*t"
				},
				{
					"name": "c",
					"expression": "eval:q*v"
				},
				{
					"name": "d",
					"expression": "eval:p*w"
				},
				{
					"name": "N",
					"expression": "eval:u*v"
				},
				{
					"name": "D",
					"expression": "eval:t*w"
				}
			],
			"conditions": ["p!=q", "gcd(a,b)==1", "gcd(c,d)==1", "gcd(u*v,t*w)==1", "t*w>1"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{ {{N}} }{ {{D}} }",
					"expectedErrors": [
						{
							"answer": "\\frac{ {{eval:a*d}} }{ {{eval:b*c}} }",
							"message": "Tu as multiplié en croix : pour un produit, on multiplie les numérateurs entre eux et les dénominateurs entre eux.",
							"label": "Produit en croix"
						},
						{
							"answer": "\\frac{ {{eval:a*d+b*c}} }{ {{eval:b*d}} }",
							"message": "Tu as additionné les deux fractions au lieu de les multiplier.",
							"label": "Addition au lieu de multiplication"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"On ne multiplie pas tout de suite : on décompose pour repérer les facteurs communs.",
					"$$\\dfrac{ {{a}} }{ {{b}} }\\times\\dfrac{ {{c}} }{ {{d}} }=\\dfrac{ {{p}}{{if:u>1|\\times{{u}}}}\\times{{q}}{{if:v>1|\\times{{v}}}} }{ {{q}}{{if:t>1|\\times{{t}}}}\\times{{p}}{{if:w>1|\\times{{w}}}} }$$",
					"On simplifie par ${{p}}$ et par ${{q}}$ :",
					"$$\\dfrac{ {{a}} }{ {{b}} }\\times\\dfrac{ {{c}} }{ {{d}} }=\\dfrac{ {{if:u==1|{{v}}|{{if:v==1|{{u}}|{{u}}\\times{{v}}}}}} }{ {{if:t==1|{{w}}|{{if:w==1|{{t}}|{{t}}\\times{{w}}}}}} }=\\textcolor{{{color:primary.0}}}{\\dfrac{ {{N}} }{ {{D}} }}$$"
				]
			},
			"hint": "Ne multiplie pas tout de suite : décompose ${{a}}$, ${{b}}$, ${{c}}$ et ${{d}}$ en produits pour repérer les facteurs communs, puis simplifie."
		},
		{
			"statement": "Donne le résultat sous la forme d'une fraction irréductible.\n\n$\\dfrac{ {{a}} }{ {{b}} }\\times\\left(-\\dfrac{ {{c}} }{ {{d}} }\\right)=?$",

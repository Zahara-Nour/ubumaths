	"title": "Convertir des aires",
	"description": "Convertir entre m² et dm², ou entre dm² et cm² (× 100 ou : 100), un nombre entier ou décimal",
	"grades": ["CM2"],
	"level": 1,
	"delay": 90,
	"status": "draft",
	"options": {
		"constraints": {
			"spacesFromFourDigits": true,
			"zeros": "off"
		}
	},
	"variations": [
		{
			"statement": "Convertis.\n\n$${{a}}~\\unit{{{if:j==1|m^2|dm^2}}} = ?~\\unit{{{if:j==1|dm^2|cm^2}}}$$",
			"variables": [
				{
					"name": "j",
					"expression": "1..2"
				},
				{
					"name": "a",
					"expression": "2..99"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*100}}"
				}
			],
			"correction": {
				"steps": [
					"$1~\\unit{{{if:j==1|m^2|dm^2}}} = 100~\\unit{{{if:j==1|dm^2|cm^2}}}$ : un carré de $1~\\unit{{{if:j==1|m|dm}}}$ de côté contient $10$ rangées de $10$ carrés de $1~\\unit{{{if:j==1|dm|cm}}}$ de côté. Vers l'unité plus petite, on **multiplie par $100$**.",
					"$${{a}} \\times 100 = \\textcolor{{{color:primary.0}}}{{{eval:a*100}}}$$",
					"${{a}}~\\unit{{{if:j==1|m^2|dm^2}}} = \\textcolor{{{color:primary.0}}}{{{eval:a*100}}}~\\unit{{{if:j==1|dm^2|cm^2}}}$."
				]
			}
		},
		{
			"statement": "Convertis.\n\n$${{eval:a}}~\\unit{{{if:j==1|dm^2|cm^2}}} = ?~\\unit{{{if:j==1|m^2|dm^2}}}$$",
			"variables": [
				{
					"name": "j",
					"expression": "1..2"
				},
				{
					"name": "a",
					"expression": "120..9999"
				}
			],
			"conditions": ["mod(a,10) != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a/100;d}}",
					"requiredForm": {
						"pattern": "a:number"
					}
				}
			],
			"correction": {
				"steps": [
					"$1~\\unit{{{if:j==1|m^2|dm^2}}} = 100~\\unit{{{if:j==1|dm^2|cm^2}}}$ : un carré de $1~\\unit{{{if:j==1|m|dm}}}$ de côté contient $10$ rangées de $10$ carrés de $1~\\unit{{{if:j==1|dm|cm}}}$ de côté. Vers l'unité plus grande, on **divise par $100$**.",
					"$${{eval:a}} \\div 100 = \\textcolor{{{color:primary.0}}}{{{eval:a/100;d}}}$$",
					"${{eval:a}}~\\unit{{{if:j==1|dm^2|cm^2}}} = \\textcolor{{{color:primary.0}}}{{{eval:a/100;d}}}~\\unit{{{if:j==1|m^2|dm^2}}}$."
				]
			}
		},
		{
			"statement": "Convertis.\n\n$${{eval:d/10;d}}~\\unit{{{if:j==1|m^2|dm^2}}} = ?~\\unit{{{if:j==1|dm^2|cm^2}}}$$",
			"variables": [
				{
					"name": "j",
					"expression": "1..2"
				},
				{
					"name": "d",
					"expression": "11..99"
				}
			],
			"conditions": ["mod(d,10) != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:d*10}}"
				}
			],
			"correction": {
				"steps": [
					"$1~\\unit{{{if:j==1|m^2|dm^2}}} = 100~\\unit{{{if:j==1|dm^2|cm^2}}}$ : un carré de $1~\\unit{{{if:j==1|m|dm}}}$ de côté contient $10$ rangées de $10$ carrés de $1~\\unit{{{if:j==1|dm|cm}}}$ de côté. Vers l'unité plus petite, on **multiplie par $100$**.",
					"$${{eval:d/10;d}} \\times 100 = \\textcolor{{{color:primary.0}}}{{{eval:d*10}}}$$",
					"${{eval:d/10;d}}~\\unit{{{if:j==1|m^2|dm^2}}} = \\textcolor{{{color:primary.0}}}{{{eval:d*10}}}~\\unit{{{if:j==1|dm^2|cm^2}}}$."
				]
			}
		}

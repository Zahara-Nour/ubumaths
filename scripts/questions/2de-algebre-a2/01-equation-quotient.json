			},
			"answers": ["\\{\\frac{4}{3}\\}"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "(x − 4)/(x + 1) = −2 : x ≠ −1, S = {2/3}",
			"variationIndex": 1,
			"variables": {
				"p": "-4",
				"q": "1",
				"k": "-2"
			},
			"answers": ["-1", "\\{\\frac{2}{3}\\}"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : valeur interdite de signe opposé",
			"variationIndex": 1,
			"variables": {
				"p": "-4",
				"q": "1",
				"k": "-2"
			},
			"answers": ["1", "\\{\\frac{2}{3}\\}"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "(2x + 6)/(x + 3) = 3 : x ≠ −3, S = ∅",
			"variationIndex": 2,
			"variables": {
				"a": "2",
				"q": "3",
				"k": "3"
			},
			"answers": ["-3", "\\varnothing"],
			"expected": {
				"status": "correct"
			}
		},
		{

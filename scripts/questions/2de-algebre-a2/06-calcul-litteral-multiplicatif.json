{
	"title": "Calcul littéral multiplicatif",
	"description": "1/(a/b) = b/a ; (a/b)/(c/d) = ad/(bc) ; ax/b = (a/b) × x ; a/(−1) = −a",
	"grades": ["2"],
	"theme": "Calcul littéral",
	"domain": "Transformation",
	"subdomain": "Simplification d'écriture",
	"level": 5,
	"delay": 45,
	"status": "draft",
	"shared": {
		"cleanCoefficients": true
	},
	"variations": [
		{
			"statement": "Écris sous la forme d'une fraction : $\\dfrac{1}{\\dfrac{ {{a}} }{ {{b}} }}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				},
				{
					"name": "b",
					"expression": "2..9!a"
				}
			],
			"conditions": ["gcd(a,b) == 1"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{ {{b}} }{ {{a}} }"
				}
			],
			"correction": {
				"steps": [
					"$$\\dfrac{1}{\\dfrac{a}{b}}=\\dfrac{b}{a}$$",
					"$$\\dfrac{1}{\\dfrac{ {{a}} }{ {{b}} }}=\\textcolor{{{color:primary.0}}}{\\dfrac{ {{b}} }{ {{a}} }}$$"
				]
			}
		},
		{
			"statement": "Écris sous la forme d'une fraction irréductible : $\\dfrac{\\dfrac{ {{a}} }{ {{b}} }}{\\dfrac{ {{c}} }{ {{d}} }}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "b",
					"expression": "2..9"
				},
				{
					"name": "c",
					"expression": "1..9"
				},
				{
					"name": "d",
					"expression": "2..9"
				}
			],
			"conditions": ["gcd(a,b) == 1", "gcd(c,d) == 1", "(a)*(d) != (b)*(c)"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:((a)*(d))/((b)*(c))}}"
				}
			],
			"correction": {
				"steps": [
					"Diviser par une fraction, c'est multiplier par son inverse : $\\dfrac{\\dfrac{a}{b}}{\\dfrac{c}{d}}=\\dfrac{a}{b}\\times\\dfrac{d}{c}=\\dfrac{ad}{bc}$.",
					"$$\\dfrac{ {{a}} }{ {{b}} }\\times\\dfrac{ {{d}} }{ {{c}} }=\\dfrac{ {{eval:(a)*(d)}} }{ {{eval:(b)*(c)}} }=\\textcolor{{{color:primary.0}}}{{{eval:((a)*(d))/((b)*(c))}}}$$"
				]
			}
		},
		{
			"statement": "Complète : $\\dfrac{ {{a}}x}{ {{b}} }=?\\times x$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				},
				{
					"name": "b",
					"expression": "2..9!a"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(a)/(b)}}"
				}
			],
			"correction": {
				"steps": [
					"$$\\dfrac{ab}{c}=\\dfrac{a}{c}\\times b$$",
					"$$\\dfrac{ {{a}}x}{ {{b}} }=\\textcolor{{{color:primary.0}}}{{{eval:(a)/(b)}}}\\times x$$"
				]
			}
		},
		{
			"statement": "Simplifie : $\\dfrac{ {{a}}x}{-1}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "-{{a}}x"
				}
			],
			"correction": {
				"steps": [
					"Diviser par $-1$, c'est multiplier par $-1$ : $\\dfrac{a}{-1}=(-1)\\times a=-a$.",
					"$$\\dfrac{ {{a}}x}{-1}=\\textcolor{{{color:primary.0}}}{-{{a}}x}$$"
				]
			}
		}
	],

					"expectedAnswer": "{{eval:n*(n-1)/2}}"
				}
			],
			"correction": {
				"steps": [
					"Dans le graphe complet, chacun des ${{n}}$ sommets est de degré ${{eval:n-1}}$ : somme des degrés ${{n}} \\times {{eval:n-1}} = {{eval:n*(n-1)}}$.",
					"Chaque arête est comptée deux fois : $\\dfrac{ {{eval:n*(n-1)}} }{2} = \\textcolor{{{color:primary.0}}}{{{eval:n*(n-1)/2}}}$ arêtes."
				]
			}
		},
		{
			"statement": "Dans un tournoi, chacune des ${{n}}$ équipes rencontre une fois chacune des autres. Combien de matchs sont joués ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "5..20"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n*(n-1)/2}}"
				}
			],
			"correction": {
				"steps": [
					"On modélise par le graphe complet d'ordre ${{n}}$ : un sommet par équipe, une arête par match.",
					"Nombre d'arêtes : $\\dfrac{ {{n}} \\times {{eval:n-1}} }{2} = \\textcolor{{{color:primary.0}}}{{{eval:n*(n-1)/2}}}$."
				]
			}
		},
		{
			"statement": "Un graphe a ${{n}}$ sommets, tous de degré ${{k}}$. Combien a-t-il d'arêtes ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "6..14"
				},
				{
					"name": "k",
					"expression": "2..5"
				}
			],
			"conditions": ["mod(n*k,2) == 0", "k < n"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n*k/2}}"
				}
			],
			"correction": {
				"steps": [
					"Somme des degrés : ${{n}} \\times {{k}} = {{eval:n*k}}$, égale au double du nombre d'arêtes.",
					"Nombre d'arêtes : $\\textcolor{{{color:primary.0}}}{{{eval:n*k/2}}}$."
				]
			}
		},
		{
			"statement": "Quel est le degré de chaque sommet du graphe complet d'ordre ${{n}}$ ?\n\n$?$",
			"variables": [
				{
					"name": "n",
					"expression": "4..15"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n-1}}"
				}
			],
			"correction": {
				"steps": [
					"Chaque sommet est adjacent à tous les **autres** : degré $\\textcolor{{{color:primary.0}}}{{{eval:n-1}}}$."
				]
			}
		}
	],

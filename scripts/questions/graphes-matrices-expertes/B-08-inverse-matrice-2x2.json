{
	"title": "Inverse d'une matrice carrée d'ordre 2",
	"description": "Calculer le déterminant ad − bc et l'inverse d'une matrice 2 × 2, à coefficients entiers ou fractionnaires (pièges : signes de b et c non changés, a et d non échangés, oubli de diviser par ad − bc)",
	"grades": ["T_EXP"],
	"points": ["TEXP-125", "TEXP-133"],
	"theme": "Graphes et matrices",
	"domain": "Matrices",
	"subdomain": "Calcul matriciel",
	"level": 2,
	"status": "draft",
	"delay": 60,
	"variations": [
		{
			"statement": "$A = \\begin{pmatrix}{{a1}}&{{a2}}\\\\{{a3}}&{{a4}}\\end{pmatrix}$ est inversible.\n\nOn note $A^{-1} = \\begin{pmatrix} c_{11} & c_{12} \\\\ c_{21} & c_{22} \\end{pmatrix}$.\n\n$c_{11}=?$\n\n$c_{12}=?$\n\n$c_{21}=?$\n\n$c_{22}=?$",
			"variables": [
				{
					"name": "a1",
					"expression": "1..5"
				},
				{
					"name": "a2",
					"expression": "-4..4"
				},
				{
					"name": "a3",
					"expression": "-4..4"
				},
				{
					"name": "a4",
					"expression": "eval:(1+a2*a3)/a1"
				}
			],
			"conditions": ["mod(1+a2*a3,a1) == 0", "a2 != 0", "a3 != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a4}}"
				},
				{
					"expectedAnswer": "{{eval:-a2}}"
				},
				{
					"expectedAnswer": "{{eval:-a3}}"
				},
				{
					"expectedAnswer": "{{eval:a1}}"
				}
			],
			"correction": {
				"steps": [
					"$ad - bc = {{a1}} \\times {{a4;()}} - {{a2;()}} \\times {{a3;()}} = 1$.",
					"$A^{-1} = \\dfrac{1}{ad - bc}\\begin{pmatrix} d & -b \\\\ -c & a \\end{pmatrix} = \\begin{pmatrix}\\textcolor{{{color:primary.0}}}{{{eval:a4}}}&\\textcolor{{{color:primary.0}}}{{{eval:-a2}}}\\\\\\textcolor{{{color:primary.0}}}{{{eval:-a3}}}&\\textcolor{{{color:primary.0}}}{{{eval:a1}}}\\end{pmatrix}$.",
					"Vérification : $AA^{-1} = I_2$."
				]
			}
		},
		{
			"statement": "$A = \\begin{pmatrix}{{a1}}&{{a2}}\\\\{{a3}}&{{a4}}\\end{pmatrix}$ est inversible.\n\nOn note $A^{-1} = \\begin{pmatrix} c_{11} & c_{12} \\\\ c_{21} & c_{22} \\end{pmatrix}$.\n\n$c_{11}=?$\n\n$c_{12}=?$\n\n$c_{21}=?$\n\n$c_{22}=?$\n\n(valeurs exactes, fractions irréductibles)",
			"variables": [
				{
					"name": "a1",
					"expression": "-3..5"
				},
				{
					"name": "a2",
					"expression": "-4..4"
				},
				{
					"name": "a3",
					"expression": "-4..4"
				},
				{
					"name": "a4",
					"expression": "-3..5"
				},
				{
					"name": "dt",
					"expression": "eval:a1*a4-a2*a3"
				}
			],
			"conditions": ["abs(dt) >= 2", "abs(dt) <= 9", "a2 != 0", "a3 != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a4/dt}}"
				},
				{
					"expectedAnswer": "{{eval:-a2/dt}}"
				},
				{
					"expectedAnswer": "{{eval:-a3/dt}}"
				},
				{
					"expectedAnswer": "{{eval:a1/dt}}"
				}
			],
			"correction": {
				"steps": [
					"$ad - bc = {{a1}} \\times {{a4;()}} - {{a2;()}} \\times {{a3;()}} = {{dt}}$.",
					"$A^{-1} = \\dfrac{1}{ {{dt}} }\\begin{pmatrix} {{a4}} & {{eval:-a2}} \\\\ {{eval:-a3}} & {{a1}} \\end{pmatrix} = \\begin{pmatrix}\\textcolor{{{color:primary.0}}}{{{eval:a4/dt}}}&\\textcolor{{{color:primary.0}}}{{{eval:-a2/dt}}}\\\\\\textcolor{{{color:primary.0}}}{{{eval:-a3/dt}}}&\\textcolor{{{color:primary.0}}}{{{eval:a1/dt}}}\\end{pmatrix}$."
				]
			}
		},
		{
			"statement": "$A = \\begin{pmatrix}a&b\\\\c&d\\end{pmatrix} = \\begin{pmatrix}{{a1}}&{{a2}}\\\\{{a3}}&{{a4}}\\end{pmatrix}$. Calcule le nombre $ad - bc$ (la matrice est inversible si et seulement s'il est non nul).\n\n$ad-bc=?$",
			"variables": [
				{
					"name": "a1",
					"expression": "-3..5"
				},
				{
					"name": "a2",
					"expression": "-4..4"
				},
				{
					"name": "a3",
					"expression": "-4..4"
				},
				{
					"name": "a4",
					"expression": "-3..5"
				},
				{
					"name": "dt",
					"expression": "eval:a1*a4-a2*a3"
				}
			],
			"conditions": ["a2 != 0", "a3 != 0", "a2*a3 != a1*a4 or mod(a1+a2,2) == 0"],
			"blanks": [
				{
					"expectedAnswer": "{{dt}}"
				}
			],
			"correction": {
				"steps": [
					"$ad - bc = {{a1}} \\times {{a4;()}} - {{a2;()}} \\times {{a3;()}} = \\textcolor{{{color:primary.0}}}{{{dt}}}${{if:dt==0| : $A$ n'est pas inversible.| : $A$ est inversible.}}"
				]
			}
		}
	],

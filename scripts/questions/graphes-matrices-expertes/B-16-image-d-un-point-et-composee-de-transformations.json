		},
		{
			"description": "v1 : π/2, sens inverse (5 ; −3)",
			"variationIndex": 1,
			"variables": { "m": "1", "co": "0", "si": "1", "x": "3", "y": "5" },
			"answers": ["(5;-3)"],

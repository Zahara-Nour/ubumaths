		},
		{
			"description": "v1 : π, M(3 ; −5) → (−3 ; 5)",
			"variationIndex": 1,
			"variables": { "m": "2", "co": "-1", "si": "0", "x": "3", "y": "-5" },
			"answers": ["(-3;5)"],
			"expected": { "status": "correct" }
		},
		{
			"description": "v1 : −π/2, M(3 ; 5) → (5 ; −3)",
			"variationIndex": 1,
			"variables": { "m": "3", "co": "0", "si": "-1", "x": "3", "y": "5" },
			"answers": ["(5;-3)"],
			"expected": { "status": "correct" }
		},
		{
			"description": "v2 : s (Ox) puis r → RS = (0 1 ; 1 0)",
			"variationIndex": 2,
			"variables": { "t": "1", "o": "1", "s1": "1", "s2": "0", "s3": "0", "s4": "-1" },
			"answers": ["\\begin{pmatrix}0&1\\\\1&0\\end{pmatrix}"],
			"expected": { "status": "correct" }
		},
		{
			"description": "v2 : s (Ox) puis r, ordre inversé SR",
			"variationIndex": 2,
			"variables": { "t": "1", "o": "1", "s1": "1", "s2": "0", "s3": "0", "s4": "-1" },
			"answers": ["\\begin{pmatrix}0&-1\\\\-1&0\\end{pmatrix}"],

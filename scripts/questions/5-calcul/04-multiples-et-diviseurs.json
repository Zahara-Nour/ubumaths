				{
					"name": "x",
					"expression": "2..10"
				},
				{
					"name": "y",
					"expression": "2..10"
				},
				{
					"name": "z",
					"expression": "2..10"
				}
			],
			"conditions": ["N<=100", "mod(N,x)!=0", "mod(N,y)!=0", "mod(N,z)!=0", "x!=y", "y!=z", "x!=z"],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"**Diviseur.** Un diviseur de ${{N}}$ est un nombre qui divise ${{N}}$ : la division tombe juste.",
					"${{N}} = {{d}} \\times {{q}}$ : $\\textcolor{{{color:primary.0}}}{{{d}}}$ est un diviseur de ${{N}}$.",
					"Les autres ne le sont pas : ${{N}}$ n'est dans la table ni de ${{x}}$, ni de ${{y}}$, ni de ${{z}}$."
				]
			}
		},
		{
			"statement": "${{d}}$ divise-t-il ${{n}}$ ?\n\n```choix\nmelanger: non\n- Oui\n- Non\n```",
			"variables": [

					"expression": "10..30"
				},
				{
					"name": "b",
					"expression": "1..9"
				},
				{
					"name": "c",
					"expression": "1..9"
				}
			],
			"conditions": ["a>b+c"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a-b-c}}"
				}
			],
			"correction": {
				"steps": [
					"**Priorité.** On calcule d'abord **entre les parenthèses**.",
					"$${{a}} - \\textcolor{{{color:primary.1}}}{({{b}} + {{c}})} = {{a}} - \\textcolor{{{color:primary.1}}}{{{eval:b+c}}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		}

				},
				{
					"name": "y",
					"expression": "eval:Y/10;d"
				}
			],
			"conditions": ["mod(X,10)!=0", "mod(Y,10)!=0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(X+c*Y)/10;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Priorité.** La multiplication se calcule **avant** l'addition et la soustraction.",
					"$${{x}} + \\textcolor{{{color:primary.1}}}{{{c}} \\times {{y}}} = {{x}} + \\textcolor{{{color:primary.1}}}{{{eval:c*Y/10;d}}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		},
		{
			"statement": "Calcule.\n\n$${{a}} - ({{y}} + {{z}}) = ?$$",
			"variables": [
				{

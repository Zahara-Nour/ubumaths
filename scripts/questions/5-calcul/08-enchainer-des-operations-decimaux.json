					"name": "y",
					"expression": "eval:Y/10;d"
				},
				{
					"name": "z",
					"expression": "eval:Z/10;d"
				}
			],
			"conditions": ["mod(Y,10)!=0", "mod(Z,10)!=0", "10*a>Y+Z"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(10*a-Y-Z)/10;d}}"
				}
			],
			"correction": {
				"steps": [
					"**Priorité.** On calcule d'abord **entre les parenthèses**.",
					"$${{a}} - \\textcolor{{{color:primary.1}}}{({{y}} + {{z}})} = {{a}} - \\textcolor{{{color:primary.1}}}{{{eval:(Y+Z)/10;d}}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			}
		}

	"variations": [
		{
			"statement": "Résous dans $\\mathbb{R}$ l'équation ${{eval:(a)*x+(b)}}=0$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "2..9;±"
				},
				{
					"name": "k",
					"expression": "1..9;±"
				},
				{
					"name": "b",
					"expression": "eval:-(a)*(k)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\{ {{eval:-(b)/(a)}} \\}"
				}
			],
			"correction": {
				"steps": [
					"On isole $x$ : on {{if:b>0|soustrait ${{b}}$|ajoute ${{eval:-(b)}}$}} aux deux membres, puis on divise par ${{a}}$, qui n'est pas nul.",
					"$${{eval:(a)*x+(b)}}=0\\iff {{eval:(a)*x}}={{eval:-(b)}}\\iff x=\\frac{ {{eval:-(b)}} }{ {{a}} }\\iff x={{eval:-(b)/(a)}}$$",
					"$S=\\textcolor{{{color:primary.0}}}{\\{ {{eval:-(b)/(a)}} \\}}$."
				]
			}
		},
		{
			"statement": "Résous dans $\\mathbb{R}$ l'équation ${{eval:(a)*x+(b)}}=0$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [

					"expectedErrors": [
						{
							"answer": "{{eval:round(10*(a)*(q)^(dd-1))/10;d}}",
							"message": "Tu as multiplié une fois de trop ou de moins : de $u_{ {{p}} }$ à $u_{ {{r}} }$, la puissance de $q$ est ${{dd}}$.",
							"label": "Exposant décalé d'un rang"
						},
						{
							"answer": "{{eval:round(10*((a)*(q))^(dd))/10;d}}",
							"message": "Seule la raison est élevée à la puissance : ${{a}}\\times q^{ {{dd}} }$, pas $({{a}}\\times q)^{ {{dd}} }$.",
							"label": "Puissance du produit"
						},
						{
							"answer": "{{eval:round(10*(a)*(q)*(dd))/10;d}}",
							"message": "On multiplie ${{dd}}$ fois par $q$ : c'est une puissance, pas un produit par ${{dd}}$.",
							"label": "Produit au lieu de puissance"
						}
					]
				}
			],
			"statement": "$(u_n)$ est une suite géométrique de raison ${{q}}$, et $u_{ {{p}} }={{a}}$.\n\nCalcule $u_{ {{r}} }$, arrondi au dixième.\n\n$u_{ {{r}} }\\approx ?$",
			"variables": [
				{
					"name": "kq",
					"expression": "8..29!10,20"
				},
				{
					"name": "sg",
					"expression": "1|-1"
				},
				{
					"name": "q",
					"expression": "eval:sg*kq/10;d"
				},
				{
					"name": "p",
					"expression": "1..9"
				},
				{
					"name": "dd",
					"expression": "8..11"
				},
				{
					"name": "r",
					"expression": "eval:p+dd"
				},
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "v",
					"expression": "eval:a*(q)^dd;d"
				}
			],
			"conditions": [
				"abs(10*(v)-floor(10*(v))-0.5) > 0.05",
				"mod(round(10*abs(v)),10) != 0",
				"abs(v) < 10000",
				"abs(v) > 1"
			],
			"correction": {
				"steps": [
					"De $u_{ {{p}} }$ à $u_{ {{r}} }$, on avance de ${{r}}-{{p}}={{dd}}$ rangs : on multiplie ${{dd}}$ fois par la raison $\\textcolor{{{color:primary.0}}}{{{q}}}$.",
					"$u_{ {{r}} }=u_{ {{p}} }\\times q^{ {{dd}} }={{a}}\\times\\textcolor{{{color:primary.0}}}{\\left({{q}}\\right)}^{ {{dd}} }\\approx{{eval:round(1000*(v))/1000;d}}$, soit $u_{ {{r}} }\\approx{{eval:round(10*(v))/10;d}}$ au dixième."
				]
			},
			"hint": "Combien de fois multiplie-t-on par la raison pour passer de $u_{ {{p}} }$ à $u_{ {{r}} }$ ? Utilise la touche puissance de la calculatrice."
		}

{
	"title": "La part qui reste",
	"description": "Lucie colorie 3/10 d'une figure en bleu et le reste en rouge : quelle fraction est rouge ?",
	"grades": ["CE1"],
	"theme": "Fractions",
	"domain": "Calculer",
	"subdomain": "Addition et Soustraction",
	"level": 17,
	"delay": 60,
	"status": "draft",
	"options": {
		"constraints": {
			"reducedFractions": "off"
		}
	},
	"variations": [
		{
			"statement": "Lucie a colorié {{if:a==1|le|les}} $\\frac{{{a}}}{{{d}}}$ d'une figure en bleu et le reste en rouge.\n\nQuelle fraction de la figure est coloriée en rouge ?\n\n$$?$$",
			"variables": [
				{
					"name": "d",
					"expression": "3|4|5|6|8|10"
				},
				{
					"name": "a",
					"expression": "1..{{eval:d-1}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{{{eval:d-a}}}{{{d}}}"
				}
			],
			"correction": {
				"steps": [
					"La figure entière, c'est le tout : la partie rouge est ce qui manque à la partie bleue pour faire le tout.",
					"Le tout, c'est ${{d}}$ {{if:d==3|tiers|{{if:d==4|quarts|{{if:d==5|cinquièmes|{{if:d==6|sixièmes|{{if:d==8|huitièmes|dixièmes}}}}}}}}}} : $1 = \\frac{{{d}}}{{{d}}}$.",
					"$$1 - \\frac{{{a}}}{{{d}}} = \\frac{{{d}}}{{{d}}} - \\frac{{{a}}}{{{d}}} = \\textcolor{{{color:primary.0}}}{\\frac{{{eval:d-a}}}{{{d}}}}$$"
				]
			}
		}
	],
	"testSpecs": [
		{
			"description": "BO : Lucie, 3/10 bleu, 7/10 rouge",
			"variationIndex": 0,
			"variables": {
				"d": "10",
				"a": "3"
			},
			"answers": ["\\frac{7}{10}"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : Lucie, la partie bleue (3/10)",
			"variationIndex": 0,
			"variables": {
				"d": "10",
				"a": "3"
			},
			"answers": ["\\frac{3}{10}"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "Erreur : Lucie, 7 (dénominateur oublié)",
			"variationIndex": 0,
			"variables": {
				"d": "10",
				"a": "3"
			},
			"answers": ["7"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "le 1/4 bleu : 3/4 rouge",
			"variationIndex": 0,
			"variables": {
				"d": "4",
				"a": "1"
			},
			"answers": ["\\frac{3}{4}"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "6/8 rouge, non simplifiée juste",
			"variationIndex": 0,
			"variables": {
				"d": "8",
				"a": "2"
			},
			"answers": ["\\frac{6}{8}"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "borne : 2/3 bleu, 1/3 rouge",
			"variationIndex": 0,
			"variables": {
				"d": "3",
				"a": "2"
			},
			"answers": ["\\frac{1}{3}"],
			"expected": {
				"status": "correct"
			}
		}
	]
}

	"variations": [
		{
			"statement": "Le plan est muni d'une base orthonormée $(\\vec{i},\\vec{j})$. On considère le vecteur $\\vec{u}\\begin{pmatrix}{{x}}\\\\{{y}}\\end{pmatrix}$.\n\nCalcule $\\|\\vec{u}\\|$.\n\n$\\|\\vec{u}\\|=?$",
			"variables": [
				{
					"name": "m",
					"expression": "2..4"
				},
				{
					"name": "n",
					"expression": "1..3"
				},
				{
					"name": "sw",
					"expression": "0..1"
				},
				{
					"name": "sx",
					"expression": "1|-1"
				},
				{
					"name": "sy",
					"expression": "1|-1"
				},
				{
					"name": "x",
					"expression": "{{eval:sx*(sw*(m^2-n^2)+(1-sw)*2*m*n)}}"
				},
				{
					"name": "y",
					"expression": "{{eval:sy*(sw*2*m*n+(1-sw)*(m^2-n^2))}}"
				},
				{
					"name": "N",
					"expression": "{{eval:x^2+y^2}}"
				},
				{
					"name": "R",
					"expression": "{{eval:m^2+n^2}}"
				}
			],
			"conditions": ["n < m"],
			"blanks": [
				{
					"expectedAnswer": "{{R}}"
				}
			],
			"correction": {
				"steps": [
					"En base orthonormée, $\\|\\vec{u}\\|^2=\\vec{u}\\cdot \\vec{u}=x^2+y^2$, donc $\\|\\vec{u}\\|=\\sqrt{x^2+y^2}$.",
					"$\\|\\vec{u}\\|=\\sqrt{ {{x;()}}^2+{{y;()}}^2 }=\\sqrt{ {{eval:x^2}}+{{eval:y^2}} }=\\sqrt{ {{N}} }=\\textcolor{{{color:primary.0}}}{{{R}}}$."
				]
			}
		},
		{
			"statement": "Le plan est muni d'une base orthonormée $(\\vec{i},\\vec{j})$. On considère le vecteur $\\vec{u}\\begin{pmatrix}{{x}}\\\\{{y}}\\end{pmatrix}$.\n\nCalcule $\\|\\vec{u}\\|$. Donne sa valeur exacte.\n\n$\\|\\vec{u}\\|=?$",
			"variables": [
				{
					"name": "x",
					"expression": "1..6;±"

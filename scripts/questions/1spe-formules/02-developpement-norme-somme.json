				},
				{
					"name": "S",
					"expression": "{{eval:a^2+2*p+b^2}}"
				}
			],
			"conditions": ["p != 0", "abs(p) < a*b"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a^2}}"
				}
			],
			"correction": {
				"steps": [
					"$\\|\\vec{u}+\\vec{v}\\|^2=\\|\\vec{u}\\|^2+2\\,\\vec{u}\\cdot \\vec{v}+\\|\\vec{v}\\|^2$, donc $\\|\\vec{u}\\|^2=\\|\\vec{u}+\\vec{v}\\|^2-2\\,\\vec{u}\\cdot \\vec{v}-\\|\\vec{v}\\|^2$.",
					"$\\|\\vec{u}\\|^2={{S}}-2\\times {{p;()}}-{{b}}^2={{S}}{{eval:-2*p;+}}-{{eval:b^2}}=\\textcolor{{{color:primary.0}}}{{{eval:a^2}}}$."
				]
			}
		}

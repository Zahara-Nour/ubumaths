	"variations": [
		{
			"statement": "Soit $\\vec{u}$ et $\\vec{v}$ deux vecteurs. Le nombre $\\|\\vec{u}+\\vec{v}\\|^2$ est égal à :\n\n```choix\n- $\\|\\vec{u}\\|^2+2\\,\\vec{u}\\cdot \\vec{v}+\\|\\vec{v}\\|^2$\n- $\\|\\vec{u}\\|^2+\\|\\vec{v}\\|^2$\n- $\\|\\vec{u}\\|^2+\\vec{u}\\cdot \\vec{v}+\\|\\vec{v}\\|^2$\n- $\\left(\\|\\vec{u}\\|+\\|\\vec{v}\\|\\right)^2$\n```",
			"variables": [],
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"$\\|\\vec{u}+\\vec{v}\\|^2=(\\vec{u}+\\vec{v})\\cdot(\\vec{u}+\\vec{v})$ : on développe par bilinéarité, comme une identité remarquable.",
					"$\\|\\vec{u}+\\vec{v}\\|^2=\\vec{u}\\cdot \\vec{u}+\\vec{u}\\cdot \\vec{v}+\\vec{v}\\cdot \\vec{u}+\\vec{v}\\cdot \\vec{v}$, et $\\vec{v}\\cdot \\vec{u}=\\vec{u}\\cdot \\vec{v}$ (symétrie).",
					"Donc $\\|\\vec{u}+\\vec{v}\\|^2=\\textcolor{{{color:primary.0}}}{\\|\\vec{u}\\|^2+2\\,\\vec{u}\\cdot \\vec{v}+\\|\\vec{v}\\|^2}$."
				]
			}
		},
		{
			"statement": "Soit $\\vec{u}$ et $\\vec{v}$ deux vecteurs orthogonaux tels que $\\|\\vec{u}\\|={{a}}$ et $\\|\\vec{v}\\|={{b}}$.\n\nCalcule $\\|\\vec{u}+\\vec{v}\\|^2$.\n\n$\\|\\vec{u}+\\vec{v}\\|^2=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				},
				{
					"name": "b",
					"expression": "2..9"
				}
			],
			"conditions": ["a != b"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a^2+b^2}}"
				}
			],
			"correction": {
				"steps": [
					"$\\|\\vec{u}+\\vec{v}\\|^2=\\|\\vec{u}\\|^2+2\\,\\vec{u}\\cdot \\vec{v}+\\|\\vec{v}\\|^2$.",
					"Les vecteurs sont orthogonaux, donc $\\vec{u}\\cdot \\vec{v}=0$ et $\\|\\vec{u}+\\vec{v}\\|^2=\\|\\vec{u}\\|^2+\\|\\vec{v}\\|^2$.",
					"$\\|\\vec{u}+\\vec{v}\\|^2={{a}}^2+{{b}}^2={{eval:a^2}}+{{eval:b^2}}=\\textcolor{{{color:primary.0}}}{{{eval:a^2+b^2}}}$."
				]
			}
		},
		{
			"statement": "Soit $\\vec{u}$ et $\\vec{v}$ deux vecteurs tels que $\\|\\vec{u}+\\vec{v}\\|^2={{S}}$, $\\vec{u}\\cdot \\vec{v}={{p}}$ et $\\|\\vec{v}\\|={{b}}$.\n\nCalcule $\\|\\vec{u}\\|^2$.\n\n$\\|\\vec{u}\\|^2=?$",
			"variables": [

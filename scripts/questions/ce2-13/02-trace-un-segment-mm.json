	"title": "Tracer un segment de longueur donnée en cm et mm",
	"description": "Papier uni : tracer à la règle graduée un segment donné en cm et mm (5 cm et 3 mm) ou en mm (72 mm)",
	"grades": ["CE2"],
	"level": 9,
	"delay": 240,
	"status": "draft",
	"variations": [
		{
			"statement": "Avec la règle graduée, trace le segment $[AB]$ de $\\textcolor{{{color:primary.0}}}{{{a}}\\text{ cm et }{{b}}\\text{ mm}}$ en partant du point $A$.\n\n```figure-a-completer\nfenetre: 0 ; 14 ; 0 ; 10\nverifier: segment AB = {{a}} cm {{b}} mm\n---\n{{if:k==1|A = point(1, 5)|{{if:k==2|A = point(1, 2)|A = point(1, 8)}}}}\n```",
			"variables": [
				{
					"name": "k",
					"expression": "1..3"
				},
				{
					"name": "a",
					"expression": "2..11"
				},
				{
					"name": "b",
					"expression": "1..9"
				}
			],
			"correction": {
				"steps": [
					"On pose la règle graduée : son $\\textcolor{{{color:primary.0}}}{\\text{0}}$ sur le point $A$.",
					"On compte $\\textcolor{{{color:primary.0}}}{{{a}}\\text{ cm}}$, puis encore $\\textcolor{{{color:primary.0}}}{{{b}}\\text{ petits traits}}$ (les millimètres), et on trace le segment depuis $A$ jusque-là."
				]
			}
		},
		{
			"statement": "Avec la règle graduée, trace le segment $[AB]$ de $\\textcolor{{{color:primary.0}}}{{{m}}\\text{ mm}}$ en partant du point $A$.\n\n```figure-a-completer\nfenetre: 0 ; 14 ; 0 ; 10\nverifier: segment AB = {{m}} mm\n---\n{{if:k==1|A = point(1, 5)|{{if:k==2|A = point(1, 2)|A = point(1, 8)}}}}\n```",
			"variables": [
				{
					"name": "k",
					"expression": "1..3"
				},
				{
					"name": "a",
					"expression": "2..11"
				},
				{
					"name": "b",
					"expression": "1..9"
				},
				{
					"name": "m",
					"expression": "{{eval:10*a+b}}"
				}
			],
			"correction": {
				"steps": [
					"$10\\text{ mm} = 1\\text{ cm}$ : $\\textcolor{{{color:primary.0}}}{{{m}}\\text{ mm}}$, c'est {{a}} cm et {{b}} mm.",
					"On pose la règle graduée, son $\\textcolor{{{color:primary.0}}}{\\text{0}}$ sur le point $A$, on compte {{a}} cm puis {{b}} petits traits, et on trace le segment depuis $A$ jusque-là."
				]
			}
		}
	],

		{
			"statement": "On considère la fonction $f$ définie par $f(x)={{a}}x$.\n\nCalcule $f({{n}})$.\n\n$f({{n}})=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9;±"
				},
				{
					"name": "n",
					"expression": "2..9"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(a)*(n)}}"
				}
			],
			"correction": {
				"steps": [
					"Pour calculer l'image d'un nombre, on **remplace $x$** par ce nombre dans l'expression.",
					"$$f({{n}}) = {{a}} \\times {{if:n<0|({{n}})|{{n}}}} = \\textcolor{{{color:primary.0}}}{{{eval:(a)*(n)}}}$$"
				]
			}
		},

	"title": "Utiliser le sens de variation de x ↦ k·a^x",
	"description": "Comparer deux images sans calcul (k < 0 compris) ; abscisse du maximum sur [0 ; 5] ; retrouver k et a à partir de f(0) et f(1)",
	"grades": ["T_TECHNO"],
	"level": 2,
	"delay": 45,
	"status": "draft",
	"shared": {
		"blankDefaults": {
			"acceptDecimal": true
		}

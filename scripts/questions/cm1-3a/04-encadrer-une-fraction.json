{
	"title": "Encadrer une fraction par deux entiers",
	"description": "Encadrer une fraction par deux entiers consécutifs à l'aide des tables (2 < 21/8 < 3 ; 5 < 16/3 < 6) ; dénominateur au plus 10",
	"grades": ["CM1"],
	"theme": "Fractions",
	"domain": "Apprivoiser",
	"subdomain": "Encadrer",
	"level": 2,
	"delay": 30,
	"status": "draft",
	"options": {
		"constraints": {
			"reducedFractions": "off"
		}
	},
	"variations": [
		{
			"statement": "Encadre cette fraction par deux nombres entiers qui se suivent.\n\n$$? < \\frac{{{a}}}{{{d}}} < ?$$",
			"variables": [
				{
					"name": "d",
					"expression": "2..10"
				},
				{
					"name": "q",
					"expression": "0..9"
				},
				{
					"name": "dm",
					"expression": "eval:d-1"
				},
				{
					"name": "r",
					"expression": "1..{{dm}}"
				},
				{
					"name": "a",
					"expression": "eval:q*d+r"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{q}}"
				},
				{
					"expectedAnswer": "{{eval:q+1}}"
				}
			],
			"correction": {
				"steps": [
					"**Combien d'unités ?** On cherche le multiple de ${{d}}$ juste avant ${{a}}$, dans la table de ${{d}}$ : ${{a}} = {{q}} \\times {{d}} + {{r}}$.",
					"$$\\frac{{{a}}}{{{d}}} = {{q}} + \\frac{{{r}}}{{{d}}}$$",
					"$\\frac{{{r}}}{{{d}}}$ est entre $0$ et $1$, donc $\\textcolor{{{color:primary.0}}}{{{q}}} < \\frac{{{a}}}{{{d}}} < \\textcolor{{{color:primary.0}}}{{{eval:q+1}}}$."
				]
			}
		}
	],
	"testSpecs": [
		{
			"description": "2 < 21/8 < 3",
			"variationIndex": 0,
			"variables": {
				"d": "8",
				"q": "2",
				"dm": "7",
				"r": "5",
				"a": "21"
			},
			"answers": ["2", "3"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : 8 et 21 (dénominateur et numérateur)",
			"variationIndex": 0,
			"variables": {
				"d": "8",
				"q": "2",
				"dm": "7",
				"r": "5",
				"a": "21"
			},
			"answers": ["8", "21"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "Erreur : 1 et 3 (pas consécutifs)",
			"variationIndex": 0,
			"variables": {
				"d": "8",
				"q": "2",
				"dm": "7",
				"r": "5",
				"a": "21"
			},
			"answers": ["1", "3"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "Erreur : 3 et 4",
			"variationIndex": 0,
			"variables": {
				"d": "8",
				"q": "2",
				"dm": "7",
				"r": "5",
				"a": "21"
			},
			"answers": ["3", "4"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "0 < 2/5 < 1",
			"variationIndex": 0,
			"variables": {
				"d": "5",
				"q": "0",
				"dm": "4",
				"r": "2",
				"a": "2"
			},
			"answers": ["0", "1"],
			"expected": {
				"status": "correct"
			}
		}
	]
}

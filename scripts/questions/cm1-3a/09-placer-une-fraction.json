{
	"title": "Placer une fraction sur une demi-droite graduée",
	"description": "Placer une fraction sur une demi-droite graduée (place 3/4) en touchant la droite ; unité partagée en 2 à 10 parts",
	"grades": ["CM1"],
	"theme": "Fractions",
	"domain": "Apprivoiser",
	"subdomain": "Repérage",
	"level": 3,
	"delay": 45,
	"status": "draft",
	"options": {
		"constraints": {
			"reducedFractions": "off"
		}
	},
	"variations": [
		{
			"statement": "Place le nombre $\\frac{{{n}}}{{{d}}}$ sur la demi-droite graduée.\n\n```line\nstart: 0\nend: {{u}}\nstep: 1/{{d}}\nmajor: {{d}}\nplacer: {{n}}/{{d}}\n```",
			"variables": [
				{
					"name": "d",
					"expression": "2|3|4|5|6|8|10"
				},
				{
					"name": "u",
					"expression": "eval:min(4,floor(12/d))"
				},
				{
					"name": "nm",
					"expression": "eval:u*d-1"
				},
				{
					"name": "n",
					"expression": "1..{{nm}}"
				}
			],
			"conditions": ["mod(n,d)!=0"],
			"correction": {
				"steps": [
					"**L'unité.** De $0$ à $1$, l'unité est partagée en ${{d}}$ parts égales : chaque petit intervalle vaut $\\frac{1}{{{d}}}$.",
					"$\\frac{{{n}}}{{{d}}}$, c'est ${{n}}$ petits intervalles à partir de $0$."
				]
			}
		}
	],
	"testSpecs": [
		{
			"description": "3/4 placé",
			"variationIndex": 0,
			"variables": {
				"d": "4",
				"u": "3",
				"nm": "11",
				"n": "3"
			},
			"answers": ["0.75"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : 1/4 de trop (1)",
			"variationIndex": 0,
			"variables": {
				"d": "4",
				"u": "3",
				"nm": "11",
				"n": "3"
			},
			"answers": ["1"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "Erreur : 3 (graduation de l'unité 3)",
			"variationIndex": 0,
			"variables": {
				"d": "4",
				"u": "3",
				"nm": "11",
				"n": "3"
			},
			"answers": ["3"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "2/3 placé",
			"variationIndex": 0,
			"variables": {
				"d": "3",
				"u": "4",
				"nm": "11",
				"n": "2"
			},
			"answers": ["\\frac{2}{3}"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : 1/3",
			"variationIndex": 0,
			"variables": {
				"d": "3",
				"u": "4",
				"nm": "11",
				"n": "2"
			},
			"answers": ["\\frac{1}{3}"],
			"expected": {
				"status": "incorrect"
			}
		}
	]
}

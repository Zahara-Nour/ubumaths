	"variations": [
		{
			"statement": "On considère l'arbre pondéré ci-dessous.\n\n```probtree\nA:0.{{a}}\n  B:0.{{b}}\n  \\overline{B}:0.{{eval:10-b}}\n\\overline{A}:0.{{eval:10-a}}\n  B:0.{{c}}\n  \\overline{B}:0.{{eval:10-c}}\n```\n\nDonne le résultat en fraction irréductible.\n\n$P(A\\cap B)=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "b",
					"expression": "1..9"
				},
				{
					"name": "c",
					"expression": "1..9"
				}
			],
			"conditions": ["b != c", "a != b"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*b/100}}"
				}
			],
			"correction": {
				"steps": [
					"La probabilité d'un chemin est le produit des probabilités portées par ses branches.",
					"$P(A\\cap B)=P(A)\\times P_A(B)=0.{{a}}\\times0.{{b}}={{eval:a*b/100}}$"
				]
			}
		},
		{
			"statement": "On considère l'arbre pondéré ci-dessous.\n\n```probtree\nA:0.{{a}}\n  B:0.{{c}}\n  \\overline{B}:0.{{eval:10-c}}\n\\overline{A}:0.{{eval:10-a}}\n  B:0.{{t}}{{u}}\n  \\overline{B}:0.{{eval:9-t}}{{eval:10-u}}\n```\n\nDonne le résultat en fraction irréductible.\n\n$P(\\overline{A}\\cap \\overline{B})=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "c",
					"expression": "1..9"
				},
				{
					"name": "t",
					"expression": "1..8"
				},
				{
					"name": "u",
					"expression": "1..9"
				}
			],
			"conditions": ["u != 5"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(10-a)*(100-10*t-u)/1000}}"
				}
			],
			"correction": {
				"steps": [
					"La probabilité d'un chemin est le produit des probabilités portées par ses branches.",
					"$P(\\overline{A}\\cap \\overline{B})=P(\\overline{A})\\times P_{\\overline{A}}(\\overline{B})=0.{{eval:10-a}}\\times0.{{eval:9-t}}{{eval:10-u}}={{eval:(10-a)*(100-10*t-u)/1000}}$"
				]
			}
		},
		{
			"statement": "On considère l'arbre pondéré ci-dessous.\n\n```probtree\nA:{{n}}/{{d}}\n  B:{{r}}/{{s}}\n  \\overline{B}:{{eval:s-r}}/{{s}}\n\\overline{A}:{{eval:d-n}}/{{d}}\n  B:{{m}}/{{q}}\n  \\overline{B}:{{eval:q-m}}/{{q}}\n```\n\nDonne le résultat en fraction irréductible.\n\n$P(A\\cap \\overline{B})=?$",
			"variables": [
				{
					"name": "d",
					"expression": "3..9"
				},
				{
					"name": "n",
					"expression": "1..8"
				},
				{
					"name": "s",
					"expression": "3..9"
				},
				{
					"name": "r",
					"expression": "1..8"
				},
				{
					"name": "q",
					"expression": "3..9"
				},
				{
					"name": "m",
					"expression": "1..8"
				}
			],
			"conditions": [
				"n < d",
				"gcd(n, d) = 1",
				"r < s",
				"gcd(r, s) = 1",
				"m < q",
				"gcd(m, q) = 1",
				"s != d"
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n*(s-r)/(d*s)}}"
				}
			],
			"correction": {
				"steps": [
					"La probabilité d'un chemin est le produit des probabilités portées par ses branches.",
					"$P(A\\cap \\overline{B})=P(A)\\times P_A(\\overline{B})=\\dfrac{ {{n}} }{ {{d}} }\\times\\dfrac{ {{eval:s-r}} }{ {{s}} }={{eval:n*(s-r)/(d*s)}}$"
				]
			}
		}
	],

				"a": "3",
				"b": "4"
			},
			"answers": ["0,12", "0,58"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "v0 : P(A∪B) = P(A) + P(B) = 0,7 (intersection oubliée)",
			"variationIndex": 0,
			"variables": {
				"a": "3",
				"b": "4"

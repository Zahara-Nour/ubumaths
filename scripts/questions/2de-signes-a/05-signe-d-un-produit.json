				{
					"name": "s1",
					"expression": "-1|1"
				},
				{
					"name": "s2",
					"expression": "-1|1"
				},
				{
					"name": "t",
					"expression": "eval:(p)+1"
				},
				{
					"name": "u",
					"expression": "eval:(s1)*((t)-(p))"
				},
				{
					"name": "w",
					"expression": "eval:(s2)*((t)-(q))"
				},
				{
					"name": "v",
					"expression": "eval:(u)*(w)"

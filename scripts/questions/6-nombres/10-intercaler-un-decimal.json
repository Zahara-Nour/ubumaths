	"variations": [
		{
			"statement": "Écris un nombre décimal compris entre ${{lo}}$ et ${{hi}}$.\n\n$${{lo}} < ? < {{hi}}$$",
			"variables": [
				{
					"name": "a",
					"expression": "0..20"
				},
				{
					"name": "b",
					"expression": "0..9"
				},
				{
					"name": "lo",
					"expression": "eval:a+b/10;d"
				},
				{
					"name": "hi",
					"expression": "eval:a+(b+1)/10;d"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a+b/10+0.05;d}}",
					"rulesSuffice": true,
					"validationRules": [
						{
							"type": "range",
							"min": "{{lo}}",
							"max": "{{hi}}",
							"inclusive": false
						}
					]
				}
			],
			"correction": {
				"steps": [
					"**Intercaler.** On écrit les deux nombres avec un chiffre de plus après la virgule : il apparaît de la place entre eux.",
					"${{lo}} = {{a}}.{{b}}0$ et ${{hi}} = {{if:b==9|{{eval:a+1}}.00|{{a}}.{{eval:b+1}}0}}$ : tout nombre de centièmes entre ${{b}}0$ et ${{eval:10*(b+1)}}$ convient, par exemple $\\textcolor{{{color:primary.0}}}{{{solution}}}$ (mais aussi ${{eval:a+b/10+0.01;d}}$, ${{eval:a+b/10+0.08;d}}$…)."
				]
			}

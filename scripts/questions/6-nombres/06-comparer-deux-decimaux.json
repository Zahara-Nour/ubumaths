			"blanks": [
				{
					"expectedAnswer": "{{if:q<2|0|1}}"
				}
			],
			"correction": {
				"steps": [
					"**Le signe $\\leqslant$** se lit « inférieur ou égal à » : il est vrai si le premier nombre est plus petit que le second, **ou** s'ils sont égaux.",
					"{{if:q==0|${{a}}.{{b}} = {{a}}.{{b}}0$ : les deux nombres sont égaux, donc c'est **vrai**.|{{if:q==1|${{a}}.{{b}} = {{a}}.{{b}}0$ et ${{c}}{{d}} < {{b}}0$ : ${{a}}.{{c}}{{d}} < {{a}}.{{b}}$, donc c'est **vrai**.|${{a}}.{{b}} = {{a}}.{{b}}0$ et ${{b}}0 > {{c}}{{d}}$ : ${{a}}.{{b}} > {{a}}.{{c}}{{d}}$, donc c'est **faux**.}}}}"
				]
			}
		}

{
	"title": "Encadrer un nombre",
	"description": "Un nombre plus petit, un nombre plus grand : … < 47 < …",
	"grades": ["CP"],
	"theme": "Entiers",
	"domain": "Apprivoiser",
	"subdomain": "Encadrer",
	"level": 5,
	"delay": 20,
	"status": "draft",
	"variations": [
		{
			"statement": "Écris un nombre plus petit que ${{n}}$ et un nombre plus grand que ${{n}}$.\n\n$${{expression1}}$$",
			"variables": [
				{
					"name": "n",
					"expression": "1..99"
				},
				{
					"name": "expression1",
					"expression": "?<{{n}}<?"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n-1}}",
					"rulesSuffice": true,
					"validationRules": [
						{
							"type": "range",
							"min": "-1",
							"max": "{{n}}",
							"inclusive": false
						},
						{
							"type": "predicate",
							"predicate": "isInteger"
						}
					]
				},
				{
					"expectedAnswer": "{{eval:n+1}}",
					"rulesSuffice": true,
					"validationRules": [
						{
							"type": "range",
							"min": "{{n}}",
							"max": "1000000",
							"inclusive": false
						},
						{
							"type": "predicate",
							"predicate": "isInteger"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"Un nombre plus petit que ${{n}}$ vient avant lui dans la suite des nombres ; un nombre plus grand vient après.",
					"Plusieurs réponses sont possibles. Par exemple : $${{eval:n-1}} < {{n}} < {{eval:n+1}}$$"
				]
			}
		}
	],
	"testSpecs": [

{
	"title": "Le nombre juste avant, le nombre juste après",
	"description": "Encadrer par les deux voisins : 46 < 47 < 48",
	"grades": ["CP"],
	"theme": "Entiers",
	"domain": "Apprivoiser",
	"subdomain": "Encadrer",

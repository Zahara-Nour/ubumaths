				{
					"name": "n",
					"expression": "1..99"
				},
				{
					"name": "expression1",
					"expression": "?<{{n}}<?"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:n-1}}"
				},
				{
					"expectedAnswer": "{{eval:n+1}}"
				}
			],
			"correction": {
				"steps": [
					"Le nombre juste avant ${{n}}$ est celui qu'on dit en reculant de $1$ ; le nombre juste après, celui qu'on dit en avançant de $1$.",
					"$${{eval:n-1}} < {{n}} < {{eval:n+1}}$$"
				]
			}
		}
	],

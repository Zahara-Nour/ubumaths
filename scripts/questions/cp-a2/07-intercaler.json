{
	"title": "Intercaler un nombre",
	"description": "Un nombre entre deux nombres donnés : 47 < … < 52",
	"grades": ["CP"],
	"theme": "Entiers",
	"domain": "Apprivoiser",
	"subdomain": "Encadrer",
	"level": 6,
	"delay": 20,
	"status": "draft",
	"variations": [
		{
			"statement": "Écris un nombre compris entre ${{a}}$ et ${{b}}$.\n\n$${{expression1}}$$",
			"variables": [
				{
					"name": "a",
					"expression": "0..90"
				},
				{
					"name": "k",
					"expression": "2..10"
				},
				{
					"name": "b",
					"expression": "eval:a+k"
				},
				{
					"name": "expression1",
					"expression": "{{a}}<?<{{b}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a+1}}",
					"rulesSuffice": true,
					"validationRules": [
						{
							"type": "range",
							"min": "{{a}}",
							"max": "{{b}}",
							"inclusive": false
						},
						{
							"type": "predicate",
							"predicate": "isInteger"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"Un nombre compris entre ${{a}}$ et ${{b}}$ vient après ${{a}}$ et avant ${{b}}$ dans la suite des nombres.",
					"{{if:k==2|Il n'y en a qu'un : ${{eval:a+1}}$.|{{if:k==3|Il y en a deux : ${{eval:a+1}}$ ou ${{eval:a+2}}$.|Ce sont les nombres de ${{eval:a+1}}$ à ${{eval:b-1}}$ : n'importe lequel convient.}}}}"
				]
			}
		}
	],
	"testSpecs": [

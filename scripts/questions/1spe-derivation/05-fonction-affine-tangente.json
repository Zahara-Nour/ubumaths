		"cleanCoefficients": true
	},
	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=x^2$.\n\nDonne, sous forme réduite, la fonction affine tangente $g$ à $f$ en ${{a}}$.\n\n$g(x)=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..4;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:2*a*x-a^2}}"
				}
			],
			"correction": {
				"steps": [
					"La fonction affine tangente à $f$ en $a$ est $g(x)=f(a)+f'(a)(x-a)$.",
					"Ici $f({{a}})={{eval:a^2}}$ et $f'({{a}})={{eval:2*a}}$, donc $g(x)={{eval:a^2}}+\\left({{eval:2*a}}\\right)(x{{eval:-a;+}})$.",
					"$$g(x)=\\textcolor{{{color:primary.0}}}{{{eval:2*a*x-a^2}}}$$"
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=x^3$.\n\nDonne, sous forme réduite, la fonction affine tangente $g$ à $f$ en ${{a}}$.\n\n$g(x)=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..2;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:3*a^2*x-2*a^3}}"
				}
			],
			"correction": {
				"steps": [
					"La fonction affine tangente à $f$ en $a$ est $g(x)=f(a)+f'(a)(x-a)$.",
					"Ici $f({{a}})={{eval:a^3}}$ et $f'({{a}})={{eval:3*a^2}}$, donc $g(x)={{eval:a^3}}+\\left({{eval:3*a^2}}\\right)(x{{eval:-a;+}})$.",
					"$$g(x)=\\textcolor{{{color:primary.0}}}{{{eval:3*a^2*x-2*a^3}}}$$"
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}^*$ par $f(x)=\\dfrac{1}{x}$.\n\nDonne, sous forme réduite, la fonction affine tangente $g$ à $f$ en ${{a}}$.\n\n$g(x)=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..4;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:-x/a^2+2/a}}"
				}
			],
			"correction": {
				"steps": [
					"La fonction affine tangente à $f$ en $a$ est $g(x)=f(a)+f'(a)(x-a)$.",
					"Ici $f({{a}})={{eval:1/a}}$ et $f'({{a}})={{eval:-1/a^2}}$, donc $g(x)={{eval:1/a}}+\\left({{eval:-1/a^2}}\\right)(x{{eval:-a;+}})$.",
					"$$g(x)=\\textcolor{{{color:primary.0}}}{{{eval:-x/a^2+2/a}}}$$"
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $[0\\,;+\\infty[$ par $f(x)=\\sqrt{x}$.\n\nDonne, sous forme réduite, la fonction affine tangente $g$ à $f$ en ${{a}}$.\n\n$g(x)=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "r",
					"expression": "1..3"
				},
				{
					"name": "a",
					"expression": "eval:r^2"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:x/(2*r)+r/2}}"
				}
			],
			"correction": {
				"steps": [
					"La fonction affine tangente à $f$ en $a$ est $g(x)=f(a)+f'(a)(x-a)$, avec $f'(x)=\\dfrac{1}{2\\sqrt{x}}$.",
					"Ici $f({{a}})={{r}}$ et $f'({{a}})=\\dfrac{1}{{{eval:2*r}}}$.",
					"$$g(x)=\\textcolor{{{color:primary.0}}}{{{eval:x/(2*r)+r/2}}}$$"
				]
			}
		}
	],

	"variations": [
		{
			"statement": "Écris sans parenthèses, sous la forme la plus simple.\n\n$$\\left({{k}}{{L}}\\right)^{ {{n}} }=?$$",
			"variables": [
				{
					"name": "L",
					"expression": "x|y|t|z"
				},
				{
					"name": "k",
					"expression": "2..5"
				},
				{
					"name": "n",
					"expression": "2..3"
				}
			],
			"conditions": ["k^n <= 125"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(k)^(n)}}{{L}}^{ {{n}} }"
				}
			],
			"correction": {
				"steps": [
					"**Puissance d'un produit** : $(ab)^n=a^n\\times b^n$ : chaque facteur est élevé à la puissance $n$.",
					"$$\\left({{k}}{{L}}\\right)^{ {{n}} }=\\textcolor{{{color:primary.0}}}{{{k}}^{ {{n}} }}\\times\\textcolor{{{color:primary.1}}}{{{L}}^{ {{n}} }}=\\textcolor{{{color:primary.0}}}{{{eval:(k)^(n)}}{{L}}^{ {{n}} }}$$"
				]
			}
		},
		{
			"statement": "Écris sans parenthèses, sous la forme la plus simple.\n\n$$\\left(-{{k}}{{L}}\\right)^{ {{n}} }=?$$",
			"variables": [
				{
					"name": "L",
					"expression": "x|y|t|z"
				},
				{
					"name": "k",
					"expression": "2..5"
				},
				{
					"name": "n",
					"expression": "2..3"
				}
			],
			"conditions": ["k^n <= 125"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(-(k))^(n)}}{{L}}^{ {{n}} }"
				}
			],
			"correction": {
				"steps": [
					"**Puissance d'un produit** : $(ab)^n=a^n\\times b^n$ : chaque facteur est élevé à la puissance $n$. Le facteur $-{{k}}$ garde son signe dans la puissance.",
					"$$\\left(-{{k}}{{L}}\\right)^{ {{n}} }=\\textcolor{{{color:primary.0}}}{(-{{k}})^{ {{n}} }}\\times\\textcolor{{{color:primary.1}}}{{{L}}^{ {{n}} }}=\\textcolor{{{color:primary.0}}}{{{eval:(-(k))^(n)}}{{L}}^{ {{n}} }}$$",
					"{{if:n==2|Un exposant pair rend le signe positif.|Un exposant impair garde le signe négatif.}}"
				]
			}
		},
		{
			"statement": "Écris sans parenthèses, sous la forme la plus simple.\n\n$$\\left({{k}}{{L}}^{ {{m}} }\\right)^{ {{n}} }=?$$",
			"variables": [
				{
					"name": "L",
					"expression": "x|y|t|z"
				},
				{
					"name": "k",
					"expression": "2..3"
				},
				{
					"name": "m",
					"expression": "2..4"
				},
				{
					"name": "n",
					"expression": "2..3"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(k)^(n)}}{{L}}^{ {{eval:(m)*(n)}} }"
				}
			],
			"correction": {
				"steps": [
					"**Puissance d'un produit** : $(ab)^n=a^n\\times b^n$ : chaque facteur est élevé à la puissance $n$. Puis **puissance d'une puissance** : $(a^m)^n=a^{m\\times n}$.",
					"$$\\left({{k}}{{L}}^{ {{m}} }\\right)^{ {{n}} }=\\textcolor{{{color:primary.0}}}{{{k}}^{ {{n}} }}\\times\\textcolor{{{color:primary.1}}}{\\left({{L}}^{ {{m}} }\\right)^{ {{n}} }}=\\textcolor{{{color:primary.0}}}{{{eval:(k)^(n)}}}\\times\\textcolor{{{color:primary.1}}}{{{L}}^{ {{m}}\\times{{n}} }}=\\textcolor{{{color:primary.0}}}{{{eval:(k)^(n)}}{{L}}^{ {{eval:(m)*(n)}} }}$$"
				]
			}
		}
	],

			"correction": {
				"steps": [
					"Règles : $a^m\\times a^n=a^{m+n}$ ; $\\dfrac{a^m}{a^n}=a^{m-n}$ ; $(a^m)^n=a^{m\\times n}$.",
					"$$\\left({{L}}^{ {{a}} }\\right)^{ {{b}} }\\times {{L}}^{ {{c}} }=\\textcolor{{{color:primary.0}}}{{{L}}^{ {{eval:(a)*(b)}} }}\\times {{L}}^{ {{c}} }={{L}}^{ {{eval:(a)*(b)}}+{{if:c<0|({{c}})|{{c}}}} }=\\textcolor{{{color:primary.1}}}{{{L}}^{ {{eval:(a)*(b)+(c)}} }}$$"
				]
			}
		},

					"expression": "5|7|11|13!p"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{ {{p}} }{ {{q}} }"
				}
			],
			"correction": {
				"steps": [
					"On décompose le numérateur et le dénominateur en **produits de facteurs premiers**.",
					"$${{eval:2^(u)*3^(v)*(p)}}=\\textcolor{{{color:primary.0}}}{{{if:u==1|2|2^{ {{eval:u}} }}}\\times{{if:v==1|3|3^{ {{eval:v}} }}}}\\times{{p}}\\qquad{{eval:2^(u)*3^(v)*(q)}}=\\textcolor{{{color:primary.0}}}{{{if:u==1|2|2^{ {{eval:u}} }}}\\times{{if:v==1|3|3^{ {{eval:v}} }}}}\\times{{q}}$$",
					"Le plus grand diviseur commun est $\\textcolor{{{color:primary.0}}}{{{eval:2^(u)*3^(v)}}}$ ; on simplifie par lui :",
					"$$\\dfrac{ {{eval:2^(u)*3^(v)*(p)}} }{ {{eval:2^(u)*3^(v)*(q)}} }=\\dfrac{\\textcolor{{{color:primary.0}}}{{{eval:2^(u)*3^(v)}}}\\times{{p}} }{\\textcolor{{{color:primary.0}}}{{{eval:2^(u)*3^(v)}}}\\times{{q}} }=\\textcolor{{{color:primary.1}}}{\\dfrac{ {{p}} }{ {{q}} }}$$",
					"${{p}}$ et ${{q}}$ sont premiers et différents : la fraction est irréductible."
				]
			}
		},
		{
			"statement": "Écris cette fraction sous forme irréductible.\n\n$$\\dfrac{ {{eval:(p)*(r)*(s)}} }{ {{eval:(q)*(r)*(s)}} }=?$$",

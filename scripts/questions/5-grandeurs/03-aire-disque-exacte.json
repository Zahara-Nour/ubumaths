		"constraints": {
			"products": "off"
		}
	},
	"variations": [
		{
			"statement": "Donne la valeur **exacte** de l'aire d'un disque de rayon ${{r}}~\\unit{cm}$ (en fonction de $\\pi$).\n\n$?~\\unit{cm^2}$",
			"variables": [
				{
					"name": "r",
					"expression": "2..10"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:r^2}}\\pi"
				}
			],
			"correction": {
				"steps": [
					"**Aire d'un disque.** $\\text{Aire} = \\pi \\times \\text{rayon} \\times \\text{rayon} = \\pi r^2$. Le rayon est la moitié du diamètre.",
					"$\\pi \\times {{r}} \\times {{r}} = \\textcolor{{{color:primary.0}}}{{{eval:r^2}}\\pi~\\unit{cm^2}}$."
				]
			}
		},
		{
			"statement": "Donne la valeur **exacte** de l'aire d'un disque de diamètre ${{d}}~\\unit{cm}$ (en fonction de $\\pi$).\n\n$?~\\unit{cm^2}$",
			"variables": [
				{
					"name": "r",
					"expression": "2..10"
				},
				{
					"name": "d",
					"expression": "eval:2*r"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:r^2}}\\pi"
				}
			],
			"correction": {
				"steps": [
					"**Aire d'un disque.** $\\text{Aire} = \\pi \\times \\text{rayon} \\times \\text{rayon} = \\pi r^2$. Le rayon est la moitié du diamètre.",
					"Le rayon est ${{d}}~\\unit{cm} \\div 2 = {{r}}~\\unit{cm}$.",
					"$\\pi \\times {{r}} \\times {{r}} = \\textcolor{{{color:primary.0}}}{{{eval:r^2}}\\pi~\\unit{cm^2}}$."
				]
			}
		}
	],

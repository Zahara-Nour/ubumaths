		"constraints": {
			"products": "off"
		}
	},
	"variations": [
		{
			"statement": "Donne la valeur **exacte** du volume d'un cylindre de rayon ${{r}}~\\unit{cm}$ et de hauteur ${{h}}~\\unit{cm}$ (en fonction de $\\pi$).\n\n$?~\\unit{cm^3}$",
			"variables": [
				{
					"name": "r",
					"expression": "1..6"
				},
				{
					"name": "h",
					"expression": "2..10"
				}
			],
			"conditions": ["r!=h", "r>=2 || h>=3"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:r^2*h}}\\pi"
				}
			],
			"correction": {
				"steps": [
					"**Volume d'un cylindre.** $\\text{Volume} = \\text{aire de la base} \\times \\text{hauteur} = \\pi r^2 \\times h$.",
					"Aire de la base : $\\pi \\times {{r}} \\times {{r}} = {{eval:r^2}}\\pi~\\unit{cm^2}$.",
					"Volume : ${{eval:r^2}}\\pi~\\unit{cm^2} \\times {{h}}~\\unit{cm} = \\textcolor{{{color:primary.0}}}{{{eval:r^2*h}}\\pi~\\unit{cm^3}}$."
				]
			}
		},
		{
			"statement": "Donne la valeur **exacte** du volume d'un cylindre de diamètre ${{d}}~\\unit{cm}$ et de hauteur ${{h}}~\\unit{cm}$ (en fonction de $\\pi$).\n\n$?~\\unit{cm^3}$",
			"variables": [
				{
					"name": "r",
					"expression": "2..6"
				},
				{
					"name": "d",
					"expression": "eval:2*r"
				},
				{
					"name": "h",
					"expression": "2..10"
				}
			],
			"conditions": ["d!=h"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:r^2*h}}\\pi"
				}
			],
			"correction": {
				"steps": [
					"**Volume d'un cylindre.** $\\text{Volume} = \\text{aire de la base} \\times \\text{hauteur} = \\pi r^2 \\times h$.",
					"Le rayon est ${{d}}~\\unit{cm} \\div 2 = {{r}}~\\unit{cm}$.",
					"Aire de la base : $\\pi \\times {{r}} \\times {{r}} = {{eval:r^2}}\\pi~\\unit{cm^2}$.",
					"Volume : ${{eval:r^2}}\\pi~\\unit{cm^2} \\times {{h}}~\\unit{cm} = \\textcolor{{{color:primary.0}}}{{{eval:r^2*h}}\\pi~\\unit{cm^3}}$."
				]
			}
		}
	],

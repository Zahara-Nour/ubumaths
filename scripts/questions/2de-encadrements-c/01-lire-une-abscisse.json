{
	"id": "a692569a-ec38-413b-a774-4991d8c88b94",
	"title": "Lire l'abscisse d'un point",
	"description": "Lire une abscisse sur une droite graduée en dixièmes, en tiers, en quarts, abscisses négatives comprises",
	"grades": ["2"],
	"level": 5,
	"delay": 60,
	"status": "draft",
	"shared": {
		"cleanCoefficients": true,
		"blankDefaults": {
			"acceptDecimal": true
		}
	},
	"variations": [
		{
			"statement": "Lis l'abscisse du point $A$.\n\n```line\nstart: {{a}}\nend: {{eval:(a)+2}}\nstep: 1/10\nmajor: 10\npoints: A={{eval:(a)*10+(k)}}/10\n```\n\n$$A=?$$",
			"variables": [
				{
					"name": "a",
					"expression": "-3..3"
				},
				{
					"name": "k",
					"expression": "1..19"
				}
			],
			"conditions": ["k != 10"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:((a)*10+(k))/10}}"
				}
			],
			"correction": {
				"steps": [
					"Entre deux nombres entiers, la droite est partagée en $10$ : une graduation vaut $0{,}1$.",
					"$A$ est à ${{k}}$ graduations de ${{a}}$ : $\\textcolor{{{color:primary.0}}}{A={{a}}+{{k}}\\times0{,}1}$."
				]
			}
		},
		{
			"statement": "Lis l'abscisse du point $A$. Donne-la sous la forme d'une fraction.\n\n```line\nstart: {{a}}\nend: {{eval:(a)+2}}\nstep: 1/3\nmajor: 3\npoints: A={{eval:3*(a)+(k)}}/3\n```\n\n$$A=?$$",
			"variables": [
				{
					"name": "a",
					"expression": "-2..2"
				},
				{
					"name": "k",
					"expression": "1|2|4|5"
				},
				{
					"name": "N",
					"expression": "eval:3*a+k"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:N<0|-}}\\frac{ {{eval:abs(N)}} }{3}"
				}
			],
			"correction": {
				"steps": [
					"Entre deux nombres entiers, la droite est partagée en $3$ : une graduation vaut $\\dfrac{1}{3}$.",
					"$A$ est à ${{k}}$ graduations de ${{a}}$ : $A={{a}}+\\dfrac{ {{k}} }{3}=\\textcolor{{{color:primary.0}}}{{{if:N<0|-}}\\dfrac{ {{eval:abs(N)}} }{3}}$."
				]
			}
		},
		{
			"statement": "Lis l'abscisse du point $A$.\n\n```line\nstart: {{a}}\nend: {{eval:(a)+3}}\nstep: 1/4\nmajor: 4\npoints: A={{eval:4*(a)+(k)}}/4\n```\n\n$$A=?$$",
			"variables": [
				{
					"name": "a",
					"expression": "-3..-1"
				},
				{
					"name": "k",
					"expression": "1|3|5|7|9|11"
				},
				{
					"name": "N",
					"expression": "eval:4*a+k"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(4*(a)+(k))/4}}"
				}
			],
			"correction": {
				"steps": [
					"Entre deux nombres entiers, la droite est partagée en $4$ : une graduation vaut $\\dfrac{1}{4}=0{,}25$.",
					"$A$ est à ${{k}}$ graduation{{if:k>1|s}} de ${{a}}$ : $A={{a}}+\\dfrac{ {{k}} }{4}=\\textcolor{{{color:primary.0}}}{{{if:N<0|-}}\\dfrac{ {{eval:abs(N)}} }{4}}$."
				]
			}
		}
	],
	"testSpecs": [
		{
			"description": "−2 + 7 × 0,1 = −1,3",
			"variationIndex": 0,
			"variables": {
				"a": "-2",
				"k": "7"
			},
			"answers": ["-1.3"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : lu depuis 0 vers la gauche (−2,7)",
			"variationIndex": 0,

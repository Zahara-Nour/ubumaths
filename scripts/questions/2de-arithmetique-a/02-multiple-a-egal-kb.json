					"expression": "2..9"
				},
				{
					"name": "p",
					"expression": "2..5"
				},
				{
					"name": "q",
					"expression": "1..9"
				}
			],
			"conditions": ["gcd(p,q) == 1"],
			"blanks": [
				{
					"expectedAnswer": "{{p}}n+{{q}}"
				}
			],
			"correction": {
				"steps": [
					"**Définition** : $a$ est un **multiple** de $b$ s'il existe un **entier** $k$ tel que $a=k\\times b$. On met ${{d}}$ en facteur :",
					"$${{eval:(d)*(p)}}n+{{eval:(d)*(q)}}={{d}}\\times{{p}}n+{{d}}\\times{{q}}={{d}}\\times\\textcolor{{{color:primary.0}}}{\\left({{p}}n+{{q}}\\right)}$$",
					"$k=\\textcolor{{{color:primary.0}}}{{{p}}n+{{q}}}$ est un entier (produit et somme d'entiers) : le nombre est un multiple de ${{d}}$."
				]
			}
		}
	],

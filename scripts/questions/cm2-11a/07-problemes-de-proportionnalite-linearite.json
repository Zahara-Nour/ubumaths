	"variations": [
		{
			"statement": "À la boulangerie, ${{n}}$ croissants coûtent ${{eval:floor((n*u)/100)}}.{{eval:floor(mod(n*u,100)/10)}}{{eval:mod(n*u,10)}}~\\unit{€}$.\n\nCombien coûtent ${{eval:k*n}}$ croissants ?\n\nIls coûtent $?~\\text{€}$.",
			"variables": [
				{
					"name": "n",
					"expression": "2..6"
				},
				{
					"name": "k",
					"expression": "2..5"
				},
				{
					"name": "x",
					"expression": "17..28"
				},
				{
					"name": "u",
					"expression": "eval:5*x"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(k*n*u)/100;d}}",
					"requiredForm": {
						"pattern": "a:number"
					}
				}
			],
			"correction": {
				"steps": [
					"${{eval:k*n}}$ croissants, c'est ${{k}}$ fois plus que ${{n}}$ croissants. Les croissants coûtent tous le même prix : on paie ${{k}}$ fois plus.",
					"$${{k}} \\times {{eval:floor((n*u)/100)}}.{{eval:floor(mod(n*u,100)/10)}}{{eval:mod(n*u,10)}} = \\textcolor{{{color:primary.0}}}{{{eval:floor((k*n*u)/100)}}.{{eval:floor(mod(k*n*u,100)/10)}}{{eval:mod(k*n*u,10)}}}$$",
					"${{eval:k*n}}$ croissants coûtent ${{eval:floor((k*n*u)/100)}}.{{eval:floor(mod(k*n*u,100)/10)}}{{eval:mod(k*n*u,10)}}~\\unit{€}$.",
					"On n'a pas eu besoin du prix d'un seul croissant."
				]
			}
		},
		{
			"statement": "Un paquet de ${{eval:a*g}}$ feuilles d'un certain papier a une épaisseur de ${{eval:a*w}}~\\unit{mm}$.\n\nQuelle est l'épaisseur de ${{eval:b*g}}$ feuilles de ce papier ?\n\nElle est de $?~\\text{mm}$.",
			"variables": [
				{
					"name": "a",
					"expression": "2..5"
				},
				{
					"name": "b",
					"expression": "3..9"
				},
				{
					"name": "w",
					"expression": "2..15"
				},
				{
					"name": "gi",
					"expression": "1..3"
				},
				{
					"name": "g",
					"expression": "eval:20+30*min(max(gi-1,0),1)+50*min(max(gi-2,0),1)"
				}
			],
			"conditions": ["mod(b,a) != 0", "mod(a,b) != 0", "b * g <= 900", "20 * w >= g", "5 * w <= g"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:b*w}}"
				}
			],
			"correction": {
				"steps": [
					"On passe par un petit paquet : ${{g}}$ feuilles, c'est ${{a}}$ fois moins que ${{eval:a*g}}$ feuilles ; son épaisseur est ${{a}}$ fois plus petite.",
					"$${{eval:a*w}} \\div {{a}} = {{w}}$$",
					"${{eval:b*g}}$ feuilles, c'est ${{b}}$ fois ${{g}}$ feuilles : l'épaisseur est ${{b}}$ fois plus grande.",
					"$${{b}} \\times {{w}} = \\textcolor{{{color:primary.0}}}{{{eval:b*w}}}$$",
					"${{eval:b*g}}$ feuilles ont une épaisseur de ${{eval:b*w}}~\\unit{mm}$."
				]
			}
		},
		{
			"statement": "Pour faire un gâteau avec ${{eval:q*h}}$ œufs, on utilise ${{eval:q*f}}~\\unit{g}$ de farine.\n\nQuelle masse de farine faut-il avec ${{eval:q*h+h}}$ œufs ?\n\nIl faut $?~\\text{g}$ de farine.",
			"variables": [
				{
					"name": "q",
					"expression": "2..4"
				},
				{
					"name": "h",
					"expression": "2..6"
				},
				{
					"name": "z",
					"expression": "8..96"
				},
				{
					"name": "f",
					"expression": "eval:5*z"
				}
			],
			"conditions": ["f >= 30 * h", "f <= 80 * h"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(q+1)*f}}"
				}
			],
			"correction": {
				"steps": [
					"${{eval:q*h+h}}$ œufs, c'est ${{eval:q*h}}$ œufs et encore ${{h}}$ œufs. Et ${{h}}$ œufs, c'est ${{q}}$ fois moins que ${{eval:q*h}}$ œufs.",
					"**${{h}}$ œufs.** ${{eval:q*f}} \\div {{q}} = {{f}}$ g de farine.",
					"**${{eval:q*h+h}}$ œufs.** On ajoute les deux quantités de farine : ${{eval:q*f}} + {{f}} = \\textcolor{{{color:primary.0}}}{{{eval:(q+1)*f}}}$.",
					"Il faut ${{eval:(q+1)*f}}~\\unit{g}$ de farine pour ${{eval:q*h+h}}$ œufs."
				]
			}
		}
	],

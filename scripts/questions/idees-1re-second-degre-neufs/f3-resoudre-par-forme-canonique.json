	"variations": [
		{
			"statement": "On veut résoudre dans $\\mathbb{R}$ l'équation ${{eval:x^2+bx+c}}=0$ sans le discriminant.\n\n1. Écris ${{eval:x^2+bx+c}}$ sous forme canonique : ${{eval:x^2+bx+c}}=?$\n\n2. Déduis-en l'ensemble des solutions, entre accolades ($\\varnothing$ s'il n'y en a pas) : $S=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "h",
					"expression": "1..6;±"
				},
				{
					"name": "m",
					"expression": "1..6"
				},
				{
					"name": "b",
					"expression": "eval:-2*h"
				},
				{
					"name": "c",
					"expression": "eval:h^2-m^2"
				}
			],
			"conditions": ["c != 0"],
			"blanks": [
				{
					"expectedAnswer": "(x{{eval:-h;+}})^2-{{eval:m^2}}",
					"requiredForm": {
						"pattern": "u*($x+v)^2+w"
					},
					"expectedErrors": [
						{
							"answer": "(x{{eval:h;+}})^2{{eval:c-h^2;+}}",
							"message": "Le carré à compléter est $\\left(x+\\dfrac{b}{2}\\right)^2$ avec $b={{b}}$ : attention au signe.",
							"label": "Signe de b/2"
						},
						{
							"answer": "(x{{eval:-h;+}})^2{{eval:c;+}}",
							"message": "Tu as gardé $c$ tel quel : en développant $(x{{eval:-h;+}})^2$, on obtient ${{eval:h^2}}$ en trop, à retirer.",
							"label": "Constante non corrigée"
						}
					]
				},
				{
					"expectedAnswer": "\\{ {{eval:h-m}} ; {{eval:h+m}} \\}",
					"answerKind": "intervalles",
					"expectedErrors": [

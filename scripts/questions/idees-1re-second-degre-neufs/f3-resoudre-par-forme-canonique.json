	"title": "Résoudre une équation par la forme canonique",
	"description": "x² + bx + c (b pair) : forme canonique par complétion du carré, puis ensemble des solutions, sans discriminant",
	"grades": ["1_SPE"],
	"level": 2,
	"delay": 120,

	"variations": [
		{
			"statement": "Pose et effectue la division. Continue après la virgule jusqu'à ce que le reste soit nul.\n\n```operation\ncalcul: {{eval:M/100;d}} ÷ {{d}}\nquotient: décimal\n```",
			"variables": [
				{
					"name": "d",
					"expression": "2..9"
				},
				{
					"name": "M",
					"expression": "100..99999"
				}
			],
			"conditions": ["mod(M,d) == 0", "mod(M,10) != 0"],
			"blanks": [],
			"correction": {
				"steps": [
					"On divise d'abord la partie entière ; quand on abaisse le chiffre des dixièmes, on écrit la virgule au quotient.",
					"Le reste devient nul au chiffre des centièmes.",
					"$${{eval:M/100;d}} \\div {{d}} = \\textcolor{{{color:primary.0}}}{{{eval:M/d/100;d}}}$$",
					"On vérifie : ${{d}} \\times {{eval:M/d/100;d}} = {{eval:M/100;d}}$."
				]
			}
		},
		{
			"statement": "Pose et effectue la division. Continue après la virgule jusqu'à ce que le reste soit nul.\n\n```operation\ncalcul: {{eval:T/10;d}} ÷ {{d}}\nquotient: décimal\n```",
			"variables": [
				{
					"name": "k",
					"expression": "1..5"
				},
				{
					"name": "d",
					"expression": "{{if:k==1|2|{{if:k==2|4|{{if:k==3|5|{{if:k==4|6|8}}}}}}}}"
				},
				{
					"name": "T",
					"expression": "101..9999"
				}
			],
			"conditions": ["mod(T,10) != 0", "mod(T,d) != 0", "mod(10*T,d) == 0"],
			"blanks": [],
			"correction": {
				"steps": [
					"On divise d'abord la partie entière ; quand on abaisse le chiffre des dixièmes, on écrit la virgule au quotient.",
					"Après les dixièmes, il reste ${{eval:mod(T,d)}}$ : on ajoute un zéro au dividende (${{eval:T/10;d}} = {{eval:T/10;d}}0$) et on continue jusqu'aux centièmes.",
					"$${{eval:T/10;d}} \\div {{d}} = \\textcolor{{{color:primary.0}}}{{{eval:T/d/10;d}}}$$",
					"On vérifie : ${{d}} \\times {{eval:T/d/10;d}} = {{eval:T/10;d}}$."
				]
			}
		}
	],

	"variations": [
		{
			"statement": "On considère deux vecteurs $\\vec{u}$ et $\\vec{v}$ tels que $\\|\\vec{u}\\|={{a}}$, $\\|\\vec{v}\\|={{b}}$ et $\\|\\vec{u}+\\vec{v}\\|={{c}}$.\n\nCalcule le produit scalaire $\\vec{u}\\cdot\\vec{v}$. Donne sa valeur exacte.\n\n$\\vec{u}\\cdot\\vec{v}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..8"
				},
				{
					"name": "b",
					"expression": "2..8"
				},
				{
					"name": "c",
					"expression": "{{eval:abs(a-b)+1}}..{{eval:a+b-1}}"
				},
				{
					"name": "N",
					"expression": "{{eval:c*c-a*a-b*b}}"
				}
			],
			"conditions": ["N != 0", "a != b"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{ {{N}} }{2}"
				}
			],
			"correction": {
				"steps": [
					"$\\|\\vec{u}+\\vec{v}\\|^2=\\|\\vec{u}\\|^2+2\\,\\vec{u}\\cdot\\vec{v}+\\|\\vec{v}\\|^2$, donc $\\vec{u}\\cdot\\vec{v}=\\dfrac{1}{2}\\left(\\|\\vec{u}+\\vec{v}\\|^2-\\|\\vec{u}\\|^2-\\|\\vec{v}\\|^2\\right)$.",
					"$\\vec{u}\\cdot\\vec{v}=\\dfrac{1}{2}\\left({{c}}^2-{{a}}^2-{{b}}^2\\right)=\\dfrac{1}{2}\\left({{eval:c*c}}-{{eval:a*a}}-{{eval:b*b}}\\right)=\\textcolor{{{color:primary.0}}}{ {{eval:N/2}} }$"
				]
			}
		},
		{
			"statement": "On considère deux vecteurs $\\vec{u}$ et $\\vec{v}$ tels que $\\|\\vec{u}\\|={{a}}$, $\\|\\vec{v}\\|={{b}}$ et $\\|\\vec{u}-\\vec{v}\\|={{c}}$.\n\nCalcule le produit scalaire $\\vec{u}\\cdot\\vec{v}$. Donne sa valeur exacte.\n\n$\\vec{u}\\cdot\\vec{v}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..8"
				},
				{
					"name": "b",
					"expression": "2..8"
				},
				{
					"name": "c",
					"expression": "{{eval:abs(a-b)+1}}..{{eval:a+b-1}}"
				},
				{
					"name": "N",
					"expression": "{{eval:a*a+b*b-c*c}}"
				}
			],
			"conditions": ["N != 0", "a != b"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{ {{N}} }{2}"
				}
			],
			"correction": {
				"steps": [
					"$\\|\\vec{u}-\\vec{v}\\|^2=\\|\\vec{u}\\|^2-2\\,\\vec{u}\\cdot\\vec{v}+\\|\\vec{v}\\|^2$, donc $\\vec{u}\\cdot\\vec{v}=\\dfrac{1}{2}\\left(\\|\\vec{u}\\|^2+\\|\\vec{v}\\|^2-\\|\\vec{u}-\\vec{v}\\|^2\\right)$.",
					"$\\vec{u}\\cdot\\vec{v}=\\dfrac{1}{2}\\left({{a}}^2+{{b}}^2-{{c}}^2\\right)=\\dfrac{1}{2}\\left({{eval:a*a}}+{{eval:b*b}}-{{eval:c*c}}\\right)=\\textcolor{{{color:primary.0}}}{ {{eval:N/2}} }$"
				]
			}
		},
		{
			"statement": "$ABC$ est un triangle tel que $AB={{a}}$, $AC={{b}}$ et $BC={{c}}$.\n\nCalcule le produit scalaire $\\overrightarrow{AB}\\cdot\\overrightarrow{AC}$. Donne sa valeur exacte.\n\n$\\overrightarrow{AB}\\cdot\\overrightarrow{AC}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..8"
				},
				{
					"name": "b",
					"expression": "2..8"
				},
				{
					"name": "c",
					"expression": "{{eval:abs(a-b)+1}}..{{eval:a+b-1}}"
				},
				{
					"name": "N",
					"expression": "{{eval:a*a+b*b-c*c}}"
				}
			],
			"conditions": ["N != 0", "a != b", "b != c", "a != c"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{ {{N}} }{2}"
				}
			],
			"correction": {
				"steps": [
					"$\\overrightarrow{BC}=\\overrightarrow{AC}-\\overrightarrow{AB}$, donc $BC^2=AC^2-2\\,\\overrightarrow{AB}\\cdot\\overrightarrow{AC}+AB^2$.",
					"On en déduit $\\overrightarrow{AB}\\cdot\\overrightarrow{AC}=\\dfrac{1}{2}\\left(AB^2+AC^2-BC^2\\right)$.",
					"$\\overrightarrow{AB}\\cdot\\overrightarrow{AC}=\\dfrac{1}{2}\\left({{a}}^2+{{b}}^2-{{c}}^2\\right)=\\dfrac{1}{2}\\left({{eval:a*a}}+{{eval:b*b}}-{{eval:c*c}}\\right)=\\textcolor{{{color:primary.0}}}{ {{eval:N/2}} }$"
				]
			}
		},
		{
			"statement": "On considère deux vecteurs $\\vec{u}$ et $\\vec{v}$ tels que $\\|\\vec{u}\\|={{a}}$, $\\|\\vec{v}\\|={{b}}$ et $\\|\\vec{u}+\\vec{v}\\|=\\sqrt{ {{n}} }$.\n\nCalcule le produit scalaire $\\vec{u}\\cdot\\vec{v}$. Donne sa valeur exacte.\n\n$\\vec{u}\\cdot\\vec{v}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..6"
				},
				{
					"name": "b",
					"expression": "2..6"
				},
				{
					"name": "n",
					"expression": "{{eval:(a-b)^2+1}}..{{eval:(a+b)^2-1}}"
				},
				{
					"name": "N",
					"expression": "{{eval:n-a*a-b*b}}"
				}
			],
			"conditions": [
				"N != 0",
				"a != b",
				"sqrt(n) != round(sqrt(n))",
				"mod(n,4) != 0",
				"mod(n,9) != 0",
				"mod(n,25) != 0",
				"mod(n,49) != 0"
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{ {{N}} }{2}"
				}
			],
			"correction": {
				"steps": [
					"$\\|\\vec{u}+\\vec{v}\\|^2=\\|\\vec{u}\\|^2+2\\,\\vec{u}\\cdot\\vec{v}+\\|\\vec{v}\\|^2$, donc $\\vec{u}\\cdot\\vec{v}=\\dfrac{1}{2}\\left(\\|\\vec{u}+\\vec{v}\\|^2-\\|\\vec{u}\\|^2-\\|\\vec{v}\\|^2\\right)$.",
					"$\\left(\\sqrt{ {{n}} }\\right)^2={{n}}$, donc $\\vec{u}\\cdot\\vec{v}=\\dfrac{1}{2}\\left({{n}}-{{eval:a*a}}-{{eval:b*b}}\\right)=\\textcolor{{{color:primary.0}}}{ {{eval:N/2}} }$"
				]
			}
		}
	],

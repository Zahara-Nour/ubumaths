	"variations": [
		{
			"statement": "Dans une base orthonormée, on considère les vecteurs $\\vec{u}\\begin{pmatrix}{{x1}}\\\\{{y1}}\\end{pmatrix}$ et $\\vec{v}\\begin{pmatrix}{{x2}}\\\\{{y2}}\\end{pmatrix}$.\n\nCalcule le produit scalaire $\\vec{u}\\cdot\\vec{v}$.\n\n$\\vec{u}\\cdot\\vec{v}=?$",
			"variables": [
				{
					"name": "x1",
					"expression": "-6..6"
				},
				{
					"name": "y1",
					"expression": "-6..6"
				},
				{
					"name": "x2",
					"expression": "-6..6"
				},
				{
					"name": "y2",
					"expression": "-6..6"
				}
			],
			"conditions": ["x1*x2 != 0", "y1*y2 != 0", "x1*x2+y1*y2 != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:x1*x2+y1*y2}}"
				}
			],
			"correction": {
				"steps": [
					"Dans une base orthonormée, si $\\vec{u}\\begin{pmatrix}x\\\\y\\end{pmatrix}$ et $\\vec{v}\\begin{pmatrix}x'\\\\y'\\end{pmatrix}$, alors $\\vec{u}\\cdot\\vec{v}=xx'+yy'$.",
					"$\\vec{u}\\cdot\\vec{v}={{x1}}\\times {{x2;()}}+{{y1;()}}\\times {{y2;()}}={{eval:x1*x2}}{{eval:y1*y2;+}}=\\textcolor{{{color:primary.0}}}{ {{eval:x1*x2+y1*y2}} }$"
				]
			}
		},
		{
			"statement": "Dans un repère orthonormé, on considère les points $A({{xA}}\\,;{{yA}})$, $B({{xB}}\\,;{{yB}})$ et $C({{xC}}\\,;{{yC}})$.\n\nCalcule le produit scalaire $\\overrightarrow{AB}\\cdot\\overrightarrow{AC}$.\n\n$\\overrightarrow{AB}\\cdot\\overrightarrow{AC}=?$",
			"variables": [
				{
					"name": "xA",
					"expression": "-5..5"
				},
				{
					"name": "yA",
					"expression": "-5..5"
				},
				{
					"name": "xB",
					"expression": "-5..5"
				},
				{
					"name": "yB",
					"expression": "-5..5"
				},
				{
					"name": "xC",
					"expression": "-5..5"
				},
				{
					"name": "yC",
					"expression": "-5..5"
				},
				{
					"name": "ux",
					"expression": "{{eval:xB-xA}}"
				},
				{
					"name": "uy",
					"expression": "{{eval:yB-yA}}"
				},
				{
					"name": "vx",
					"expression": "{{eval:xC-xA}}"
				},
				{
					"name": "vy",
					"expression": "{{eval:yC-yA}}"
				}
			],
			"conditions": [
				"ux*vx != 0",
				"uy*vy != 0",
				"ux*vx+uy*vy != 0",
				"ux*vy-uy*vx != 0",
				"abs(ux) <= 7",
				"abs(uy) <= 7",
				"abs(vx) <= 7",
				"abs(vy) <= 7"
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:ux*vx+uy*vy}}"
				}
			],
			"correction": {
				"steps": [
					"On calcule d'abord les coordonnées des vecteurs.",
					"$\\overrightarrow{AB}\\begin{pmatrix}{{xB}}-{{xA;()}}\\\\{{yB}}-{{yA;()}}\\end{pmatrix}$, soit $\\overrightarrow{AB}\\begin{pmatrix}{{ux}}\\\\{{uy}}\\end{pmatrix}$.",
					"$\\overrightarrow{AC}\\begin{pmatrix}{{xC}}-{{xA;()}}\\\\{{yC}}-{{yA;()}}\\end{pmatrix}$, soit $\\overrightarrow{AC}\\begin{pmatrix}{{vx}}\\\\{{vy}}\\end{pmatrix}$.",

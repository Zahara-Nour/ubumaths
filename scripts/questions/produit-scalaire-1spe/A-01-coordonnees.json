				"mod(abs(x2),2) == 1",
				"x1*x2+y1*y2 != 0",
				"mod(abs(x1*x2+y1*y2),2) == 1"
			],
			"blanks": [
				{
					"expectedAnswer": "\\frac{ {{eval:x1*x2+y1*y2}} }{2}"

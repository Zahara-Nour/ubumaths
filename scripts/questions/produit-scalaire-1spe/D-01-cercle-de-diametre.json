	"variations": [
		{
			"statement": "Le plan est muni d'un repère orthonormé. On considère les points $A({{xa}}\\,;{{ya}})$ et $B({{xb}}\\,;{{yb}})$.\n\nL'ensemble des points $M$ du plan tels que $\\overrightarrow{MA}\\cdot\\overrightarrow{MB}=0$ est un cercle. Détermine les coordonnées $(x_I\\,;y_I)$ du centre $I$ de ce cercle et son rayon $r$. Donne $r$ sous sa forme exacte la plus simple.\n\n$x_I=?$\n\n$y_I=?$\n\n$r=?$",
			"variables": [
				{
					"name": "xa",
					"expression": "-5..5"
				},
				{
					"name": "ya",
					"expression": "-5..5"
				},
				{
					"name": "p",
					"expression": "-4..4!0"
				},
				{
					"name": "q",
					"expression": "-4..4!0"
				},
				{
					"name": "xb",
					"expression": "{{eval:xa+2*p}}"
				},
				{
					"name": "yb",
					"expression": "{{eval:ya+2*q}}"
				},
				{
					"name": "N",
					"expression": "{{eval:4*(p^2+q^2)}}"
				},
				{
					"name": "R",
					"expression": "{{eval:sqrt(p^2+q^2)}}"
				}
			],
			"conditions": [],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(xa+xb)/2}}"
				},
				{
					"expectedAnswer": "{{eval:(ya+yb)/2}}"
				},
				{
					"expectedAnswer": "{{R}}"
				}
			],
			"correction": {
				"steps": [
					"L'ensemble des points $M$ tels que $\\overrightarrow{MA}\\cdot\\overrightarrow{MB}=0$ est le **cercle de diamètre $[AB]$** : son centre est le milieu $I$ de $[AB]$ et son rayon est $r=\\dfrac{AB}{2}$.",
					"$x_I=\\dfrac{x_A+x_B}{2}=\\dfrac{ {{xa}}+{{xb;()}} }{2}=\\textcolor{{{color:primary.0}}}{ {{eval:(xa+xb)/2}} }$ et $y_I=\\dfrac{y_A+y_B}{2}=\\dfrac{ {{ya}}+{{yb;()}} }{2}=\\textcolor{{{color:primary.0}}}{ {{eval:(ya+yb)/2}} }$",
					"$AB=\\sqrt{(x_B-x_A)^2+(y_B-y_A)^2}=\\sqrt{ {{eval:2*p;()}}^2+{{eval:2*q;()}}^2}=\\sqrt{ {{N}} }={{eval:2*R}}$",
					"$r=\\dfrac{AB}{2}=\\textcolor{{{color:primary.0}}}{ {{R}} }$"
				]
			}
		},
		{
			"statement": "Le plan est muni d'un repère orthonormé. On considère les points $A({{xa}}\\,;{{ya}})$ et $B({{xb}}\\,;{{yb}})$.\n\nL'ensemble des points $M$ du plan tels que $\\overrightarrow{MA}\\cdot\\overrightarrow{MB}=0$ est un cercle. Détermine les coordonnées $(x_I\\,;y_I)$ du centre $I$ de ce cercle et son rayon $r$. Donne $r$ sous sa forme exacte la plus simple.\n\n$x_I=?$\n\n$y_I=?$\n\n$r=?$",

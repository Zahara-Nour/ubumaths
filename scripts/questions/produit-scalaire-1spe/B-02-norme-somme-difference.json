		"blankDefaults": {
			"acceptDecimal": true
		}
	},
	"variations": [
		{
			"statement": "On donne $\\|\\vec{u}\\|={{a}}$, $\\|\\vec{v}\\|={{b}}$ et $\\vec{u}\\cdot\\vec{v}={{p}}$.\n\nCalcule $\\|\\vec{u}+\\vec{v}\\|^2$.\n\n$\\|\\vec{u}+\\vec{v}\\|^2=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..6"
				},
				{
					"name": "b",
					"expression": "2..6"
				},
				{
					"name": "p",
					"expression": "{{eval:max(-9,1-a*b)}}..{{eval:min(9,a*b-1)}}"
				},
				{
					"name": "R",
					"expression": "{{eval:a^2+2*p+b^2}}"
				}
			],
			"conditions": ["p != 0", "abs(p) < a*b"],
			"blanks": [
				{
					"expectedAnswer": "{{R}}"
				}
			],
			"correction": {
				"steps": [
					"$\\|\\vec{u}+\\vec{v}\\|^2=(\\vec{u}+\\vec{v})\\cdot(\\vec{u}+\\vec{v})$ : on développe par bilinéarité (comme une identité remarquable).",
					"$\\|\\vec{u}+\\vec{v}\\|^2=\\|\\vec{u}\\|^2+2\\,\\vec{u}\\cdot\\vec{v}+\\|\\vec{v}\\|^2$",
					"Donc $\\|\\vec{u}+\\vec{v}\\|^2={{eval:a^2}}+2\\times {{p;()}}+{{eval:b^2}}=\\textcolor{{{color:primary.0}}}{ {{R}} }$"
				]
			}
		},
		{
			"statement": "On donne $\\|\\vec{u}\\|={{a}}$, $\\|\\vec{v}\\|={{b}}$ et $\\vec{u}\\cdot\\vec{v}={{p}}$.\n\nCalcule $\\|\\vec{u}-\\vec{v}\\|^2$.\n\n$\\|\\vec{u}-\\vec{v}\\|^2=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..6"
				},
				{
					"name": "b",
					"expression": "2..6"
				},
				{
					"name": "p",
					"expression": "{{eval:max(-9,1-a*b)}}..{{eval:min(9,a*b-1)}}"
				},
				{
					"name": "R",
					"expression": "{{eval:a^2-2*p+b^2}}"
				}
			],
			"conditions": ["p != 0", "abs(p) < a*b"],
			"blanks": [
				{
					"expectedAnswer": "{{R}}"
				}
			],
			"correction": {
				"steps": [
					"$\\|\\vec{u}-\\vec{v}\\|^2=(\\vec{u}-\\vec{v})\\cdot(\\vec{u}-\\vec{v})$ : on développe par bilinéarité (comme une identité remarquable).",
					"$\\|\\vec{u}-\\vec{v}\\|^2=\\|\\vec{u}\\|^2-2\\,\\vec{u}\\cdot\\vec{v}+\\|\\vec{v}\\|^2$",
					"Donc $\\|\\vec{u}-\\vec{v}\\|^2={{eval:a^2}}-2\\times {{p;()}}+{{eval:b^2}}=\\textcolor{{{color:primary.0}}}{ {{R}} }$"
				]
			}
		},
		{
			"statement": "Deux vecteurs $\\vec{u}$ et $\\vec{v}$ vérifient $\\|\\vec{u}\\|={{a}}$, $\\|\\vec{v}\\|={{b}}$ et $\\|\\vec{u}+\\vec{v}\\|={{c}}$.\n\nCalcule $\\vec{u}\\cdot\\vec{v}$. Donne la valeur exacte.\n\n$\\vec{u}\\cdot\\vec{v}=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..6"
				},
				{
					"name": "b",
					"expression": "2..6"
				},
				{
					"name": "c",
					"expression": "2..9"
				},
				{
					"name": "R",
					"expression": "{{eval:(c^2-a^2-b^2)/2}}"
				}
			],
			"conditions": ["c > abs(a-b)", "c < a+b", "c^2 != a^2+b^2"],
			"blanks": [
				{
					"expectedAnswer": "{{R}}"
				}
			],
			"correction": {
				"steps": [
					"Par bilinéarité, $\\|\\vec{u}+\\vec{v}\\|^2=\\|\\vec{u}\\|^2+2\\,\\vec{u}\\cdot\\vec{v}+\\|\\vec{v}\\|^2$.",
					"Donc $\\vec{u}\\cdot\\vec{v}=\\dfrac{1}{2}\\left(\\|\\vec{u}+\\vec{v}\\|^2-\\|\\vec{u}\\|^2-\\|\\vec{v}\\|^2\\right)$.",
					"$\\vec{u}\\cdot\\vec{v}=\\dfrac{1}{2}\\left({{eval:c^2}}-{{eval:a^2}}-{{eval:b^2}}\\right)=\\dfrac{ {{eval:c^2-a^2-b^2}} }{2}=\\textcolor{{{color:primary.0}}}{ {{R}} }$"
				]
			}
		},
		{
			"statement": "On donne $\\|\\vec{u}\\|={{a}}$, $\\|\\vec{v}\\|={{b}}$ et $\\vec{u}\\cdot\\vec{v}={{p}}$.\n\nCalcule $\\|\\vec{u}-\\vec{v}\\|$. Donne sa valeur exacte sous la forme $k\\sqrt{n}$, où $k$ et $n$ sont des entiers et $n$ est le plus petit possible.\n\n$\\|\\vec{u}-\\vec{v}\\|=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..6"
				},
				{
					"name": "b",
					"expression": "2..6"
				},
				{
					"name": "p",
					"expression": "{{eval:max(-9,1-a*b)}}..{{eval:min(9,a*b-1)}}"
				},
				{
					"name": "N",
					"expression": "{{eval:a^2-2*p+b^2}}"
				},
				{
					"name": "R",
					"expression": "{{eval:sqrt(N)}}"
				}
			],
			"conditions": ["p != 0", "abs(p) < a*b", "sqrt(N) != round(sqrt(N))"],
			"blanks": [
				{
					"expectedAnswer": "{{R}}"
				}
			],
			"correction": {
				"steps": [
					"$\\|\\vec{u}-\\vec{v}\\|^2=(\\vec{u}-\\vec{v})\\cdot(\\vec{u}-\\vec{v})$ : on développe par bilinéarité (comme une identité remarquable).",
					"$\\|\\vec{u}-\\vec{v}\\|^2=\\|\\vec{u}\\|^2-2\\,\\vec{u}\\cdot\\vec{v}+\\|\\vec{v}\\|^2$",
					"$\\|\\vec{u}-\\vec{v}\\|^2={{eval:a^2}}-2\\times {{p;()}}+{{eval:b^2}}={{N}}$",
					"Une norme est positive, donc $\\|\\vec{u}-\\vec{v}\\|=\\sqrt{ {{N}} }=\\textcolor{{{color:primary.0}}}{ {{R}} }$"
				]
			}
		}
	],

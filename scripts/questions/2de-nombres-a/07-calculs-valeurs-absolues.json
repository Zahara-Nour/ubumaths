{
	"title": "Calculer avec plusieurs valeurs absolues",
	"description": "Somme, différence, produit de valeurs absolues, valeur absolue imbriquée (pièges : |b − c| gardé négatif, |−a| = −a, ordre des calculs)",
	"grades": ["2"],
	"level": 10,
	"delay": 45,
	"status": "draft",
	"variations": [
		{
			"statement": "Calcule $A=\\lvert -{{a}}\\rvert+\\lvert {{b}}-{{c}}\\rvert$.\n\n$A=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "b",
					"expression": "1..9"
				},
				{
					"name": "c",
					"expression": "2..15"
				}
			],
			"conditions": ["b < c"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a+c-b}}"
				}
			],
			"correction": {
				"steps": [
					"$\\lvert -{{a}}\\rvert={{a}}$ et $\\lvert {{b}}-{{c}}\\rvert=\\lvert {{eval:b-c}}\\rvert={{eval:c-b}}$ : une valeur absolue n'est jamais négative.",
					"$A={{a}}+{{eval:c-b}}=\\textcolor{{{color:primary.0}}}{{{eval:a+c-b}}}$."
				]
			}
		},
		{
			"statement": "Calcule $A=\\lvert {{b}}-{{c}}\\rvert-\\lvert -{{a}}\\rvert$.\n\n$A=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "b",
					"expression": "1..9"
				},
				{
					"name": "c",
					"expression": "2..15"
				}
			],
			"conditions": ["b < c"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:c-b-a}}"
				}
			],
			"correction": {
				"steps": [
					"$\\lvert {{b}}-{{c}}\\rvert=\\lvert {{eval:b-c}}\\rvert={{eval:c-b}}$ et $\\lvert -{{a}}\\rvert={{a}}$.",
					"$A={{eval:c-b}}-{{a}}=\\textcolor{{{color:primary.0}}}{{{eval:c-b-a}}}$."
				]
			}
		},
		{
			"statement": "Calcule $A=\\lvert -{{a}}\\rvert\\times\\lvert {{b}}-{{c}}\\rvert$.\n\n$A=?$",
			"variables": [
				{
					"name": "a",
					"expression": "2..9"
				},
				{
					"name": "b",
					"expression": "1..9"
				},
				{
					"name": "c",
					"expression": "2..12"
				}
			],
			"conditions": ["b < c"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:a*(c-b)}}"
				}
			],
			"correction": {
				"steps": [
					"$\\lvert -{{a}}\\rvert={{a}}$ et $\\lvert {{b}}-{{c}}\\rvert=\\lvert {{eval:b-c}}\\rvert={{eval:c-b}}$.",
					"$A={{a}}\\times{{eval:c-b}}=\\textcolor{{{color:primary.0}}}{{{eval:a*(c-b)}}}$."
				]
			}
		},
		{
			"statement": "Calcule $A=\\left\\lvert \\lvert -{{a}}\\rvert-{{b}}\\right\\rvert$.\n\n$A=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..9"
				},
				{
					"name": "w",
					"expression": "1..9"
				},
				{
					"name": "b",
					"expression": "eval:a+w"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:b-a}}"
				}
			],
			"correction": {
				"steps": [
					"On calcule d'abord la valeur absolue **intérieure** : $\\lvert -{{a}}\\rvert={{a}}$.",
					"$A=\\lvert {{a}}-{{b}}\\rvert=\\lvert {{eval:a-b}}\\rvert=\\textcolor{{{color:primary.0}}}{{{eval:b-a}}}$."
				]
			}
		}
	],

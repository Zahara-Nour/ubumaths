	"title": "Compter les entiers d'un intervalle",
	"description": "Nombre d'entiers d'un intervalle à bornes décimales ou entières (crochets ouverts ou fermés), plus petit entier d'un intervalle (pièges : bornes exclues comptées, −2,5 → −3)",
	"grades": ["2"],
	"level": 5,
	"delay": 45,
	"status": "draft",
	"variations": [
		{
			"statement": "Combien de nombres **entiers** l'intervalle $\\left[{{eval:(10*la+fa)/10;d}}\\,;{{eval:(10*lb+fb)/10;d}}\\right]$ contient-il ?\n\n$?$ entiers",
			"variables": [
				{
					"name": "la",
					"expression": "-9..4"
				},
				{
					"name": "w",
					"expression": "2..8"
				},
				{
					"name": "lb",
					"expression": "eval:la+w"
				},
				{
					"name": "fa",
					"expression": "1..9"
				},
				{
					"name": "fb",
					"expression": "1..9"
				},
				{
					"name": "m",
					"expression": "eval:la+1"
				},
				{
					"name": "M",
					"expression": "eval:lb"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:w}}"
				}
			],
			"correction": {
				"steps": [
					"Les bornes ne sont pas entières. Le plus petit entier de l'intervalle est ${{eval:la+1}}$ (le premier entier **après** ${{eval:(10*la+fa)/10;d}}$), le plus grand est ${{eval:lb}}$.",
					"On compte les entiers de ${{eval:la+1}}$ à ${{eval:lb}}$ : {{if:m<0|${{eval:M}}-({{eval:m}})+1=\\textcolor{{{color:primary.0}}}{{{eval:M-(m)+1}}}$|${{eval:M}}-{{eval:m}}+1=\\textcolor{{{color:primary.0}}}{{{eval:M-(m)+1}}}$}}."
				]
			}
		},
		{
			"statement": "Combien de nombres **entiers** l'intervalle $\\left{{if:o1==0|[|]}}{{a}}\\,;{{b}}\\right{{if:o2==0|]|[}}$ contient-il ?\n\n$?$ entiers",
			"variables": [
				{
					"name": "a",
					"expression": "-9..5"
				},
				{
					"name": "w",
					"expression": "2..9"
				},
				{
					"name": "b",
					"expression": "eval:a+w"
				},
				{
					"name": "o1",
					"expression": "0|1"
				},
				{
					"name": "o2",
					"expression": "0|1"
				},
				{
					"name": "m",
					"expression": "eval:a+o1"
				},
				{
					"name": "M",
					"expression": "eval:b-o2"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:w+1-o1-o2}}"
				}
			],
			"correction": {
				"steps": [
					"{{if:o1==0|Le crochet est **fermé** en ${{a}}$ : ${{a}}$ est dans l'intervalle.|Le crochet est **ouvert** en ${{a}}$ : ${{a}}$ n'est **pas** dans l'intervalle.}} {{if:o2==0|Le crochet est **fermé** en ${{b}}$ : ${{b}}$ est dans l'intervalle.|Le crochet est **ouvert** en ${{b}}$ : ${{b}}$ n'est **pas** dans l'intervalle.}}",
					"Les entiers vont de ${{eval:m}}$ à ${{eval:M}}$ : {{if:m<0|${{eval:M}}-({{eval:m}})+1=\\textcolor{{{color:primary.0}}}{{{eval:M-(m)+1}}}$|${{eval:M}}-{{eval:m}}+1=\\textcolor{{{color:primary.0}}}{{{eval:M-(m)+1}}}$}}."
				]
			}
		},
		{
			"statement": "Quel est le **plus petit** nombre entier de l'intervalle $\\left{{if:o1==0|[|]}}{{a}}\\,;{{b}}\\right]$ ?\n\n$?$",
			"variables": [
				{
					"name": "a",

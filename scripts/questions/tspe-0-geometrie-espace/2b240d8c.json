				},
				{
					"name": "p2",
					"expression": "-3..3"
				},
				{
					"name": "p3",
					"expression": "-3..3"
				},
				{
					"name": "q1",
					"expression": "-3..3"
				},
				{
					"name": "q2",
					"expression": "-3..3"
				},
				{
					"name": "q3",
					"expression": "-3..3"
				},
				{
					"name": "bx",
					"expression": "{{eval:ax+p1}}"
				},
				{
					"name": "by",

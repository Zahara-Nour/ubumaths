{
	"title": "Espace : point d'un plan, coordonnée manquante",
	"description": "Trouver la coordonnée manquante d'un point appartenant à un plan donné par une équation cartésienne (pièges : signe, division oubliée)",
	"grades": ["T_SPE"],
	"points": ["TSPE-092", "TSPE-096"],
	"theme": "Géométrie",
	"domain": "Représentations paramétriques et équations cartésiennes",
	"subdomain": "Équation cartésienne d'un plan",
	"level": 1,
	"status": "draft",
	"delay": 60,
	"shared": {
		"cleanCoefficients": true,
		"blankDefaults": {
			"acceptDecimal": true
		}
	},
	"variations": [
		{
			"statement": "Dans l'espace muni d'un repère orthonormé, on considère le plan $\\mathcal{P}$ d'équation ${{a}}x+({{b}})y+({{c}})z+({{d}})=0$ et le point $M({{mx}}\\,;\\,{{my}}\\,;\\,m)$.\n\nDétermine $m$ pour que $M$ appartienne à $\\mathcal{P}$.\n\n$m=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "b",
					"expression": "1..5;±"
				},
				{
					"name": "c",
					"expression": "1..4;±"
				},
				{
					"name": "mx",
					"expression": "-5..5"
				},
				{
					"name": "my",
					"expression": "-5..5"
				},
				{
					"name": "mz",
					"expression": "-5..5"
				},
				{
					"name": "d",
					"expression": "{{eval:-(a*mx+b*my+c*mz)}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{mz}}"
				}
			],
			"correction": {
				"steps": [
					"$M\\in\\mathcal{P}\\iff{{a}}\\times{{mx;()}}+{{b;()}}\\times{{my;()}}+{{c;()}}\\times m{{d;+}}=0$, soit ${{eval:a*mx+b*my+d}}+{{c;()}}m=0$.",
					"Donc $\\textcolor{{{color:primary.0}}}{ m={{mz}} }$."
				]
			}
		},
		{
			"statement": "Dans l'espace muni d'un repère orthonormé, on considère le plan $\\mathcal{P}$ d'équation ${{a}}x+({{b}})y+({{c}})z+({{d}})=0$ et le point $M(m\\,;\\,{{my}}\\,;\\,{{mz}})$.\n\nDétermine $m$ pour que $M$ appartienne à $\\mathcal{P}$.\n\n$m=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..4;±"
				},
				{
					"name": "b",
					"expression": "1..5;±"
				},
				{
					"name": "c",
					"expression": "1..5;±"
				},
				{
					"name": "mx",
					"expression": "-5..5"
				},
				{
					"name": "my",
					"expression": "-5..5"
				},
				{
					"name": "mz",
					"expression": "-5..5"
				},
				{
					"name": "d",
					"expression": "{{eval:-(a*mx+b*my+c*mz)}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{mx}}"
				}
			],
			"correction": {
				"steps": [
					"$M\\in\\mathcal{P}\\iff{{a}}m+{{b;()}}\\times{{my;()}}+{{c;()}}\\times{{mz;()}}{{d;+}}=0$, soit ${{a}}m{{eval:b*my+c*mz+d;+}}=0$.",
					"Donc $\\textcolor{{{color:primary.0}}}{ m={{mx}} }$."
				]
			}
		}
	],

			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:-(n1*ix+n2*iy+n3*iz)}}"
				}
			],
			"correction": {
				"steps": [
					"Le plan médiateur de $[AB]$ passe par le milieu $I({{ix}}\\,;\\,{{iy}}\\,;\\,{{iz}})$ et admet $\\overrightarrow{AB}\\begin{pmatrix}{{n1}}\\\\{{n2}}\\\\{{n3}}\\end{pmatrix}$ pour vecteur normal.",
					"$I$ appartient au plan : ${{n1}}\\times{{ix;()}}+{{n2;()}}\\times{{iy;()}}+{{n3;()}}\\times{{iz;()}}+d=0$, donc $\\textcolor{{{color:primary.0}}}{ d={{eval:-(n1*ix+n2*iy+n3*iz)}} }$."
				]
			}
		},
		{
			"statement": "Dans l'espace muni d'un repère orthonormé, on considère le point $A({{ax}}\\,;\\,{{ay}}\\,;\\,{{az}})$ et le plan $\\mathcal{Q}$ d'équation ${{a}}x+({{b}})y+({{c}})z+({{q}})=0$.\n\nLe plan $\\mathcal{P}$ passant par $A$ et parallèle à $\\mathcal{Q}$ a une équation de la forme ${{a}}x+({{b}})y+({{c}})z+d=0$. Détermine $d$.\n\n$d=?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "b",
					"expression": "-5..5"
				},
				{
					"name": "c",
					"expression": "1..5;±"
				},
				{
					"name": "ax",
					"expression": "-5..5"
				},
				{
					"name": "ay",
					"expression": "-5..5"
				},
				{
					"name": "az",
					"expression": "1..5;±"
				},
				{
					"name": "q",
					"expression": "1..9;±"
				}
			],
			"conditions": ["a*ax+b*ay+c*az+q != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:-(a*ax+b*ay+c*az)}}"
				}
			],
			"correction": {
				"steps": [
					"$\\mathcal{P}$ est parallèle à $\\mathcal{Q}$ : il a le même vecteur normal $\\vec{n}\\begin{pmatrix}{{a}}\\\\{{b}}\\\\{{c}}\\end{pmatrix}$, mais pas le même $d$ ($A\\notin\\mathcal{Q}$).",
					"$A\\in\\mathcal{P}$ : ${{a}}\\times{{ax;()}}+{{b;()}}\\times{{ay;()}}+{{c;()}}\\times{{az;()}}+d=0$, donc $\\textcolor{{{color:primary.0}}}{ d={{eval:-(a*ax+b*ay+c*az)}} }$."
				]
			}
		}
	],

	"variations": [
		{
			"statement": "Dans l'espace muni d'un repère, on considère les points $A({{ax}}\\,;\\,{{ay}}\\,;\\,{{az}})$ et $B({{bx}}\\,;\\,{{by}}\\,;\\,{{bz}})$.\n\nDonne les coordonnées du vecteur $\\overrightarrow{AB}$ : $?$",
			"variables": [
				{
					"name": "ax",
					"expression": "-6..6"
				},
				{
					"name": "ay",
					"expression": "-6..6"
				},
				{
					"name": "az",
					"expression": "-6..6"
				},
				{
					"name": "bx",
					"expression": "-6..6"
				},
				{
					"name": "by",
					"expression": "-6..6"
				},
				{
					"name": "bz",
					"expression": "-6..6"
				}
			],
			"conditions": ["abs(bx-ax)+abs(by-ay)+abs(bz-az) > 0"],
			"blanks": [
				{
					"expectedAnswer": "({{eval:bx-ax}};{{eval:by-ay}};{{eval:bz-az}})",
					"answerKind": "vecteur"
				}
			],
			"correction": {
				"steps": [
					"$\\overrightarrow{AB}\\begin{pmatrix}x_B-x_A\\\\y_B-y_A\\\\z_B-z_A\\end{pmatrix}$ : on retranche les coordonnées de l'origine $A$ à celles de l'extrémité $B$.",
					"$\\overrightarrow{AB}\\begin{pmatrix}{{bx}}-{{ax;()}}\\\\{{by}}-{{ay;()}}\\\\{{bz}}-{{az;()}}\\end{pmatrix}$, soit $\\overrightarrow{AB}\\textcolor{{{color:primary.0}}}{ \\begin{pmatrix}{{eval:bx-ax}}\\\\{{eval:by-ay}}\\\\{{eval:bz-az}}\\end{pmatrix} }$."
				]
			}
		},
		{
			"statement": "Dans l'espace muni d'un repère, on considère les vecteurs $\\vec{u}\\begin{pmatrix}{{u1}}\\\\{{u2}}\\\\{{u3}}\\end{pmatrix}$ et $\\vec{v}\\begin{pmatrix}{{v1}}\\\\{{v2}}\\\\{{v3}}\\end{pmatrix}$.\n\nDonne les coordonnées du vecteur $\\vec{w}={{p}}\\vec{u}{{q;+}}\\vec{v}$ : $?$",
			"variables": [
				{
					"name": "u1",
					"expression": "-5..5"
				},
				{
					"name": "u2",
					"expression": "-5..5"
				},
				{
					"name": "u3",
					"expression": "-5..5"
				},
				{
					"name": "v1",
					"expression": "-5..5"
				},
				{
					"name": "v2",
					"expression": "-5..5"
				},
				{
					"name": "v3",
					"expression": "-5..5"
				},
				{
					"name": "p",
					"expression": "2..4"
				},
				{
					"name": "q",
					"expression": "2..4;±"
				}
			],
			"conditions": ["abs(u1)+abs(u2)+abs(u3) > 0", "abs(v1)+abs(v2)+abs(v3) > 0"],
			"blanks": [
				{
					"expectedAnswer": "({{eval:p*u1+q*v1}};{{eval:p*u2+q*v2}};{{eval:p*u3+q*v3}})",
					"answerKind": "vecteur"
				}
			],
			"correction": {
				"steps": [
					"On calcule coordonnée par coordonnée : $\\vec{w}\\begin{pmatrix}{{p}}\\times{{u1;()}}+{{q;()}}\\times{{v1;()}}\\\\{{p}}\\times{{u2;()}}+{{q;()}}\\times{{v2;()}}\\\\{{p}}\\times{{u3;()}}+{{q;()}}\\times{{v3;()}}\\end{pmatrix}$",
					"$\\vec{w}\\textcolor{{{color:primary.0}}}{ \\begin{pmatrix}{{eval:p*u1+q*v1}}\\\\{{eval:p*u2+q*v2}}\\\\{{eval:p*u3+q*v3}}\\end{pmatrix} }$"
				]
			}
		},
		{
			"statement": "Dans l'espace muni d'un repère, on considère les points $A({{ax}}\\,;\\,{{ay}}\\,;\\,{{az}})$ et $B({{bx}}\\,;\\,{{by}}\\,;\\,{{bz}})$.\n\nDonne les coordonnées du milieu $I$ du segment $[AB]$.\n\n$I(?\\,;\\,?\\,;\\,?)$",
			"variables": [
				{
					"name": "ax",
					"expression": "-6..6"
				},
				{
					"name": "ay",
					"expression": "-6..6"
				},
				{
					"name": "az",
					"expression": "-6..6"
				},
				{
					"name": "bx",
					"expression": "-6..6"
				},
				{
					"name": "by",
					"expression": "-6..6"
				},
				{
					"name": "bz",
					"expression": "-6..6"
				}
			],
			"conditions": ["abs(bx-ax)+abs(by-ay)+abs(bz-az) > 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(ax+bx)/2}}"
				},
				{
					"expectedAnswer": "{{eval:(ay+by)/2}}"
				},
				{
					"expectedAnswer": "{{eval:(az+bz)/2}}"
				}
			],
			"correction": {
				"steps": [
					"$I\\left(\\dfrac{x_A+x_B}{2}\\,;\\,\\dfrac{y_A+y_B}{2}\\,;\\,\\dfrac{z_A+z_B}{2}\\right)$ : on fait la moyenne des coordonnées.",
					"$I\\left(\\dfrac{ {{ax}}+{{bx;()}} }{2}\\,;\\,\\dfrac{ {{ay}}+{{by;()}} }{2}\\,;\\,\\dfrac{ {{az}}+{{bz;()}} }{2}\\right)$, soit $\\textcolor{{{color:primary.0}}}{ I\\left({{eval:(ax+bx)/2}}\\,;\\,{{eval:(ay+by)/2}}\\,;\\,{{eval:(az+bz)/2}}\\right) }$."
				]
			}
		},
		{
			"statement": "Dans l'espace muni d'un repère, on considère le point $A({{ax}}\\,;\\,{{ay}}\\,;\\,{{az}})$ et le vecteur $\\vec{u}\\begin{pmatrix}{{u1}}\\\\{{u2}}\\\\{{u3}}\\end{pmatrix}$.\n\nLe point $C$ est l'image de $A$ par la translation de vecteur $\\vec{u}$. Donne ses coordonnées.\n\n$C(?\\,;\\,?\\,;\\,?)$",
			"variables": [
				{
					"name": "ax",
					"expression": "-6..6"
				},
				{
					"name": "ay",
					"expression": "-6..6"
				},
				{
					"name": "az",
					"expression": "-6..6"
				},
				{
					"name": "u1",
					"expression": "-5..5"
				},
				{
					"name": "u2",
					"expression": "-5..5"
				},
				{
					"name": "u3",
					"expression": "-5..5"
				}
			],
			"conditions": ["abs(u1)+abs(u2)+abs(u3) > 0"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:ax+u1}}"
				},
				{
					"expectedAnswer": "{{eval:ay+u2}}"
				},
				{
					"expectedAnswer": "{{eval:az+u3}}"
				}
			],
			"correction": {
				"steps": [
					"$C$ est l'image de $A$ par la translation de vecteur $\\vec{u}$ si et seulement si $\\overrightarrow{AC}=\\vec{u}$, c'est-à-dire $x_C=x_A+x_{\\vec{u}}$, et de même pour $y$ et $z$.",
					"$x_C={{ax}}+{{u1;()}}$, $y_C={{ay}}+{{u2;()}}$, $z_C={{az}}+{{u3;()}}$, donc $\\textcolor{{{color:primary.0}}}{ C\\left({{eval:ax+u1}}\\,;\\,{{eval:ay+u2}}\\,;\\,{{eval:az+u3}}\\right) }$."
				]
			}
		},
		{
			"statement": "Dans l'espace muni d'un repère, on considère les points $A({{ax}}\\,;\\,{{ay}}\\,;\\,{{az}})$, $B({{bx}}\\,;\\,{{by}}\\,;\\,{{bz}})$ et $C({{cx}}\\,;\\,{{cy}}\\,;\\,{{cz}})$.\n\nDonne les coordonnées du point $D$ tel que $ABCD$ soit un parallélogramme.\n\n$D(?\\,;\\,?\\,;\\,?)$",
			"variables": [
				{
					"name": "ax",
					"expression": "-6..6"
				},
				{
					"name": "ay",
					"expression": "-6..6"
				},
				{
					"name": "az",
					"expression": "-6..6"
				},
				{
					"name": "bx",
					"expression": "-6..6"
				},
				{
					"name": "by",
					"expression": "-6..6"
				},
				{
					"name": "bz",
					"expression": "-6..6"
				},
				{
					"name": "cx",
					"expression": "-6..6"
				},
				{
					"name": "cy",
					"expression": "-6..6"
				},
				{
					"name": "cz",
					"expression": "-6..6"
				}
			],
			"conditions": [
				"(by-ay)*(cz-az)-(bz-az)*(cy-ay) != 0 || (bz-az)*(cx-ax)-(bx-ax)*(cz-az) != 0 || (bx-ax)*(cy-ay)-(by-ay)*(cx-ax) != 0"
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:ax+cx-bx}}"
				},
				{
					"expectedAnswer": "{{eval:ay+cy-by}}"
				},
				{
					"expectedAnswer": "{{eval:az+cz-bz}}"
				}
			],
			"correction": {
				"steps": [
					"$ABCD$ est un parallélogramme si et seulement si $\\overrightarrow{AD}=\\overrightarrow{BC}$, soit $x_D=x_A+x_C-x_B$, et de même pour $y$ et $z$.",
					"$\\overrightarrow{BC}\\begin{pmatrix}{{eval:cx-bx}}\\\\{{eval:cy-by}}\\\\{{eval:cz-bz}}\\end{pmatrix}$, donc $\\textcolor{{{color:primary.0}}}{ D\\left({{eval:ax+cx-bx}}\\,;\\,{{eval:ay+cy-by}}\\,;\\,{{eval:az+cz-bz}}\\right) }$."
				]
			}
		}
	],

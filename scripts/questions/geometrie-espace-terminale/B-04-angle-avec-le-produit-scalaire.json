				},
				{
					"name": "cx",
					"expression": "{{eval:ax+b}}"
				},
				{
					"name": "cy",
					"expression": "{{ay}}"
				},
				{
					"name": "cz",
					"expression": "{{eval:az+b}}"
				},
				{
					"name": "T",
					"expression": "{{eval:90-45*sign(a*b)}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{T}}"
				}
			],
			"correction": {
				"steps": [
					"$\\overrightarrow{AB}\\begin{pmatrix}0\\\\0\\\\{{a}}\\end{pmatrix}$, $\\overrightarrow{AC}\\begin{pmatrix}{{b}}\\\\0\\\\{{b}}\\end{pmatrix}$, donc $\\overrightarrow{AB}\\cdot\\overrightarrow{AC}={{eval:a*b}}$, $AB={{eval:abs(a)}}$ et $AC={{eval:abs(b)*sqrt(2)}}$.",
					"$\\cos\\widehat{BAC}=\\dfrac{\\overrightarrow{AB}\\cdot\\overrightarrow{AC}}{AB\\times AC}={{eval:sign(a*b)*sqrt(2)/2}}$, donc $\\textcolor{{{color:primary.0}}}{ \\widehat{BAC}={{T}}^\\circ }$."
				]
			}
		}
	],

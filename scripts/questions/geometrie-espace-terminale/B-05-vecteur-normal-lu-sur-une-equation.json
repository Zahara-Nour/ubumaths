{
	"title": "Espace : vecteur normal lu sur une équation de plan",
	"description": "Lire un vecteur normal sur une équation cartésienne (terme absent, membres à regrouper) ; tout vecteur colinéaire non nul est juste (pièges : d pris pour une coordonnée, z oublié, signe)",
	"grades": ["T_SPE"],
	"points": ["TSPE-075", "TSPE-092", "TSPE-096"],
	"theme": "Géométrie",
	"domain": "Représentations paramétriques et équations cartésiennes",
	"subdomain": "Vecteur normal à un plan",
	"level": 1,
	"status": "draft",
	"delay": 45,
	"shared": {
		"cleanCoefficients": true,
		"blankDefaults": {
			"answerKind": "vecteur",
			"vectorMode": "colineaire"
		}
	},
	"variations": [
		{
			"statement": "Dans l'espace muni d'un repère orthonormé, on considère le plan $\\mathcal{P}$ d'équation ${{a}}x+({{b}})y+({{c}})z+({{d}})=0$.\n\nDonne un vecteur normal au plan $\\mathcal{P}$ : $?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..6;±"
				},
				{
					"name": "b",
					"expression": "1..6;±"
				},
				{
					"name": "c",
					"expression": "1..6;±"
				},
				{
					"name": "d",
					"expression": "1..9;±"
				}
			],
			"conditions": ["abs(a) != abs(b) || abs(b) != abs(c)"],
			"blanks": [
				{
					"expectedAnswer": "({{a}};{{b}};{{c}})"
				}
			],
			"correction": {
				"steps": [
					"Le plan d'équation $ax+by+cz+d=0$ admet pour vecteur normal $\\vec{n}\\begin{pmatrix}a\\\\b\\\\c\\end{pmatrix}$ : on lit les coefficients de $x$, $y$ et $z$.",
					"Ici $\\textcolor{{{color:primary.0}}}{ \\vec{n}\\begin{pmatrix}{{a}}\\\\{{b}}\\\\{{c}}\\end{pmatrix} }$ ; tout vecteur colinéaire non nul convient aussi."
				]
			}
		},
		{
			"statement": "Dans l'espace muni d'un repère orthonormé, on considère le plan $\\mathcal{P}$ d'équation ${{a}}x+({{c}})z+({{d}})=0$.\n\nDonne un vecteur normal au plan $\\mathcal{P}$ : $?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..6;±"
				},
				{
					"name": "c",
					"expression": "1..6;±"
				},
				{
					"name": "d",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "({{a}};0;{{c}})"
				}
			],
			"correction": {
				"steps": [
					"L'équation s'écrit ${{a}}x+0y+({{c}})z+({{d}})=0$ : le coefficient de $y$ est nul.",
					"Un vecteur normal est $\\textcolor{{{color:primary.0}}}{ \\vec{n}\\begin{pmatrix}{{a}}\\\\0\\\\{{c}}\\end{pmatrix} }$."
				]
			}
		},
		{
			"statement": "Dans l'espace muni d'un repère orthonormé, on considère le plan $\\mathcal{P}$ d'équation ${{a}}x+({{b}})y={{c}}z+({{d}})$.\n\nDonne un vecteur normal au plan $\\mathcal{P}$ : $?$",
			"variables": [
				{
					"name": "a",
					"expression": "1..6;±"
				},
				{
					"name": "b",
					"expression": "1..6;±"
				},
				{
					"name": "c",
					"expression": "1..6;±"
				},
				{
					"name": "d",
					"expression": "1..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "({{a}};{{b}};{{eval:-c}})"
				}
			],
			"correction": {
				"steps": [
					"On écrit d'abord l'équation sous la forme $ax+by+cz+d=0$ : ${{a}}x+({{b}})y+({{eval:-c}})z+({{eval:-d}})=0$.",
					"Un vecteur normal est $\\textcolor{{{color:primary.0}}}{ \\vec{n}\\begin{pmatrix}{{a}}\\\\{{b}}\\\\{{eval:-c}}\\end{pmatrix} }$."
				]
			}
		}
	],

			"conditions": ["x1 != 0", "x2 != 0", "al != 0"],
			"blanks": [
				{
					"expectedAnswer": "{{a}}(x{{eval:-al;+}})^2{{eval:be;+}}",
					"requiredForm": {
						"pattern": "u*($x+v)^2+w"
					},
					"expectedErrors": [
						{
							"answer": "{{a}}(x{{eval:-al;+}})^2{{eval:-be;+}}",
							"message": "$\\beta=f(\\alpha)$ : calcule $f({{al}})={{a}}\\times{{eval:al-x1;()}}\\times{{eval:al-x2;()}}$ ; attention au signe.",
							"label": "Signe de β"
						},
						{
							"answer": "{{a}}(x{{eval:-al;+}})^2{{eval:-k^2;+}}",
							"message": "Tu as oublié le facteur ${{a}}$ en calculant $\\beta=f({{al}})$.",
							"label": "Facteur a oublié dans β"
						},
						{
							"answer": "{{a}}(x{{eval:al;+}})^2{{eval:be;+}}",
							"message": "$\\alpha$ est le milieu des racines : $\\dfrac{ {{x1}}{{eval:x2;+}} }{2}={{al}}$ ; attention au signe dans $(x-\\alpha)^2$.",
							"label": "Signe de α"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"L'axe de symétrie passe par le milieu des racines : $\\alpha=\\dfrac{ {{x1}}{{eval:x2;+}} }{2}={{al}}$.",
					"$\\beta=P({{al}})={{a}}\\times{{eval:al-x1;()}}\\times{{eval:al-x2;()}}={{be}}$.",
					"Donc $P(x)=\\textcolor{{{color:primary.0}}}{ {{a}}(x{{eval:-al;+}})^2{{eval:be;+}}}$."
				]
			},
			"hint": "L'abscisse du sommet est le milieu des deux racines ; l'ordonnée est l'image de ce milieu."
		}
	],

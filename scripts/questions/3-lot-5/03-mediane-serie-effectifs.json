{
	"title": "Médiane d'une série à effectifs",
	"description": "Donner la médiane d'une série donnée par un tableau d'effectifs ou un diagramme en barres, par les effectifs cumulés",
	"grades": ["3"],
	"theme": "Statistiques",
	"domain": "Indicateurs",
	"subdomain": "Médiane à effectifs",

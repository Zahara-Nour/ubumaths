				},
				{
					"name": "C5",
					"expression": "eval:n0+n1+n2+n3+n4+n5"
				},
				{
					"name": "N",
					"expression": "eval:C5"
				},
				{
					"name": "M",
					"expression": "{{if:2*C0>=N+1|0|{{if:2*C1>=N+1|1|{{if:2*C2>=N+1|2|{{if:2*C3>=N+1|3|{{if:2*C4>=N+1|4|5}}}}}}}}}}"
				}
			],
			"conditions": ["N-2*floor(N/2)==1"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:4+M}}"
				}
			],
			"correction": {
				"steps": [
					"L'effectif total est ${{N}}$, impair : la médiane est la ${{eval:(N+1)/2}}^{\\text{e}}$ valeur de la série rangée, car $\\dfrac{ {{N}} + 1}{2} = {{eval:(N+1)/2}}$.",
					"Effectifs cumulés croissants : $4$ → ${{C0}}$ ; $5$ → ${{C1}}$ ; $6$ → ${{C2}}$ ; $7$ → ${{C3}}$ ; $8$ → ${{C4}}$ ; $9$ → ${{C5}}$.",
					"Le premier effectif cumulé qui atteint ${{eval:(N+1)/2}}$ est celui de $\\textcolor{{{color:primary.0}}}{{{eval:4+M}}}$."
				]
			}
		},

{
	"title": "Ranger des fractions décimales",
	"description": "Ranger dans l'ordre croissant ou décroissant quatre nombres : un entier, des dixièmes, des centièmes et des millièmes (9/10 ; 1 201/1 000 ; 140/100 ; 2)",
	"grades": ["CM2"],
	"theme": "Fractions",
	"domain": "Apprivoiser",
	"subdomain": "Ordonner",
	"level": 4,
	"delay": 60,
	"status": "draft",
	"options": {
		"constraints": {
			"reducedFractions": "off",
			"spacesFromFourDigits": true
		}
	},
	"variations": [
		{
			"statement": "Range ces nombres du plus petit au plus grand.\n\n```ranger\nsigne: <\n- $\\frac{{{a}}}{10}$\n- $\\frac{{{b}}}{1000}$\n- $\\frac{{{c}}}{100}$\n- ${{m}}$\n```",
			"variables": [
				{
					"name": "m",
					"expression": "2..5"
				},
				{
					"name": "k",
					"expression": "eval:m-1"
				},
				{
					"name": "a",
					"expression": "{{eval:10*k-9}}..{{eval:10*k-1}}"
				},
				{
					"name": "c",
					"expression": "{{eval:100*k+11}}..{{eval:100*m-1}}"
				},
				{
					"name": "b",
					"expression": "{{eval:1000*k+1}}..{{eval:10*c-1}}"
				}
			],
			"conditions": ["mod(b,10)!=0"],
			"correction": {
				"steps": [
					"**Tout en millièmes.** $\\frac{{{a}}}{10} = \\frac{{{eval:100*a}}}{1000}$, $\\frac{{{c}}}{100} = \\frac{{{eval:10*c}}}{1000}$, ${{m}} = \\frac{{{eval:1000*m}}}{1000}$ : on compare les numérateurs ${{eval:100*a}}$, ${{b}}$, ${{eval:10*c}}$ et ${{eval:1000*m}}$.",
					"$$\\frac{{{a}}}{10} < \\frac{{{b}}}{1000} < \\frac{{{c}}}{100} < {{m}}$$"
				]
			}
		},
		{
			"statement": "Range ces nombres du plus grand au plus petit.\n\n```ranger\nsigne: >\n- ${{m}}$\n- $\\frac{{{c}}}{100}$\n- $\\frac{{{b}}}{1000}$\n- $\\frac{{{a}}}{10}$\n```",
			"variables": [
				{
					"name": "m",
					"expression": "2..5"
				},
				{
					"name": "k",
					"expression": "eval:m-1"
				},
				{
					"name": "a",
					"expression": "{{eval:10*k-9}}..{{eval:10*k-1}}"
				},
				{
					"name": "c",
					"expression": "{{eval:100*k+11}}..{{eval:100*m-1}}"
				},
				{
					"name": "b",
					"expression": "{{eval:1000*k+1}}..{{eval:10*c-1}}"
				}
			],
			"conditions": ["mod(b,10)!=0"],
			"correction": {
				"steps": [
					"**Tout en millièmes.** $\\frac{{{a}}}{10} = \\frac{{{eval:100*a}}}{1000}$, $\\frac{{{c}}}{100} = \\frac{{{eval:10*c}}}{1000}$, ${{m}} = \\frac{{{eval:1000*m}}}{1000}$ : on compare les numérateurs ${{eval:100*a}}$, ${{b}}$, ${{eval:10*c}}$ et ${{eval:1000*m}}$.",
					"$${{m}} > \\frac{{{c}}}{100} > \\frac{{{b}}}{1000} > \\frac{{{a}}}{10}$$"
				]
			}
		}
	],
	"testSpecs": [
		{
			"description": "croissant : 9/10 < 1201/1000 < 140/100 < 2",
			"variationIndex": 0,
			"variables": {
				"m": "2",
				"k": "1",
				"a": "9",
				"c": "140",
				"b": "1201"
			},
			"answers": ["3", "0", "1", "2"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : rangés par numérateurs (2 ; 9/10 ; 140/100 ; 1201/1000)",
			"variationIndex": 0,
			"variables": {
				"m": "2",
				"k": "1",
				"a": "9",
				"c": "140",
				"b": "1201"
			},
			"answers": ["2", "3", "1", "0"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "Erreur : ordre décroissant",
			"variationIndex": 0,
			"variables": {
				"m": "2",
				"k": "1",
				"a": "9",
				"c": "140",
				"b": "1201"
			},
			"answers": ["2", "1", "0", "3"],
			"expected": {
				"status": "incorrect"
			}
		},
		{

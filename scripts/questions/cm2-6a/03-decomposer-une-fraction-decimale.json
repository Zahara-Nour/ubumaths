			"variationIndex": 1,
			"variables": {
				"q": "4",
				"t": "1",
				"v": "7",
				"a": "4107"
			},
			"answers": ["4\\,107"],
			"expected": {
				"status": "correct"
			}
		},
		{
			"description": "Erreur : 417 (zéro oublié)",
			"variationIndex": 1,
			"variables": {
				"q": "4",

	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)={{k}}{{if:n==1|x|x^{ {{n}} }}}$.\n\nDétermine la limite de $f$ en $-\\infty$.\n\n$\\displaystyle\\lim_{x\\to-\\infty}f(x)=?$",
			"variables": [
				{
					"name": "k",
					"expression": "2..9;±"
				},
				{
					"name": "n",
					"expression": "1..5"
				},
				{
					"name": "sg",
					"expression": "{{eval:sign(k)*(-1)^n}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:sg>0|+\\infty|-\\infty}}"
				}
			],
			"correction": {
				"steps": [
					"{{if:n%2==0|L'exposant ${{n}}$ est pair : $\\displaystyle\\lim_{x\\to-\\infty}{{if:n==1|x|x^{ {{n}} }}}=+\\infty$.|L'exposant ${{n}}$ est impair : $\\displaystyle\\lim_{x\\to-\\infty}{{if:n==1|x|x^{ {{n}} }}}=-\\infty$.}}",
					"On multiplie par ${{k}}$ : {{if:k>0|le signe ne change pas.|le signe change.}}",
					"$$\\displaystyle\\lim_{x\\to-\\infty}f(x)=\\textcolor{{{color:primary.0}}}{{{if:sg>0|+\\infty|-\\infty}}}$$"
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}^*$ par $f(x)=\\dfrac{ {{k}} }{{{if:n==1|x|x^{ {{n}} }}}}$.\n\nDétermine la limite de $f$ en $0$ (on a $x{{if:c==0|>|<}}0$).\n\n$\\displaystyle\\lim_{x\\to0}f(x)=?$",
			"variables": [
				{
					"name": "k",
					"expression": "1..9;±"
				},
				{
					"name": "n",
					"expression": "1..4"
				},
				{
					"name": "c",
					"expression": "0..1"
				},
				{
					"name": "sg",
					"expression": "{{eval:sign(k)*(1-2*c)^n}}"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:sg>0|+\\infty|-\\infty}}"
				}
			],
			"correction": {
				"steps": [
					"Quand $x$ tend vers $0$, ${{if:n==1|x|x^{ {{n}} }}}$ tend vers $0$ {{if:c==0|en restant positif (car $x>0$)|{{if:n%2==0|en restant positif (exposant pair)|en restant négatif (exposant impair, $x<0$)}}}} : $\\dfrac{1}{{{if:n==1|x|x^{ {{n}} }}}}$ tend vers {{if:c==0|$+\\infty$|{{if:n%2==0|$+\\infty$|$-\\infty$}}}}.",
					"On multiplie par ${{k}}$ : {{if:k>0|le signe ne change pas.|le signe change.}}",
					"$$\\displaystyle\\lim_{x\\to0}f(x)=\\textcolor{{{color:primary.0}}}{{{if:sg>0|+\\infty|-\\infty}}}$$"
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}^*$ par $f(x)=\\dfrac{ {{k}} }{{{if:n==1|x|x^{ {{n}} }}}}$.\n\nDétermine la limite de $f$ en ${{if:c==0|+\\infty|-\\infty}}$.\n\n$\\displaystyle\\lim_{x\\to{{if:c==0|+\\infty|-\\infty}}}f(x)=?$",
			"variables": [
				{
					"name": "k",
					"expression": "1..9;±"
				},
				{
					"name": "n",
					"expression": "1..4"
				},
				{
					"name": "c",
					"expression": "0..1"

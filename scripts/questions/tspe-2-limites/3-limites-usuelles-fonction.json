			"blanks": [
				{
					"expectedAnswer": "0"
				}
			],
			"correction": {
				"steps": [
					"${{if:n==1|x|x^{ {{n}} }}}$ tend vers l'infini, donc $\\dfrac{1}{{{if:n==1|x|x^{ {{n}} }}}}$ tend vers $0$.",
					"Multiplier par ${{k}}$ ne change pas une limite nulle.",
					"$$\\displaystyle\\lim_{x\\to{{if:c==0|+\\infty|-\\infty}}}f(x)=\\textcolor{{{color:primary.0}}}{0}$$"
				]
			}
		},
		{
			"statement": "{{if:s==0|Soit $f$ la fonction définie sur $\\left[0\\,;+\\infty\\right[$ par $f(x)={{if:k==1||{{if:k==-1|-|{{k}}}}}}\\sqrt{x}$.\n\nDétermine la limite de $f$ en $+\\infty$.\n\n$\\displaystyle\\lim_{x\\to+\\infty}f(x)=?$|Soit $f$ la fonction définie sur $\\left]0\\,;+\\infty\\right[$ par $f(x)=\\dfrac{ {{k}} }{\\sqrt{x}}$.\n\nDétermine la limite de $f$ en $0$ (on a $x>0$).\n\n$\\displaystyle\\lim_{x\\to0}f(x)=?$}}",
			"variables": [
				{
					"name": "k",
					"expression": "2..9;±"
				},
				{
					"name": "s",
					"expression": "0..1"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:k>0|+\\infty|-\\infty}}"
				}
			],
			"correction": {
				"steps": [
					"{{if:s==0|$\\displaystyle\\lim_{x\\to+\\infty}\\sqrt{x}=+\\infty$ (limite usuelle).|Quand $x$ tend vers $0$ avec $x>0$, $\\sqrt{x}$ tend vers $0$ en restant positif : $\\displaystyle\\lim_{x\\to0}\\dfrac{1}{\\sqrt{x}}=+\\infty$.}}",
					"On multiplie par ${{k}}$ : {{if:k>0|le signe ne change pas.|le signe change.}}",
					"$$\\displaystyle\\lim_{x\\to{{if:s==0|+\\infty|0}}}f(x)=\\textcolor{{{color:primary.0}}}{{{if:k>0|+\\infty|-\\infty}}}$$"
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)={{if:k==1||{{if:k==-1|-|{{k}}}}}}e^{x}$.\n\nDétermine la limite de $f$ en ${{if:c==0|+\\infty|-\\infty}}$.\n\n$\\displaystyle\\lim_{x\\to{{if:c==0|+\\infty|-\\infty}}}f(x)=?$",
			"variables": [
				{
					"name": "k",
					"expression": "2..9;±"
				},
				{
					"name": "c",
					"expression": "0..1"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:c==0|{{if:k>0|+\\infty|-\\infty}}|0}}"
				}
			],
			"correction": {
				"steps": [
					"{{if:c==0|$\\displaystyle\\lim_{x\\to+\\infty}e^{x}=+\\infty$ (limite usuelle).|$\\displaystyle\\lim_{x\\to-\\infty}e^{x}=0$ (limite usuelle).}}",
					"{{if:c==0|On multiplie par ${{k}}$ : {{if:k>0|le signe ne change pas.|le signe change.}}|Multiplier par ${{k}}$ ne change pas une limite nulle.}}",
					"$$\\displaystyle\\lim_{x\\to{{if:c==0|+\\infty|-\\infty}}}f(x)=\\textcolor{{{color:primary.0}}}{{{if:c==0|{{if:k>0|+\\infty|-\\infty}}|0}}}$$"
				]
			}
		}
	],

	"title": "Ajouter des inégalités",
	"description": "Encadrer a + b, puis a − b = a + (−b), à partir de deux encadrements",
	"grades": ["2"],
	"level": 1,
	"delay": 90,
	"status": "draft",
	"shared": {
		"cleanCoefficients": true
	},
	"variations": [
		{
			"statement": "On sait que ${{p}}\\leqslant a\\leqslant {{q}}$ et ${{r}}\\leqslant b\\leqslant {{s}}$.\n\nEncadre $a+b$.\n\n$$?\\leqslant a+b\\leqslant ?$$",
			"variables": [
				{
					"name": "p",
					"expression": "-3..6"
				},
				{
					"name": "dq",
					"expression": "1..5"
				},
				{
					"name": "q",
					"expression": "eval:(p)+(dq)"
				},
				{
					"name": "r",
					"expression": "-6..3"
				},
				{
					"name": "ds",
					"expression": "1..5"
				},
				{
					"name": "s",
					"expression": "eval:(r)+(ds)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(p)+(r)}}"
				},
				{
					"expectedAnswer": "{{eval:(q)+(s)}}"
				}
			],
			"correction": {
				"steps": [
					"**On peut ajouter membre à membre deux inégalités de même sens.**",
					"$$\\begin{aligned}{{p}}&\\leqslant a\\leqslant {{q}}\\\\{{r}}&\\leqslant b\\leqslant {{s}}\\end{aligned}$$",
					"$${{p}}+({{r}})\\leqslant a+b\\leqslant {{q}}+({{s}})$$",
					"$$\\textcolor{{{color:primary.0}}}{{{eval:(p)+(r)}}}\\leqslant a+b\\leqslant \\textcolor{{{color:primary.1}}}{{{eval:(q)+(s)}}}$$"
				]
			}
		},
		{
			"statement": "On sait que ${{p}}\\leqslant a\\leqslant {{q}}$ et ${{r}}\\leqslant b\\leqslant {{s}}$.\n\nEncadre $a-b$.\n\n$$?\\leqslant a-b\\leqslant ?$$",
			"variables": [
				{
					"name": "p",
					"expression": "-3..6"
				},
				{
					"name": "dq",
					"expression": "1..5"
				},
				{
					"name": "q",
					"expression": "eval:(p)+(dq)"
				},
				{
					"name": "r",
					"expression": "-6..3"
				},
				{
					"name": "ds",
					"expression": "1..5"
				},
				{
					"name": "s",
					"expression": "eval:(r)+(ds)"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{eval:(p)-(s)}}"
				},
				{
					"expectedAnswer": "{{eval:(q)-(r)}}"
				}
			],
			"correction": {
				"steps": [
					"**On ne soustrait pas deux inégalités membre à membre.** On écrit $a-b=a+(-b)$ et on encadre d'abord $-b$ : multiplier par $-1$ **change le sens** des inégalités.",
					"$${{r}}\\leqslant b\\leqslant {{s}}\\quad\\text{donne}\\quad {{eval:-(s)}}\\leqslant -b\\leqslant {{eval:-(r)}}$$",
					"On ajoute membre à membre avec ${{p}}\\leqslant a\\leqslant {{q}}$ :",
					"$$\\textcolor{{{color:primary.0}}}{{{eval:(p)-(s)}}}\\leqslant a-b\\leqslant \\textcolor{{{color:primary.1}}}{{{eval:(q)-(r)}}}$$"
				]
			}
		}
	],

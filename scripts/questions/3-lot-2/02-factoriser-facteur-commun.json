					"$$\\textcolor{{{color:primary.0}}}{({{eval:(a)*x+(b)}})}({{eval:(c)*x+(d)}})+({{eval:(f)*x+(g)}})\\textcolor{{{color:primary.0}}}{({{eval:(a)*x+(b)}})} = \\textcolor{{{color:primary.0}}}{({{eval:(a)*x+(b)}})}\\left[({{eval:(c)*x+(d)}})+({{eval:(f)*x+(g)}})\\right] = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"

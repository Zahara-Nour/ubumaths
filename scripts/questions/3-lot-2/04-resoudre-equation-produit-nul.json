					"expression": "1..9;±"
				},
				{
					"name": "q",
					"expression": "1..9;±"
				}
			],
			"conditions": ["p != q"],
			"blanks": [
				{
					"expectedAnswer": "\\{ {{p}} ; {{q}} \\}"
				}
			],
			"correction": {
				"steps": [
					"**Un produit est nul si et seulement si l'un au moins de ses facteurs est nul.**",
					"$$({{eval:x-(p)}})({{eval:x-(q)}})=0 \\iff {{eval:x-(p)}}=0 \\text{ ou } {{eval:x-(q)}}=0 \\iff x={{p}} \\text{ ou } x={{q}}$$",
					"L'équation a deux solutions : $S=\\textcolor{{{color:primary.0}}}{\\{ {{p}} ; {{q}} \\}}$."
				]
			}
		},
		{
			"statement": "Résous l'équation $({{eval:(a)*x+(b)}})({{eval:(c)*x+(d)}})=0$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "2..5"
				},
				{
					"name": "b",
					"expression": "1..9;±"
				},
				{
					"name": "c",
					"expression": "2..5"
				},
				{
					"name": "d",
					"expression": "1..9;±"
				}
			],
			"conditions": ["gcd(a, abs(b)) == 1", "gcd(c, abs(d)) == 1", "(b)*(c) != (a)*(d)"],
			"blanks": [
				{
					"expectedAnswer": "\\{ {{eval:-(b)/(a)}} ; {{eval:-(d)/(c)}} \\}"
				}
			],
			"correction": {
				"steps": [
					"**Un produit est nul si et seulement si l'un au moins de ses facteurs est nul.**",
					"$$\\begin{align} ({{eval:(a)*x+(b)}})({{eval:(c)*x+(d)}})=0 & \\iff {{eval:(a)*x+(b)}}=0 \\text{ ou } {{eval:(c)*x+(d)}}=0 \\\\ & \\iff x=\\dfrac{{{eval:-(b)}}}{{{a}}} \\text{ ou } x=\\dfrac{{{eval:-(d)}}}{{{c}}} \\end{align}$$",
					"L'équation a deux solutions : $S=\\textcolor{{{color:primary.0}}}{\\{ {{eval:-(b)/(a)}} ; {{eval:-(d)/(c)}} \\}}$."
				]
			}
		},
		{
			"statement": "Résous l'équation $({{eval:n/2;d}}x-{{eval:n*m/10;d}})({{c}}x{{eval:-(c*j/10);d;+}})=0$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [
				{
					"name": "n",
					"expression": "1|3|5|7|9"
				},
				{
					"name": "m",
					"expression": "6..24"
				},
				{
					"name": "c",
					"expression": "2..9"
				},
				{
					"name": "j",
					"expression": "11..49;±"
				}
			],
			"conditions": ["mod(m,5) != 0", "mod(j,10) != 0", "2*j != 4*m"],
			"blanks": [
				{
					"expectedAnswer": "\\{ {{eval:m/5;d}} ; {{eval:j/10;d}} \\}"
				}
			],
			"correction": {
				"steps": [
					"**Un produit est nul si et seulement si l'un au moins de ses facteurs est nul.**",
					"$$\\begin{align} ({{eval:n/2;d}}x-{{eval:n*m/10;d}})({{c}}x{{eval:-(c*j/10);d;+}})=0 & \\iff {{eval:n/2;d}}x={{eval:n*m/10;d}} \\text{ ou } {{c}}x={{eval:c*j/10;d}} \\\\ & \\iff x=\\dfrac{{{eval:n*m/10;d}}}{{{eval:n/2;d}}} \\text{ ou } x=\\dfrac{{{eval:c*j/10;d}}}{{{c}}} \\\\ & \\iff x={{eval:m/5;d}} \\text{ ou } x={{eval:j/10;d}} \\end{align}$$",
					"L'équation a deux solutions : $S=\\textcolor{{{color:primary.0}}}{\\{ {{eval:m/5;d}} ; {{eval:j/10;d}} \\}}$."
				]
			}
		},
		{
			"statement": "Résous l'équation $x({{eval:(a)*x+(b)}})=0$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "2..9"
				},
				{
					"name": "b",
					"expression": "1..20;±"

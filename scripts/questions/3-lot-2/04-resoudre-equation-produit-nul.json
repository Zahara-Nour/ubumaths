		"blankDefaults": {
			"answerKind": "intervalles"
		}
	},
	"variations": [
		{
			"statement": "Résous l'équation $({{eval:x-(p)}})({{eval:x-(q)}})=0$.\n\nL'ensemble des solutions est $S=?$.",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{

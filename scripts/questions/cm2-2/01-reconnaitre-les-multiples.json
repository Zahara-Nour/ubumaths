					"name": "q",
					"expression": "2..10"
				},
				{
					"name": "r",
					"expression": "1..{{eval:d-1}}"
				},
				{
					"name": "n",
					"expression": "eval:d*q+(1-ok)*r"
				}
			],
			"conditions": ["n<=100"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:1-ok}}"
				}
			],
			"correction": {
				"steps": [
					"**Multiple.** ${{n}}$ est un multiple de ${{d}}$ s'il est dans la table de ${{d}}$ : la division de ${{n}}$ par ${{d}}$ tombe juste.",
					"{{if:ok==1|${{n}} = {{d}} \\times {{q}}$ : la division tombe juste.|${{eval:d*q}} = {{d}} \\times {{q}}$ et ${{eval:d*q+d}} = {{d}} \\times {{eval:q+1}}$ : ${{n}}$ est entre les deux. ${{n}} = {{d}} \\times {{q}} + {{r}}$ : il reste ${{r}}$.}}",

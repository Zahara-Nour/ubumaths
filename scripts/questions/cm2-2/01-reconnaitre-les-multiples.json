	"variations": [
		{
			"statement": "${{n}}$ est-il un multiple de ${{d}}$ ?\n\n```choix\nmelanger: non\n- Oui\n- Non\n```",
			"variables": [
				{
					"name": "ok",
					"expression": "0..1"
				},
				{
					"name": "d",

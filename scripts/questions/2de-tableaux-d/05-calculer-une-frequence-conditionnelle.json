	"variations": [
		{
			"statement": "Le tableau ci-dessous donne la répartition des élèves d'un lycée selon leur sexe et leur régime.\n\n```tableau-croise\nlignes: Filles ; Garçons\ncolonnes: Externe ; Demi-pensionnaire ; Interne\nFilles = {{f1}} ; {{f2}} ; {{f3}}\nGarçons = {{g1}} ; {{g2}} ; {{g3}}\ncoin: Sexe \\ Régime\n```\n\nParmi les **garçons**, quel pourcentage est demi-pensionnaire ?\n\n$?\\,\\%$",
			"variables": [
				{
					"name": "f1",
					"expression": "8..60"
				},
				{
					"name": "f2",
					"expression": "8..60"
				},
				{
					"name": "f3",
					"expression": "8..60"
				},
				{
					"name": "k",
					"expression": "3..6"
				},
				{
					"name": "q",
					"expression": "5..14"
				},
				{
					"name": "pg",
					"expression": "eval:5*(q)"
				},
				{
					"name": "g2",
					"expression": "eval:20*(k)*(pg)/100"
				},
				{
					"name": "g1",
					"expression": "3..40"
				},
				{
					"name": "g3",
					"expression": "eval:20*(k)-(g1)-(g2)"
				},
				{
					"name": "tf",
					"expression": "eval:(f1)+(f2)+(f3)"
				},
				{
					"name": "tg",
					"expression": "eval:(g1)+(g2)+(g3)"
				},
				{
					"name": "t1",
					"expression": "eval:(f1)+(g1)"
				},
				{
					"name": "t2",
					"expression": "eval:(f2)+(g2)"
				},
				{
					"name": "t3",
					"expression": "eval:(f3)+(g3)"
				},
				{
					"name": "nt",
					"expression": "eval:(tf)+(tg)"
				}
			],
			"conditions": ["g3 >= 3", "g2 != g1"],
			"blanks": [
				{
					"expectedAnswer": "{{pg}}"
				}
			],
			"correction": {
				"steps": [
					"« Parmi les garçons » : le dénominateur est l'effectif des **garçons**, ${{tg}}$ (colonne Total), pas l'effectif du lycée.",
					"$\\dfrac{ {{g2}} }{ {{tg}} }={{eval:(pg)/100;d}}=\\textcolor{{{color:primary.0}}}{{{pg}}\\,\\%}$."
				]
			}
		},
		{
			"statement": "Le tableau ci-dessous donne la répartition des élèves d'un lycée selon leur sexe et leur régime.\n\n```tableau-croise\nlignes: Filles ; Garçons\ncolonnes: Externe ; Demi-pensionnaire ; Interne\nFilles = {{f1}} ; {{f2}} ; {{f3}}\nGarçons = {{g1}} ; {{g2}} ; {{g3}}\ncoin: Sexe \\ Régime\n```\n\nParmi les **externes**, quelle est la fréquence des filles ? Donne une fraction irréductible ou un nombre décimal.\n\n$?$",

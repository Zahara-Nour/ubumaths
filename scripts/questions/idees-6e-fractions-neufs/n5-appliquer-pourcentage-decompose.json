	"variations": [
		{
			"statement": "Calcule.\n\n$$60\\,\\% \\text{ de } {{n}} = ?$$",
			"variables": [
				{
					"name": "k",
					"expression": "7..40"
				},
				{
					"name": "n",
					"expression": "eval:10*k"
				}
			],
			"conditions": ["n!=150", "n!=120"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:6*k}}",
					"expectedErrors": [
						{
							"answer": "{{k}}",

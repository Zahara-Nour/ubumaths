							"label": "Pourcentage recopié"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"**Appliquer un pourcentage.** ${{p}}\\,\\%$ de ${{P}}$, c'est $\\frac{{{p}}}{100} \\times {{P}}$. {{if:p==50|$50\\,\\%$, c'est la moitié.|{{if:p==25|$25\\,\\%$, c'est le quart.|{{if:p==10|$10\\,\\%$, c'est le dixième.|$20\\,\\%$, c'est deux fois $10\\,\\%$.}}}}}}",
					"$$\\frac{{{p}}}{100} \\times {{P}} = \\textcolor{{{color:primary.0}}}{{{r}}}$$",
					"La réduction est de ${{r}}~\\unit{€}$."
				]
			},
			"hint": "${{p}}\\,\\%$ de ${{P}}~\\unit{€}$, c'est $\\frac{{{p}}}{100} \\times {{P}}$."
		}

						{
							"answer": "{{eval:n/2}}",
							"message": "Tu as calculé $50\\,\\%$ de ${{n}}$ : il faut encore ajouter $10\\,\\%$.",
							"label": "50 % seulement"
						},
						{
							"answer": "{{eval:n-60}}",
							"message": "On n'enlève pas $60$ : $60\\,\\%$ de ${{n}}$, c'est $60$ sur $100$, soit $\\frac{60}{100} \\times {{n}}$.",
							"label": "Soustraction de 60"
						}
					]
				}
			],
			"correction": {
				"steps": [
					"**Décomposer.** $60\\,\\% = 50\\,\\% + 10\\,\\%$. $50\\,\\%$ de ${{n}}$, c'est la moitié : ${{eval:n/2}}$. $10\\,\\%$ de ${{n}}$, c'est le dixième : ${{k}}$.",
					"$$60\\,\\% \\text{ de } {{n}} = {{eval:n/2}} + {{k}} = \\textcolor{{{color:primary.0}}}{{{solution}}}$$"
				]
			},
			"hint": "$60\\,\\% = 50\\,\\% + 10\\,\\%$ : calcule la moitié, puis le dixième."

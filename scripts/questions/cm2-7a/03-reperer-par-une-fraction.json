				"r": "3",
				"n": "17"
			},
			"answers": ["\\frac{3}{7}"],
			"expected": {
				"status": "incorrect"
			}
		},
		{
			"description": "Erreur : 23/7 (compté depuis 3)",
			"variationIndex": 1,
			"variables": {
				"d": "7",
				"k": "2",
				"dm": "6",
				"r": "3",
				"n": "17"
			},
			"answers": ["\\frac{23}{7}"],
			"expected": {
				"status": "incorrect"
			}
		}
	]
}

{
	"title": "Placer un nombre entier sur une demi-droite graduée",
	"description": "Placer un nombre entier sur une demi-droite graduée de 1 en 1 jusqu'à 100 000 en 100 000 (deux graduations étiquetées, le pas est à trouver), puis deux points sur la même droite",
	"grades": ["CM2"],
	"theme": "Entiers",
	"domain": "Apprivoiser",
	"subdomain": "Repérage",
	"level": 3,
	"delay": 45,
	"status": "draft",
	"options": {
		"constraints": {
			"spaces": "off"
		}
	},
	"variations": [
		{
			"statement": "Place le nombre ${{x}}$ sur la demi-droite graduée.\n\n```line\nstart: {{a}}\nend: {{fin}}\nstep: {{s}}\nmajor: 5\nlabels: {{a}}, {{l}}\nplacer: {{x}}\n```",
			"variables": [
				{
					"name": "s",
					"expression": "1|10|100"
				},
				{
					"name": "b",
					"expression": "1..99"
				},
				{
					"name": "a",
					"expression": "eval:10*s*b"
				},
				{
					"name": "l",
					"expression": "eval:a+5*s"
				},
				{
					"name": "fin",
					"expression": "eval:a+10*s"
				},
				{
					"name": "k",
					"expression": "1..9"
				},
				{
					"name": "x",
					"expression": "eval:a+k*s"
				}
			],
			"conditions": ["k!=5"],
			"correction": {
				"steps": [
					"**Le pas.** De ${{a}}$ à ${{l}}$, il y a $5$ intervalles : un intervalle vaut $({{l}} - {{a}}) \\div 5 = {{s}}$.",
					"${{x}} = {{a}} + {{k}} \\times {{s}}$ : on part de ${{a}}$ et on avance de ${{k}}$ intervalle{{if:k>1|s|}}."
				]
			}
		},

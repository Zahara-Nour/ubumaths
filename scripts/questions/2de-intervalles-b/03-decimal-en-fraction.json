			"conditions": ["10*c+d > 0"],
			"blanks": [
				{
					"expectedAnswer": "\\frac{ {{eval:(100*(c)+10*(d)+5)/gcd(100*(c)+10*(d)+5,1000)}} }{ {{eval:1000/gcd(100*(c)+10*(d)+5,1000)}} }"
				}
			],
			"correction": {
				"steps": [
					"Un nombre est **rationnel** s'il s'écrit $\\dfrac{a}{b}$, avec $a$ et $b\\neq0$ entiers.",
					"$$0{,}{{c}}{{d}}5=\\dfrac{ {{eval:100*(c)+10*(d)+5}} }{1000}=\\textcolor{{{color:primary.0}}}{\\dfrac{ {{eval:(100*(c)+10*(d)+5)/gcd(100*(c)+10*(d)+5,1000)}} }{ {{eval:1000/gcd(100*(c)+10*(d)+5,1000)}} }}$$",

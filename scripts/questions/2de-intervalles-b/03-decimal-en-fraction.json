			"blanks": [
				{
					"expectedAnswer": "{{if:s==1|-}}\\frac{ {{eval:(10*(a)+(b))/gcd(10*(a)+(b),10)}} }{ {{eval:10/gcd(10*(a)+(b),10)}} }"
				}
			],
			"correction": {
				"steps": [
					"Un nombre est **rationnel** s'il s'écrit $\\dfrac{a}{b}$, avec $a$ et $b\\neq0$ entiers.",
					"$${{if:s==1|-}}{{a}}{,}{{b}}={{if:s==1|-}}\\dfrac{ {{eval:10*(a)+(b)}} }{10}=\\textcolor{{{color:primary.0}}}{{{if:s==1|-}}\\dfrac{ {{eval:(10*(a)+(b))/gcd(10*(a)+(b),10)}} }{ {{eval:10/gcd(10*(a)+(b),10)}} }}$$",
					"On a simplifié par ${{eval:gcd(10*(a)+(b),10)}}$."
				]
			}
		},
		{
			"statement": "Écris ce nombre sous la forme d'une fraction irréductible.\n\n$$0{,}{{c}}{{d}}5=?$$",

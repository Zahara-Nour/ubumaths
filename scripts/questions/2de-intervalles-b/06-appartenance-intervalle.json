					"expression": "0..4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{if:t==0|0|{{if:t==1|0|{{if:t==2|1|{{if:t==3|0|1}}}}}}}}"
				}
			],
			"correction": {
				"steps": [
					"On compare les carrés (tous les nombres sont positifs), ou on utilise une valeur approchée.",
					"{{if:t==0|$1{,}4^2=1{,}96<2<2{,}25=1{,}5^2$ : $\\textcolor{{{color:primary.0}}}{1{,}4<\\sqrt{2}<1{,}5}$, **oui**.|{{if:t==1|$\\pi\\approx3{,}14159$ : $\\textcolor{{{color:primary.0}}}{3{,}14<\\pi<3{,}15}$, **oui**.|{{if:t==2|$1{,}8^2=3{,}24>3$ : $\\textcolor{{{color:primary.0}}}{\\sqrt{3}<1{,}8}$, **non** ($\\sqrt{3}\\approx1{,}732$).|{{if:t==3|$2{,}2^2=4{,}84<5<5{,}29=2{,}3^2$ : $\\textcolor{{{color:primary.0}}}{2{,}2<\\sqrt{5}<2{,}3}$, **oui**.|$3{,}1^2=9{,}61<10$ : $\\textcolor{{{color:primary.0}}}{\\sqrt{10}>3{,}1}$, **non** ($\\sqrt{10}\\approx3{,}162$).}}}}}}}}"
				]
			}
		}
	],

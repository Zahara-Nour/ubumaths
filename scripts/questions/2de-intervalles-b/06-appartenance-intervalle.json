					"expectedAnswer": "{{u}}"
				}
			],
			"correction": {
				"steps": [
					"$x\\in[{{a}}\\,;\\,{{b}}[$ veut dire ${{a}}\\leqslant x<{{b}}$.",
					"{{if:u==1|$\\textcolor{{{color:primary.0}}}{{{b}}{,}01>{{b}}}$ : **non**, il est à droite de l'intervalle.|$\\textcolor{{{color:primary.0}}}{{{a}}\\leqslant{{eval:(b)-1}}{,}99<{{b}}}$ : **oui**, il est juste avant ${{b}}$, exclu.}}"
				]
			}
		},
		{
			"statement": "${{if:t==0|\\sqrt{2}\\in[1{,}4\\,;\\,1{,}5]|{{if:t==1|\\pi\\in\\,]3{,}14\\,;\\,3{,}15[|{{if:t==2|\\sqrt{3}\\in[1{,}8\\,;\\,2]|{{if:t==3|\\sqrt{5}\\in\\,]2{,}2\\,;\\,2{,}3[|\\sqrt{10}\\in[3\\,;\\,3{,}1]}}}}}}}}$ ?\n\n```choix\nmelanger: non\n- Oui\n- Non\n```",
			"variables": [

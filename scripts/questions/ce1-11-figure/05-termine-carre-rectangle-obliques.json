{
	"title": "Termine le carré ou le rectangle aux côtés obliques",
	"description": "Sur quadrillage, compléter un carré (un côté oblique tracé) ou un rectangle (deux côtés obliques tracés)",
	"grades": ["CE1"],
	"theme": "Géométrie",

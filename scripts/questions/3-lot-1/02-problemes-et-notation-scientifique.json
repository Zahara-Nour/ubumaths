		{
			"statement": "Complète.\n\n$$1~{{if:k==-9|\\unit{nm}|}}{{if:k==-6|\\unit{μm}|}}{{if:k==-3|\\unit{mm}|}}{{if:k==3|\\unit{kW}|}}{{if:k==6|\\unit{MW}|}}{{if:k==9|\\unit{GW}|}} = 10^{?}~{{if:k<0|\\unit{m}|\\unit{W}}}$$",
			"variables": [

	"variations": [
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=({{a}}x{{eval:b;+}})e^{x}$.\n\nCalcule $f'(x)$ et donne le résultat sous la forme $(mx+p)e^{x}$.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "b",
					"expression": "1..6;±"
				}
			],
			"conditions": ["a+b != 0"],
			"blanks": [
				{
					"expectedAnswer": "({{eval:a*x+a+b}})e^{x}"
				}
			],
			"correction": {
				"steps": [
					"$f$ est un produit $u\\times v$ : $(uv)'=u'v+uv'$.",
					"Avec $u(x)={{a}}x{{eval:b;+}}$ et $v(x)=e^x$ : $u'(x)={{a}}$ et $v'(x)=e^x$.",
					"$$f'(x)={{a}}e^x+({{a}}x{{eval:b;+}})e^x$$ soit $$f'(x)=(\\textcolor{{{color:primary.0}}}{ {{eval:a*x+a+b}} })e^{x}$$",
					"On factorise par $e^x$ : c'est la forme qui permet ensuite d'étudier le signe de $f'(x)$."
				]
			}
		},
		{
			"statement": "Soit $f$ la fonction définie sur $\\mathbb{R}$ par $f(x)=(x{{eval:b;+}})e^{x}$.\n\nCalcule $f'(x)$ et donne le résultat sous la forme $(mx+p)e^{x}$.\n\n$f'(x)=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "b",
					"expression": "2..9;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "(x{{eval:b+1;+}})e^{x}"
				}
			],
			"correction": {
				"steps": [
					"$f$ est un produit $u\\times v$ : $(uv)'=u'v+uv'$.",
					"Avec $u(x)=x{{eval:b;+}}$ et $v(x)=e^x$ : $u'(x)=1$ et $v'(x)=e^x$.",
					"$$f'(x)=1\\times e^x+(x{{eval:b;+}})e^x=(\\textcolor{{{color:primary.0}}}{ x{{eval:b+1;+}} })e^{x}$$",
					"On factorise par $e^x$ : c'est la forme qui permet ensuite d'étudier le signe de $f'(x)$."
				]
			}
		}
	],

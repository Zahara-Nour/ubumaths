{
	"title": "Puissance et inverse d'une exponentielle",
	"description": "(eᵃ)ⁿ = eⁿᵃ et 1/eᵃ = e⁻ᵃ",
	"grades": ["1_SPE"],
	"theme": "Fonctions",
	"domain": "Fonction exponentielle",
	"subdomain": "Propriétés algébriques",
	"level": 4,
	"status": "draft",
	"delay": 45,
	"variations": [
		{
			"statement": "Écris $A$ sous la forme $e^{\\cdots}$, l'exposant étant réduit.\n\n$A=\\left(e^{ {{eval:a*x+b}} }\\right)^{ {{n}} }$\n\n$A=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "b",
					"expression": "1..6;±"
				},
				{
					"name": "n",
					"expression": "2..4"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "e^{ {{eval:n*a*x+n*b}} }"
				}
			],
			"correction": {
				"steps": [
					"On utilise $\\left(e^a\\right)^n=e^{na}$ : on **multiplie** l'exposant par $n$ (tout l'exposant).",
					"$A=e^{ {{n}}({{eval:a*x+b}}) }=\\textcolor{{{color:primary.0}}}{e^{ {{eval:n*a*x+n*b}} } }$."
				]
			}
		},
		{
			"statement": "Écris $A$ sous la forme $e^{\\cdots}$, l'exposant étant réduit.\n\n$A=\\dfrac{1}{e^{ {{eval:a*x+b}} }}$\n\n$A=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..5;±"
				},
				{
					"name": "b",
					"expression": "1..6;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "e^{ {{eval:-a*x-b}} }"
				}
			],
			"correction": {
				"steps": [
					"On utilise $\\dfrac{1}{e^a}=e^{-a}$ : on prend l'**opposé** de tout l'exposant.",
					"$A=e^{-({{eval:a*x+b}}) }=\\textcolor{{{color:primary.0}}}{e^{ {{eval:-a*x-b}} } }$."
				]
			}
		},
		{
			"statement": "Écris $A$ sous la forme $e^{\\cdots}$, l'exposant étant réduit.\n\n$A=\\left(e^{ {{p}} }\\right)^{ {{q}} }$\n\n$A=?$",
			"variables": [
				{
					"name": "p",
					"expression": "1..5;±"
				},
				{
					"name": "q",
					"expression": "2..4;±"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "e^{ {{eval:p*q}} }"
				}
			],
			"correction": {
				"steps": [
					"On utilise $\\left(e^a\\right)^n=e^{na}$ : on **multiplie** les exposants.",
					"$A=e^{ {{p}}\\times{{eval:q;()}} }=\\textcolor{{{color:primary.0}}}{e^{ {{eval:p*q}} } }$."
				]
			}
		}
	],
	"testSpecs": [

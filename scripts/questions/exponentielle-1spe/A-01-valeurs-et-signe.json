			"variables": [],
			"correction": {
				"steps": [
					"La fonction exponentielle est **strictement positive** sur $\\mathbb{R}$ : pour tout réel $x$, $\\textcolor{{{color:primary.0}}}{e^x>0 }$. C'est **vrai**."
				]
			},
			"blanks": [
				{
					"expectedAnswer": "0"
				}
			]
		},

			"variables": [],
			"correction": {
				"steps": [
					"$\\textcolor{{{color:primary.0}}}{e\\approx2{,}718 }$. Attention : $3{,}142$ est une valeur approchée de $\\pi$, et $1{,}414$ de $\\sqrt2$."
				]
			},

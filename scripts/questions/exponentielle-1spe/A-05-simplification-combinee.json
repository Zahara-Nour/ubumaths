					"name": "d",
					"expression": "1..4;±"
				},
				{
					"name": "f",
					"expression": "1..5;±"
				}
			],
			"conditions": ["n*a+b-d != 0", "c != f"],
			"blanks": [
				{
					"expectedAnswer": "e^{ {{eval:(n*a+b-d)*x+c-f}} }"
				}
			],
			"correction": {
				"steps": [
					"Puissance : $\\left(e^{ {{eval:a*x}} }\\right)^{ {{n}} }=e^{ {{eval:n*a*x}} }$.",
					"Produit (on additionne) : $e^{ {{eval:n*a*x}} }\\times e^{ {{eval:b*x+c}} }=e^{ {{eval:(n*a+b)*x+c}} }$.",
					"Quotient (on soustrait tout l'exposant) : $A=e^{ {{eval:(n*a+b)*x+c}}-({{eval:d*x+f}}) }=\\textcolor{{{color:primary.0}}}{e^{ {{eval:(n*a+b-d)*x+c-f}} } }$."
				]
			}
		},
		{
			"statement": "Écris $A$ sous la forme $e^{\\cdots}$, l'exposant étant réduit.\n\n$A=\\dfrac{\\left(e^{ {{eval:a*x+b}} }\\right)^{ {{n}} }}{e^{ {{eval:c*x}} }\\times e^{ {{d}} }}$\n\n$A=?$",
			"variables": [
				{
					"name": "x",
					"expression": "x|x"
				},
				{
					"name": "a",
					"expression": "1..3;±"
				},
				{
					"name": "b",
					"expression": "1..4;±"

					"name": "c",
					"expression": "1..5;±"
				},
				{
					"name": "d",
					"expression": "1..5;±"
				}
			],
			"conditions": ["n*a-c != 0", "n*b-d != 0"],
			"blanks": [
				{
					"expectedAnswer": "e^{ {{eval:(n*a-c)*x+n*b-d}} }"
				}
			],
			"correction": {
				"steps": [
					"Numérateur (puissance) : $\\left(e^{ {{eval:a*x+b}} }\\right)^{ {{n}} }=e^{ {{eval:n*a*x+n*b}} }$.",
					"Dénominateur (produit) : $e^{ {{eval:c*x}} }\\times e^{ {{d}} }=e^{ {{eval:c*x+d}} }$.",
					"Quotient : $A=e^{ {{eval:n*a*x+n*b}}-({{eval:c*x+d}}) }=\\textcolor{{{color:primary.0}}}{e^{ {{eval:(n*a-c)*x+n*b-d}} } }$."
				]
			}
		}

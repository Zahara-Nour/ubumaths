	"variations": [
		{
			"statement": "Le nombre de bactéries d'une culture, $t$ heures après le début d'un traitement, est modélisé par\n\n$$N(t)={{N}}\\,e^{-{{k}}t}\\qquad(t\\geqslant0).$$\n\nCombien y a-t-il de bactéries au début du traitement ?\n\n$N(0)=?$",
			"variables": [
				{
					"name": "N",
					"expression": "200|400|500|800|1000|1500|2000"
				},
				{
					"name": "k",
					"expression": "0.05|0.1|0.2|0.3|0.5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "{{N}}"
				}
			],
			"correction": {
				"steps": [
					"Le début du traitement correspond à $t=0$.",
					"$$N(0)={{N}}\\,e^{-{{k}}\\times0}={{N}}\\times e^{0}={{N}}\\times1={{N}}$$",
					"Conclusion : il y a ${{N}}$ bactéries au début du traitement."
				]
			}
		},
		{
			"statement": "Le nombre de bactéries d'une culture, $t$ heures après le début d'un traitement, est modélisé par\n\n$$N(t)={{N}}\\,e^{-{{k}}t}\\qquad(t\\geqslant0).$$\n\nComplète : sur $[0\\,;+\\infty[$, la fonction $N$ est [_].",
			"variables": [
				{
					"name": "N",
					"expression": "200|400|500|800|1000|1500|2000"
				},
				{
					"name": "k",
					"expression": "0.05|0.1|0.2|0.3|0.5"
				}
			],
			"blanks": [
				{
					"expectedAnswer": "décroissante",
					"pool": ["croissante", "décroissante", "constante"]
				}
			],
			"correction": {
				"steps": [
					"La fonction $t\\mapsto e^{-{{k}}t}$ est de la forme $t\\mapsto e^{mt}$ avec $m=-{{k}}<0$ : elle est décroissante.",
					"On la multiplie par ${{N}}>0$, ce qui ne change pas le sens de variation.",
					"Conclusion : $N$ est décroissante sur $[0\\,;+\\infty[$ (le nombre de bactéries diminue)."
				]
			}
		},
		{
			"statement": "Le nombre de bactéries d'une culture, $t$ heures après le début d'un traitement, est modélisé par\n\n$$N(t)={{N}}\\,e^{-{{k}}t}\\qquad(t\\geqslant0).$$\n\nCombien reste-t-il de bactéries au bout de ${{t}}$ heures ? Arrondis à l'unité.\n\n$N({{t}})\\approx ?$",
			"variables": [
				{
					"name": "N",
					"expression": "200|400|500|800|1000|1500|2000"
				},
				{
					"name": "k",
					"expression": "0.05|0.1|0.2|0.3|0.5"
				},
				{
					"name": "t",
					"expression": "2..10"
				}
			],
			"conditions": ["abs(N*exp(-k*t)-round(N*exp(-k*t))) <= 0.4", "k*t >= 0.2", "k*t <= 2"],
			"blanks": [
				{
					"expectedAnswer": "{{eval:round(N*exp(-k*t))}}",
					"precision": {
						"type": "decimal",
						"digits": 0
					}
				}
			],
			"correction": {
				"steps": [
					"On remplace $t$ par ${{t}}$ :",
					"$$N({{t}})={{N}}\\,e^{-{{k}}\\times{{t}}}={{N}}\\,e^{-{{eval:k*t;d}}}\\approx{{eval:round(N*exp(-k*t)*100)/100;d}}$$",
					"Conclusion : arrondi à l'unité, il reste environ $\\mathbf{ {{eval:round(N*exp(-k*t))}} }$ bactéries."
				]
			}
		}
	],

			"conditions": ["p+q != 0", "p+q != 1"],
			"blanks": [
				{
					"expectedAnswer": "e^{ {{eval:p+q}} }"
				}
			],
			"correction": {
				"steps": [
					"On utilise $e^a\\times e^b=e^{a+b}$ : pour un produit, on **additionne** les exposants.",
					"$A=e^{ {{p}}+{{eval:q;()}} }=\\textcolor{{{color:primary.0}}}{e^{ {{eval:p+q}} } }$."
				]
			}
		},

<script lang="ts">
	import type { PageData } from './$types';
	import { enhance } from '$app/forms';
	import { Button } from '$lib/components/ui/button';
	import { Input } from '$lib/components/ui/input';
	import * as Tabs from '$lib/components/ui/tabs';
	import * as Card from '$lib/components/ui/card';
	import * as Avatar from '$lib/components/ui/avatar';
	import * as Dialog from '$lib/components/ui/dialog';
	import { Badge } from '$lib/components/ui/badge';
	import { Label } from '$lib/components/ui/label';
	import { Separator } from '$lib/components/ui/separator';
	import type { Profile, Class } from '$lib/types/database';

	let { data }: { data: PageData } = $props();

	// State
	let activeLayout = $state<'table' | 'card'>('card');
	let searchTerm = $state('');
	let searchResults = $state<any[]>([]);
	let selectedUser = $state<any | null>(null);
	let isSearching = $state(false);
	let selectedClassFilter = $state<string>('');
	let searchTimeout: NodeJS.Timeout | null = null;

	// Edit state
	let editedUser = $state<any>({});
	let isEditing = $state(false);
	let showTableModal = $state(false);

	// Get initials from name
	function getInitials(firstname: string | null, lastname: string | null): string {
		const first = firstname?.charAt(0)?.toUpperCase() || '';
		const last = lastname?.charAt(0)?.toUpperCase() || '';
		return first + last || '?';
	}

	// Get full name
	function getFullName(user: any): string {
		if (user.firstname && user.lastname) {
			return `${user.firstname} ${user.lastname}`;
		}
		return user.full_name || user.email;
	}

	// Get role badge color
	function getRoleBadgeClass(role: string): string {
		switch (role) {
			case 'admin':
				return 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200';
			case 'teacher':
				return 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200';
			case 'student':
				return 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200';
			default:
				return 'bg-muted text-muted-foreground';
		}
	}

	// Get class names from IDs
	function getClassNames(classIds: string[]): string[] {
		if (!classIds || classIds.length === 0) return [];
		return classIds
			.map((id) => data.classes.find((c) => c.id === id)?.name)
			.filter((name): name is string => !!name);
	}

	// Debounced search
	function handleSearchInput() {
		if (searchTimeout) {
			clearTimeout(searchTimeout);
		}

		if (searchTerm.length < 3) {
			searchResults = [];
			return;
		}

		searchTimeout = setTimeout(async () => {
			isSearching = true;
			const formData = new FormData();
			formData.append('search', searchTerm);

			try {
				const response = await fetch('?/search_users', {
					method: 'POST',
					body: formData
				});

				const result = await response.json();
				if (result.type === 'success' && result.data?.users) {
					searchResults = result.data.users;
				}
			} catch (err) {
				console.error('Search error:', err);
			} finally {
				isSearching = false;
			}
		}, 300);
	}

	// Select user
	function selectUser(user: any) {
		selectedUser = user;
		editedUser = { ...user };
		isEditing = false;
	}

	// Start editing
	function startEdit() {
		editedUser = { ...selectedUser };
		isEditing = true;
	}

	// Cancel editing
	function cancelEdit() {
		editedUser = { ...selectedUser };
		isEditing = false;
	}

	// Handle class filter change
	async function handleClassFilter(classId: string) {
		if (!classId) {
			searchResults = [];
			return;
		}

		isSearching = true;
		const formData = new FormData();
		formData.append('class_id', classId);

		try {
			const response = await fetch('?/get_class_students', {
				method: 'POST',
				body: formData
			});

			const result = await response.json();
			if (result.type === 'success' && result.data?.users) {
				searchResults = result.data.users;
			}
		} catch (err) {
			console.error('Class filter error:', err);
		} finally {
			isSearching = false;
		}
	}

	// Remove class from user
	async function removeClass(classId: string) {
		if (!selectedUser) return;

		const formData = new FormData();
		formData.append('user_id', selectedUser.id);
		formData.append('class_id', classId);

		try {
			const response = await fetch('?/remove_from_class', {
				method: 'POST',
				body: formData
			});

			const result = await response.json();
			if (result.type === 'success') {
				// Update local state
				selectedUser.class_ids = selectedUser.class_ids.filter((id: string) => id !== classId);
				editedUser.class_ids = [...selectedUser.class_ids];
			}
		} catch (err) {
			console.error('Remove class error:', err);
		}
	}

	// Table modal functions
	function openTableModal(user: any) {
		selectedUser = user;
		editedUser = { ...user };
		showTableModal = true;
	}

	function closeTableModal() {
		showTableModal = false;
	}
</script>

<div class="space-y-6">
	<!-- Header -->
	<div class="flex items-center justify-between">
		<div>
			<h1 class="text-3xl font-bold text-foreground">Gestion des Utilisateurs</h1>
			<p class="mt-2 text-muted-foreground">Gérer les profils des étudiants et enseignants</p>
		</div>
	</div>

	<!-- Layout Tabs -->
	<Tabs.Root bind:value={activeLayout}>
		<Tabs.List class="grid w-full grid-cols-2 max-w-md">
			<Tabs.Trigger value="card">Vue Carte (Moderne)</Tabs.Trigger>
			<Tabs.Trigger value="table">Vue Tableau</Tabs.Trigger>
		</Tabs.List>

		<!-- CARD LAYOUT (More Ergonomic) -->
		<Tabs.Content value="card" class="mt-6">
			<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
				<!-- Left Panel: Search & Browse -->
				<div class="lg:col-span-1 space-y-4">
					<!-- Search -->
					<Card.Root>
						<Card.Header>
							<Card.Title>Rechercher un utilisateur</Card.Title>
						</Card.Header>
						<Card.Content class="space-y-4">
							<div>
								<Label for="search-input">Email, Prénom ou Nom (min 3 caractères)</Label>
								<Input
									id="search-input"
									type="text"
									placeholder="Rechercher..."
									bind:value={searchTerm}
									oninput={handleSearchInput}
								/>
								{#if isSearching}
									<p class="text-sm text-muted-foreground mt-2">Recherche en cours...</p>
								{/if}
							</div>

							<!-- Search Results -->
							{#if searchResults.length > 0}
								<div class="space-y-2 max-h-64 overflow-y-auto">
									{#each searchResults as user}
										<button
											type="button"
											onclick={() => selectUser(user)}
											class="w-full text-left p-3 rounded-lg border border-border hover:bg-muted transition-colors {selectedUser?.id ===
											user.id
												? 'bg-primary/10 border-primary'
												: ''}"
										>
											<div class="flex items-center gap-3">
												<Avatar.Root class="h-10 w-10">
													{#if user.avatar_url}
														<Avatar.Image src={user.avatar_url} alt={getFullName(user)} />
													{/if}
													<Avatar.Fallback>{getInitials(user.firstname, user.lastname)}</Avatar.Fallback>
												</Avatar.Root>
												<div class="flex-1 min-w-0">
													<p class="text-sm font-medium text-foreground truncate">
														{getFullName(user)}
													</p>
													<p class="text-xs text-muted-foreground truncate">{user.email}</p>
												</div>
												<Badge class={getRoleBadgeClass(user.role)}>{user.role}</Badge>
											</div>
										</button>
									{/each}
								</div>
							{:else if searchTerm.length >= 3 && !isSearching}
								<p class="text-sm text-muted-foreground">Aucun résultat trouvé</p>
							{/if}
						</Card.Content>
					</Card.Root>

					<!-- Browse by Class -->
					<Card.Root>
						<Card.Header>
							<Card.Title>Parcourir par classe</Card.Title>
						</Card.Header>
						<Card.Content>
							<Select.Root
								onSelectedChange={(selected) => {
									selectedClassFilter = selected?.value || '';
									handleClassFilter(selectedClassFilter);
								}}
							>
								<Select.Trigger>
									<Select.Value placeholder="Sélectionner une classe" />
								</Select.Trigger>
								<Select.Content>
									{#each data.classes as classItem}
										<Select.Item value={classItem.id}>{classItem.name}</Select.Item>
									{/each}
								</Select.Content>
							</Select.Root>
						</Card.Content>
					</Card.Root>
				</div>

				<!-- Right Panel: User Profile Card -->
				<div class="lg:col-span-2">
					{#if selectedUser}
						<Card.Root>
							<Card.Header>
								<div class="flex items-center justify-between">
									<Card.Title>Profil de l'utilisateur</Card.Title>
									{#if !isEditing}
										<Button onclick={startEdit} size="sm">Modifier</Button>
									{:else}
										<div class="flex gap-2">
											<Button type="button" variant="outline" size="sm" onclick={cancelEdit}>
												Annuler
											</Button>
										</div>
									{/if}
								</div>
							</Card.Header>
							<Card.Content class="space-y-6">
								<!-- Avatar -->
								<div class="flex items-center gap-4">
									<Avatar.Root class="h-20 w-20">
										{#if (isEditing ? editedUser.avatar_url : selectedUser.avatar_url)}
											<Avatar.Image
												src={isEditing ? editedUser.avatar_url : selectedUser.avatar_url}
												alt={getFullName(isEditing ? editedUser : selectedUser)}
											/>
										{/if}
										<Avatar.Fallback class="text-2xl">
											{getInitials(
												isEditing ? editedUser.firstname : selectedUser.firstname,
												isEditing ? editedUser.lastname : selectedUser.lastname
											)}
										</Avatar.Fallback>
									</Avatar.Root>
									<div class="flex-1">
										{#if isEditing}
											<Label for="avatar-url">URL de l'avatar</Label>
											<Input id="avatar-url" type="url" bind:value={editedUser.avatar_url} />
										{:else}
											<h3 class="text-xl font-semibold">{getFullName(selectedUser)}</h3>
											<p class="text-sm text-muted-foreground">{selectedUser.email}</p>
										{/if}
									</div>
								</div>

								<Separator />

								<!-- Profile Form -->
								<form
									method="POST"
									action="?/update_profile"
									use:enhance={() => {
										return async ({ result, update }) => {
											await update();
											if (result.type === 'success') {
												selectedUser = { ...editedUser };
												isEditing = false;
											}
										};
									}}
								>
									<input type="hidden" name="user_id" value={selectedUser.id} />

									<div class="space-y-4">
										<!-- Personal Info -->
										<div class="grid grid-cols-2 gap-4">
											<div>
												<Label for="firstname">Prénom</Label>
												{#if isEditing}
													<Input
														id="firstname"
														name="firstname"
														type="text"
														bind:value={editedUser.firstname}
													/>
												{:else}
													<p class="text-sm mt-1">{selectedUser.firstname || '—'}</p>
												{/if}
											</div>

											<div>
												<Label for="lastname">Nom</Label>
												{#if isEditing}
													<Input
														id="lastname"
														name="lastname"
														type="text"
														bind:value={editedUser.lastname}
													/>
												{:else}
													<p class="text-sm mt-1">{selectedUser.lastname || '—'}</p>
												{/if}
											</div>
										</div>

										<div>
											<Label for="email">Email</Label>
											{#if isEditing}
												<Input id="email" name="email" type="email" bind:value={editedUser.email} />
											{:else}
												<p class="text-sm mt-1">{selectedUser.email}</p>
											{/if}
										</div>

										<!-- Role -->
										<div>
											<Label for="role">Rôle</Label>
											{#if isEditing}
												<Select.Root
													onSelectedChange={(selected) => {
														if (selected) editedUser.role = selected.value;
													}}
												>
													<Select.Trigger>
														<Select.Value placeholder={editedUser.role} />
													</Select.Trigger>
													<Select.Content>
														<Select.Item value="student">Student</Select.Item>
														<Select.Item value="teacher">Teacher</Select.Item>
														<Select.Item value="admin">Admin</Select.Item>
													</Select.Content>
												</Select.Root>
												<input type="hidden" name="role" value={editedUser.role} />
											{:else}
												<Badge class={getRoleBadgeClass(selectedUser.role) + ' mt-1'}>
													{selectedUser.role}
												</Badge>
											{/if}
										</div>

										<!-- School -->
										<div>
											<Label for="school">École</Label>
											{#if isEditing}
												<Select.Root
													onSelectedChange={(selected) => {
														if (selected) editedUser.school_id = selected.value;
													}}
												>
													<Select.Trigger>
														<Select.Value
															placeholder={data.schools.find((s) => s.id === editedUser.school_id)
																?.name || 'Sélectionner une école'}
														/>
													</Select.Trigger>
													<Select.Content>
														<Select.Item value="">Aucune école</Select.Item>
														{#each data.schools as school}
															<Select.Item value={school.id}>{school.name}</Select.Item>
														{/each}
													</Select.Content>
												</Select.Root>
												<input type="hidden" name="school_id" value={editedUser.school_id || ''} />
											{:else}
												<p class="text-sm mt-1">
													{selectedUser.schools?.name || '—'}
												</p>
											{/if}
										</div>

										<!-- Classes -->
										<div>
											<Label>Classes</Label>
											<div class="flex flex-wrap gap-2 mt-2">
												{#if selectedUser.class_ids && selectedUser.class_ids.length > 0}
													{#each selectedUser.class_ids as classId}
														{@const className = data.classes.find((c) => c.id === classId)?.name}
														<Badge variant="outline" class="flex items-center gap-1">
															{className || 'Unknown'}
															{#if isEditing}
																<button
																	type="button"
																	onclick={() => removeClass(classId)}
																	class="ml-1 hover:text-destructive"
																>
																	×
																</button>
															{/if}
														</Badge>
													{/each}
												{:else}
													<p class="text-sm text-muted-foreground">Aucune classe</p>
												{/if}
											</div>

											{#if isEditing}
												<div class="mt-2">
													<form
														method="POST"
														action="?/add_to_class"
														use:enhance={() => {
															return async ({ result, update }) => {
																await update();
																if (result.type === 'success') {
																	// Reload user data
																	const classIdToAdd = document.querySelector<HTMLInputElement>(
																		'[name="class_id_to_add"]'
																	)?.value;
																	if (classIdToAdd && !selectedUser.class_ids.includes(classIdToAdd)) {
																		selectedUser.class_ids = [...selectedUser.class_ids, classIdToAdd];
																		editedUser.class_ids = [...selectedUser.class_ids];
																	}
																}
															};
														}}
													>
														<input type="hidden" name="user_id" value={selectedUser.id} />
														<div class="flex gap-2">
															<Select.Root>
																<Select.Trigger class="flex-1">
																	<Select.Value placeholder="Ajouter une classe" />
																</Select.Trigger>
																<Select.Content>
																	{#each data.classes.filter((c) => !selectedUser.class_ids?.includes(c.id)) as classItem}
																		<Select.Item value={classItem.id}>{classItem.name}</Select.Item>
																	{/each}
																</Select.Content>
															</Select.Root>
															<input type="hidden" name="class_id" class="class_id_to_add" />
															<Button type="submit" size="sm">Ajouter</Button>
														</div>
													</form>
												</div>
											{/if}
										</div>

										{#if isEditing}
											<div class="flex justify-end pt-4">
												<Button type="submit">Enregistrer les modifications</Button>
											</div>
										{/if}
									</div>
								</form>
							</Card.Content>
						</Card.Root>
					{:else}
						<Card.Root>
							<Card.Content class="py-12 text-center">
								<p class="text-muted-foreground">
									Recherchez un utilisateur ou sélectionnez une classe pour commencer
								</p>
							</Card.Content>
						</Card.Root>
					{/if}
				</div>
			</div>
		</Tabs.Content>

		<!-- TABLE LAYOUT (Following Schools Pattern) -->
		<Tabs.Content value="table" class="mt-6 space-y-4">
			<!-- Search and Filter -->
			<div class="flex gap-4">
				<div class="flex-1">
					<Input
						type="text"
						placeholder="Rechercher par email, prénom ou nom (min 3 caractères)"
						bind:value={searchTerm}
						oninput={handleSearchInput}
					/>
				</div>
				<Select.Root
					onSelectedChange={(selected) => {
						selectedClassFilter = selected?.value || '';
						handleClassFilter(selectedClassFilter);
					}}
				>
					<Select.Trigger class="w-64">
						<Select.Value placeholder="Filtrer par classe" />
					</Select.Trigger>
					<Select.Content>
						<Select.Item value="">Toutes les classes</Select.Item>
						{#each data.classes as classItem}
							<Select.Item value={classItem.id}>{classItem.name}</Select.Item>
						{/each}
					</Select.Content>
				</Select.Root>
			</div>

			<!-- Results Table -->
			<div class="bg-card rounded-lg shadow border border-border overflow-hidden">
				<div class="overflow-x-auto">
					<table class="w-full">
						<thead class="bg-muted border-b border-border">
							<tr>
								<th
									class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider"
								>
									Utilisateur
								</th>
								<th
									class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider"
								>
									Email
								</th>
								<th
									class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider"
								>
									Rôle
								</th>
								<th
									class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider"
								>
									École
								</th>
								<th
									class="px-6 py-3 text-left text-xs font-medium text-muted-foreground uppercase tracking-wider"
								>
									Classes
								</th>
								<th
									class="px-6 py-3 text-right text-xs font-medium text-muted-foreground uppercase tracking-wider"
								>
									Actions
								</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border">
							{#if searchResults.length > 0}
								{#each searchResults as user}
									<tr class="hover:bg-muted/50 transition-colors">
										<td class="px-6 py-4 whitespace-nowrap">
											<div class="flex items-center gap-3">
												<Avatar.Root class="h-8 w-8">
													{#if user.avatar_url}
														<Avatar.Image src={user.avatar_url} alt={getFullName(user)} />
													{/if}
													<Avatar.Fallback>
														{getInitials(user.firstname, user.lastname)}
													</Avatar.Fallback>
												</Avatar.Root>
												<div class="text-sm font-medium text-foreground">
													{getFullName(user)}
												</div>
											</div>
										</td>
										<td class="px-6 py-4 whitespace-nowrap">
											<div class="text-sm text-muted-foreground">{user.email}</div>
										</td>
										<td class="px-6 py-4 whitespace-nowrap">
											<Badge class={getRoleBadgeClass(user.role)}>{user.role}</Badge>
										</td>
										<td class="px-6 py-4 whitespace-nowrap">
											<div class="text-sm text-muted-foreground">
												{user.schools?.name || '—'}
											</div>
										</td>
										<td class="px-6 py-4">
											<div class="flex flex-wrap gap-1">
												{#each getClassNames(user.class_ids || []) as className}
													<Badge variant="outline" class="text-xs">{className}</Badge>
												{/each}
												{#if !user.class_ids || user.class_ids.length === 0}
													<span class="text-sm text-muted-foreground">—</span>
												{/if}
											</div>
										</td>
										<td class="px-6 py-4 whitespace-nowrap text-right">
											<Button variant="ghost" size="sm" onclick={() => openTableModal(user)}>
												Modifier
											</Button>
										</td>
									</tr>
								{/each}
							{:else if searchTerm.length >= 3 || selectedClassFilter}
								<tr>
									<td colspan="6" class="px-6 py-8 text-center text-muted-foreground">
										{isSearching ? 'Recherche en cours...' : 'Aucun utilisateur trouvé'}
									</td>
								</tr>
							{:else}
								<tr>
									<td colspan="6" class="px-6 py-8 text-center text-muted-foreground">
										Utilisez la recherche ou le filtre pour afficher les utilisateurs
									</td>
								</tr>
							{/if}
						</tbody>
					</table>
				</div>
			</div>
		</Tabs.Content>
	</Tabs.Root>
</div>

<!-- Table Modal (for editing in table view) -->
{#if showTableModal && selectedUser}
	<Dialog.Root open={showTableModal} onOpenChange={(open) => (showTableModal = open)}>
		<Dialog.Content class="max-w-2xl">
			<Dialog.Header>
				<Dialog.Title>Modifier l'utilisateur</Dialog.Title>
			</Dialog.Header>

			<form
				method="POST"
				action="?/update_profile"
				use:enhance={() => {
					return async ({ result, update }) => {
						await update();
						if (result.type === 'success') {
							closeTableModal();
							// Refresh search results
							handleSearchInput();
						}
					};
				}}
			>
				<input type="hidden" name="user_id" value={selectedUser.id} />

				<div class="space-y-4 py-4">
					<!-- Avatar Preview -->
					<div class="flex items-center gap-4">
						<Avatar.Root class="h-16 w-16">
							{#if editedUser.avatar_url}
								<Avatar.Image src={editedUser.avatar_url} alt={getFullName(editedUser)} />
							{/if}
							<Avatar.Fallback class="text-xl">
								{getInitials(editedUser.firstname, editedUser.lastname)}
							</Avatar.Fallback>
						</Avatar.Root>
						<div class="flex-1">
							<Label for="modal-avatar-url">URL de l'avatar</Label>
							<Input id="modal-avatar-url" name="avatar_url" type="url" bind:value={editedUser.avatar_url} />
						</div>
					</div>

					<!-- Name Fields -->
					<div class="grid grid-cols-2 gap-4">
						<div>
							<Label for="modal-firstname">Prénom</Label>
							<Input id="modal-firstname" name="firstname" type="text" bind:value={editedUser.firstname} />
						</div>
						<div>
							<Label for="modal-lastname">Nom</Label>
							<Input id="modal-lastname" name="lastname" type="text" bind:value={editedUser.lastname} />
						</div>
					</div>

					<!-- Email -->
					<div>
						<Label for="modal-email">Email</Label>
						<Input id="modal-email" name="email" type="email" bind:value={editedUser.email} required />
					</div>

					<!-- Role -->
					<div>
						<Label for="modal-role">Rôle</Label>
						<Select.Root
							onSelectedChange={(selected) => {
								if (selected) editedUser.role = selected.value;
							}}
						>
							<Select.Trigger>
								<Select.Value placeholder={editedUser.role} />
							</Select.Trigger>
							<Select.Content>
								<Select.Item value="student">Student</Select.Item>
								<Select.Item value="teacher">Teacher</Select.Item>
								<Select.Item value="admin">Admin</Select.Item>
							</Select.Content>
						</Select.Root>
						<input type="hidden" name="role" value={editedUser.role} />
					</div>

					<!-- School -->
					<div>
						<Label for="modal-school">École</Label>
						<Select.Root
							onSelectedChange={(selected) => {
								if (selected) editedUser.school_id = selected.value;
							}}
						>
							<Select.Trigger>
								<Select.Value
									placeholder={data.schools.find((s) => s.id === editedUser.school_id)?.name ||
										'Sélectionner une école'}
								/>
							</Select.Trigger>
							<Select.Content>
								<Select.Item value="">Aucune école</Select.Item>
								{#each data.schools as school}
									<Select.Item value={school.id}>{school.name}</Select.Item>
								{/each}
							</Select.Content>
						</Select.Root>
						<input type="hidden" name="school_id" value={editedUser.school_id || ''} />
					</div>

					<!-- Classes (read-only in modal, use card view for full management) -->
					<div>
						<Label>Classes actuelles</Label>
						<div class="flex flex-wrap gap-2 mt-2">
							{#if selectedUser.class_ids && selectedUser.class_ids.length > 0}
								{#each selectedUser.class_ids as classId}
									{@const className = data.classes.find((c) => c.id === classId)?.name}
									<Badge variant="outline">{className || 'Unknown'}</Badge>
								{/each}
							{:else}
								<p class="text-sm text-muted-foreground">Aucune classe</p>
							{/if}
						</div>
						<p class="text-xs text-muted-foreground mt-2">
							Utilisez la vue carte pour gérer les classes
						</p>
					</div>
				</div>

				<Dialog.Footer>
					<Button type="button" variant="outline" onclick={closeTableModal}>Annuler</Button>
					<Button type="submit">Enregistrer</Button>
				</Dialog.Footer>
			</form>
		</Dialog.Content>
	</Dialog.Root>
{/if}

exports[`snapshot — composition > (\\sqrt{x^2 + 1}) 1`] = `
"
###### (\\sqrt{x^2 + 1}) ######

Expression: \\sqrt{x^2 + 1} (variable: x)

========== LYCEE (summarized) ==========
- [sqrt] Dérivée de la racine carrée
  \\begin{aligned} & \\textcolor{blue}{(\\sqrt{x^2 + 1})'} \\\\ & = \\dfrac{2 x}{2 \\sqrt{x^2 + 1}} \\end{aligned}
  - [sum-with-constant] La constante a une dérivée nulle
    \\begin{aligned} & \\textcolor{blue}{(x^2 + 1)'} \\\\ & = 2 x \\end{aligned}
    - [power-natural] Règle de la puissance (2)
      \\begin{aligned} & \\textcolor{blue}{(x^2)'} \\\\ & = 2 x \\end{aligned}
Result: \\dfrac{2 x}{2 \\sqrt{x^2 + 1}}

========== LYCEE (detailed) ==========
- [sqrt] Dérivée de la racine carrée
  · Avec u = x^2 + 1, on a (\\sqrt u)' = u'/(2\\sqrt u).
  \\begin{aligned} & \\textcolor{blue}{(\\sqrt{x^2 + 1})'} \\\\ & = \\dfrac{2 x}{2 \\sqrt{x^2 + 1}} \\end{aligned}
  - [sum-with-constant] La constante a une dérivée nulle
    · La constante 1 a une dérivée nulle, donc seule la dérivée de x^2 contribue.
    \\begin{aligned} & \\textcolor{blue}{(x^2 + 1)'} \\\\ & = 2 x \\end{aligned}
    - [power-natural] Règle de la puissance (2)
      · (x^n)' = n x^{n-1} avec n = 2.
      \\begin{aligned} & \\textcolor{blue}{(x^2)'} \\\\ & = 2 x \\end{aligned}
Result: \\dfrac{2 x}{2 \\sqrt{x^2 + 1}}

========== SUPERIEUR (summarized) ==========
- [sqrt] (\\sqrt u)' = u'/(2\\sqrt u)
  \\begin{aligned} & \\textcolor{blue}{(\\sqrt{x^2 + 1})'} \\\\ & = \\dfrac{2 x}{2 \\sqrt{x^2 + 1}} \\end{aligned}
  - [sum-with-constant] (f+c)' = f'
    \\begin{aligned} & \\textcolor{blue}{(x^2 + 1)'} \\\\ & = 2 x \\end{aligned}
    - [power-natural] (x^n)' = nx^{n-1}
      \\begin{aligned} & \\textcolor{blue}{(x^2)'} \\\\ & = 2 x \\end{aligned}
Result: \\dfrac{2 x}{2 \\sqrt{x^2 + 1}}

========== SUPERIEUR (detailed) ==========
- [sqrt] (\\sqrt u)' = u'/(2\\sqrt u)
  · Avec u = x^2 + 1, on a (\\sqrt u)' = u'/(2\\sqrt u).
  \\begin{aligned} & \\textcolor{blue}{(\\sqrt{x^2 + 1})'} \\\\ & = \\dfrac{2 x}{2 \\sqrt{x^2 + 1}} \\end{aligned}
  - [sum-with-constant] (f+c)' = f'
    · La constante 1 a une dérivée nulle, donc seule la dérivée de x^2 contribue.
    \\begin{aligned} & \\textcolor{blue}{(x^2 + 1)'} \\\\ & = 2 x \\end{aligned}
    - [power-natural] (x^n)' = nx^{n-1}
      · (x^n)' = n x^{n-1} avec n = 2.
      \\begin{aligned} & \\textcolor{blue}{(x^2)'} \\\\ & = 2 x \\end{aligned}
Result: \\dfrac{2 x}{2 \\sqrt{x^2 + 1}}
"
`;


exports[`snapshot — non-standard-form > 3x² = 2x + 1 1`] = `
"
###### 3x² = 2x + 1 ######

========== TECHNIQUE — pipeline pédagogique (EquationStep) ==========
[1] identify-equation: Équation du second degré
[2] standardize: On déplace tous les termes dans le membre de gauche
[3] identify-coefficients: On identifie les coefficients a, b et c
[4] compute-discriminant: On calcule le discriminant Δ = b² − 4ac
[5] discriminant-positive: Δ > 0 : deux solutions distinctes
[6] apply-quadratic-formula: On applique la formule : x = (−b ± √Δ) / (2a)
[7] simplify-solutions: On simplifie les solutions
[8] read-solutions: On conclut sur l’ensemble des solutions

========== LYCEE (summarized) ==========
[1] Équation du second degré
[2] On met l’équation sous la forme \`ax² + bx + c = 0\`
[3] On identifie les coefficients a, b et c
[4] On calcule le discriminant Δ = b² − 4ac
[5] Δ > 0 : deux solutions distinctes
[6] On applique la formule : x = (−b ± √Δ) / (2a)
[7] On simplifie les solutions
[8] Solutions

========== LYCEE (detailed) ==========
[1] Équation du second degré
    │ 3x^2 = 2x + 1
[2] On met l’équation sous la forme \`ax² + bx + c = 0\`
    │ \\begin{aligned}   3x^2 &= 2x + 1 \\\\   3x^2 - 2x - 1 &= 0 \\end{aligned}
[3] On identifie les coefficients a, b et c
    │ a = 3, \\quad b = -2, \\quad c = -1
[4] On calcule le discriminant Δ = b² − 4ac
    │ \\Delta = b^2 - 4ac = \\left(-2\\right)^2 - 4 \\cdot \\left(3\\right) \\cdot \\left(-1\\right) = 16
[5] Δ > 0 : deux solutions distinctes
    │ 3x^2 - 2x - 1 = 0
[6] On applique la formule : x = (−b ± √Δ) / (2a)
    │ \\begin{aligned}   x &= \\dfrac{-b \\pm \\sqrt{\\Delta}}{2a} \\\\   &= \\dfrac{-\\left(-2\\right) \\pm \\sqrt{16}}{2 \\cdot \\left(3\\right)} \\end{aligned}
[7] On simplifie les solutions
    │ \\begin{aligned}   x_1 &= \\dfrac{2 - \\sqrt{16}}{2 3} = -\\dfrac{1}{3} \\\\
  x_2 &= \\dfrac{2 + \\sqrt{16}}{2 3} = 1 \\end{aligned}
[8] Solutions
    │ S = \\left\\{ -\\dfrac{1}{3} \\,;\\, 1 \\right\\}

========== SUPERIEUR (summarized) ==========
[1] Forme standard
[2] Coefficients a, b, c
[3] Discriminant : Δ > 0
[4] Formule du second degré
[5] Simplification
[6] Ensemble des solutions

========== SUPERIEUR (detailed) ==========
[1] Forme standard
    │ \\begin{aligned}   3x^2 &= 2x + 1 \\\\   3x^2 - 2x - 1 &= 0 \\end{aligned}
[2] Coefficients a, b, c
    │ a = 3, \\quad b = -2, \\quad c = -1
[3] Discriminant : Δ > 0
    │ \\Delta = b^2 - 4ac = \\left(-2\\right)^2 - 4 \\cdot \\left(3\\right) \\cdot \\left(-1\\right) = 16
[4] Formule du second degré
    │ \\begin{aligned}   x &= \\dfrac{-b \\pm \\sqrt{\\Delta}}{2a} \\\\   &= \\dfrac{-\\left(-2\\right) \\pm \\sqrt{16}}{2 \\cdot \\left(3\\right)} \\end{aligned}
[5] Simplification
    │ \\begin{aligned}   x_1 &= \\dfrac{2 - \\sqrt{16}}{2 3} = -\\dfrac{1}{3} \\\\
  x_2 &= \\dfrac{2 + \\sqrt{16}}{2 3} = 1 \\end{aligned}
[6] Ensemble des solutions
    │ S = \\left\\{ -\\dfrac{1}{3} \\,;\\, 1 \\right\\}
"
`;


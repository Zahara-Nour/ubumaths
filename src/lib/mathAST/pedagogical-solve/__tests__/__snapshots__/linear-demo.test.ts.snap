exports[`snapshot — regroupement-fractions > 2x/3 − 1/2 = x/4 + 1 1`] = `
"
###### 2x/3 − 1/2 = x/4 + 1 ######

========== TECHNIQUE — solveur algorithmique (solve()) ==========
[1] identify-linear-coefficients: On identifie les coefficients: a = 5/12, b = -3/2
[2] isolate-variable: Solution: x = 18/5

========== TECHNIQUE — pipeline pédagogique (EquationStep) ==========
[1] identify-equation: Équation du premier degré
[2] add-both-sides: On ajoute -\\dfrac{1}{4}x aux deux membres
[3] add-both-sides: On ajoute \\dfrac{1}{2} aux deux membres
[4] divide-both-sides: On divise les deux membres par \\dfrac{5}{12}
[5] read-solution: Solution : x = \\dfrac{18}{5}

========== COLLEGE (summarized) ==========
[1] Équation du premier degré
[2] On ajoute -\\dfrac{1}{4}x aux deux membres
[3] On ajoute \\dfrac{1}{2} aux deux membres
[4] On divise les deux membres par \\dfrac{5}{12}
[5] Solution : x = \\dfrac{18}{5}

========== COLLEGE (detailed) ==========
[1] Équation du premier degré
[2] On ajoute -\\dfrac{1}{4}x aux deux membres
    │ \\begin{aligned}
    │   \\dfrac{2x}{3} - \\dfrac{1}{2} \\textcolor{blue}{+ -\\dfrac{1}{4}x} &= \\dfrac{x}{4} + 1 \\textcolor{blue}{+ -\\dfrac{1}{4}x} \\\\
    │   \\dfrac{5}{12}x - \\dfrac{1}{2} &= 1
    │ \\end{aligned}
[3] On ajoute \\dfrac{1}{2} aux deux membres
    │ \\begin{aligned}
    │   \\dfrac{5}{12}x - \\dfrac{1}{2} \\textcolor{blue}{+ \\dfrac{1}{2}} &= 1 \\textcolor{blue}{+ \\dfrac{1}{2}} \\\\
    │   \\dfrac{5}{12}x &= \\dfrac{3}{2}
    │ \\end{aligned}
[4] On divise les deux membres par \\dfrac{5}{12}
    │ \\begin{aligned}
    │   \\dfrac{\\dfrac{5}{12}x}{\\textcolor{blue}{\\dfrac{5}{12}}} &= \\dfrac{\\dfrac{3}{2}}{\\textcolor{blue}{\\dfrac{5}{12}}} \\\\
    │   x &= \\dfrac{18}{5}
    │ \\end{aligned}
[5] Solution : x = \\dfrac{18}{5}

========== LYCEE (summarized) ==========
[1] Équation du premier degré
[2] On isole les termes en x dans le membre de gauche
[3] On termine en simplifiant le coefficient de x
[4] S = { \\dfrac{18}{5} }

========== LYCEE (detailed) ==========
[1] Équation du premier degré
[2] On isole les termes en x dans le membre de gauche
    │ \\begin{aligned}
    │   \\dfrac{2x}{3} \\textcolor{blue}{+ -\\dfrac{1}{4}x} &= 1 \\textcolor{blue}{+ \\dfrac{1}{2}} \\\\
    │   \\dfrac{5}{12}x &= \\dfrac{3}{2}
    │ \\end{aligned}
[3] On termine en simplifiant le coefficient de x
    │ x = \\dfrac{18}{5}
[4] S = { \\dfrac{18}{5} }

========== SUPERIEUR (summarized) ==========
[1] On isole x
    [1] On isole les termes en x dans le membre de gauche
    [2] On termine en simplifiant le coefficient de x
    [3] S = { \\dfrac{18}{5} }

========== SUPERIEUR (detailed) ==========
[1] On isole x
    │ \\begin{aligned}
    │   \\dfrac{2x}{3} - \\dfrac{1}{2} &= \\dfrac{x}{4} + 1 \\\\
    │   x &= \\dfrac{18}{5}
    │ \\end{aligned}
    [1] On isole les termes en x dans le membre de gauche
        │ \\begin{aligned}
        │   \\dfrac{2x}{3} \\textcolor{blue}{+ -\\dfrac{1}{4}x} &= 1 \\textcolor{blue}{+ \\dfrac{1}{2}} \\\\
        │   \\dfrac{5}{12}x &= \\dfrac{3}{2}
        │ \\end{aligned}
    [2] On termine en simplifiant le coefficient de x
        │ x = \\dfrac{18}{5}
    [3] S = { \\dfrac{18}{5} }
"
`;


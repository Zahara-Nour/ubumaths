exports[`snapshot — scientific > '(3 × 10⁴) × (2 × 10⁻²) → 6 × 10²' 1`] = `
"
###### (3 × 10⁴) × (2 × 10⁻²) → 6 × 10² ######

target: {"structure":"scientific"}

========== COLLEGE (detailed) ==========
[0] On écrit la puissance comme un produit
    │ 3*@blue{10^4}*2*10^{-2}
    │ = 3*10*10*10*10*2*10^{-2}
[1] Multiplication
    │ 3*@blue{10*10}*10*10*2*10^{-2}
    │ = 3*100*10*10*2*10^{-2}
[2] Multiplication
    │ 3*@blue{100*10}*10*2*10^{-2}
    │ = 3*1000*10*2*10^{-2}
[3] Multiplication
    │ 3*@blue{1000*10}*2*10^{-2}
    │ = 3*10000*2*10^{-2}
[4] Multiplication
    │ @blue{3*10000}*2*10^{-2}
    │ = 30000*2*10^{-2}
[5] On calcule
    │ @blue{30000*2*10^{-2}}
    │ = 600
[6] On écrit en notation scientifique
    │ @blue{600}
    │ = 6*10^2
    │ (On déplace la virgule pour obtenir un nombre entre 1 et 10, en compensant par une puissance de 10.)
"
`;

exports[`snapshot — scientific > '(5 × 10³) × (4 × 10²) → 2 × 10⁶ (over…' 1`] = `
"
###### (5 × 10³) × (4 × 10²) → 2 × 10⁶ (overflow re-norm) ######

target: {"structure":"scientific"}

========== COLLEGE (detailed) ==========
[0] On écrit la puissance comme un produit
    │ 5*@blue{10^3}*4*10^2
    │ = 5*10*10*10*4*10^2
[1] Multiplication
    │ 5*@blue{10*10}*10*4*10^2
    │ = 5*100*10*4*10^2
[2] Multiplication
    │ 5*@blue{100*10}*4*10^2
    │ = 5*1000*4*10^2
[3] Multiplication
    │ @blue{5*1000}*4*10^2
    │ = 5000*4*10^2
[4] On écrit la puissance comme un produit
    │ 5000*4*@blue{10^2}
    │ = 5000*4*10*10
[5] Multiplication
    │ 5000*4*@blue{10*10}
    │ = 5000*4*100
[6] Multiplication
    │ 5000*@blue{4*100}
    │ = 5000*400
[7] Multiplication
    │ @blue{5000*400}
    │ = 2000000
[8] On écrit en notation scientifique
    │ @blue{2000000}
    │ = 2*10^6
    │ (On déplace la virgule pour obtenir un nombre entre 1 et 10, en compensant par une puissance de 10.)
"
`;


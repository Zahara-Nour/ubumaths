"
`;

exports[`snapshot — basic > '(2 + 3) × (4 − 1) (deux parenthèses)' 1`] = `
"
###### (2 + 3) × (4 − 1) (deux parenthèses) ######

========== PRIMAIRE (detailed) ==========
[0] On additionne 2 et 3
    │ (@blue{2+3})*(4-1)
    │ = 5*(4-1)
[1] On soustrait 1 de 4
    │ 5*(@blue{4-1})
    │ = 5*3
[2] On multiplie 5 par 3
    │ @blue{5*3}
    │ = 15

========== COLLEGE (detailed) ==========
[0] On effectue les calculs entre parenthèses
    │ @blue{(2+3)}*@blue{(4-1)}
    │ = 5*3
    │ (En présence de parenthèses, on commence par calculer ce qu'il y a à l'intérieur.)
[1] Multiplication
    │ @blue{5*3}
    │ = 15
"
`;


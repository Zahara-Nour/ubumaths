exports[`snapshot — scientific > '(3 × 10⁴) × (2 × 10⁻²) → 6 × 10²' 1`] = `
"
###### (3 × 10⁴) × (2 × 10⁻²) → 6 × 10² ######

target: {"structure":"scientific"}

========== COLLEGE (detailed) ==========
[0] On multiplie les coefficients et on additionne les exposants
    │ @blue{3*10^4*2*10^{-2}}
    │ = 6*10^2
[1] On écrit la puissance comme un produit
    │ 6*@blue{10^2}
    │ = 6*10*10
[2] Multiplication
    │ 6*@blue{10*10}
    │ = 6*100
[3] Multiplication
    │ @blue{6*100}
    │ = 600
[4] On écrit en notation scientifique
    │ @blue{600}
    │ = 6*10^2
    │ (On déplace la virgule pour obtenir un nombre entre 1 et 10, en compensant par une puissance de 10.)
"
`;


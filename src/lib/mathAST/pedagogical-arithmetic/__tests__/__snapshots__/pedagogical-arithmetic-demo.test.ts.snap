exports[`snapshot — target-form-scenarios > '1/3 + 1/6 + reduced-fraction strict →…' 1`] = `
"
###### 1/3 + 1/6 + reduced-fraction strict → 1/2 ######

target: {"structure":"reduced-fraction","strictCosmetics":{"reducedFractions":"strict"}}

========== COLLEGE (summarized) ==========
[0] On met les fractions au même dénominateur
[1] On additionne les numérateurs (même dénominateur)
[2] On simplifie la fraction

========== COLLEGE (detailed) ==========
[0] On met les fractions au même dénominateur
    │ \\begin{aligned}
  & \\textcolor{blue}{\\dfrac{1}{3} + \\dfrac{1}{6}} \\\\
  & = \\dfrac{2}{6} + \\dfrac{1}{6}
\\end{aligned}
    │ (Pour additionner deux fractions, on les écrit avec le même dénominateur (le PPCM des dénominateurs).)
[1] On additionne les numérateurs (même dénominateur)
    │ \\begin{aligned}
  & \\textcolor{blue}{\\dfrac{2}{6} + \\dfrac{1}{6}} \\\\
  & = \\dfrac{3}{6}
\\end{aligned}
[2] On simplifie la fraction
    │ \\begin{aligned}
  & \\textcolor{blue}{\\dfrac{3}{6}} \\\\
  & = \\dfrac{1}{2}
\\end{aligned}
    │ (On divise numérateur et dénominateur par leur PGCD.)

========== LYCEE (summarized) ==========
[0] Mise au même dénominateur
[1] Addition des numérateurs
[2] Réduction

========== LYCEE (detailed) ==========
[0] Mise au même dénominateur
    │ \\begin{aligned}
  & \\textcolor{blue}{\\dfrac{1}{3} + \\dfrac{1}{6}} \\\\
  & = \\dfrac{2}{6} + \\dfrac{1}{6}
\\end{aligned}
[1] Addition des numérateurs
    │ \\begin{aligned}
  & \\textcolor{blue}{\\dfrac{2}{6} + \\dfrac{1}{6}} \\\\
  & = \\dfrac{3}{6}
\\end{aligned}
[2] Réduction
    │ \\begin{aligned}
  & \\textcolor{blue}{\\dfrac{3}{6}} \\\\
  & = \\dfrac{1}{2}
\\end{aligned}
"
`;


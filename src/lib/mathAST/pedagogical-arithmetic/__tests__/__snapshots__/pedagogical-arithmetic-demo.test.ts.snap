exports[`snapshot — basic > '2 + 3 × 4 + 5 × 6 (regroupement)' 1`] = `
"
###### 2 + 3 × 4 + 5 × 6 (regroupement) ######

========== PRIMAIRE (detailed) ==========
[0] On multiplie 3 par 4
    │ 2+@blue{3*4}+5*6
    │ = 2+12+5*6
[1] On additionne 2 et 12
    │ @blue{2+12}+5*6
    │ = 14+5*6
[2] On multiplie 5 par 6
    │ 14+@blue{5*6}
    │ = 14+30
[3] On additionne 14 et 30
    │ @blue{14+30}
    │ = 44

========== COLLEGE (detailed) ==========
[0] On effectue d'abord les multiplications
    │ @blue{2+3*4+5*6}
    │ = 2+12+30
    │ (En l'absence de parenthèses, les multiplications sont effectuées avant les additions et soustractions.)
[1] Addition
    │ @blue{2+12}+30
    │ = 14+30
[2] Addition
    │ @blue{14+30}
    │ = 44
"
`;


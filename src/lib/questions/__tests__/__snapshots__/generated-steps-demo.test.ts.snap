    "hasExplanation": true,
    "hasExpressionLatex": true,
    "id": 8,
    "rule": "inequality-conclude-quadratic",
    "schoolLevel": "lycee",
    "title": "Solution : S = ]2 ; 3[",
  },
]
`;


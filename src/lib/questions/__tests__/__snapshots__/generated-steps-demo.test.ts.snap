  },
  {
    "hasExplanation": true,
    "hasExpressionLatex": true,
    "id": 3,
    "rule": "compute-discriminant",
    "schoolLevel": "lycee",
    "title": "On calcule le discriminant Δ = b² − 4ac",
  },
  {
    "hasExplanation": true,
    "hasExpressionLatex": true,
    "id": 4,
    "rule": "discriminant-positive",
    "schoolLevel": "lycee",
    "title": "Δ > 0 : le polynôme admet deux racines distinctes",
  },
  {
    "hasExplanation": true,
    "hasExpressionLatex": true,
    "id": 5,
    "rule": "apply-quadratic-formula",
    "schoolLevel": "lycee",
    "title": "On applique la formule : x = (−b ± √Δ) / (2a)",
  },
  {
    "hasExplanation": true,
    "hasExpressionLatex": true,
    "id": 6,
    "rule": "simplify-solutions",
    "schoolLevel": "lycee",
    "title": "On simplifie les racines",

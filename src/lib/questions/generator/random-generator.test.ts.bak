/**
 * Random Generator Tests
 * =======================
 *
 * Tests for generating random integers and decimals with exclusions.
 */

import { describe, it, expect } from 'vitest';
import { generateRandomNumber } from './random-generator';
import type { RandomExpression, NumberOrVariable } from '../types';

// Helper functions for constructing test specifications
function num(value: number): NumberOrVariable {
	return { type: 'number', value };
}

function varRef(name: string): NumberOrVariable {
	return { type: 'variable', name };
}

describe('generateRandomNumber - Integer Ranges', () => {
	it('should generate integer within range', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 10,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		expect(result).toBeGreaterThanOrEqual(1);
		expect(result).toBeLessThanOrEqual(10);
		expect(Number.isInteger(result)).toBe(true);
	});

	it('should generate same number with same seed', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 100,
			exclusions: []
		};

		const result1 = generateRandomNumber(spec, {}, 12345);
		const result2 = generateRandomNumber(spec, {}, 12345);

		expect(result1).toBe(result2);
	});

	it('should generate different numbers with different seeds', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 1000,
			exclusions: []
		};

		const result1 = generateRandomNumber(spec, {}, 11111);
		const result2 = generateRandomNumber(spec, {}, 22222);

		// With large range, very unlikely to be same
		expect(result1).not.toBe(result2);
	});

	it('should handle negative ranges', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: -10,
			max: -1,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		expect(result).toBeGreaterThanOrEqual(-10);
		expect(result).toBeLessThanOrEqual(-1);
	});

	it('should handle range crossing zero', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: -5,
			max: 5,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		expect(result).toBeGreaterThanOrEqual(-5);
		expect(result).toBeLessThanOrEqual(5);
	});

	it('should handle single-value range', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 42,
			max: 42,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		expect(result).toBe(42);
	});
});

describe('generateRandomNumber - Decimal Ranges', () => {
	it('should generate decimal within range', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			min: 0.5,
			max: 9.99,
			step: 0.01,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		expect(result).toBeGreaterThanOrEqual(0.5);
		expect(result).toBeLessThanOrEqual(9.99);
	});

	it('should respect decimal step', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			min: 0,
			max: 1,
			step: 0.1,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		// Result should be multiple of step
		const stepsFromMin = Math.round((result - 0) / 0.1);
		const expected = 0 + stepsFromMin * 0.1;

		expect(Math.abs(result - expected)).toBeLessThan(0.0001);
	});

	it('should handle decimal step of 0.01', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			min: 1.5,
			max: 2.5,
			step: 0.01,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		expect(result).toBeGreaterThanOrEqual(1.5);
		expect(result).toBeLessThanOrEqual(2.5);

		// Check precision
		const rounded = Math.round(result * 100) / 100;
		expect(Math.abs(result - rounded)).toBeLessThan(0.0001);
	});

	it('should generate same decimal with same seed', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			min: 0,
			max: 10,
			step: 0.1,
			exclusions: []
		};

		const result1 = generateRandomNumber(spec, {}, 54321);
		const result2 = generateRandomNumber(spec, {}, 54321);

		expect(result1).toBe(result2);
	});
});

describe('generateRandomNumber - Decimal by Digits', () => {
	it('should generate decimal with specified digits', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			digitsBefore: 2,
			digitsAfter: 3,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		// Should be between 10.000 and 99.999
		expect(result).toBeGreaterThanOrEqual(10);
		expect(result).toBeLessThan(100);

		// Check decimal places
		const str = result.toString();
		const parts = str.split('.');
		expect(parts.length).toBe(2); // Has decimal point
		expect(parts[1].length).toBeLessThanOrEqual(3);
	});

	it('should handle single digit before decimal', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			digitsBefore: 1,
			digitsAfter: 2,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		expect(result).toBeGreaterThanOrEqual(0);
		expect(result).toBeLessThan(10);
	});

	it('should handle many digits after decimal', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			digitsBefore: 1,
			digitsAfter: 5,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		expect(result).toBeGreaterThanOrEqual(0);
		expect(result).toBeLessThan(10);

		const str = result.toFixed(5);
		const parts = str.split('.');
		expect(parts[1].length).toBe(5);
	});
});

describe('generateRandomNumber - Value Exclusions', () => {
	it('should exclude single value', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 5,
			exclusions: [{ type: 'value', value: 3 }]
		};

		// Generate many times to ensure 3 is never chosen
		for (let i = 0; i < 50; i++) {
			const result = generateRandomNumber(spec, {}, i);
			expect(result).not.toBe(3);
			expect([1, 2, 4, 5]).toContain(result);
		}
	});

	it('should exclude multiple values', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 10,
			exclusions: [
				{ type: 'value', value: 3 },
				{ type: 'value', value: 5 },
				{ type: 'value', value: 7 }
			]
		};

		for (let i = 0; i < 50; i++) {
			const result = generateRandomNumber(spec, {}, i);
			expect([3, 5, 7]).not.toContain(result);
		}
	});

	it('should handle decimal value exclusions', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			min: 1.0,
			max: 5.0,
			step: 0.5,
			exclusions: [{ type: 'value', value: 2.5 }]
		};

		for (let i = 0; i < 30; i++) {
			const result = generateRandomNumber(spec, {}, i);
			expect(result).not.toBe(2.5);
		}
	});
});

describe('generateRandomNumber - Range Exclusions', () => {
	it('should exclude range of values', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 20,
			exclusions: [{ type: 'range', min: 10, max: 15 }]
		};

		for (let i = 0; i < 50; i++) {
			const result = generateRandomNumber(spec, {}, i);
			expect(result < 10 || result > 15).toBe(true);
		}
	});

	it('should exclude multiple ranges', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 30,
			exclusions: [
				{ type: 'range', min: 5, max: 10 },
				{ type: 'range', min: 20, max: 25 }
			]
		};

		for (let i = 0; i < 50; i++) {
			const result = generateRandomNumber(spec, {}, i);
			const inFirstRange = result >= 5 && result <= 10;
			const inSecondRange = result >= 20 && result <= 25;
			expect(inFirstRange || inSecondRange).toBe(false);
		}
	});

	it('should handle range exclusion at boundaries', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 10,
			exclusions: [{ type: 'range', min: 1, max: 5 }]
		};

		for (let i = 0; i < 30; i++) {
			const result = generateRandomNumber(spec, {}, i);
			expect(result).toBeGreaterThan(5);
			expect(result).toBeLessThanOrEqual(10);
		}
	});
});

describe('generateRandomNumber - Variable Resolution', () => {
	it('should resolve variable in min bound', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: { type: 'variable', name: 'minVal' },
			max: 10,
			exclusions: []
		};

		const context = { minVal: 5 };
		const result = generateRandomNumber(spec, context);

		expect(result).toBeGreaterThanOrEqual(5);
		expect(result).toBeLessThanOrEqual(10);
	});

	it('should resolve variable in max bound', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: { type: 'variable', name: 'maxVal' },
			exclusions: []
		};

		const context = { maxVal: 8 };
		const result = generateRandomNumber(spec, context);

		expect(result).toBeGreaterThanOrEqual(1);
		expect(result).toBeLessThanOrEqual(8);
	});

	it('should resolve variables in both bounds', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: { type: 'variable', name: 'min' },
			max: { type: 'variable', name: 'max' },
			exclusions: []
		};

		const context = { min: 10, max: 20 };
		const result = generateRandomNumber(spec, context);

		expect(result).toBeGreaterThanOrEqual(10);
		expect(result).toBeLessThanOrEqual(20);
	});

	it('should resolve variable in value exclusion', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 10,
			exclusions: [{ type: 'variable', name: 'excluded' }]
		};

		const context = { excluded: 5 };

		for (let i = 0; i < 30; i++) {
			const result = generateRandomNumber(spec, context, i);
			expect(result).not.toBe(5);
		}
	});

	it('should resolve variables in range exclusion', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 20,
			exclusions: [
				{
					type: 'range',
					min: { type: 'variable', name: 'excludeMin' },
					max: { type: 'variable', name: 'excludeMax' }
				}
			]
		};

		const context = { excludeMin: 8, excludeMax: 12 };

		for (let i = 0; i < 30; i++) {
			const result = generateRandomNumber(spec, context, i);
			expect(result < 8 || result > 12).toBe(true);
		}
	});

	it('should resolve variables in decimal digits', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			digitsBefore: { type: 'variable', name: 'before' },
			digitsAfter: { type: 'variable', name: 'after' },
			exclusions: []
		};

		const context = { before: 2, after: 2 };
		const result = generateRandomNumber(spec, context);

		expect(result).toBeGreaterThanOrEqual(10);
		expect(result).toBeLessThan(100);
	});
});

describe('generateRandomNumber - Edge Cases', () => {
	it('should handle large ranges', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 1000000,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		expect(result).toBeGreaterThanOrEqual(1);
		expect(result).toBeLessThanOrEqual(1000000);
	});

	it('should handle very small decimal steps', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			min: 0,
			max: 1,
			step: 0.001,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		expect(result).toBeGreaterThanOrEqual(0);
		expect(result).toBeLessThanOrEqual(1);
	});

	it('should handle many exclusions', () => {
		const exclusions = [];
		for (let i = 2; i <= 50; i += 2) {
			exclusions.push({ type: 'value' as const, value: i });
		}

		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 50,
			exclusions
		};

		for (let i = 0; i < 20; i++) {
			const result = generateRandomNumber(spec, {}, i);
			// Should only generate odd numbers
			expect(result % 2).toBe(1);
		}
	});

	it('should handle exclusion covering entire range except one value', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 5,
			exclusions: [{ type: 'range', min: 1, max: 4 }]
		};

		const result = generateRandomNumber(spec, {});

		// Only 5 is available
		expect(result).toBe(5);
	});

	it('should handle negative decimal numbers', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			min: -5.5,
			max: -0.5,
			step: 0.5,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		expect(result).toBeGreaterThanOrEqual(-5.5);
		expect(result).toBeLessThanOrEqual(-0.5);
	});

	it('should handle zero in range', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: -3,
			max: 3,
			exclusions: []
		};

		const result = generateRandomNumber(spec, {});

		expect(result).toBeGreaterThanOrEqual(-3);
		expect(result).toBeLessThanOrEqual(3);
	});
});

describe('generateRandomNumber - Error Cases', () => {
	it('should throw on min > max', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 10,
			max: 1,
			exclusions: []
		};

		expect(() => generateRandomNumber(spec, {})).toThrow();
	});

	it('should throw on invalid step (zero)', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			min: 0,
			max: 10,
			step: 0,
			exclusions: []
		};

		expect(() => generateRandomNumber(spec, {})).toThrow();
	});

	it('should throw on negative step', () => {
		const spec: RandomExpression = {
			type: 'decimal',
			min: 0,
			max: 10,
			step: -0.1,
			exclusions: []
		};

		expect(() => generateRandomNumber(spec, {})).toThrow();
	});

	it('should throw on missing variable in context', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: { type: 'variable', name: 'missing' },
			max: 10,
			exclusions: []
		};

		expect(() => generateRandomNumber(spec, {})).toThrow();
	});

	it('should throw when all values are excluded', () => {
		const spec: RandomExpression = {
			type: 'integer',
			min: 1,
			max: 5,
			exclusions: [{ type: 'range', min: 1, max: 5 }]
		};

		expect(() => generateRandomNumber(spec, {})).toThrow();
	});
});

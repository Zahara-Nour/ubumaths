		description: 'Get a specific assessment by ID',
		summary: 'Get assessment',
		tags: ['Assessments'],
		request: {
			params: z.object({ id: common.uuidSchema })
		},
		responses: {
			200: {
				description: 'Assessment details',
				content: {
					'application/json': {

{
	"name": "ubumaths",
	"private": true,
	"version": "0.6.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "NODE_OPTIONS='--max-old-space-size=4096' vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "NODE_OPTIONS='--max-old-space-size=8192' svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:changed": "bash scripts/check-changed.sh",
		"check:staged": "bash scripts/check-changed.sh --staged",
		"check:fast": "svelte-kit sync && tsc --noEmit --incremental",
		"check:safe": "NODE_OPTIONS='--max-old-space-size=8192' svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"format": "prettier --write .",
		"lint": "eslint . --cache",
		"test:unit": "vitest",
		"test:server": "vitest run --project=server",
		"test:client": "vitest run --project=client",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:integration:watch": "vitest --config vitest.integration.config.ts",
		"test:triggers": "vitest run --config vitest.triggers.config.ts",
		"test:triggers:watch": "vitest --config vitest.triggers.config.ts",
		"test:lint-rules": "node eslint-rules/require-zod-validation.test.js",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"release": "standard-version",
		"release:patch": "standard-version --release-as patch",
		"release:minor": "standard-version --release-as minor",
		"release:major": "standard-version --release-as major",
		"kill:servers": "bash scripts/kill-servers.sh",
		"db:types": "pnpm supabase gen types typescript --project-id aqtijumsgfufoztohdua > src/lib/types/database.ts",
		"db:migrate": "supabase db push",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:fix-profiles": "supabase db execute --file supabase/migrations/005_fix_existing_users.sql",
		"db:status": "supabase db execute --sql \"SELECT COUNT(CASE WHEN p.id IS NULL THEN 1 END) as missing_profiles, COUNT(CASE WHEN p.id IS NOT NULL THEN 1 END) as users_with_profiles, COUNT(*) as total_users FROM auth.users u LEFT JOIN public.profiles p ON u.id = p.id;\"",
		"db:link": "supabase link",
		"game:setup-assets": "bash scripts/setup-game-assets.sh",
		"migrate:phase1": "tsx scripts/migrate-questions-phase1.ts",
		"migrate:phase1:dry": "tsx scripts/migrate-questions-phase1.ts --dry-run",
		"migrate:phase1:resume": "tsx scripts/migrate-questions-phase1.ts --resume",
		"migrate:phase1:rollback": "tsx scripts/migrate-questions-phase1.ts --rollback",
		"migrate:phase1:validate": "tsx scripts/validate-phase1-questions.ts",
		"migration:import": "tsx scripts/import-questions-to-db.ts",
		"migration:import:dry": "tsx scripts/import-questions-to-db.ts --dry-run",
		"migration:import:approved": "tsx scripts/import-questions-to-db.ts --approved-only",
		"migration:rollback": "tsx scripts/rollback-migration.ts",
		"migration:rollback:dry": "tsx scripts/rollback-migration.ts --dry-run",
		"migration:rollback:all": "tsx scripts/rollback-migration.ts --all",
		"game:import-challenges": "npx tsx scripts/import-navadra-challenges.ts",
		"game:seed-spells": "npx tsx scripts/seed-spell-definitions.ts",
		"docs:check-links": "npx tsx scripts/check-doc-links.ts",
		"openapi:generate": "npx tsx scripts/generate-openapi.ts",
		"migrate:sanitize": "tsx scripts/sanitize-existing-notifications.ts",
		"math": "tsx src/lib/mathAST/cli/cli.ts"
	},

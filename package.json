		"openapi3-ts": "^4.5.0",
		"oxlint": "^1.70.0",
		"pg": "^8.20.0",
		"playwright": "^1.59.1",
		"prettier": "3.4.2",
		"prettier-plugin-svelte": "3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"rollup-plugin-visualizer": "^7.0.1",
		"shadcn-svelte": "^1.2.7",
		"sharp": "^0.35.0",
		"standard-version": "^9.5.0",
		"svelte": "^5.56.3",
		"svelte-check": "^4.4.6",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2",
		"tailwindcss": "^4.2.2",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.2",
		"vite": "^7.3.5",
		"vitest": "^3.2.7",
		"vitest-browser-svelte": "^1.1.0",
		"xml2js": "^0.6.2"

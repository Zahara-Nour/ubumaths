{
	"name": "chiphre",
	"private": true,
	"version": "0.43.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/Zahara-Nour/ubumaths.git"
	},
	"packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec",
	"engines": {
		"node": "22.x"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "bash scripts/gros-process.sh 'Un pnpm build' env NODE_OPTIONS='--max-old-space-size=8192' vite build",
		"analyze": "ANALYZE=1 pnpm build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && bash scripts/gros-process.sh 'Un pnpm check' env NODE_OPTIONS='--max-old-space-size=8192' svelte-check --tsconfig ./tsconfig.check.json",
		"check:watch": "svelte-kit sync && NODE_OPTIONS='--max-old-space-size=8192' svelte-check --tsconfig ./tsconfig.check.json --watch",
		"check:changed": "bash scripts/check-changed.sh",
		"check:staged": "bash scripts/check-changed.sh --staged",
		"check:incremental": "bash scripts/check-incremental.sh",
		"logs:cliquet": "tsx scripts/cliquet-console-serveur.ts",
		"types:cliquet": "svelte-kit sync && bash scripts/gros-process.sh 'Un cliquet des types des tests' tsx scripts/cliquet-types-tests.ts",
		"check:css-tokens": "bash scripts/check-css-tokens.sh",
		"extern:sync": "bash scripts/extern-sync.sh",
		"format": "prettier --write",
		"format:all": "prettier --write .",
		"format:check": "bash scripts/format-check-tracked.sh",
		"format:check:all": "prettier --check --cache .",
		"lint": "bash scripts/gros-process.sh 'Un pnpm lint' eslint --cache --cache-strategy content",
		"lint:fast": "bash scripts/lint-fast.sh",
		"svelte:autofix": "svelte-mcp svelte-autofixer",
		"lint:all": "eslint . --cache",
		"test:server": "vitest run --project=server",
		"test:client": "vitest run --project=client",
		"test:changed": "vitest run --changed --passWithNoTests",
		"test:integration": "bash scripts/with-db-lock.sh vitest run --config vitest.integration.config.ts",
		"test:definer-guard": "bash scripts/with-db-lock.sh vitest run --config vitest.definer-guard.config.ts",
		"test:integration:watch": "bash scripts/with-db-lock.sh vitest --config vitest.integration.config.ts",
		"test:lint-rules": "node eslint-rules/require-zod-validation.test.js",
		"test": "npm run test:changed",
		"test:e2e": "playwright test",
		"release": "tsx scripts/release.ts",
		"release:patch": "commit-and-tag-version --release-as patch",
		"release:minor": "commit-and-tag-version --release-as minor",
		"release:major": "commit-and-tag-version --release-as major",
		"ci": "gh run watch --interval 30",
		"ci:list": "gh run list --branch main --limit 10",
		"ci:status": "gh api repos/{owner}/{repo}/commits/main/check-runs -q '.check_runs[] | \"\\(.name): \\(.conclusion // .status)\"'",
		"ci:fail": "gh run view \"$(gh run list --branch main -L1 --json databaseId -q '.[0].databaseId')\" --log-failed",
		"ci:web": "gh run view --web",
		"deploy:status": "gh api repos/{owner}/{repo}/commits/main/status -q '\"overall: \\(.state)\", (.statuses[] | \"\\(.context): \\(.state)  \\(.target_url)\")'",
		"status": "pnpm ci:status && pnpm deploy:status",
		"vercel:env": "vercel env ls production",
		"deploy:prod": "bash scripts/deploy-prod.sh",
		"env:pull": "vercel env pull .env.local",
		"env:pull:prod": "vercel env pull --environment=production .env.local",
		"maintenance:on": "bash scripts/vercel-maintenance.sh on",
		"maintenance:off": "bash scripts/vercel-maintenance.sh off",
		"maintenance:status": "bash scripts/vercel-maintenance.sh status",
		"kill:servers": "bash scripts/kill-servers.sh",
		"db:types": "pnpm supabase gen types typescript --project-id cnevnzsvixxpnurautls --schema public > src/lib/types/database.ts && tsx scripts/generate-db-doc.ts",
		"db:doc": "tsx scripts/generate-db-doc.ts",
		"check:barrels": "tsx scripts/check-barrel-exports.ts",
		"check:await-render": "tsx scripts/check-await-render.ts",
		"check:integration-paths": "tsx scripts/check-integration-paths.ts",
		"check:ubumark": "tsx scripts/check-ubumark.ts",
		"fiche:verifier": "bash scripts/fiches/verifier-fiche.sh",
		"db:migrate": "supabase db push",
		"db:start": "bash scripts/with-db-lock.sh supabase start",
		"db:stop": "bash scripts/with-db-lock.sh supabase stop",
		"db:reset": "bash scripts/with-db-lock.sh supabase db reset",
		"db:seed-riche": "bash scripts/with-db-lock.sh tsx scripts/db-seed-riche/index.ts",
		"db:dev-accounts": "bash scripts/with-db-lock.sh docker exec -i supabase_db_ubumaths psql -U postgres -d postgres -q -v ON_ERROR_STOP=1 < supabase/seed/dev_accounts.sql && echo \"✓ comptes de dev restaurés\"",
		"db:status": "supabase db execute --sql \"SELECT COUNT(CASE WHEN p.id IS NULL THEN 1 END) as missing_profiles, COUNT(CASE WHEN p.id IS NOT NULL THEN 1 END) as users_with_profiles, COUNT(*) as total_users FROM auth.users u LEFT JOIN public.profiles p ON u.id = p.id;\"",
		"db:link": "supabase link",
		"game:setup-assets": "bash scripts/setup-game-assets.sh",
		"migrate:phase1": "tsx scripts/migrate-questions-phase1.ts",
		"migrate:phase1:dry": "tsx scripts/migrate-questions-phase1.ts --dry-run",
		"migrate:phase1:resume": "tsx scripts/migrate-questions-phase1.ts --resume",
		"migrate:phase1:rollback": "tsx scripts/migrate-questions-phase1.ts --rollback",
		"migrate:phase1:validate": "tsx scripts/validate-phase1-questions.ts",
		"question:specs": "tsx scripts/question-specs.ts",
		"relecture:verdicts": "tsx scripts/record-review.ts",
		"relecture:import": "tsx scripts/import-reviewed-questions.ts",
		"corrections:generate": "tsx scripts/corrections/generate.ts",
		"corrections:check": "tsx scripts/corrections/check.ts",
		"corrections:preview": "tsx scripts/corrections/preview.ts",
		"corrections:import": "tsx scripts/corrections/import.ts",
		"corrections:retouches": "tsx scripts/corrections/retouches.ts",
		"migration:import": "tsx scripts/import-questions-to-db.ts",
		"migration:import:dry": "tsx scripts/import-questions-to-db.ts --dry-run",
		"migration:import:approved": "tsx scripts/import-questions-to-db.ts --approved-only",
		"migration:rollback": "tsx scripts/rollback-migration.ts",
		"migration:rollback:dry": "tsx scripts/rollback-migration.ts --dry-run",
		"migration:rollback:all": "tsx scripts/rollback-migration.ts --all",
		"game:import-challenges": "npx tsx scripts/import-navadra-challenges.ts",
		"game:seed-spells": "npx tsx scripts/seed-spell-definitions.ts",
		"docs:check-links": "tsx scripts/check-doc-links.ts",
		"docs:check-refs": "tsx scripts/check-doc-refs.ts",
		"docs:check-a-jour": "tsx scripts/check-doc-a-jour.ts",
		"openapi:generate": "npx tsx scripts/generate-openapi.ts",
		"migrate:sanitize": "tsx scripts/sanitize-existing-notifications.ts",
		"math": "tsx src/lib/mathAST/cli/cli.ts"
	},

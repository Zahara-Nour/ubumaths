{
	"name": "ubumaths",
	"private": true,
	"version": "0.2.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "husky",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:changed": "bash scripts/check-changed.sh",
		"check:staged": "bash scripts/check-changed.sh --staged",
		"check:fast": "svelte-kit sync && tsc --noEmit --incremental",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint . --cache",
		"test:unit": "vitest",
		"test:integration": "vitest run --config vitest.integration.config.ts",
		"test:integration:watch": "vitest --config vitest.integration.config.ts",
		"test:triggers": "vitest run --config vitest.triggers.config.ts",
		"test:triggers:watch": "vitest --config vitest.triggers.config.ts",
		"test:lint-rules": "node eslint-rules/require-zod-validation.test.js",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"release": "standard-version",
		"release:patch": "standard-version --release-as patch",
		"release:minor": "standard-version --release-as minor",
		"release:major": "standard-version --release-as major",
		"kill:servers": "bash scripts/kill-servers.sh",
		"db:migrate": "supabase db push",
		"db:start": "supabase start",
		"db:stop": "supabase stop",
		"db:reset": "supabase db reset",
		"db:fix-profiles": "supabase db execute --file supabase/migrations/005_fix_existing_users.sql",
		"db:status": "supabase db execute --sql \"SELECT COUNT(CASE WHEN p.id IS NULL THEN 1 END) as missing_profiles, COUNT(CASE WHEN p.id IS NOT NULL THEN 1 END) as users_with_profiles, COUNT(*) as total_users FROM auth.users u LEFT JOIN public.profiles p ON u.id = p.id;\"",
		"db:link": "supabase link",
		"game:setup-assets": "bash scripts/setup-game-assets.sh",
		"game:import-challenges": "npx tsx scripts/import-navadra-challenges.ts",
		"game:seed-spells": "npx tsx scripts/seed-spell-definitions.ts",
		"docs:check-links": "npx tsx scripts/check-doc-links.ts",
		"openapi:generate": "npx tsx scripts/generate-openapi.ts",
		"migrate:sanitize": "tsx scripts/sanitize-existing-notifications.ts"
	},
	"lint-staged": {
		"*.{js,ts,svelte}": [
			"eslint --cache --fix",
			"prettier --write"
		],
		"*.{json,md,css,html}": "prettier --write"
	},
	"devDependencies": {
		"@asteasolutions/zod-to-openapi": "^8.1.0",
		"@commitlint/cli": "^20.1.0",
		"@commitlint/config-conventional": "^20.0.0",
		"@eslint/compat": "^1.4.0",
		"@eslint/js": "^9.36.0",
		"@internationalized/date": "^3.10.0",
		"@lucide/svelte": "^0.544.0",
		"@playwright/test": "^1.55.1",
		"@sveltejs/adapter-vercel": "^5.10.2",
		"@sveltejs/kit": "^2.43.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.0",
		"@tailwindcss/forms": "^0.5.10",
		"@tailwindcss/typography": "^0.5.18",
		"@tailwindcss/vite": "^4.1.13",
		"@types/canvas-confetti": "^1.9.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22",
		"@types/pg": "^8.15.5",
		"@types/ws": "^8.18.1",
		"@vitest/browser": "^3.2.4",
		"bits-ui": "^2.11.5",
		"clsx": "^2.1.1",
		"dotenv": "^17.2.3",
		"eslint": "^9.36.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.12.4",
		"globals": "^16.4.0",
		"husky": "^9.1.7",
		"lint-staged": "^16.2.6",
		"lucide-svelte": "^0.545.0",
		"openapi3-ts": "^4.5.0",
		"pg": "^8.16.3",
		"playwright": "^1.55.1",
		"prettier": "^3.6.2",
		"prettier-plugin-svelte": "^3.4.0",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"shadcn-svelte": "^1.0.8",
		"standard-version": "^9.5.0",
		"svelte": "^5.39.5",
		"svelte-check": "^4.3.2",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^3.1.1",
		"tailwindcss": "^4.1.13",
		"tsx": "^4.20.6",
		"typescript": "^5.9.2",
		"typescript-eslint": "^8.44.1",
		"vite": "^7.1.7",
		"vitest": "^3.2.4",
		"vitest-browser-svelte": "^1.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild"
		]
	},
	"dependencies": {
		"@cortex-js/compute-engine": "^0.30.2",
		"@fontsource/inter": "^5.2.8",
		"@fontsource/lora": "^5.2.8",
		"@neoconfetti/svelte": "^2.2.2",
		"@supabase/ssr": "^0.7.0",
		"@supabase/supabase-js": "^2.74.0",
		"@tiptap/core": "^3.7.0",
		"@tiptap/extension-color": "^3.7.0",
		"@tiptap/extension-highlight": "^3.7.0",
		"@tiptap/extension-link": "^3.7.0",
		"@tiptap/extension-subscript": "^3.7.0",
		"@tiptap/extension-superscript": "^3.7.0",
		"@tiptap/extension-task-item": "^3.7.0",
		"@tiptap/extension-task-list": "^3.7.0",
		"@tiptap/extension-text-align": "^3.7.0",
		"@tiptap/extension-text-style": "^3.7.0",
		"@tiptap/extension-underline": "^3.7.0",
		"@tiptap/starter-kit": "^3.7.0",
		"bad-words": "^4.0.0",
		"canvas-confetti": "^1.9.3",
		"date-fns": "^4.1.0",
		"glob": "^11.0.3",
		"highlight.js": "^11.11.1",
		"isomorphic-dompurify": "^2.30.1",
		"marked": "^16.4.1",
		"mathjs": "^15.0.0",
		"mathlive": "^0.107.1",
		"mode-watcher": "^1.1.0",
		"svelte-sonner": "^1.0.5",
		"ws": "^8.18.3",
		"yaml": "^2.8.1",
		"zod": "^4.1.12"
	}
}

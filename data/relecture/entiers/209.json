					{
						"type": "custom",
						"expression": "answer != {{a}}*{{b}}",
						"description": "Legacy testAnswer: &answer!=&1*&2"
					},
					{
						"type": "divisor",
						"dividend": "{{a}}*{{b}}"
					}
				],
				"blanks": [

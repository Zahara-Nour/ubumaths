{
	"git": {
		"deploymentEnabled": {
			"**": false,
			"main": true
		}
	},
	"crons": [],
	"ignoreCommand": "bash scripts/vercel-ignore-build.sh",
	"headers": [
		{
			"source": "/upsilon-simulator/(.*)",
			"headers": [
				{
					"key": "Cache-Control",
					"value": "public, max-age=2592000"
				}
			]
		}
	]
}

#!/usr/bin/env sh

# Get current branch
BRANCH=$(git branch --show-current)

# Only run checks on main branch
if [ "$BRANCH" = "main" ]; then
  echo "🧪 Running pre-commit checks on main branch..."
  
  # Run linting
  echo "📋 Running linting..."
  pnpm lint
  # Linting errors are now warnings-only, no need to block commits
  
  # Optional: Run tests (commented out by default as it can be slow)
  # Uncomment the following lines to run tests before every commit on main
  # echo "🧪 Running tests..."
  # pnpm test:unit --run || {
  #   echo "❌ Tests failed. Please fix tests before committing."
  #   exit 1
  # }
  
  echo "✅ Pre-commit checks passed!"
else
  echo "ℹ️  Skipping pre-commit checks (not on main branch)"
fi

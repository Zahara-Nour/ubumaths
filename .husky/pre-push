# Les refs poussées arrivent sur l'entrée standard, lisible une seule fois : gardées ici
# pour la garde du déploiement et, plus bas, pour « code modifié ⇒ doc modifiée ».
refs_poussees="$(cat)"
printf '%s\n' "$refs_poussees" | bash scripts/garde-deploy-en-cours.sh push || exit 1
# Début des contrôles, pour `pnpm durees` (noté tout en bas, si tout est vert).
debut_durees=$(date +%s)
# Fichiers SUIVIS uniquement (cf. scripts/format-check-tracked.sh) : la CI voit un
# clone frais, donc un fichier non commité ne peut pas la faire rougir. Vérifier
# tout l'arbre bloquait des push pour le brouillon non suivi d'une autre session,
# et poussait au `--no-verify` — qui saute aussi le lint ci-dessous.
echo "pre-push : prettier --check (fichiers suivis)…"
if ! pnpm format:check; then
	echo ""
	echo "❌ Formatage : les fichiers signalés ci-dessus ne sont pas formatés → la CI échouerait (job Lint)."
	echo "   Les formater, eux seuls, puis re-push :  pnpm format <fichiers>"
	echo "   (jamais pnpm format:all : il reformaterait le travail en cours des autres sessions)"
	exit 1
fi

# Le full ESLint reste CI-only (type-aware, coûteux). `scripts/lint-fast.sh`
# rejoue en ~2,5 s TOUTES les règles de niveau erreur de la config complète,
# sans le service TypeScript (élargi le 2026-10-07 après un échec CI sur
# `no-fallthrough`) : il évite un aller-retour CI pour une erreur de lint.
# `--push` : seulement les fichiers des commits qui partent, jamais un non
# suivi — même raison que le formatage ci-dessus (dépôt principal partagé ;
# le brouillon `.ts` d'une autre session a bloqué tous les push le 2026-10-18).
# Horodatages des migrations neuves contre origin/main relu à l'instant : la CI
# d'une PR peut tourner sur un main périmé (2026-11-01, `20261101215000` pris deux fois).
echo "pre-push : horodatages des migrations…"
if ! pnpm check:migrations; then
	exit 1
fi

echo "pre-push : lint rapide…"
if ! pnpm lint:fast --push; then
	exit 1
fi

# Liens de la doc : un commit de doc poussé directement sur main ne passe pas
# par la CI (filtre `paths` de quality.yml) ; c'est ici qu'un lien cassé est arrêté (~1 s).
echo "pre-push : liens de la doc…"
if ! pnpm docs:check-links; then
	exit 1
fi

# Renvois de la doc vers le code (fichiers, scripts pnpm) : même raison.
echo "pre-push : renvois de la doc vers le code…"
if ! pnpm docs:check-refs --strict; then
	exit 1
fi

# Couverture du code par la doc (chaque fichier a sa doc, ou est un trou connu).
echo "pre-push : doc à jour…"
if ! pnpm docs:check-a-jour --couverture; then
	exit 1
fi

# Code modifié ⇒ doc modifiée, ou `Doc-inchangée:` / `Doc-reportée:` dans un commit.
# Bloquant depuis le 2026-11-22 (avertissement avant) : 18 des 29 CI rouges de la
# semaine venaient de cette garde, vue seulement 7 min après le push.
# Seulement quand le push emporte le commit courant : la garde lit HEAD, et une suppression
# de branche, un tag ou une autre branche ne doivent pas être refusés pour la doc de HEAD.
# `origin/main` vient d'être relu par la garde des horodatages ci-dessus.
if printf '%s\n' "$refs_poussees" | grep -q " $(git rev-parse HEAD) "; then
	if ! pnpm docs:check-a-jour --depuis origin/main; then
		exit 1
	fi
else
	echo "pre-push : le commit courant ne part pas, « code modifié ⇒ doc modifiée » non vérifié."
	# Il n'a pas tout joué : sa durée n'est pas une mesure.
	debut_durees=""
fi

# Filtre de chemins de la suite d'intégration : 13 des 20 rouges de la semaine (~2 s).
echo "pre-push : filtre de chemins de l'intégration…"
if ! pnpm check:integration-paths; then
	exit 1
fi

# Durée d'un pre-push vert, pour `pnpm durees` (ne peut pas faire échouer : cf. noter.sh).
[ -z "$debut_durees" ] || bash scripts/durees/noter.sh pre-push "$debut_durees"

# Fichiers SUIVIS uniquement (cf. scripts/format-check-tracked.sh) : la CI voit un
# clone frais, donc un fichier non commité ne peut pas la faire rougir. Vérifier
# tout l'arbre bloquait des push pour le brouillon non suivi d'une autre session,
# et poussait au `--no-verify` — qui saute aussi le lint ci-dessous.
echo "pre-push : prettier --check (fichiers suivis)…"
if ! pnpm format:check; then
	echo ""
	echo "❌ Formatage : des fichiers suivis ne sont pas formatés → la CI échouerait (job Lint)."
	echo "   Corrige puis re-push :  pnpm format:all"
	exit 1
fi

# Le full ESLint reste CI-only (type-aware, coûteux). `scripts/lint-fast.sh`
# rejoue en ~2,5 s TOUTES les règles de niveau erreur de la config complète,
# sans le service TypeScript (élargi le 2026-10-07 après un échec CI sur
# `no-fallthrough`) : il évite un aller-retour CI pour une erreur de lint.
echo "pre-push : lint rapide…"
if ! pnpm lint:fast; then
	exit 1
fi

# Liens de la doc : un commit de doc poussé directement sur main ne passe pas
# par la CI (`paths-ignore`) ; c'est ici qu'un lien cassé est arrêté (~1 s).
echo "pre-push : liens de la doc…"
if ! pnpm docs:check-links; then
	exit 1
fi

# Renvois de la doc vers le code (fichiers, scripts pnpm) : même raison.
echo "pre-push : renvois de la doc vers le code…"
if ! pnpm docs:check-refs --strict; then
	exit 1
fi

# Couverture du code par la doc (chaque fichier a sa doc, ou est un trou connu),
# et rappel des docs que la branche devrait mettre à jour (avertissement).
echo "pre-push : doc à jour…"
if ! pnpm docs:check-a-jour --couverture; then
	exit 1
fi
pnpm docs:check-a-jour --depuis origin/main --avertir

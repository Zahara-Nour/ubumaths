# Fichiers SUIVIS uniquement (cf. scripts/format-check-tracked.sh) : la CI voit un
# clone frais, donc un fichier non commité ne peut pas la faire rougir. Vérifier
# tout l'arbre bloquait des push pour le brouillon non suivi d'une autre session,
# et poussait au `--no-verify` — qui saute aussi le lint ci-dessous.
echo "pre-push : prettier --check (fichiers suivis)…"
if ! pnpm format:check; then
	echo ""
	echo "❌ Formatage : des fichiers suivis ne sont pas formatés → la CI échouerait (job Lint)."
	echo "   Corrige puis re-push :  pnpm format:all"
	exit 1
fi

# Le full ESLint reste CI-only : type-aware, ~35 s et 1,15 Go pour douze fichiers.
# Mais les trois règles qui l'ont fait rougir sur les 100 derniers runs sont des
# règles AST pures — `scripts/lint-fast.sh` les rejoue en ~2 s et 279 Mo, ce qui
# évite un aller-retour CI de six minutes pour une variable inutilisée.
echo "pre-push : lint rapide…"
if ! pnpm lint:fast; then
	exit 1
fi

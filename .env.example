# ============================================================================
# UbuMaths Environment Variables
# ============================================================================
# This file documents all available environment variables for UbuMaths.
# Copy this file to .env and fill in your values.
#
# All environment variables are validated on application startup using Zod.
# See src/lib/server/env.ts for the validation schema.
#
# IMPORTANT: Never commit .env to version control!
# ============================================================================

# ============================================================================
# Node Environment
# ============================================================================
# Environment mode: development, production, or test
NODE_ENV=development

# ============================================================================
# Supabase Configuration
# ============================================================================
# Your Supabase project URL (required)
PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anonymous key for client-side authentication (required)
PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Alternative name for public key (legacy support)
PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Service role key for server-side operations (required)
# WARNING: Keep this secret! Never expose to client-side code
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Access token for Supabase CLI operations
SUPABASE_ACCESS_TOKEN=your-access-token-here

# ============================================================================
# Database Configuration
# ============================================================================
# Optional: Direct database connection URL (for advanced use cases)
# Usually not needed - Supabase client handles connections
DATABASE_URL=postgresql://user:password@host:port/database

# ============================================================================
# Google OAuth Configuration
# ============================================================================
# Optional: Google OAuth client ID (if using Google sign-in)
PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Optional: Google OAuth client secret
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_SECRET=your-google-client-secret

# ============================================================================
# AI Chatbot Configuration (Groq API)
# ============================================================================
# Optional: Groq API key for Père Ubu chatbot feature
# Get your free API key at: https://console.groq.com
GROQ_API_KEY=gsk_your-groq-api-key-here

# Default model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Legacy OpenAI support (optional, if migrating from OpenAI)
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# ============================================================================
# App Configuration
# ============================================================================
# Optional: Public app URL (for canonical URLs, redirects, etc.)
PUBLIC_APP_URL=http://localhost:5173

# ============================================================================
# Feature Flags
# ============================================================================
# Enable/disable AI chatbot feature (default: true)
ENABLE_AI_CHATBOT=true

# Enable/disable WebSocket server for real-time features (default: true)
ENABLE_WEBSOCKET=true

# Enable/disable error logging to database (default: true)
ENABLE_ERROR_LOGGING=true

# ============================================================================
# Rate Limiting Configuration
# ============================================================================
# Rate limit window in milliseconds (default: 900000 = 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum requests per window (default: 5)
RATE_LIMIT_MAX_REQUESTS=5

# ============================================================================
# Security Configuration
# ============================================================================
# Optional: Secret for session encryption (min 32 characters)
# Generate with: openssl rand -base64 32
SESSION_SECRET=your-32-character-session-secret-here

# Optional: Secret for CSRF token encryption (min 32 characters)
# Generate with: openssl rand -base64 32
CSRF_SECRET=your-32-character-csrf-secret-here

# Optional: Secret for cron job authentication (min 16 characters)
# Used to protect cron endpoints from unauthorized access
CRON_SECRET=your-cron-secret-here

# ============================================================================
# File Upload Configuration
# ============================================================================
# Maximum file size in megabytes (default: 5)
MAX_FILE_SIZE_MB=5

# Allowed file types (comma-separated MIME types)
ALLOWED_FILE_TYPES=image/png,image/jpeg,application/pdf

# ============================================================================
# Logging Configuration
# ============================================================================
# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# ============================================================================
# External Services (Optional)
# ============================================================================

# LaTeX compilation service URL
LATEX_COMPILER_URL=https://latex-compiler.example.com

# Typst compilation service URL
TYPST_COMPILER_URL=https://typst-compiler.example.com

# Email service configuration
EMAIL_FROM=noreply@ubumaths.com
EMAIL_SERVICE_API_KEY=your-email-service-key

# ============================================================================
# Monitoring & Error Tracking
# ============================================================================
# Optional: Sentry DSN for error tracking
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ============================================================================
# Vercel Deployment (Auto-populated by Vercel)
# ============================================================================
# These are automatically set by Vercel - no need to configure manually
VERCEL=1
VERCEL_ENV=production
VERCEL_URL=your-app.vercel.app

# ============================================================================
# Test Configuration
# ============================================================================
# Optional: Test API base URL for integration tests
VITE_TEST_API_BASE=http://localhost:5173

# Skip integration tests (set to 'true' to skip)
TEST_SKIP_INTEGRATION=false

# Test data IDs (for integration tests)
TEST_CLASS_ID=test-class-1
TEST_EMPTY_CLASS_ID=test-empty-class
TEST_OTHER_CLASS_ID=other-teacher-class

# Placeholder environment for CI ONLY — copied to `.env` by the CI jobs.
# Contains NO real secrets: tests mock all Supabase responses and
# `createClient()` makes no network call at construction. These values exist
# only so that:
#   - `svelte-kit sync` generates the `$env/static/{public,private}` members
#     used across the app (otherwise svelte-check reports "no exported member"),
#   - `getServiceRoleClient()` & co. do not throw on missing env in unit tests.
# `.env` itself stays gitignored, so this never affects local development.

PUBLIC_SUPABASE_URL=https://placeholder.supabase.co
PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key
PUBLIC_SUPABASE_PUBLISHABLE_KEY=placeholder-publishable-key
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key

PUBLIC_GOOGLE_CLIENT_ID=placeholder-google-client-id
PUBLIC_APP_URL=http://localhost:5173

# Likely-referenced server secrets (placeholders, never real values)
SESSION_SECRET=placeholder-session-secret
CSRF_SECRET=placeholder-csrf-secret
CRON_SECRET=placeholder-cron-secret
GOOGLE_TOKEN_ENCRYPTION_KEY=placeholder-google-token-encryption-key

{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"ask": [
			"Bash(git reset:*)",
			"Bash(git rebase:*)",
			"Bash(git clean:*)",
			"Bash(rm -rf :*)",
			"Bash(rm -r :*)",
			"Bash(rm :*)",
			"Bash(mv :*)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde-commandes.py\"",
						"timeout": 10
					}
				]
			}
		]
	}
}

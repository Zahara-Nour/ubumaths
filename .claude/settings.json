{
	"$schema": "https://json.schemastore.org/claude-code-settings.json",
	"permissions": {
		"ask": [
			"Bash(git reset:*)",
			"Bash(git rebase:*)",
			"Bash(git clean:*)",
			"Bash(git revert:*)",
			"Bash(git restore:*)",
			"Bash(git checkout -- :*)",
			"Bash(git checkout . :*)",
			"Bash(git stash drop:*)",
			"Bash(git stash clear:*)",
			"Bash(git branch -D:*)",
			"Bash(git worktree remove --force:*)",
			"Bash(git worktree remove -f:*)",
			"Bash(git push --force:*)",
			"Bash(git push -f:*)",
			"Bash(git push --force-with-lease:*)",
			"Bash(rm -rf :*)",
			"Bash(rm -r :*)",
			"Bash(rm :*)",
			"Bash(mv :*)"
		]
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [
					{
						"type": "command",
						"command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/garde-commandes.py\"",
						"timeout": 10
					}
				]
			}
		]
	}
}

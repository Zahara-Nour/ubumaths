											stroke-width={shape.strokeWidth}
											stroke-linecap="round"
											stroke-dasharray={dashArray}
											opacity={shape.opacity}
											transform={rotation ? `rotate(${rotation} ${shapeCx} ${shapeCy})` : undefined}
										/>

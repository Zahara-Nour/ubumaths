// une tentative pour générer un mathgraph.d.ts,
// mais ça ne génère pas les déclarations de type d'après les jsdoc
// on laisse tomber et on revient à l'usage de tsd-jsdoc
// (même s'il n'est plus maintenu depuis longtemps et demande un patch de son
// dist/type_resolve_helpers.js pour remplacer la ligne 443
// `if (parent) {`
// par
// `if (parent?.prop?.type) {`
// pour continuer à fonctionner avec le code de mathgraph
// (sans ce patch ça marchait jusqu'au commit b44c3c37 (2024-03-24 10:02)
// mais plus ensuite)
{
  // Change this to match your project
  "include": ["src/**/*.js"],
  // les fichiers de l'include précédent à ne pas charger
  // (s'ils sont importé par un fichier inclus ils seront chargé quand même)
  "exclude": ["src/uiCommands/brython/scripts/brython*"],
  "compilerOptions": {
    // Tells TypeScript to read JS files, as
    // normally they are ignored as source files
    "allowJs": true,
    // Generate d.ts files
    "declaration": true,
    // This compiler run should
    // only output d.ts files
    "emitDeclarationOnly": true,
    // Types should go into this directory.
    // Removing this would place the .d.ts files
    // next to the .js files
    "outDir": "dist/types",
    // on précise de tout mettre dans un seul fichier (outDir est alors ignoré)
    "outFile": "dist/mathgraph.d.ts",
    // go to js file when using IDE functions like
    // "Go to Definition" in VSCode
    "declarationMap": false, // on veut pas de .map
    // faut ajouter ça pour qu'il arrête de râler avec par ex du
    // TS2583: Cannot find name 'Set'. Do you need to change your target library? Try changing the 'lib' compiler option to 'es2015' or later.
    "lib":["ESNext", "DOM"],
    // pour du debug
//    "listFiles": true,
    "listEmittedFiles": true
  }
}

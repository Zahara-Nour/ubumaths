; Script generated by the Inno Setup Script Wizard.
; SEE THE DOCUMENTATION FOR DETAILS ON CREATING INNO SETUP SCRIPT FILES!

[Setup]
; NOTE: The value of AppId uniquely identifies this application.
; Do not use the same AppId value in installers for other applications.
; (To generate a new GUID, click Tools | Generate GUID inside the IDE.)
AppId={{31BC28F5-98A9-4C4F-828E-22F937C4E349}
AppName=MathGraph32JS
AppVerName=MathGraph32 JS 9.4.0 64 bits
AppPublisher=Yves Biton
AppPublisherURL=http://mathgraph32.org
AppSupportURL=http://mathgraph32.org
AppUpdatesURL=http://mathgraph32.org
DefaultDirName={pf}\MathGraph32JS
DefaultGroupName=MathGraph32JS
LicenseFile=D:\MathGraphJS\mathgraph_js\electron\license.txt
OutputBaseFilename=setupMathGraph32JS-arm-64bits
SetupIconFile=D:\MathGraphJS\mathgraph_js\electron\logoMathGraph.ico
Compression=lzma
SolidCompression=yes
ChangesAssociations=yes
VersionInfoVersion=9.4.0
ShowLanguageDialog=yes

[Languages]
Name: "french"; MessagesFile: "compiler:Languages\French.isl"
Name: "english";MessagesFile: "compiler:default.isl"
Name: "spanish"; MessagesFile: "compiler:Languages\Spanish.isl"


[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"

[Files]
Source: "D:\MathGraphJS\mathgraph_js\electron-packages\MathGraph32JS-win32-arm64\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; NOTE: Don't use "Flags: ignoreversion" on any shared system files

[Icons]
Name: "{group}\MathGraph32JS"; Filename: "{app}\MathGraph32JS.exe"
Name: "{commondesktop}\MathGraph32JS"; Filename: "{app}\MathGraph32JS.exe"; Tasks: desktopicon

[Registry]
Root: HKCR; Subkey: ".mgj"; ValueType: string; ValueName: ""; ValueData: "MathGraph32File"; Flags: uninsdeletekey
Root: HKCR; Subkey: "MathGraph32File"; ValueType: string; ValueName: ""; ValueData: "MathGraph32 Figure"; Flags: uninsdeletekey
Root: HKCR; Subkey: "MathGraph32File\DefaultIcon"; ValueType: string; ValueName: ""; ValueData: "{app}\MathGraph32JS.exe,0"; Flags: uninsdeletekey
Root: HKCR; Subkey: "MathGraph32File\shell\open\command"; ValueType: string; ValueName: ""; ValueData: """{app}\MathGraph32JS.exe"" ""%1"""; Flags: uninsdeletekey


[Run]
Filename: "{app}\MathGraph32JS.exe"; Description: "{cm:LaunchProgram,MathGraph32JS}"; Flags: nowait postinstall skipifsilent




































































































































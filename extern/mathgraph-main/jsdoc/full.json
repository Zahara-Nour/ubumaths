{
  "comment"  : "cf http://usejsdoc.org/about-configuring-jsdoc.html",
  "tags"     : {
    "allowUnknownTags": true
  },
  "source"   : {
    "include": [ "./src", "./jsdoc/full.md"],
    "exclude": ["src/uiCommands/brython/scripts/brython.min.js", "src/pwa"]
  },
  "plugins"  : ["plugins/markdown"],
  "markdown" : {
    "idInHeadings": true
  },
  "opts"     : {
    "destination": "./documentation/full",
    "recurse"    : true,
    "private"    : false,
    "template": "node_modules/docdash",
    "tutorials": "./jsdoc/tutorials"
  },
  "docdash": {
    "comment": "Cf https://github.com/clenemt/docdash (options)",
    "static": true,
    "sort": true,
    "search": true,
    "collapse": true,
    "commonNav": true
  },
  "templates": {
    "cleverLinks": true
  }
}

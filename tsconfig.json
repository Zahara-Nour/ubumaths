{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"sourceMap": true,
		"strict": true,
		"incremental": true,
		"tsBuildInfoFile": ".svelte-kit/tsconfig.tsbuildinfo",
		"paths": {
			"#lib/*": ["./src/lib/*"],
			"#tests/*": ["./tests/*"]
		}
	},
	"include": ["src", "vite.config.ts", "playwright.config.ts", "tests", "scripts/nuit"]
}
